        "name": "Image with Text V2",
        "settings": {
          "heading": "<p>How Rejuvia Works <em>3x Faster</em></p>",
          "description": "<p>6-8 spritzes under your tongue, where the tissue is packed with blood vessels, is all it takes. The ingredients absorb directly into your bloodstream. No stomach. No liver. No wasted ingredients.</p><p>More of the formula reaches your body — so you feel it working in minutes, not an hour.</p>",
          "image": "shopify://shop_images/Rejuvia_3-16-224311_copy.webp"
        }
      },
      "real_stories_v2_CKGqJy": {
        "type": "real-stories-v2",
        "blocks": {
