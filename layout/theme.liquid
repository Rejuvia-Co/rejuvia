<!doctype html>
<html lang="en" class="no-js">
<head>
  
{% render 'skio-head' %}

  {% include 'dataLayer-allPages' %}

  <meta name="robots" content="index,follow" />
  <meta name="p:domain_verify" content="5bf1b1953f372700ea99b8077d51896f" />
  <meta name="facebook-domain-verification" content="83oi8yqil0ha2pgr9sit7bgxfv8dcr" />
  <meta name="google-site-verification" content="XM6h9jLMM-HNdEytyhvpQtsP3_rgxIxUHyL6FS3qGmY" />
  <meta charset="UTF-8">

  <!-- Preconnect to improve CDN connection times -->
  <link rel="preconnect" href="https://api.skio.com" crossorigin>
  <link rel="preconnect" href="https://cdn.skio.com" crossorigin>
  <link rel="preconnect" href="https://fonts.googleapis.com" crossorigin>
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

<!-- Theme settings for JavaScript -->
  <script>
    window.THEME_SETTINGS = {
      allow_ajax_cart: {{ settings.allow_ajax_cart | json }}
    };

  </script>

  <!-- Modern interactions - vanilla JS, loads immediately -->
  <script src="{{ 'modern-interactions.js' | asset_url }}"></script>

  {%- if template == 'index' -%}
    <title>{{ page_title }}</title>
  {%- elsif template == '404' -%}
    <title>{{ shop.name }} | Page Not Found</title>
  {%- else -%}
    <title>{{ shop.name }} | {{ page_title }}</title>
  {%- endif -%}

  <meta name="description" content="{{ page_description | default: page_title }}" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="canonical" href="{{ canonical_url }}" />
  <link rel="shortcut icon" type="image/png" href="{{ 'favicon.png' | asset_url }}">

  {%- include 'fb_open_graph' -%}
  {%- include 'fonts' -%}
  {% render 'head-styles' %}

  {%- comment -%} Site-wide section-title typography. One toggle (Customizer > Theme settings > Fonts > Section Titles) restyles every section title's font/weight/letter-spacing. Each section keeps its own font SIZE (desktop + mobile). {%- endcomment -%}
  <style>
    :root {
      --rj-title-font-family: 'HelveticaNeueL', 'Helvetica Neue', Helvetica, Arial, sans-serif;
      --rj-title-weight: {{ settings.section_title_weight | default: 600 }};
      --rj-title-letter-spacing: {{ settings.section_title_letter_spacing | default: 'normal' }};
    }

    /* Unify every section title (font family, weight, letter-spacing) from the
       vars above. `body :is()` + !important guarantees this wins over each
       section's own rules. Font-size, line-height and color are intentionally
       NOT set here, so every section keeps its own sizes. */
    body :is(
      .hero-v2-heading,
      .rs-v2-heading,
      .pi-v2-heading,
      .listicle-v2-heading, .listicle-v2-heading-mobile,
      .iwt-v2-heading, .iwt-v2-heading-mobile,
      .wmd-v2-heading, .wmd-v2-heading-mobile,
      .product-intro-v3__heading,
      .hus__heading,
      .fc__title,
      .gs__title,
      .pfaq-v2-heading,
      .fp-v2-heading,
      .key-ingredients-v2__title,
      .palt-v2-heading,
      .fs__headline, .fs__headline--m,
      .reviews_section-title,
      .bogo-content__heading, .bogo-content__heading--m,
      .section-title--h1,
      .product-widget-container h1.title
    ) {
      font-family: var(--rj-title-font-family, 'HelveticaNeueL', 'Helvetica Neue', Helvetica, Arial, sans-serif) !important;
      font-weight: var(--rj-title-weight, 600) !important;
      letter-spacing: var(--rj-title-letter-spacing, normal) !important;
    }
  </style>

  <script src="{{ 'lazysizes.min.js' | asset_url }}" async="async"></script>

  <!-- jQuery loaded synchronously for inline script compatibility -->
  <!-- Positioned late in head to minimize render blocking -->
  <script src="{{ 'jquery.min.js' | asset_url }}"></script>
  <script src="{{ 'custom.js' | asset_url }}"></script>

  <!-- ProductJs must load before inline product scripts -->
  <script src="{{ 'vendor.js' | asset_url }}"></script>
  <script src="{{ 'ProductJs.js' | asset_url }}"></script>

  {{ content_for_header }}

  {%- if template contains 'customers' -%}
    {{ 'customer-account.scss.css' | asset_url | stylesheet_tag }}
    {{ "shopify_common.js" | shopify_asset_url | script_tag }}
    {{ "customer_area.js" | shopify_asset_url | script_tag }}
  {%- endif -%}

  {%- render 'structured_data', data: 'shop' -%}

  {% if template contains 'page.ingredients' %}
  <link rel="stylesheet" href="{{ 'page-ingredients.css' | asset_url }}">
  {% endif %}

  {% if template contains 'cart' %}
  <link rel="stylesheet" href="{{ 'cart.css' | asset_url }}">
  <link rel="stylesheet" href="{{ 'okendo-cart.css' | asset_url }}">
  {% endif %}

</head>

<body class="template{{ template | split: '.' | first | camelize }}{% if customer %} customer-logged-in{% endif %} {{ template.suffix }} template--{{ template.name }} {% if template.name == 'cart' and cart.item_count == 0 %} template--{{ template.name }}--empty {% endif %}">
  <a href="#main-content" class="skip-to-main-content">Skip to Main Content</a>
  <div id="page">
    {%- section 'header-top' -%}
    <header role="banner" class="{% if settings.sticky_header_desktop %}sticky_header_desktop {% endif %}{% if settings.sticky_header_mobile %}sticky_header_mobile{% endif %}">
      {%- section 'header' -%}
    </header>
    <main class="content-wrapper" id="main-content" role="main">
      {{ content_for_layout }}
    </main>
    {% sections 'footer-group' %}


    <div id="loading-overlay">
      <div class="loader"></div>
    </div>
  </div>

  {%- if settings.grid_product_image_behavior == "thumbs_swatches" -%}
    {%- if template == 'product' and settings.show_related_products -%}
      {%- include 'thumbs_swatches_js' -%}
    {%- elsif template == "index" or template == 'search' or template == 'collection' -%}
      {%- include 'thumbs_swatches_js' -%}
    {%- endif -%}
  {%- endif -%}
  {%- if template contains 'product' or template contains 'collection' or template == "index" -%}
    {%- include 'photoswipe' -%}
  {%- endif -%}

  {% render 'content_for_footer' %}

  <!-- Initialize add to cart with settings -->
  <script>
    if (window.ModernInteractions) {
      {%- if settings.allow_ajax_cart -%}
        window.ModernInteractions.initAddToCart(true);
      {%- else -%}
        window.ModernInteractions.initAddToCart(false);
      {%- endif -%}
    }
  </script>
</body>
</html>