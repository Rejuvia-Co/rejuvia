{%- comment -%}
  Homepage "It's how you absorbed it" (direction 2c): photo + short headline,
  one-line subhead and three icon benefit rows. Static — replaces Listicle V2.

  Desktop (>=990px): photo | [headline, subhead, rows].
  Below 990px: headline → photo → subhead → rows.
{%- endcomment -%}

{%- liquid
  assign accent = section.settings.accent_color | default: '#672666'
-%}

{% style %}
  .absv2-section { background: {{ section.settings.bg_color | default: '#ffffff' }}; overflow-x: clip; }

  .absv2 {
    max-width: 1120px;
    margin: 0 auto;
    padding: 72px 40px;
    box-sizing: content-box;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    grid-template-rows: 1fr auto auto auto 1fr;
    grid-template-areas:
      "photo ."
      "photo head"
      "photo sub"
      "photo rows"
      "photo .";
    column-gap: 64px;
    align-items: center;
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
    color: #141414;
  }

  .absv2__photo {
    grid-area: photo;
    margin: 0;
    aspect-ratio: 1 / 1;
    border-radius: 16px;
    overflow: hidden;
  }
  .absv2__photo img { display: block; width: 100%; height: 100%; object-fit: cover; }

  /* Family / weight / tracking come from the global --rj-title-* system. */
  .absv2__heading {
    grid-area: head;
    margin: 0;
    font-size: 40px;
    line-height: 1.15;
    color: #171512;
    text-wrap: balance;
  }
  .absv2__heading p { margin: 0; font: inherit; color: inherit; letter-spacing: inherit; }
  .absv2__heading em,
  .absv2__heading u,
  .absv2__heading [style*="underline"] {
    color: {{ accent }};
    font-style: normal;
    text-decoration: underline;
    text-decoration-thickness: 3px;
    text-underline-offset: 6px;
  }

  .absv2__sub {
    grid-area: sub;
    margin: 16px 0 0;
    font-size: 18px;
    line-height: 1.4;
    color: #141414;
    text-wrap: pretty;
  }

  .absv2__rows {
    grid-area: rows;
    margin-top: 28px;
    display: flex;
    flex-direction: column;
    gap: 22px;
  }
  .absv2__row {
    display: grid;
    grid-template-columns: 60px minmax(0, 1fr);
    gap: 18px;
    align-items: center;
  }
  .absv2__icon {
    width: 60px;
    height: 60px;
    border-radius: 100px;
    background: {{ section.settings.icon_bg | default: '#f3eef6' }};
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .absv2__icon svg { width: 36px; height: 36px; display: block; }
  .absv2__text { display: flex; flex-direction: column; gap: 3px; }
  .absv2__title { font-size: 19px; font-weight: 600; line-height: 1.3; color: #171512; }
  .absv2__desc { font-size: 16px; line-height: 1.4; color: #5a5664; }

  @media (max-width: 989px) {
    .absv2 {
      max-width: 600px;
      padding: 40px 16px;
      display: flex;
      flex-direction: column;
      align-items: stretch;
      gap: 20px;
    }
    .absv2__heading { font-size: 29px; }
    .absv2__heading em,
    .absv2__heading u,
    .absv2__heading [style*="underline"] { text-decoration-thickness: 2px; text-underline-offset: 5px; }
    .absv2__photo { aspect-ratio: auto; height: 260px; }
    .absv2__photo img { object-position: 50% 40%; }
    .absv2__sub { margin: 0; font-size: 16px; }
    .absv2__rows { margin: 0; gap: 16px; }
    .absv2__row { grid-template-columns: 48px minmax(0, 1fr); gap: 14px; }
    .absv2__icon { width: 48px; height: 48px; }
    .absv2__icon svg { width: 30px; height: 30px; }
    .absv2__text { gap: 2px; }
    .absv2__title { font-size: 17px; }
    .absv2__desc { font-size: 15px; }
  }
{% endstyle %}

<div class="absv2">
  {%- if section.settings.heading != blank -%}
    <h2 class="absv2__heading">{{ section.settings.heading }}</h2>
  {%- endif -%}

  {%- if section.settings.image != blank -%}
    <div class="absv2__photo">
      <img src="{{ section.settings.image | image_url: width: 1100, format: 'webp' }}"
           srcset="{{ section.settings.image | image_url: width: 500, format: 'webp' }} 500w,
                   {{ section.settings.image | image_url: width: 800, format: 'webp' }} 800w,
                   {{ section.settings.image | image_url: width: 1100, format: 'webp' }} 1100w"
           sizes="(max-width: 989px) min(100vw, 600px), 560px"
           alt="{{ section.settings.image.alt | default: 'Rejuvia spray mist' | escape }}"
           width="{{ section.settings.image.width }}" height="{{ section.settings.image.height }}"
           loading="lazy" decoding="async">
    </div>
  {%- endif -%}

  {%- if section.settings.subhead != blank -%}
    <p class="absv2__sub">{{ section.settings.subhead }}</p>
  {%- endif -%}

  {%- if section.blocks.size > 0 -%}
    <div class="absv2__rows">
      {%- for block in section.blocks -%}
        <div class="absv2__row" {{ block.shopify_attributes }}>
          <span class="absv2__icon" aria-hidden="true">
            <svg viewBox="0 0 48 48" fill="none" stroke-linecap="round" stroke-linejoin="round">
              {%- case block.settings.icon -%}
                {%- when 'clock' -%}
                  <circle cx="24" cy="26" r="16" fill="#e6d6ea" stroke="{{ accent }}" stroke-width="2.5"/>
                  <path d="M24 17v9l6 4M20 5h8" stroke="{{ accent }}" stroke-width="2.5"/>
                {%- when 'drop' -%}
                  <path d="M24 6S11 21 11 30a13 13 0 0 0 26 0C37 21 24 6 24 6Z" fill="#e6d6ea" stroke="{{ accent }}" stroke-width="2.5"/>
                  <path d="M19 31a5 5 0 0 0 5 5" stroke="{{ accent }}" stroke-width="2.5"/>
                {%- else -%}
                  <path d="M19 5v8c0 4-9 6-9 16 0 8 6 13 14 13 9 0 16-6 16-15 0-7-5-10-10-8-4 1.5-6-.5-6-4V5" stroke="{{ accent }}" stroke-width="2.5"/>
                  <circle cx="21" cy="31" r="2.4" fill="#e6d6ea"/>
                  <circle cx="28" cy="27" r="1.8" fill="#e6d6ea"/>
                  <circle cx="27" cy="35" r="1.6" fill="#e6d6ea"/>
              {%- endcase -%}
            </svg>
          </span>
          <span class="absv2__text">
            <span class="absv2__title">{{ block.settings.title }}</span>
            {%- if block.settings.description != blank -%}
              <span class="absv2__desc">{{ block.settings.description }}</span>
            {%- endif -%}
          </span>
        </div>
      {%- endfor -%}
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Absorption V2",
  "class": "absv2-section",
  "max_blocks": 5,
  "settings": [
    {
      "type": "richtext",
      "id": "heading",
      "label": "Heading",
      "info": "Italic or underlined words show in the accent colour, underlined.",
      "default": "<p>It's Not What You Took. It's How You <em>Absorbed It.</em></p>"
    },
    { "type": "textarea", "id": "subhead", "label": "Subhead", "default": "Pills and gummies lose up to 80% to digestion. Rejuvia absorbs under your tongue instead." },
    { "type": "image_picker", "id": "image", "label": "Photo" },
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#ffffff" },
    { "type": "color", "id": "accent_color", "label": "Accent", "default": "#672666" },
    { "type": "color", "id": "icon_bg", "label": "Icon circle", "default": "#f3eef6" }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit row",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "stomach", "label": "Stomach" },
            { "value": "clock", "label": "Clock" },
            { "value": "drop", "label": "Drop" }
          ],
          "default": "stomach"
        },
        { "type": "text", "id": "title", "label": "Title", "default": "Skips Your Stomach" },
        { "type": "text", "id": "description", "label": "Description", "default": "No acid or enzymes breaking it down." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Absorption V2",
      "category": "Custom",
      "blocks": [
        { "type": "benefit", "settings": { "icon": "stomach", "title": "Skips Your Stomach", "description": "No acid or enzymes breaking it down." } },
        { "type": "benefit", "settings": { "icon": "clock", "title": "Works In Minutes", "description": "Asleep in 10–15 minutes, not 45+." } },
        { "type": "benefit", "settings": { "icon": "drop", "title": "Nothing Wasted", "description": "More of every spray reaches your bloodstream." } }
      ]
    }
  ]
}
{% endschema %}
