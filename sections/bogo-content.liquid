{%- comment -%}
  BOGO content section — image bed (lavender gradient) + headline, subhead,
  benefit bullets, CTA pill, and money-back-guarantee line. Image side and
  image treatment (contained product vs lifestyle cover) are configurable.
{%- endcomment -%}

{%- comment -%} Persona landing pages: own heading/subhead and all four bullets; other pages use the settings. {%- endcomment -%}
{%- assign bc_heading = section.settings.heading -%}
{%- assign bc_sub = section.settings.subhead -%}
{%- assign bc_b1 = '' -%}
{%- assign bc_b2 = '' -%}
{%- assign bc_b3 = '' -%}
{%- assign bc_b4 = '' -%}
{%- case page.handle -%}
  {%- when 'senior-citizen-bogo' -%}
    {%- assign bc_heading = 'Sleep Through the Night Again, Without Swallowing Another Pill' -%}
    {%- capture bc_sub -%}Ditch the melatonin gummies and sleeping pills. Just 6–8 sprays under your tongue and most people are asleep in 10–15 minutes, with nothing to swallow.{%- endcapture -%}
    {%- assign bc_b1 = 'Fall asleep in 10-15 minutes, no pills to swallow' -%}
    {%- assign bc_b2 = 'Get right back to sleep after the 3am bathroom trip' -%}
    {%- assign bc_b3 = 'Wake up clear, not groggy, with a gentle 2mg dose' -%}
    {%- assign bc_b4 = 'Non-habit-forming, made with 13 all-natural ingredients' -%}
  {%- when 'military-bogo' -%}
    {%- capture bc_heading -%}Switch Off at Night and Wake Up Ready, Wherever You're Stationed{%- endcapture -%}
    {%- capture bc_sub -%}Years of staying on alert don't switch off at bedtime. Just 6–8 sprays under your tongue and most people are asleep in 10–15 minutes, then up clear for the morning.{%- endcapture -%}
    {%- assign bc_b1 = 'Fall asleep in 10-15 minutes, at home, on deployment or across time zones' -%}
    {%- assign bc_b2 = 'Sleep through the entire night without 3am wake-ups' -%}
    {%- assign bc_b3 = 'Wake up clear and ready, not groggy, with a low 2mg dose' -%}
    {%- assign bc_b4 = 'Non-habit-forming, made with 13 all-natural ingredients' -%}
  {%- when 'nurse-bogo' -%}
    {%- assign bc_heading = 'Finally Sleep After Any Shift, Day or Night' -%}
    {%- capture bc_sub -%}Twelve-hour shifts, flipped schedules and a mind that won't shut off. Just 6–8 sprays under your tongue and most people are asleep in 10–15 minutes, whenever your shift ends.{%- endcapture -%}
    {%- assign bc_b1 = 'Fall asleep in 10-15 minutes after any shift, even during the day' -%}
    {%- assign bc_b2 = 'Stay asleep until your alarm, even with the sun up' -%}
    {%- assign bc_b3 = 'Wake up clear for your next shift, not groggy, with a low 2mg dose' -%}
    {%- assign bc_b4 = 'Non-habit-forming, made with 13 all-natural ingredients' -%}
  {%- when 'travel-bogo' -%}
    {%- assign bc_heading = 'Beat Jet Lag and Sleep in Any Time Zone' -%}
    {%- capture bc_sub -%}Red-eyes, hotel rooms and a body clock that's hours behind. Just 6–8 sprays under your tongue and most people are asleep in 10–15 minutes, on local time.{%- endcapture -%}
    {%- assign bc_b1 = 'Fall asleep in 10-15 minutes in any hotel room or time zone' -%}
    {%- assign bc_b2 = 'Beat jet lag and sleep on your new schedule from the first night' -%}
    {%- assign bc_b3 = 'Wake up clear and ready for the day ahead, not groggy' -%}
    {%- assign bc_b4 = 'Non-habit-forming, made with 13 all-natural ingredients' -%}
  {%- when 'menopause-bogo' -%}
    {%- assign bc_heading = 'Sleep Like You Used To, Even Through Menopause' -%}
    {%- capture bc_sub -%}Wide awake at 3am, too warm to settle, mind racing? Just 6–8 sprays under your tongue and most people are asleep in 10–15 minutes, with no pills to swallow.{%- endcapture -%}
    {%- capture bc_b1 -%}Fall asleep in 10-15 minutes, even when your body won't settle{%- endcapture -%}
    {%- assign bc_b2 = 'Get right back to sleep when you wake up warm at 3am' -%}
    {%- assign bc_b3 = 'Wake up clear, not groggy, with a gentle 2mg dose' -%}
    {%- assign bc_b4 = 'Non-habit-forming, made with 13 all-natural ingredients' -%}
  {%- when '3am-wake-up-bogo' -%}
    {%- assign bc_heading = 'No More 3AM Wake-Ups. Sleep Straight Through to Morning.' -%}
    {%- capture bc_sub -%}Wide awake at 3am, doing the sleep math while your mind won't shut off? Just 6–8 sprays under your tongue at bedtime and you're asleep in 10–15 minutes, then stay asleep until your alarm.{%- endcapture -%}
    {%- assign bc_b1 = 'Sleep through the entire night without 3am wake-ups' -%}
    {%- assign bc_b2 = 'Fall asleep in 10-15 minutes after spraying under your tongue' -%}
    {%- assign bc_b3 = 'Wake up clear, not groggy, with a gentle 2mg dose' -%}
    {%- assign bc_b4 = 'Non-habit-forming, made with 13 all-natural ingredients' -%}
{%- endcase -%}

<section
  class="bogo-content{% if section.settings.image_side == 'right' %} bogo-content--img-right{% endif %}"
  style="--bgc-bg: {{ section.settings.bg_color | default: '#fafafa' }}; --bgc-accent: {{ section.settings.accent_color | default: '#672666' }};">
  <div class="bogo-content__inner">

    {%- if bc_heading != blank -%}
      <h2 class="section-title--h1 bogo-content__heading bogo-content__heading--m">{{ bc_heading }}</h2>
    {%- endif -%}

    <div class="bogo-content__media">
      <div class="bogo-content__bed">
        {%- if section.settings.image != blank -%}
          <img class="bogo-content__img"
               src="{{ section.settings.image | image_url: width: 1200, format: 'webp' }}"
               srcset="{{ section.settings.image | image_url: width: 600, format: 'webp' }} 600w, {{ section.settings.image | image_url: width: 900, format: 'webp' }} 900w, {{ section.settings.image | image_url: width: 1200, format: 'webp' }} 1200w"
               sizes="(max-width: 760px) 90vw, 540px"
               width="{{ section.settings.image.width }}" height="{{ section.settings.image.height }}"
               alt="{{ section.settings.image.alt | default: bc_heading | escape }}" loading="lazy" decoding="async">
        {%- else -%}
          {{ 'image' | placeholder_svg_tag: 'bogo-content__img bogo-content__img--ph' }}
        {%- endif -%}
      </div>
    </div>

    <div class="bogo-content__text">
      {%- if bc_heading != blank -%}
        <h2 class="section-title--h1 bogo-content__heading">{{ bc_heading }}</h2>
      {%- endif -%}
      {%- if bc_sub != blank -%}
        <p class="bogo-content__sub">{{ bc_sub }}</p>
      {%- endif -%}

      {%- if section.blocks.size > 0 -%}
        <ul class="bogo-content__bullets">
          {%- assign bc_n = 0 -%}
          {%- for block in section.blocks -%}{%- if block.type == 'bullet' and block.settings.text != blank -%}
            {%- assign bc_n = bc_n | plus: 1 -%}
            {%- assign bc_text = block.settings.text -%}
            {%- if bc_n == 1 and bc_b1 != '' -%}{%- assign bc_text = bc_b1 -%}{%- endif -%}
            {%- if bc_n == 2 and bc_b2 != '' -%}{%- assign bc_text = bc_b2 -%}{%- endif -%}
            {%- if bc_n == 3 and bc_b3 != '' -%}{%- assign bc_text = bc_b3 -%}{%- endif -%}
            {%- if bc_n == 4 and bc_b4 != '' -%}{%- assign bc_text = bc_b4 -%}{%- endif -%}
            <li class="bogo-content__bullet" {{ block.shopify_attributes }}>
              <span class="bogo-content__check" aria-hidden="true">
                <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M2 7.4 5.3 10.5 12 3.5" stroke="#ffffff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </span>
              <span class="bogo-content__bullet-text">{{ bc_text }}</span>
            </li>
          {%- endif -%}{%- endfor -%}
        </ul>
      {%- endif -%}

      <div class="bogo-content__cta">
        {%- if section.settings.cta_text != blank -%}
          <a class="bogo-content__btn" href="{{ section.settings.cta_link | default: '#offer' }}" data-cta-scroll="{{ section.settings.scroll_target }}">{{ section.settings.cta_text }}</a>
        {%- endif -%}
        {%- if section.settings.show_guarantee and section.settings.guarantee_text != blank -%}
          <span class="bogo-content__guarantee">
            <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M4 12.5l5 5 11-12" stroke="#fab851" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/></svg>
            {{ section.settings.guarantee_text }}
          </span>
        {%- endif -%}
      </div>
    </div>

  </div>
</section>

<script>
(function () {
  /* Scroll to a target on the same page instead of following the href.
     Same mechanism closing-cta uses. The href stays as the fallback, so
     nothing changes on pages where scroll_target is blank or the selector
     matches nothing (e.g. the BOGO pages, which use the #offer anchor). */
  var sec = document.getElementById('shopify-section-{{ section.id }}');
  if (!sec) return;
  var btn = sec.querySelector('[data-cta-scroll]');
  if (!btn) return;
  btn.addEventListener('click', function (e) {
    var sel = btn.getAttribute('data-cta-scroll');
    if (!sel) return;
    var target = document.querySelector(sel);
    if (!target) return;
    e.preventDefault();
    var top = target.getBoundingClientRect().top + window.pageYOffset - 24;
    window.scrollTo({ top: top, behavior: 'smooth' });
  });
})();
</script>

<style>
  .bogo-content {
    width: 100%;
    box-sizing: border-box;
    background: var(--bgc-bg, #fafafa);
    padding: 72px 64px;
    font-family: 'Helvetica Neue', Arimo, Helvetica, Arial, sans-serif;
  }
  .bogo-content__inner {
    max-width: 1180px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 72px;
    align-items: center;
  }
  .bogo-content--img-right .bogo-content__media { order: 2; }

  .bogo-content__bed {
    border-radius: 20px;
    overflow: hidden;
    aspect-ratio: 1 / 1;
  }
  .bogo-content__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .bogo-content__img--ph { width: 100%; height: 100%; background: #ececf4; }

  .bogo-content__heading--m { display: none; }
  .bogo-content__heading {
    margin: 0 0 22px;
    text-wrap: balance;
    font-size: {{ section.settings.heading_size | default: 36 }}px;
  }
  .bogo-content__sub {
    margin: 0 0 30px;
    max-width: 460px;
    font-size: {{ section.settings.subhead_size | default: 18 }}px;
    font-weight: 400;
    line-height: 1.55;
    color: #767676;
  }
  .bogo-content__bullets {
    list-style: none;
    margin: 0 0 38px;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .bogo-content__bullet {
    display: flex;
    align-items: flex-start;
    gap: 14px;
  }
  .bogo-content__check {
    flex-shrink: 0;
    width: 26px;
    height: 26px;
    border-radius: 100px;
    background: #4a1c4a;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-top: 1px;
  }
  .bogo-content__bullet-text {
    font-size: {{ section.settings.bullet_size | default: 17 }}px;
    line-height: 1.45;
    color: #232323;
  }
  .bogo-content__cta {
    max-width: 480px;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .bogo-content__btn {
    display: flex;
    width: 100%;
    box-sizing: border-box;
    align-items: center;
    justify-content: center;
    background: var(--bgc-accent, #672666);
    color: #fff;
    font-size: 18px;
    font-weight: 500;
    letter-spacing: normal;
    line-height: 1.4;
    text-align: center;
    text-decoration: none;
    padding: 24px 32px;
    border: none;
    border-radius: 100px;
    cursor: pointer;
    transition: background 150ms cubic-bezier(.22,1,.36,1), transform 150ms cubic-bezier(.22,1,.36,1);
}
  .bogo-content__btn:hover { background: #5d215f; color: #fff; }
  .bogo-content__btn:active { transform: scale(0.985); }
  .bogo-content__guarantee {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    margin-top: 18px;
    font-size: 16px;
    color: #141414;
  }
  .bogo-content__guarantee svg { width: 18px; height: 18px; display: block; flex-shrink: 0; }

  @media (max-width: 760px) {
    .bogo-content__heading { font-size: {{ section.settings.heading_size_mobile | default: 26 }}px; text-wrap: normal; }
    .bogo-content { padding: 40px 20px; }
    .bogo-content__inner { grid-template-columns: 1fr; gap: 32px; }
    .bogo-content--img-right .bogo-content__media,
    .bogo-content__media { order: 0; }
    /* Lead with the headline on mobile; the in-column copy stays for desktop. */
    .bogo-content__heading--m { display: block; margin: 0; }
    .bogo-content__text .bogo-content__heading { display: none; }
    .bogo-content__bed { aspect-ratio: 4 / 3; }
    .bogo-content__sub { font-size: {{ section.settings.subhead_size_mobile | default: 16 }}px; margin-bottom: 24px; }
    .bogo-content__bullet-text { font-size: {{ section.settings.bullet_size_mobile | default: 17 }}px; }
    .bogo-content__btn { font-size: 18px; padding: 20px 28px; }
  }
</style>

{% schema %}
{
  "name": "BOGO Content Section",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Headline", "default": "Buy One, Get One Free — Sleep Better, Together" },
    { "type": "textarea", "id": "subhead", "label": "Subhead", "default": "Stock up on Midnight Bliss Oral Sleep Spray and share the gift of deep, restful sleep with someone you love." },
    { "type": "header", "content": "Font sizes" },
    { "type": "range", "id": "heading_size", "min": 20, "max": 60, "step": 1, "unit": "px", "label": "Headline (desktop)", "default": 36 },
    { "type": "range", "id": "heading_size_mobile", "min": 16, "max": 44, "step": 1, "unit": "px", "label": "Headline (mobile)", "default": 26 },
    { "type": "range", "id": "subhead_size", "min": 12, "max": 30, "step": 1, "unit": "px", "label": "Subhead (desktop)", "default": 18 },
    { "type": "range", "id": "subhead_size_mobile", "min": 11, "max": 26, "step": 1, "unit": "px", "label": "Subhead (mobile)", "default": 16 },
    { "type": "range", "id": "bullet_size", "min": 12, "max": 28, "step": 1, "unit": "px", "label": "Bullet text (desktop)", "default": 17 },
    { "type": "range", "id": "bullet_size_mobile", "min": 11, "max": 26, "step": 1, "unit": "px", "label": "Bullet text (mobile)", "default": 17 },
    { "type": "header", "content": "Image" },
    { "type": "image_picker", "id": "image", "label": "Image", "info": "Fills the rounded frame (square works best)." },
    { "type": "select", "id": "image_side", "label": "Image side (desktop)", "options": [ { "value": "left", "label": "Left" }, { "value": "right", "label": "Right" } ], "default": "left" },
    { "type": "header", "content": "Call to action" },
    { "type": "text", "id": "cta_text", "label": "Button text", "default": "Try Rejuvia Risk-Free" },
    { "type": "url", "id": "cta_link", "label": "Button link", "info": "Defaults to #offer (scrolls to the buybox) if left blank." },
    { "type": "text", "id": "scroll_target", "label": "Scroll to (CSS selector)", "info": "Overrides the link and smooth-scrolls to this element, e.g. .product-widget-container. Leave blank to use the link." },
    { "type": "checkbox", "id": "show_guarantee", "label": "Show guarantee line", "default": true },
    { "type": "text", "id": "guarantee_text", "label": "Guarantee text", "default": "90-Day Money-Back Guarantee" },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "bg_color", "label": "Section background", "default": "#fafafa" },
    { "type": "color", "id": "accent_color", "label": "Button color", "default": "#672666" }
  ],
  "blocks": [
    {
      "type": "bullet",
      "name": "Benefit bullet",
      "settings": [
        { "type": "text", "id": "text", "label": "Text" }
      ]
    }
  ],
  "presets": [
    {
      "name": "BOGO Content Section",
      "blocks": [
        { "type": "bullet", "settings": { "text": "Fall asleep faster with a fast-absorbing oral spray — no pills to swallow" } },
        { "type": "bullet", "settings": { "text": "Wake up refreshed, never groggy, with a non-habit-forming formula" } },
        { "type": "bullet", "settings": { "text": "Made with melatonin, L-theanine & soothing botanicals" } },
        { "type": "bullet", "settings": { "text": "Two bottles delivered free — keep one, gift one" } }
      ]
    }
  ]
}
{% endschema %}
