{%- comment -%}
  BOGO-O2 minimal header.

  Used only on the page.bogo-o2 template. It hides the site's global header +
  announcement bar on this page (scoped to body.bogo-o2 so it can never affect
  any other page), and renders a plain, non-sticky white bar with a centered
  black Rejuvia logo — a distraction-free landing-page header for both mobile
  and desktop.
{%- endcomment -%}

{% style %}
  /* Hide the site's global announcement bar + main header/nav on THIS page only.
     Scoped to the template's body class (from template.suffix) as a safety belt
     on top of the section only rendering here. */
  body.bogo-o2 #shopify-section-header-top,
  body.bogo-o2 header[role="banner"] {
    display: none !important;
  }

  .bogo-o2-logobar {
    width: 100%;
    background: {{ section.settings.bg_color | default: '#ffffff' }};
    display: flex;
    align-items: center;
    justify-content: center;
    padding: {{ section.settings.padding_v | default: 22 }}px 16px;
    box-sizing: border-box;
  }

  .bogo-o2-logobar .logo-rejuvia-svg {
    width: {{ section.settings.logo_width | default: 164 }}px;
    height: auto;
    display: block;
  }

  .bogo-o2-logobar .logo-rejuvia-svg path {
    fill: {{ section.settings.logo_color | default: '#141414' }};
  }

  @media (max-width: 749px) {
    .bogo-o2-logobar {
      padding: {{ section.settings.padding_v_mobile | default: 16 }}px 16px;
    }
    .bogo-o2-logobar .logo-rejuvia-svg {
      width: {{ section.settings.logo_width_mobile | default: 150 }}px;
    }
  }
{% endstyle %}

<div class="bogo-o2-logobar">
  <span class="bogo-o2-logo" aria-label="{{ shop.name }}">
    {% render 'logo-rejuvia' %}
  </span>
</div>

{% schema %}
{
  "name": "BOGO-O2 Header",
  "class": "bogo-o2-header-section",
  "settings": [
    {
      "type": "paragraph",
      "content": "Minimal landing-page header: hides the site's nav on this page and shows a centered logo. Used on the BOGO-O2 template."
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "logo_color",
      "label": "Logo color",
      "default": "#141414"
    },
    {
      "type": "range",
      "id": "logo_width",
      "min": 100,
      "max": 240,
      "step": 2,
      "unit": "px",
      "label": "Logo width (desktop)",
      "default": 164
    },
    {
      "type": "range",
      "id": "logo_width_mobile",
      "min": 90,
      "max": 220,
      "step": 2,
      "unit": "px",
      "label": "Logo width (mobile)",
      "default": 150
    },
    {
      "type": "range",
      "id": "padding_v",
      "min": 8,
      "max": 48,
      "step": 1,
      "unit": "px",
      "label": "Vertical padding (desktop)",
      "default": 22
    },
    {
      "type": "range",
      "id": "padding_v_mobile",
      "min": 6,
      "max": 40,
      "step": 1,
      "unit": "px",
      "label": "Vertical padding (mobile)",
      "default": 16
    }
  ],
  "presets": [
    {
      "name": "BOGO-O2 Header",
      "category": "Custom"
    }
  ]
}
{% endschema %}
