{%- comment -%}
  Closing CTA — the last section on the FB ad / BOGO offer landing pages.

  Two designs live in this one section (so the live theme never depends on a
  template-JSON swap, which Shopify's GitHub sync reverts):

   • NEW "Final CTA (BOGO)" review-led close (direction 4b): floating BOGO
     bottles image + handwritten "Buy One, Get One Free!" callout on the left;
     rating bar, quote, reviewer, CTA and guarantee on the right. This renders
     on every page EXCEPT the D3+K2 page.

   • OLD card layout: kept for the D3+K2 offer page (template suffix d3-v1),
     which the user asked to exclude from the BOGO treatment.

  The NEW design reuses the settings each page already has populated live
  (review_text → quote, review_name → reviewer, button_text/scroll_target →
  CTA, guarantee_text) and falls back to schema defaults + theme-asset bottle
  images, so it fills in live with no manual configuration.
{%- endcomment -%}

{%- liquid
  assign is_d3 = false
  if template.suffix == 'd3-v1'
    assign is_d3 = true
  endif
  assign accent = section.settings.accent_color | default: '#672666'
  assign accent_hover = '#4a1b49'
-%}

{% style %}
html { scroll-behavior: smooth; }

/* ============================================================
   NEW Final CTA (BOGO) design
   ============================================================ */
.cta-{{ section.id }} .fcta { background: {{ section.settings.frame_bg | default: '#ffffff' }}; }
.cta-{{ section.id }} .fcta__inner {
  max-width: 1120px; margin: 0 auto; padding: 72px 40px; box-sizing: border-box;
  font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; color: #141414;
}
.cta-{{ section.id }} .fcta__grid {
  display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
  column-gap: 64px; row-gap: 26px; align-items: center;
}
.cta-{{ section.id }} .fcta__media {
  grid-column: 1; grid-row: 1 / span 5; position: relative; aspect-ratio: 1 / 1;
  /* Nudge the bottles + callout left so the group is centered in its column. */
  transform: translateX(-40px);
  --callout-x: 66%; --callout-y: 72%; --callout-size: 40px;
  --arrow-x: 67%; --arrow-y: 46%;
}
.cta-{{ section.id }} .fcta__media img { width: 100%; height: 100%; object-fit: contain; display: block; }
.cta-{{ section.id }} .fcta__callout {
  position: absolute; left: var(--callout-x); top: var(--callout-y); z-index: 3;
  transform: rotate(-7deg); font-family: 'Caveat', cursive; font-weight: 700;
  font-size: var(--callout-size); line-height: .95; color: {{ accent }}; white-space: nowrap;
}
.cta-{{ section.id }} .fcta__arrow { position: absolute; left: var(--arrow-x); top: var(--arrow-y); z-index: 3; overflow: visible; }

.cta-{{ section.id }} .fcta__rating { grid-column: 2; display: flex; align-items: center; gap: 14px; flex-wrap: wrap; font-size: 18px; color: #3d3a36; }
.cta-{{ section.id }} .fcta__stars { display: inline-flex; gap: 2px; }
.cta-{{ section.id }} .fcta__stars svg { width: 18px; height: 18px; display: block; }
.cta-{{ section.id }} .fcta__rate-item b { font-weight: 700; color: #171512; }
.cta-{{ section.id }} .fcta__rate-sep { width: 1px; height: 18px; background: #d6d3de; display: inline-block; }

.cta-{{ section.id }} .fcta__quote {
  grid-column: 2; margin: 0; font-size: 30px; line-height: 1.3; font-weight: 500;
  color: #171512; text-wrap: pretty;
}
.cta-{{ section.id }} .fcta__quote p { margin: 0; }

.cta-{{ section.id }} .fcta__reviewer { grid-column: 2; display: flex; align-items: center; gap: 12px; }
.cta-{{ section.id }} .fcta__reviewer img { width: 44px; height: 44px; border-radius: 100px; object-fit: cover; object-position: 50% 45%; display: block; flex: none; }
.cta-{{ section.id }} .fcta__reviewer-meta { display: flex; flex-direction: column; gap: 2px; }
.cta-{{ section.id }} .fcta__reviewer-name { font-size: 16px; font-weight: 600; }
.cta-{{ section.id }} .fcta__reviewer-since { font-size: 14px; color: #5a5664; }

.cta-{{ section.id }} .fcta__divider { grid-column: 2; height: 1px; background: #e8e6ee; }

.cta-{{ section.id }} .fcta__cta-group { grid-column: 2; display: flex; flex-direction: column; gap: 12px; }
/* Button matches the comparison section above (.palt-v2-cta-btn) exactly — same on mobile + desktop. */
.cta-{{ section.id }} .fcta__cta {
  display: flex; align-items: center; justify-content: center;
  width: 100%; padding: 24px 32px;
  background: {{ accent }}; color: #fff; text-decoration: none;
  font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
  font-size: 18px; font-weight: 500; line-height: 1.4; letter-spacing: normal;
  text-transform: capitalize;
  border: none; border-radius: 100px; cursor: pointer;
  transition: opacity 0.25s ease;
}
.cta-{{ section.id }} .fcta__cta:hover { opacity: 0.9; color: #fff; }
.cta-{{ section.id }} .fcta__guarantee { display: flex; align-items: flex-start; justify-content: center; gap: 6px; font-size: 14px; line-height: 1; color: #141414; }
.cta-{{ section.id }} .fcta__guarantee svg { flex: none; width: 14px; height: 11px; margin-top: 1px; }

@media (max-width: 749px) {
  .cta-{{ section.id }} .fcta__inner { padding: 40px 16px; }
  /* Flex column must reset align-items from the desktop grid's `center`, or items
     that aren't full-width (reviewer, guarantee, CTA group) get horizontally centered. */
  .cta-{{ section.id }} .fcta__grid { display: flex; flex-direction: column; align-items: stretch; gap: 20px; }
  .cta-{{ section.id }} .fcta__rating { order: 1; font-size: 14px; gap: 10px; flex-wrap: nowrap; white-space: nowrap; }
  .cta-{{ section.id }} .fcta__quote { order: 2; font-size: 22px; line-height: 1.35; }
  .cta-{{ section.id }} .fcta__reviewer { order: 3; }
  .cta-{{ section.id }} .fcta__reviewer img { width: 40px; height: 40px; }
  .cta-{{ section.id }} .fcta__reviewer-name { font-size: 15px; }
  .cta-{{ section.id }} .fcta__reviewer-since { font-size: 13px; }
  .cta-{{ section.id }} .fcta__media {
    order: 4; aspect-ratio: auto; height: {{ section.settings.image_mobile_height | default: 280 }}px;
    transform: translateX(-16px);
    --callout-x: 63%; --callout-y: 68%; --callout-size: 27px; --arrow-x: 66%; --arrow-y: 40%;
  }
  .cta-{{ section.id }} .fcta__divider { display: none; }
  .cta-{{ section.id }} .fcta__cta-group { order: 5; align-items: stretch; }
  /* Reviewer left-aligns with the review quote; guarantee stays centered under the button. */
  .cta-{{ section.id }} .fcta__reviewer { justify-content: flex-start; }
  .cta-{{ section.id }} .fcta__guarantee { margin-top: 2px; }
  .cta-{{ section.id }} .fcta__rate-item--stars, .cta-{{ section.id }} .fcta__rate-sep--stars { display: none; }
}

/* ============================================================
   OLD card design (D3+K2 page only)
   ============================================================ */
.cta-{{ section.id }} {
  --cta-accent: {{ section.settings.accent_color | default: '#672666' }};
  --cta-lav: {{ section.settings.panel_bg | default: '#FFFFFF' }};
  --cta-gold: {{ section.settings.stars_color | default: '#EAC78B' }};
  font-family: 'Helvetica Neue', Arimo, Helvetica, Arial, sans-serif;
}
.cta-{{ section.id }} .cta__frame { background: {{ section.settings.frame_bg | default: '#E7E0F4' }}; padding: 56px 64px; border-bottom: 1px solid #000; }
.cta-{{ section.id }} .cta__card {
  max-width: 1200px; margin: 0 auto;
  border-radius: 26px; overflow: hidden;
  display: grid; grid-template-columns: 1fr 1.05fr;
  background: var(--cta-lav);
}
.cta-{{ section.id }} .cta__panel {
  background: var(--cta-lav);
  display: flex; flex-direction: column; justify-content: center; gap: 24px; padding: 48px 64px;
}
.cta-{{ section.id }} .cta__rating { display: flex; align-items: center; gap: 12px; flex-wrap: nowrap; }
.cta-{{ section.id }} .cta__stars { display: inline-flex; gap: 2px; flex-shrink: 0; }
.cta-{{ section.id }} .cta__stars svg { width: 19.2px; height: 18px; display: block; }
.cta-{{ section.id }} .cta__rating-text { font-size: {{ section.settings.rating_size | default: 18 }}px; line-height: 1.4; color: {{ section.settings.rating_color | default: '#141414' }}; white-space: nowrap; }
.cta-{{ section.id }} .cta__rating-text p { margin: 0; display: inline; }
.cta-{{ section.id }} .cta__rating-text strong { font-weight: 700; color: var(--cta-accent); }

.cta-{{ section.id }} .cta__title,
.cta-{{ section.id }} .cta__title * {
  font-family: 'HelveticaNeueL', 'Helvetica Neue', Helvetica, Arial, sans-serif;
  font-weight: 700;
  font-size: 36px; line-height: 1.2; letter-spacing: -0.52px;
  text-transform: none;
  color: #171512;
  margin: 0;
}
.cta-{{ section.id }} .cta__title p { margin: 0; }

.cta-{{ section.id }} .cta__checklist { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 11px; }
.cta-{{ section.id }} .cta__point { display: flex; align-items: center; gap: 10px; }
.cta-{{ section.id }} .cta__check { flex-shrink: 0; width: 22px; height: 22px; border-radius: 50%; background: var(--cta-accent); display: grid; place-items: center; }
.cta-{{ section.id }} .cta__check svg { width: 13px; height: 13px; }
.cta-{{ section.id }} .cta__point-label { font-size: {{ section.settings.checklist_size | default: 15 }}px; font-weight: 400; letter-spacing: -0.2px; color: {{ section.settings.checklist_color | default: '#141414' }}; }

.cta-{{ section.id }} .cta__action {
  align-self: flex-start;
  width: 100%; max-width: 400px;
  display: flex; flex-direction: column; align-items: center; gap: 14px;
}
.cta-{{ section.id }} .cta__btn {
  width: 100%;
  display: flex; align-items: center; justify-content: center;
  background: var(--cta-accent); color: #fff;
  font-weight: 500; font-size: {{ section.settings.button_size | default: 18 }}px; letter-spacing: normal; line-height: 1.4;
  padding: 24px 32px; border: none; border-radius: 100px; text-decoration: none; cursor: pointer;
  transition: opacity 0.25s ease;
}
.cta-{{ section.id }} .cta__btn:hover { opacity: 0.9; color: #fff; }
.cta-{{ section.id }} .cta__guarantee { display: flex; align-items: center; justify-content: center; gap: 8px; margin: 0; font-size: 16px; color: #141414; }
.cta-{{ section.id }} .cta__guarantee img { width: 18px; height: 18px; object-fit: contain; display: block; }
.cta-{{ section.id }} .cta__guarantee svg { width: 18px; height: 18px; display: block; flex-shrink: 0; }

.cta-{{ section.id }} .cta__review {
  max-width: 900px; margin: 24px auto 0; box-sizing: border-box;
  background: {{ section.settings.review_bg | default: '#ffffff' }};
  border-radius: 26px; padding: 48px 64px; box-shadow: 0 3px 20px rgba(0, 0, 0, 0.05);
  display: none; flex-direction: column; align-items: center; text-align: center; gap: 18px;
}
.cta-{{ section.id }} .cta__review-stars { display: inline-flex; gap: 3px; }
.cta-{{ section.id }} .cta__review-stars svg { width: 20px; height: 19px; display: block; }
.cta-{{ section.id }} .cta__review-heading {
  font-family: 'HelveticaNeueL', 'Helvetica Neue', Helvetica, Arial, sans-serif;
  font-weight: 700; font-size: {{ section.settings.review_heading_size | default: 24 }}px; line-height: 1.2;
  letter-spacing: -0.4px; color: var(--cta-accent); margin: 0;
}
.cta-{{ section.id }} .cta__review-quote {
  margin: 0; max-width: 760px; font-size: {{ section.settings.review_text_size | default: 20 }}px;
  line-height: 1.5; color: #141414; quotes: none;
}
.cta-{{ section.id }} .cta__review-cite {
  font-style: normal; font-weight: 700; font-size: 16px; color: var(--cta-accent); margin-top: 2px;
}

.cta-{{ section.id }} .cta__photo { position: relative; height: 500px; background-size: cover; background-position: 50% 42%; background-repeat: no-repeat; background-color: var(--cta-lav); }
.cta-{{ section.id }} .cta__seam { position: absolute; inset: 0; pointer-events: none;
  background: linear-gradient(90deg,
    var(--cta-lav) 0%,
    var(--cta-lav) 2%,
    color-mix(in srgb, var(--cta-lav) 80%, transparent) 7%,
    color-mix(in srgb, var(--cta-lav) 52%, transparent) 13%,
    color-mix(in srgb, var(--cta-lav) 28%, transparent) 19%,
    color-mix(in srgb, var(--cta-lav) 12%, transparent) 24%,
    color-mix(in srgb, var(--cta-lav) 0%, transparent) 30%); }

@media (max-width: 767px) {
  .cta-{{ section.id }} .cta__frame { background: {{ section.settings.frame_bg | default: '#E7E0F4' }}; padding: 16px; }
  .cta-{{ section.id }} .cta__card { display: flex; flex-direction: column; border-radius: 20px; }
  .cta-{{ section.id }} .cta__panel { padding: 40px 28px 30px; gap: 18px; }
  .cta-{{ section.id }} .cta__title, .cta-{{ section.id }} .cta__title * { font-size: 26px; letter-spacing: -0.52px; }
  .cta-{{ section.id }} .cta__rating { flex-wrap: nowrap; gap: 8px; }
  .cta-{{ section.id }} .cta__stars { gap: 1.5px; }
  .cta-{{ section.id }} .cta__stars svg { width: 15px; height: 14px; }
  .cta-{{ section.id }} .cta__rating-text { font-size: {{ section.settings.rating_size_mobile | default: 16 }}px; white-space: nowrap; }
  .cta-{{ section.id }} .cta__point-label { font-size: {{ section.settings.checklist_size_mobile | default: 15 }}px; }
  .cta-{{ section.id }} .cta__action { align-self: stretch; max-width: none; gap: 12px; }
  .cta-{{ section.id }} .cta__btn { padding: 18px 32px; font-size: {{ section.settings.button_size_mobile | default: 18 }}px; }
  .cta-{{ section.id }} .cta__guarantee { font-size: 15px; }
  .cta-{{ section.id }} .cta__photo { height: 360px; }
  .cta-{{ section.id }} .cta__review { display: flex; padding: 32px 22px; margin-top: 16px; border-radius: 20px; gap: 14px; }
  .cta-{{ section.id }} .cta__review-stars svg { width: 17px; height: 16px; }
  .cta-{{ section.id }} .cta__review-heading { font-size: {{ section.settings.review_heading_size_mobile | default: 20 }}px; }
  .cta-{{ section.id }} .cta__review-quote { font-size: {{ section.settings.review_text_size_mobile | default: 16 }}px; }
  .cta-{{ section.id }} .cta__seam { inset: 0 0 auto 0; height: 84px;
    background: linear-gradient(180deg, var(--cta-lav) 0%, var(--cta-lav) 6%, color-mix(in srgb, var(--cta-lav) 45%, transparent) 45%, color-mix(in srgb, var(--cta-lav) 0%, transparent) 100%); }
}
{% endstyle %}

{%- capture cta_gold_check -%}<svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M4 12.5l5 5 11-12" stroke="#fab851" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/></svg>{%- endcapture -%}
{%- capture cta_star -%}<svg viewBox="0 0 18 16" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M3.85124 15.9392C3.43952 16.1504 2.97233 15.7803 3.05553 15.3078L3.94083 10.2626L0.183091 6.68298C-0.167831 6.34806 0.0145632 5.73581 0.484948 5.66968L5.70931 4.9273L8.03883 0.31199C8.24895 -0.103997 8.81747 -0.103997 9.0276 0.31199L11.3571 4.9273L16.5815 5.66968C17.0519 5.73581 17.2343 6.34806 16.8823 6.68298L13.1256 10.2626L14.0109 15.3078C14.0941 15.7803 13.6269 16.1504 13.2152 15.9392L8.53161 13.5329L3.85124 15.9392Z" fill="{{ section.settings.stars_color | default: '#EAC78B' }}"/></svg>{%- endcapture -%}

{%- if is_d3 -%}
  {%- comment -%} ===== OLD card design (D3+K2 page) ===== {%- endcomment -%}
  <section class="cta-{{ section.id }}">
    <div class="cta__frame">
      <div class="cta__card">
        <div class="cta__panel">
          {%- if section.settings.show_stars or section.settings.rating_text != blank -%}
            <div class="cta__rating">
              {%- if section.settings.show_stars -%}<span role="img" class="cta__stars" aria-label="5 stars">{{ cta_star }}{{ cta_star }}{{ cta_star }}{{ cta_star }}{{ cta_star }}</span>{%- endif -%}
              {%- if section.settings.rating_text != blank -%}<span class="cta__rating-text">{{ section.settings.rating_text }}</span>{%- endif -%}
            </div>
          {%- endif -%}

          {%- if section.settings.heading != blank -%}<h2 class="cta__title">{{ section.settings.heading }}</h2>{%- endif -%}

          {%- if section.blocks.size > 0 -%}
            <ul class="cta__checklist">
              {%- for block in section.blocks -%}{%- if block.type == 'point' -%}
                <li class="cta__point" {{ block.shopify_attributes }}>
                  <span class="cta__check" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="#ffffff" stroke-width="3.6" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg></span>
                  <span class="cta__point-label">{{ block.settings.text }}</span>
                </li>
              {%- endif -%}{%- endfor -%}
            </ul>
          {%- endif -%}

          {%- if section.settings.button_text != blank or section.settings.show_guarantee -%}
            <div class="cta__action">
              {%- if section.settings.button_text != blank -%}
                <a class="cta__btn" href="{{ section.settings.button_link | default: '#offer' }}" data-cta-scroll="{{ section.settings.scroll_target }}">{{ section.settings.button_text }}</a>
              {%- endif -%}
              {%- if section.settings.show_guarantee and section.settings.guarantee_text != blank -%}
                <div class="cta__guarantee">
                  {%- if section.settings.guarantee_icon != blank -%}
                    <img src="{{ section.settings.guarantee_icon | image_url: width: 48 }}" alt="" width="18" height="18" loading="lazy" decoding="async">
                  {%- else -%}
                    {{ cta_gold_check }}
                  {%- endif -%}
                  <span>{{ section.settings.guarantee_text }}</span>
                </div>
              {%- endif -%}
            </div>
          {%- endif -%}
        </div>

        <div class="cta__photo"{% if section.settings.image != blank %} style="background-image: url('{{ section.settings.image | image_url: width: 1600, format: 'webp' }}');"{% endif %}>
          <span class="cta__seam"></span>
        </div>
      </div>

      {%- if section.settings.review_text != blank -%}
        <div class="cta__review">
          {%- if section.settings.review_stars > 0 -%}
            <span role="img" class="cta__review-stars" aria-label="{{ section.settings.review_stars }} out of 5 stars">
              {%- for i in (1..section.settings.review_stars) -%}{{ cta_star }}{%- endfor -%}
            </span>
          {%- endif -%}
          {%- if section.settings.review_heading != blank -%}<p class="cta__review-heading">{{ section.settings.review_heading }}</p>{%- endif -%}
          <blockquote class="cta__review-quote">{{ section.settings.review_text }}</blockquote>
          {%- if section.settings.review_name != blank or section.settings.review_location != blank -%}
            <cite class="cta__review-cite">{{ section.settings.review_name }}{% if section.settings.review_name != blank and section.settings.review_location != blank %}, {% endif %}{{ section.settings.review_location }}</cite>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </section>

{%- else -%}
  {%- comment -%} ===== NEW Final CTA (BOGO) design ===== {%- endcomment -%}
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Caveat:wght@700&display=swap">
  {%- capture fcta_star -%}<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2.6c.4 0 .8.2 1 .6l2.5 5.1 5.6.8c.9.1 1.2 1.2.6 1.8l-4 3.9 1 5.6c.1.9-.8 1.5-1.6 1.1L12 18.9l-5 2.6c-.8.4-1.7-.2-1.6-1.1l1-5.6-4-3.9c-.6-.6-.3-1.7.6-1.8l5.6-.8 2.5-5.1c.2-.4.6-.6 1-.6Z" fill="#FFB547" stroke="#FFB547" stroke-width="1.2" stroke-linejoin="round"/></svg>{%- endcapture -%}

  <section class="cta-{{ section.id }}">
    <div class="fcta">
      <div class="fcta__inner">
        <div class="fcta__grid">

          {%- comment -%} Image box with BOGO callout + arrow {%- endcomment -%}
          <div class="fcta__media" role="img" aria-label="{{ section.settings.callout_line_1 }} {{ section.settings.callout_line_2 }}">
            {%- if section.settings.image_desktop != blank -%}
              <picture>
                {%- assign m_img = section.settings.image_mobile | default: section.settings.image_desktop -%}
                <source media="(max-width: 749px)" srcset="{{ m_img | image_url: width: 700, format: 'webp' }} 700w, {{ m_img | image_url: width: 1000, format: 'webp' }} 1000w" sizes="100vw">
                <img src="{{ section.settings.image_desktop | image_url: width: 1100, format: 'webp' }}"
                     srcset="{{ section.settings.image_desktop | image_url: width: 700, format: 'webp' }} 700w, {{ section.settings.image_desktop | image_url: width: 1100, format: 'webp' }} 1100w"
                     sizes="(max-width: 749px) 100vw, 480px"
                     alt="Rejuvia Sleep Spray — buy one, get one free" loading="lazy" width="1100" height="1100">
              </picture>
            {%- else -%}
              {%- comment -%} Default composited BOGO bottles shipped as theme assets. {%- endcomment -%}
              <picture>
                <source media="(max-width: 749px)" srcset="{{ 'bogo-bottles-mobile.png' | asset_url }}">
                <img src="{{ 'bogo-bottles-desktop.png' | asset_url }}" alt="Rejuvia Sleep Spray — buy one, get one free" loading="lazy" width="1100" height="1100">
              </picture>
            {%- endif -%}

            {%- if section.settings.show_callout -%}
              <svg class="fcta__arrow" width="80" height="110" viewBox="0 0 80 110" fill="none" aria-hidden="true">
                <path d="M66 104c10-14 4-26-6-28-9-2-12 8-4 10 10 3 14-16 6-34C55 34 36 20 12 12" stroke="{{ accent }}" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
                <path d="M12 12l17-1M12 12l6 15" stroke="{{ accent }}" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
              {%- if section.settings.callout_line_1 != blank or section.settings.callout_line_2 != blank -%}
                <div class="fcta__callout">{{ section.settings.callout_line_1 }}<br>{{ section.settings.callout_line_2 }}</div>
              {%- endif -%}
            {%- endif -%}
          </div>

          {%- comment -%} Rating bar {%- endcomment -%}
          <div class="fcta__rating">
            <span class="fcta__stars">{{ fcta_star }}{{ fcta_star }}{{ fcta_star }}{{ fcta_star }}{{ fcta_star }}</span>
            <span class="fcta__rate-item fcta__rate-item--stars"><b>{{ section.settings.stars_value | default: '4.5' }}</b> Stars</span>
            <span class="fcta__rate-sep fcta__rate-sep--stars" aria-hidden="true"></span>
            <span class="fcta__rate-item"><b>{{ section.settings.reviews_value | default: '7,500+' }}</b> Reviews</span>
            <span class="fcta__rate-sep" aria-hidden="true"></span>
            <span class="fcta__rate-item"><b>{{ section.settings.customers_value | default: '500K+' }}</b> Customers</span>
          </div>

          {%- comment -%} Quote — hardcoded (not a setting) so it always renders live; stored setting values don't deploy/update via GitHub sync. {%- endcomment -%}
          <div class="fcta__quote">&ldquo;It WORKS!!! It&rsquo;s been a miracle for me. I had tried everything for my sleep and Rejuvia is the ONLY product to truly work.&rdquo;</div>

          {%- comment -%} Reviewer — circular photo + name hardcoded (with picker override) so the testimonial is consistent and always renders live. {%- endcomment -%}
          {%- assign rev_name = 'Susann M Thoens' -%}
          {%- assign rev_since = section.settings.reviewer_since | default: 'Verified Customer' -%}
          <div class="fcta__reviewer">
            <img class="fcta__avatar" src="{% if section.settings.reviewer_photo != blank %}{{ section.settings.reviewer_photo | image_url: width: 120 }}{% else %}{{ 'reviewer-avatar.jpg' | asset_url }}{% endif %}" width="44" height="44" alt="{{ rev_name | escape }}" loading="lazy" decoding="async">
            <div class="fcta__reviewer-meta">
              <span class="fcta__reviewer-name">&ndash; {{ rev_name }}</span>
              <span class="fcta__reviewer-since">{{ rev_since }}</span>
            </div>
          </div>

          <div class="fcta__divider" aria-hidden="true"></div>

          {%- comment -%} CTA + guarantee {%- endcomment -%}
          <div class="fcta__cta-group">
            {%- if section.settings.button_text != blank -%}
              <a class="fcta__cta" href="{{ section.settings.button_link | default: '#offer' }}" data-cta-scroll="{{ section.settings.scroll_target }}">{{ section.settings.button_text }}</a>
            {%- endif -%}
            {%- if section.settings.show_guarantee and section.settings.guarantee_text != blank -%}
              <div class="fcta__guarantee">
                <svg width="18" height="14" viewBox="0 0 18 14" aria-hidden="true"><path d="M2 7.5l4.5 4.5L16 2" stroke="#f5b14c" stroke-width="2.4" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg>
                {{ section.settings.guarantee_text }}
              </div>
            {%- endif -%}
          </div>

        </div>
      </div>
    </div>
  </section>
{%- endif -%}

<script>
(function () {
  var sec = document.querySelector('.cta-{{ section.id }}');
  if (!sec) return;
  var btn = sec.querySelector('[data-cta-scroll]');
  if (!btn) return;
  btn.addEventListener('click', function (e) {
    var sel = btn.getAttribute('data-cta-scroll');
    if (!sel) return;
    var target = document.querySelector(sel);
    if (!target) return; /* fall back to the href */
    e.preventDefault();
    var top = target.getBoundingClientRect().top + window.pageYOffset - 24;
    window.scrollTo({ top: top, behavior: 'smooth' });
  });
})();
</script>

