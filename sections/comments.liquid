{%- render 'comments',
  badge: section.settings.badge,
  headline: section.settings.headline,
  highlight: section.settings.highlight,
  sub_desktop: section.settings.sub_desktop,
  sub_mobile: section.settings.sub_mobile
-%}

{% schema %}
{
  "name": "Comments",
  "tag": "section",
  "class": "comments-section",
  "settings": [
    { "type": "text", "id": "badge", "label": "Badge text", "default": "5,000,000+ Sprays Sold" },
    { "type": "text", "id": "headline", "label": "Headline", "default": "Real Reviews From" },
    { "type": "text", "id": "highlight", "label": "Headline highlight (purple, underlined)", "default": "531,719 Customers" },
    { "type": "text", "id": "sub_desktop", "label": "Facebook line (desktop)", "default": "Unedited comments from our Facebook community" },
    { "type": "text", "id": "sub_mobile", "label": "Facebook line (mobile)", "default": "Unedited comments from Facebook" }
  ],
  "presets": [{ "name": "Comments" }]
}
{% endschema %}
