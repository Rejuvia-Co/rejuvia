{%- comment -%}
  Content source (in priority order):
    1. The per-product metaobject custom.testimonials (header, stars_label,
       testimonials[] each -> image/quote/name) — used on product pages.
    2. The section's own blocks — used on pages with no product context
       (BOGO / landing pages, homepage), so the section still renders there.
  The section is hidden only when BOTH are empty.
{%- endcomment -%}
{%- liquid
  assign vt = product.metafields.custom.testimonials
  assign meta_items = vt.value.testimonials.value
  if meta_items == blank
    assign meta_items = vt.value.testimonial.value
  endif
  assign use_meta = false
  if meta_items != blank and meta_items.size > 0
    assign use_meta = true
  endif

  # Fall back to section blocks ONLY on pages with no product context (homepage,
  # BOGO/landers). On a product page we never borrow another product's blocks — if
  # this product has no metaobject the section simply hides.
  assign use_blocks = false
  if use_meta == false and section.blocks.size > 0 and product == blank
    assign use_blocks = true
  endif

  assign show_section = false
  if use_meta or use_blocks
    assign show_section = true
  endif

  assign header = vt.value.header | default: section.settings.header
  assign stars_label = vt.value.stars_label | default: section.settings.stars_label

  if use_meta
    assign slide_count = meta_items.size
  else
    assign slide_count = section.blocks.size
  endif
-%}

{%- if show_section -%}
{{ 'sections-reviews.css' | asset_url | stylesheet_tag }}

{% style %}
/* Accent: the review-bar text, carousel dots, and arrows follow the product's
   base colour (pink for Calm/Stress, etc.), falling back to the brand purple
   on pages with no product context (homepage, landers). */
#shopify-section-{{ section.id }} { --base-colour: {{ product.metafields.custom.base_colour | default: '#672666' }}; }
/* Carousel controls: identical spec to the press carousel (scoped so the
   non-video testimonials section is untouched). */
#shopify-section-{{ section.id }} .glide-arrows-bullet__box {
  display: flex; align-items: center; justify-content: center; gap: 20px;
  margin-top: 30px; position: static;
}
#shopify-section-{{ section.id }} .glide__arrows { display: flex; position: static; gap: 0; }
#shopify-section-{{ section.id }} .glide__arrow {
  flex: none;
  border: none !important; border-radius: 0 !important;
  background: transparent !important;
  color: var(--base-colour, #672666); height: auto !important; width: auto;
  display: inline-flex; align-items: center; justify-content: center;
  cursor: pointer; padding: 4px !important; box-shadow: none !important;
  transition: opacity .15s ease; left: auto !important; right: auto !important;
}
#shopify-section-{{ section.id }} .glide__arrow:hover { opacity: .6; background: transparent !important; border-color: transparent !important; }
/* the shared stylesheet repaints the glyph white on hover
   (.glide__arrows .glide__arrow:hover path { stroke:#fff }) and tints the svg -
   hold the chevron colour through every state, exactly like the press carousel */
#shopify-section-{{ section.id }} .glide__arrow path,
#shopify-section-{{ section.id }} .glide__arrow:hover path,
#shopify-section-{{ section.id }} .glide__arrow:focus path,
#shopify-section-{{ section.id }} .glide__arrow:active path { stroke: var(--base-colour, #672666) !important; }
#shopify-section-{{ section.id }} .glide__arrow:hover svg,
#shopify-section-{{ section.id }} .glide__arrow:focus svg,
#shopify-section-{{ section.id }} .glide__arrow:active svg {
  background: transparent !important; border: none !important; border-radius: 0 !important; padding: 0 !important;
}
/* the shared stylesheet draws the circle on the SVG itself and pads it 13px,
   which crushed the glyph - reset the svg to a plain icon */
#shopify-section-{{ section.id }} .glide__arrow svg {
  width: 22px !important; height: 22px !important; display: block;
  padding: 0 !important; border: none !important; border-radius: 0 !important;
  background: transparent !important;
}
#shopify-section-{{ section.id }} .glide__bullets {
  display: flex; justify-content: center; gap: 14px; margin: 0;
  position: static; transform: none;
}
#shopify-section-{{ section.id }} .glide__bullet {
  width: 15px; height: 15px; border-radius: 50%;
  border: 1.5px solid var(--base-colour, #672666) !important; background: transparent !important;
  padding: 0; margin: 0; cursor: pointer; box-shadow: none;
  transition: background .15s ease !important;
}
#shopify-section-{{ section.id }} .glide__bullet--active { background: var(--base-colour, #672666) !important; }
@media screen and (max-width: 767px) {
  #shopify-section-{{ section.id }} .glide-arrows-bullet__box { margin-top: 24px; gap: 14px; }
  #shopify-section-{{ section.id }} .glide__arrow {
    width: 38px; height: 38px !important; padding: 0 !important;
    border: 1.5px solid var(--base-colour, #672666) !important; border-radius: 50% !important;
  }
  /* the desktop rule clears border-color; on mobile the circle IS the border,
     so hold it through hover/focus/active (press-carousel behaviour) */
  #shopify-section-{{ section.id }} .glide__arrow:hover,
  #shopify-section-{{ section.id }} .glide__arrow:focus,
  #shopify-section-{{ section.id }} .glide__arrow:active {
    opacity: 1;
    background: rgba(0,0,0,0.05) !important;
    border: 1.5px solid var(--base-colour, #672666) !important;
    border-radius: 50% !important;
  }
  #shopify-section-{{ section.id }} .glide__arrow svg { width: 18px !important; height: 18px !important; }
  #shopify-section-{{ section.id }} .glide__bullets { gap: 11px; }
  #shopify-section-{{ section.id }} .glide__bullet { width: 13px; height: 13px; }
}

/* Social-proof pill: block-level flex so the auto margins centre it. */
#shopify-section-{{ section.id }} .testimonial-social-proof--pill {
  /* block-level flex: auto margins do not centre an inline-level box */
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10px;
  width: fit-content;
  align-self: center;
  margin-left: auto;
  margin-right: auto;
  margin-bottom: 20px;
  padding: 10px 15px;
  background: {{ section.settings.pill_bg | default: '#ffffff' }};
  border: 1px solid rgba(0,0,0,0.10);
  border-radius: 10px;
}
#shopify-section-{{ section.id }} .tsp__stars { display: inline-flex; gap: 0; flex-shrink: 0; }
#shopify-section-{{ section.id }} .tsp__stars svg { width: 18px; height: 18px; display: block; margin: 0 -1px; }
#shopify-section-{{ section.id }} .testimonial-social-proof--pill span.customer-testimonials-stars__label {
  /* Optical alignment: the text's ink box includes descenders (By, Sleep), so
     geometric centring leaves the cap-height block ~0.1em above the stars.
     em-based so it scales with the font size. */
  transform: translateY(0.1em);
  text-align: center;
  font-size: {{ section.settings.stars_label_size | default: 18 }}px;
  font-weight: 700;
  line-height: 1.3;
  color: var(--base-colour, {{ section.settings.stars_label_color | default: '#672666' }});
}
@media (max-width: 749px) {
  #shopify-section-{{ section.id }} .testimonial-social-proof--pill { padding: 9px 12px; gap: 8px; margin-left: 0; margin-right: auto; }
  #shopify-section-{{ section.id }} .tsp__stars svg { width: 16px; height: 16px; }
  #shopify-section-{{ section.id }} .testimonial-social-proof--pill span.customer-testimonials-stars__label {
    font-size: {{ section.settings.stars_label_size_mobile | default: 14 }}px;
  }
}
#shopify-section-{{ section.id }} .reviews_section-title {
  font-family: 'HelveticaNeueL', 'Helvetica Neue', Helvetica, Arial, sans-serif;
  font-size: 36px;
  font-weight: 700;
  line-height: 1.2;
  letter-spacing: -0.52px;
  color: #171512;
}
@media (max-width: 749px) {
  #shopify-section-{{ section.id }} .reviews_section-title { font-size: 26px; }
}
{%- comment -%} Section background follows the product's sub-base colour (a softer
   tint of the accent), falling back to the section's own bg_color setting. {%- endcomment -%}
{%- assign section_bg = product.metafields.custom.sub_base_colour | default: product.metafields.custom.sub_base_color | default: section.settings.bg_color -%}
{%- if section_bg != blank -%}
#shopify-section-{{ section.id }} { background: {{ section_bg }}; }
{%- endif -%}
/* Shorten the review media on mobile so the full section fits on screen */
@media (max-width: 749px) {
  #shopify-section-{{ section.id }} .customer-review-image { height: 312px; }
}
{% endstyle %}

<!-- Required Core Stylesheet - Async loaded -->
<link
  rel="stylesheet"
  href="https://cdn.jsdelivr.net/npm/@glidejs/glide/dist/css/glide.core.min.css"
  media="print"
  onload="this.media='all'"
>
<!-- Optional Theme Stylesheet - Async loaded -->
<link
  rel="stylesheet"
  href="https://cdn.jsdelivr.net/npm/@glidejs/glide/dist/css/glide.theme.min.css"
  media="print"
  onload="this.media='all'"
>
<noscript>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@glidejs/glide/dist/css/glide.core.min.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@glidejs/glide/dist/css/glide.theme.min.css">
</noscript>

<div class="customer-testimonials customer-testimonials-video customer-testimonials-container container">
  {%- if stars_label != blank -%}
    <div class="testimonial-social-proof testimonial-social-proof--pill">
      <span class="tsp__stars" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 25 24" fill="none" aria-hidden="true"><path d="M12.5006 18.26L5.44715 22.2082L7.02248 14.2799L1.08789 8.7918L9.11493 7.84006L12.5006 0.5L15.8862 7.84006L23.9132 8.7918L17.9787 14.2799L19.554 22.2082L12.5006 18.26Z" fill="{{ section.settings.stars_color | default: '#fab851' }}"/></svg><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 25 24" fill="none" aria-hidden="true"><path d="M12.5006 18.26L5.44715 22.2082L7.02248 14.2799L1.08789 8.7918L9.11493 7.84006L12.5006 0.5L15.8862 7.84006L23.9132 8.7918L17.9787 14.2799L19.554 22.2082L12.5006 18.26Z" fill="{{ section.settings.stars_color | default: '#fab851' }}"/></svg><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 25 24" fill="none" aria-hidden="true"><path d="M12.5006 18.26L5.44715 22.2082L7.02248 14.2799L1.08789 8.7918L9.11493 7.84006L12.5006 0.5L15.8862 7.84006L23.9132 8.7918L17.9787 14.2799L19.554 22.2082L12.5006 18.26Z" fill="{{ section.settings.stars_color | default: '#fab851' }}"/></svg><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 25 24" fill="none" aria-hidden="true"><path d="M12.5006 18.26L5.44715 22.2082L7.02248 14.2799L1.08789 8.7918L9.11493 7.84006L12.5006 0.5L15.8862 7.84006L23.9132 8.7918L17.9787 14.2799L19.554 22.2082L12.5006 18.26Z" fill="{{ section.settings.stars_color | default: '#fab851' }}"/></svg><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 25 24" fill="none" aria-hidden="true"><path d="M12.5006 18.26L5.44715 22.2082L7.02248 14.2799L1.08789 8.7918L9.11493 7.84006L12.5006 0.5L15.8862 7.84006L23.9132 8.7918L17.9787 14.2799L19.554 22.2082L12.5006 18.26Z" fill="{{ section.settings.stars_color | default: '#fab851' }}"/></svg></span>
      <span class="customer-testimonials-stars__label">{{ stars_label }}</span>
    </div>
  {%- endif -%}
    {%- if header != blank -%}
      <h3 class="reviews_section-title">
        {{ header }}
      </h3>
    {%- endif -%}
    <div id="glide-testimonials-video" class="glide">
      <div class="glide__track" data-glide-el="track">
        <ul class="glide__slides">
          {% if use_meta %}
            {% for item in meta_items %}
              <li class="glide__slide">
                <div class="customer-review-box">
                  <div class="customer-review-image">
                    {% if item.image %}
                      {{ item.image | image_url: width: 350, height: 410, format: 'webp' | image_tag: loading: 'lazy', alt: item.name }}
                    {% endif %}
                  </div>
                  <div class="review_content">
                    <p class="review-title">{{ item.quote }}</p>
                    <p class="review-name">{{ item.name }}</p>
                  </div>
                </div>
              </li>
            {% endfor %}
          {% else %}
            {% for block in section.blocks %}
              <li class="glide__slide" {{ block.shopify_attributes }}>
                <div class="customer-review-box">
                  <div class="customer-review-image">
                    {% if block.settings.image %}
                      {{ block.settings.image | image_url: width: 350, height: 410, format: 'webp' | image_tag: loading: 'lazy', alt: block.settings.name }}
                    {% endif %}
                  </div>
                  <div class="review_content">
                    <p class="review-title">{{ block.settings.text }}</p>
                    <p class="review-name">{{ block.settings.name }}</p>
                  </div>
                </div>
              </li>
            {% endfor %}
          {% endif %}
        </ul>
      </div>
      <div class="glide-arrows-bullet__box">
        <div class="glide__arrows" data-glide-el="controls">
          <button class="glide__arrow glide__arrow--left" data-glide-dir="<" aria-label="Previous video testimonial">
            <svg viewBox="0 0 24 24" fill="none" stroke="#672666" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 18l-6-6 6-6"/></svg>
          </button>
        </div>
        <div class="glide__bullets" data-glide-el="controls[nav]">
          {% for i in (1..slide_count) %}
            <button class="glide__bullet" type="button" aria-label="Go to slide {{ forloop.index }}" data-glide-dir="={{ forloop.index0 }}"></button>
          {% endfor %}
        </div>
        <div class="glide__arrows" data-glide-el="controls">
          <button class="glide__arrow glide__arrow--right" data-glide-dir=">" aria-label="Next video testimonial">
            <svg viewBox="0 0 24 24" fill="none" stroke="#672666" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 18l6-6-6-6"/></svg>
          </button>
        </div>
  </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/@glidejs/glide/dist/glide.min.js" defer></script>

<script src="{{ 'customer-testimonials-video.js' | asset_url }}" defer="defer"></script>

<script>
 document.addEventListener('DOMContentLoaded', () => {
  const playButtons = document.querySelectorAll('.customer-review-play');

  playButtons.forEach((button) => {
    const video = button.previousElementSibling;

    if (video && video.tagName === 'VIDEO') {
      button.addEventListener('click', () => {
        if (video.paused) {
          video.play();
          button.style.visibility = 'hidden';
        } else {
          video.pause();
          button.style.visibility = 'visible';
        }
      });

      video.addEventListener('click', () => {
        if (!video.paused) {
          video.pause();
          button.style.visibility = 'visible';
        } else {
          video.play();
          button.style.visibility = 'hidden';
        }
      });

      video.addEventListener('pause', () => {
        button.style.visibility = 'visible';
      });

      video.addEventListener('play', () => {
        button.style.visibility = 'hidden';
      });
    }
  });
});
</script>
{%- endif -%}


{% schema %}
{
  "name": "Video Testimonials",
  "tag": "section",
  "class": "customer-testimonials-section",
  "settings": [
    {
      "type": "text",
      "id": "header",
      "label": "Header"
    },
    {
      "type": "text",
      "id": "stars_label",
      "label": "Stars Label",
      "default": "Backed By 90 Million Nights of Sleep"
    },
    {
      "type": "range",
      "id": "stars_label_size",
      "min": 12,
      "max": 26,
      "step": 1,
      "unit": "px",
      "label": "Social proof text size (desktop)",
      "default": 18
    },
    {
      "type": "range",
      "id": "stars_label_size_mobile",
      "min": 11,
      "max": 22,
      "step": 1,
      "unit": "px",
      "label": "Social proof text size (mobile)",
      "default": 14
    },
    {
      "type": "color",
      "id": "stars_label_color",
      "label": "Social proof text colour",
      "default": "#672666"
    },
    {
      "type": "color",
      "id": "stars_color",
      "label": "Star colour",
      "default": "#fab851"
    },
    {
      "type": "color",
      "id": "pill_bg",
      "label": "Pill background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section background",
      "info": "Leave empty for the default (no background)."
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Review"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "video",
          "id": "video",
          "label": "Video"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Name"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Video Testimonials"
    }
  ]
}
{% endschema %}