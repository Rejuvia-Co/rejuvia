{%- liquid
  comment
    Items come from the per-product single-line metafield custom.guarantees, a
    comma-separated list (e.g. "6,500+ 5-Star Reviews, Free US Shipping over $59").
    Falls back to the section's default_items setting when the metafield is empty.
    Background follows the product's sub-base colour; icon tick follows base_colour.
  endcomment
  comment Read .value explicitly so basic metafields resolve to their string, not the drop. endcomment
  assign gv2_base = product.metafields.custom.base_colour.value | default: product.metafields.custom.base_colour

  assign gv2_bg = product.metafields.custom.sub_base_color.value | default: product.metafields.custom.sub_base_colour.value
  assign gv2_bg = gv2_bg | default: product.metafields.custom.sub_base_color | default: product.metafields.custom.sub_base_colour | default: section.settings.bg_color

  assign items_raw = product.metafields.custom.guarantees.value | default: product.metafields.custom.guarantees | default: section.settings.default_items
  assign gv2_items = items_raw | split: ','
-%}
{% style %}
.guarantees-v2-section {
    width: 100%;
    background-color: {{ gv2_bg }};
    margin: 32px 0;
}

.guarantees-v2-container {
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 100px;
    padding: 16px 32px;
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
}

.guarantees-v2-item {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-shrink: 0;
}

.guarantees-v2-icon {
    width: 22px;
    height: 22px;
    flex-shrink: 0;
}

/* Tick follows the product's base_colour where one is set; the icon_color
   setting is the fallback, so non-product pages are unchanged. */
.guarantees-v2-icon circle {
    fill: var(--base-colour, {{ section.settings.icon_color }});
}

.guarantees-v2-text {
    font-size: 16px;
    font-weight: 400;
    line-height: 1.4;
    color: #141414;
    white-space: nowrap;
}

@media (max-width: 900px) {
    .guarantees-v2-container {
        justify-content: flex-start;
        gap: 40px;
        padding: 16px 16px;
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
        scrollbar-width: none;
    }
    .guarantees-v2-container::-webkit-scrollbar {
        display: none;
    }
    .guarantees-v2-icon {
        width: 20px;
        height: 20px;
    }
    .guarantees-v2-text {
        font-size: 14px;
    }
}
{% endstyle %}

<div class="guarantees-v2-container"{% if section.settings.anchor_id != blank %} id="{{ section.settings.anchor_id }}"{% endif %}{% if gv2_base != blank %} style="--base-colour: {{ gv2_base }};"{% endif %}>
    {% for item in gv2_items %}
        {%- assign item_text = item | strip -%}
        {%- if item_text != blank -%}
        <div class="guarantees-v2-item">
            <svg class="guarantees-v2-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 22 22" fill="none">
                <circle cx="11" cy="11" r="11" fill="{{ section.settings.icon_color }}"/>
                <path d="M6.5 11.5L9.5 14.5L15.5 8.5" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            <span class="guarantees-v2-text">{{ item_text }}</span>
        </div>
        {%- endif -%}
    {% endfor %}
</div>

{% schema %}
{
    "name": "Guarantees V2",
    "class": "guarantees-v2-section",
    "settings": [
        {
            "type": "paragraph",
            "content": "Items come from the product's custom.guarantees metafield (a single line, items separated by commas). The list below is the fallback used when that metafield is empty."
        },
        {
            "type": "textarea",
            "id": "default_items",
            "label": "Default items (fallback)",
            "info": "Comma-separated, e.g. 6,500+ 5-Star Reviews, Free US Shipping over $59, 425,000+ Happy Customers",
            "default": "6,500+ 5-Star Reviews, Free US Shipping over $59, 425,000+ Happy Customers"
        },
        {
            "type": "text",
            "id": "anchor_id",
            "label": "Anchor ID",
            "info": "Optional. Used with hero nav links."
        },
        {
            "type": "color",
            "id": "bg_color",
            "label": "Background color (fallback)",
            "info": "Used when the product's custom.sub_base_colour is empty.",
            "default": "#F8EFE4"
        },
        {
            "type": "color",
            "id": "icon_color",
            "label": "Icon color (fallback)",
            "info": "Tick follows the product's base_colour; this is the fallback.",
            "default": "#672666"
        }
    ],
    "blocks": [
        {
            "type": "guarantee",
            "name": "Guarantee (legacy — no longer rendered)",
            "settings": [
                {
                    "type": "text",
                    "id": "text",
                    "label": "Text",
                    "default": "6,500+ 5-Star Reviews"
                }
            ]
        }
    ],
    "presets": [
        {
            "name": "Guarantees V2",
            "category": "Custom"
        }
    ]
}
{% endschema %}
