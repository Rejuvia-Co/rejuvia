{%- liquid
  assign purple = '#672666'
  assign purple_dark = '#4E1C4E'
  assign ink = '#141414'
  assign body_gray = '#3D3A36'
  assign muted = '#5B5866'
  assign strike = '#8A8594'
  assign hairline = '#E7E4F0'
  assign hairline_in = '#EAE7F1'
  assign tile_bg = '#F7F6FB'
  assign star_gold = '#EAC78B'

  assign product_blocks = section.blocks | where: 'type', 'product'
  assign account_url = '/a/account/login'
  if customer
    assign account_url = '/account'
  endif
-%}

<style>
  html, body { overflow: visible !important; overflow-x: hidden; }
  #page > header { z-index: 110; }
  .main-header { background: #fff; }

  /* ===== Header Nav V3 — full-bleed white, attached to top ===== */
  #header.header {
    --rjnav-h: 84px;
    background: #fff;
    border: none;
    border-bottom: 1px solid {{ hairline }};
    width: 100%;
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    position: sticky;
    top: 0;
    z-index: 110;
    transition: transform 0.3s ease;
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
    color: {{ ink }};
  }
  #header.header.is-hidden { transform: translateY(-100%); }

  #header .rjnav-bar {
    height: var(--rjnav-h);
    display: flex;
    align-items: center;
    padding: 0 48px;
    gap: 64px;
    position: relative;
    z-index: 3;
    background: #fff;
  }

  /* Logo */
  #header .rjnav-logo { flex-shrink: 0; line-height: 0; display: block; }
  #header .rjnav-logo .logo-rejuvia-svg { width: {{ section.settings.logo_width | default: 150 }}px; height: auto; display: block; }
  #header .rjnav-logo .logo-rejuvia-svg path { fill: {{ ink }}; }

  /* Nav links */
  #header .rjnav-links {
    display: flex;
    align-items: stretch;
    gap: 36px;
    height: var(--rjnav-h);
    font-size: 16px;
  }
  #header .rjnav-link {
    display: flex;
    align-items: center;
    gap: 6px;
    white-space: nowrap;
    color: {{ ink }};
    text-decoration: none;
    background: none;
    border: none;
    padding: 0;
    font: inherit;
    cursor: pointer;
    box-shadow: inset 0 0 0 transparent;
    transition: color .2s, box-shadow .2s;
  }
  #header .rjnav-link:hover,
  #header .rjnav-link:focus-visible,
  #header .rjnav-link.is-active {
    color: {{ purple }};
    box-shadow: inset 0 -2px 0 {{ purple }};
    text-decoration: none;
    outline: none;
  }
  #header .rjnav-link--products { font-weight: 600; }
  #header .rjnav-chevron { display: inline-flex; transition: transform .25s; }
  #header .rjnav-link--products[aria-expanded="true"] .rjnav-chevron { transform: rotate(180deg); }

  /* Right cluster */
  #header .rjnav-right { margin-left: auto; display: flex; align-items: center; gap: 24px; font-size: 16px; }
  #header .rjnav-account { display: flex; align-items: center; gap: 8px; white-space: nowrap; color: {{ ink }}; text-decoration: none; transition: color .2s; }
  #header .rjnav-account:hover { color: {{ purple }}; }
  #header .rjnav-account svg { width: 22px; height: 22px; }
  #header .rjnav-cta {
    white-space: nowrap; flex-shrink: 0; background: {{ purple }}; color: #fff; font-weight: 600; font-size: 15px;
    padding: 11px 20px; border-radius: 100px; text-decoration: none; transition: background .2s, transform .2s;
  }
  #header .rjnav-cta:hover { background: {{ purple_dark }}; color: #fff; transform: translateY(-1px); }
  #header .rjnav-carticon { position: relative; display: flex; color: {{ ink }}; transition: color .2s; }
  #header .rjnav-carticon:hover { color: {{ purple }}; }
  #header .rjnav-carticon svg { width: 26px; height: 26px; }
  #header .rjnav-cart-count {
    position: absolute; top: -7px; right: -9px; background: {{ purple }}; color: #fff; font-size: 11px; font-weight: 700;
    width: 18px; height: 18px; border-radius: 50%; display: flex; align-items: center; justify-content: center;
  }

  /* Overlay */
  #header .rjnav-overlay {
    position: fixed; left: 0; right: 0; top: var(--rjnav-h); height: calc(100vh - var(--rjnav-h));
    background: #2A1830; opacity: 0; pointer-events: none; transition: opacity .3s; z-index: 1;
  }
  #header.rjnav-open .rjnav-overlay { opacity: .32; pointer-events: auto; }

  /* Mega menu */
  #header .rjnav-mega {
    position: absolute; top: 100%; left: 0; right: 0; z-index: 2;
    background: #fff; border-bottom: 1px solid {{ hairline }}; box-shadow: 0 18px 40px rgba(45,21,48,.14);
    opacity: 0; transform: translateY(-8px); pointer-events: none;
    transition: opacity .28s cubic-bezier(.22,1,.36,1), transform .28s cubic-bezier(.22,1,.36,1);
  }
  #header.rjnav-open .rjnav-mega { opacity: 1; transform: translateY(0); pointer-events: auto; }
  #header .rjnav-mega-inner { max-width: 1240px; margin: 0 auto; padding: 32px 24px; display: grid; grid-template-columns: 480px minmax(0,1fr); gap: 40px; }

  /* Left: product list */
  #header .rjnav-plist { display: flex; flex-direction: column; gap: 6px; }
  #header .rjnav-prow {
    color: inherit; text-decoration: none; display: grid; grid-template-columns: 88px minmax(0,1fr) auto; gap: 16px;
    align-items: center; padding: 12px 16px 12px 12px; border-radius: 14px; background: transparent; transition: background .2s;
  }
  #header .rjnav-prow.is-active { background: var(--rjnav-tint, #F4EEF5); }
  #header .rjnav-pthumb { width: 88px; height: 88px; background: #fff; border: 1px solid {{ hairline }}; border-radius: 12px; display: flex; align-items: center; justify-content: center; box-sizing: border-box; overflow: hidden; }
  #header .rjnav-pthumb img { width: 78px; height: 78px; object-fit: contain; display: block; }
  #header .rjnav-ptext { display: flex; flex-direction: column; gap: 4px; min-width: 0; }
  #header .rjnav-badge { align-self: flex-start; white-space: nowrap; background: {{ purple }}; color: #fff; font-size: 10px; font-weight: 700; letter-spacing: .06em; padding: 3px 8px; border-radius: 100px; }
  #header .rjnav-pname { font-size: 18px; font-weight: 700; white-space: nowrap; }
  #header .rjnav-pshort { font-size: 14px; color: {{ muted }}; }
  #header .rjnav-pprice { font-size: 16px; font-weight: 700; white-space: nowrap; color: {{ ink }}; align-self: center; }

  /* Trust list */
  #header .rjnav-trust { margin-top: 14px; padding-top: 18px; border-top: 1px solid {{ hairline_in }}; display: flex; flex-direction: column; gap: 12px; font-size: 14px; color: {{ body_gray }}; }
  #header .rjnav-trust span { display: flex; align-items: center; gap: 10px; }
  #header .rjnav-trust svg { width: 18px; height: 18px; flex-shrink: 0; }

  /* Right: preview panels */
  #header .rjnav-preview { position: relative; }
  #header .rjnav-panel {
    display: none; background: var(--rjnav-tint, #F4EEF5); border-radius: 18px; min-height: 420px; padding: 20px;
    grid-template-columns: minmax(0,1fr) minmax(0,1fr); align-items: center; gap: 8px; transition: background .3s;
  }
  #header .rjnav-panel.is-active { display: grid; }
  #header .rjnav-panel-img { background: #fff; border-radius: 14px; aspect-ratio: 1; display: flex; align-items: center; justify-content: center; overflow: hidden; }
  #header .rjnav-panel-img img { width: 86%; height: 86%; object-fit: contain; display: block; }
  #header .rjnav-panel-info { display: flex; flex-direction: column; gap: 14px; padding: 12px 28px 12px 24px; }
  #header .rjnav-panel-rating { display: flex; align-items: center; gap: 8px; font-size: 14px; }
  #header .rjnav-panel-rating .rjnav-stars { display: flex; gap: 0; }
  #header .rjnav-panel-rating .rjnav-stars svg { width: 16px; height: 16px; display: block; }
  #header .rjnav-panel-rating .rjnav-rcount { color: {{ muted }}; white-space: nowrap; }
  #header .rjnav-panel-name { font-size: 34px; font-weight: 700; letter-spacing: -.01em; line-height: 1.05; }
  #header .rjnav-panel-desc { font-size: 16px; line-height: 1.5; color: {{ body_gray }}; text-wrap: pretty; }
  #header .rjnav-panel-price { display: flex; align-items: baseline; gap: 10px; }
  #header .rjnav-panel-now { font-size: 24px; font-weight: 700; color: {{ ink }}; }
  #header .rjnav-panel-was { font-size: 16px; color: {{ strike }}; text-decoration: line-through; }
  #header .rjnav-shopnow {
    align-self: stretch; max-width: 340px; box-sizing: border-box; text-align: center; margin-top: 6px; white-space: nowrap;
    background: var(--rjnav-base, {{ purple }}); color: #fff; font-size: 18px; font-weight: 600; letter-spacing: .06em;
    padding: 19px 32px; border-radius: 100px; text-decoration: none; transition: background .3s, transform .2s;
  }
  #header .rjnav-shopnow:hover { color: #fff; transform: translateY(-1px); }

  /* Mobile bar + menu (hidden on desktop) */
  #header .rjnav-mbar { display: none; }
  #header .rjnav-mmenu { display: none; }

  /* ===================== Mobile (<= 989px) ===================== */
  @media (max-width: 989px) {
    #header.header { --rjnav-h: 64px; }
    #header .rjnav-bar, #header .rjnav-mega, #header .rjnav-overlay { display: none !important; }

    #header .rjnav-mbar {
      display: flex; height: var(--rjnav-h); align-items: center; justify-content: space-between; padding: 0 18px; background: #fff;
    }
    #header .rjnav-mbar .rjnav-logo .logo-rejuvia-svg { width: {{ section.settings.logo_width_mobile | default: 132 }}px; }
    #header .rjnav-mright { display: flex; align-items: center; gap: 20px; }
    #header .rjnav-mright .rjnav-carticon svg { width: 30px; height: 30px; }
    #header .rjnav-mright .rjnav-cart-count { top: -6px; right: -8px; }
    #header .rjnav-mtoggle {
      width: 44px; height: 44px; margin-right: -8px; display: flex; align-items: center; justify-content: center;
      background: none; border: none; color: {{ ink }}; cursor: pointer; padding: 0;
    }
    #header .rjnav-mtoggle svg { width: 32px; height: 32px; }
    #header .rjnav-mtoggle .rjnav-icon-close { display: none; }
    #header.rjnav-mopen .rjnav-mtoggle .rjnav-icon-open { display: none; }
    #header.rjnav-mopen .rjnav-mtoggle .rjnav-icon-close { display: block; }

    #header .rjnav-mmenu {
      display: flex; flex-direction: column; position: fixed; left: 0; right: 0; top: var(--rjnav-h); height: calc(100vh - var(--rjnav-h));
      background: #fff; z-index: 105; overflow-y: auto;
      opacity: 0; visibility: hidden; transition: opacity .2s ease, visibility .2s ease;
    }
    #header.rjnav-mopen .rjnav-mmenu { opacity: 1; visibility: visible; }

    #header .rjnav-mcards { padding: 16px 18px 12px; display: flex; flex-direction: column; gap: 8px; border-bottom: 1px solid {{ hairline_in }}; }
    #header .rjnav-mcard {
      color: inherit; text-decoration: none; position: relative; display: grid; grid-template-columns: 76px minmax(0,1fr); gap: 14px;
      align-items: center; border: 1px solid {{ hairline }}; border-radius: 12px; padding: 10px 14px 10px 10px;
    }
    #header .rjnav-mcard:active { background: var(--rjnav-tint, #F4EEF5); }
    #header .rjnav-mcard--featured { border: 1.5px solid {{ purple }}; padding: 9.5px 14px 9.5px 9.5px; }
    #header .rjnav-mcard--featured:active { background: #F4EEF5; }
    #header .rjnav-mcard-tag {
      position: absolute; top: -1.5px; right: -1.5px; white-space: nowrap; background: {{ purple }}; color: #fff; font-size: 10px;
      font-weight: 700; letter-spacing: .06em; padding: 4px 9px; border-radius: 0 12px 0 10px;
    }
    #header .rjnav-mcard-imgwrap { width: 76px; height: 76px; display: flex; align-items: center; justify-content: center; }
    #header .rjnav-mcard-imgwrap img { width: 74px; height: 74px; object-fit: contain; display: block; }
    #header .rjnav-mcard--featured .rjnav-mcard-imgwrap img { width: 84px; height: 84px; }
    #header .rjnav-mcard-text { display: flex; flex-direction: column; gap: 3px; min-width: 0; }
    #header .rjnav-mcard-rating { display: flex; align-items: center; gap: 6px; font-size: 13px; white-space: nowrap; }
    #header .rjnav-mcard-rating .rjnav-stars { display: flex; gap: 1px; }
    #header .rjnav-mcard-rating .rjnav-stars svg { width: 12px; height: 12px; display: block; }
    #header .rjnav-mcard-rating .rjnav-rcount { color: {{ muted }}; }
    #header .rjnav-mcard-name { font-size: 19px; font-weight: 700; white-space: nowrap; }
    #header .rjnav-mcard-short { font-size: 13px; color: {{ muted }}; }

    #header .rjnav-mlinks { padding: 0 18px; display: flex; flex-direction: column; }
    #header .rjnav-mlink {
      color: {{ ink }}; text-decoration: none; display: flex; justify-content: space-between; align-items: center;
      height: 56px; border-bottom: 1px solid {{ hairline_in }}; font-size: 18px;
    }
    #header .rjnav-mlink svg { width: 18px; height: 18px; }

    #header .rjnav-mcta { margin: 16px 18px 0; background: {{ purple }}; color: #fff; text-align: center; font-size: 16px; font-weight: 600; padding: 16px; border-radius: 100px; text-decoration: none; }
    #header .rjnav-mcta:active { background: {{ purple_dark }}; color: #fff; }

    #header .rjnav-mtrust { margin-top: auto; padding: 16px 18px 22px; display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: 8px; text-align: center; font-size: 12px; line-height: 1.3; color: {{ body_gray }}; }
    #header .rjnav-mtile { display: flex; flex-direction: column; align-items: center; gap: 6px; background: {{ tile_bg }}; border-radius: 12px; padding: 12px 6px; }
    #header .rjnav-mtile svg { width: 22px; height: 22px; }

    body.rjnav-lock { overflow: hidden; }
  }
</style>

{%- comment -%} Reusable gold star + trust icons {%- endcomment -%}
{%- capture star_svg -%}<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2.5l2.9 6.1 6.6.8-4.9 4.6 1.3 6.6L12 17.3l-5.9 3.3 1.3-6.6L2.5 9.4l6.6-.8z" fill="{{ star_gold }}"/></svg>{%- endcapture -%}
{%- capture icon_star_outline -%}<svg viewBox="0 0 24 24" fill="none" stroke="{{ purple }}" stroke-width="1.6" stroke-linejoin="round" aria-hidden="true"><path d="M12 2.5l2.9 6.1 6.6.8-4.9 4.6 1.3 6.6L12 17.3l-5.9 3.3 1.3-6.6L2.5 9.4l6.6-.8z"/></svg>{%- endcapture -%}
{%- capture icon_box -%}<svg viewBox="0 0 24 24" fill="none" stroke="{{ purple }}" stroke-width="1.6" stroke-linejoin="round" aria-hidden="true"><path d="M12 3l8 4.5v9L12 21l-8-4.5v-9z"/><path d="M4 7.5l8 4.5 8-4.5M12 12v9"/></svg>{%- endcapture -%}
{%- capture icon_heart -%}<svg viewBox="0 0 24 24" fill="none" stroke="{{ purple }}" stroke-width="1.6" stroke-linejoin="round" aria-hidden="true"><path d="M12 20s-7.5-4.6-7.5-10.1A4.2 4.2 0 0 1 12 7.6a4.2 4.2 0 0 1 7.5 2.3C19.5 15.4 12 20 12 20z"/></svg>{%- endcapture -%}
{%- assign trust_icons = icon_star_outline | append: '|||' | append: icon_box | append: '|||' | append: icon_heart | split: '|||' -%}
{%- capture icon_cart -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 4h2.2l2.1 10.2a1.5 1.5 0 0 0 1.5 1.2h8.4a1.5 1.5 0 0 0 1.5-1.1L20.5 8H6.2"/><circle cx="9.5" cy="19.5" r="1.2"/><circle cx="17" cy="19.5" r="1.2"/></svg>{%- endcapture -%}
{%- capture icon_user -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><circle cx="12" cy="12" r="9.5"/><circle cx="12" cy="10" r="3.2"/><path d="M6.2 18.6c1.3-2.2 3.4-3.4 5.8-3.4s4.5 1.2 5.8 3.4"/></svg>{%- endcapture -%}

<div id="header" class="header nav-v3 fixed-pending {{ section.settings.behavior }}-desktop {{ section.settings.behavior_mobile }}-mobile" data-rjnav>

  {%- comment -%} ===== Desktop bar ===== {%- endcomment -%}
  <div class="rjnav-bar">
    <a href="/" class="rjnav-logo" aria-label="Rejuvia home">{% render 'logo-rejuvia' %}</a>

    <nav class="rjnav-links" role="navigation" aria-label="Main">
      <button type="button" class="rjnav-link rjnav-link--products" data-rjnav-trigger aria-haspopup="true" aria-expanded="false" aria-controls="rjnav-mega">
        {{ section.settings.products_label | default: 'Products' }}
        <span class="rjnav-chevron"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg></span>
      </button>
      {%- if section.settings.link_1_label != blank -%}<a class="rjnav-link" href="{{ section.settings.link_1_url }}" data-rjnav-close>{{ section.settings.link_1_label }}</a>{%- endif -%}
      {%- if section.settings.link_2_label != blank -%}<a class="rjnav-link" href="{{ section.settings.link_2_url }}" data-rjnav-close>{{ section.settings.link_2_label }}</a>{%- endif -%}
      {%- if section.settings.link_3_label != blank -%}<a class="rjnav-link" href="{{ section.settings.link_3_url }}" data-rjnav-close>{{ section.settings.link_3_label }}</a>{%- endif -%}
    </nav>

    <div class="rjnav-right" data-rjnav-close>
      <a class="rjnav-account" href="{{ account_url }}" aria-label="Sign in">{{ icon_user }}{{ section.settings.account_label | default: 'Sign In' }}</a>
      <a class="rjnav-cta" href="{{ section.settings.cta_url | default: '/products/sleep-spray' }}">{{ section.settings.cta_label | default: 'Shop Sleep Spray' }}</a>
      <a class="rjnav-carticon" href="/cart" aria-label="Cart">{{ icon_cart }}{% if cart.item_count > 0 %}<span class="rjnav-cart-count">{{ cart.item_count }}</span>{% endif %}</a>
    </div>
  </div>

  {%- comment -%} ===== Overlay + Mega menu ===== {%- endcomment -%}
  <div class="rjnav-overlay" data-rjnav-close aria-hidden="true"></div>

  <div class="rjnav-mega" id="rjnav-mega" role="region" aria-label="Products">
    <div class="rjnav-mega-inner">
      {%- comment -%} Left: product rows {%- endcomment -%}
      <div class="rjnav-plist">
        {%- for block in product_blocks -%}
          {%- assign product = block.settings.product -%}
          {%- if product == blank -%}{%- continue -%}{%- endif -%}
          {%- liquid
            assign base = product.metafields.custom.base_colour | default: purple
            assign tint = product.metafields.custom.sub_base_color.value | default: product.metafields.custom.sub_base_colour.value | default: product.metafields.custom.sub_base_color | default: product.metafields.custom.sub_base_colour | default: '#F4EEF5'
            assign sub_price = nil
            for v in product.variants
              for alloc in v.selling_plan_allocations
                if sub_price == nil or alloc.price < sub_price
                  assign sub_price = alloc.price
                endif
              endfor
            endfor
            if sub_price == nil
              assign now_price = product.price
            else
              assign now_price = sub_price
            endif
          -%}
          <a href="{{ product.url }}" class="rjnav-prow{% if forloop.first %} is-active{% endif %}" data-rjnav-row data-index="{{ forloop.index0 }}" style="--rjnav-tint: {{ tint }};">
            <span class="rjnav-pthumb"><img src="{{ product.featured_image | image_url: width: 180, format: 'webp' }}" alt="{{ product.title | escape }}" width="78" height="78" loading="lazy" decoding="async"></span>
            <span class="rjnav-ptext">
              {%- if block.settings.badge_text != blank -%}<span class="rjnav-badge">{{ block.settings.badge_text }}</span>{%- endif -%}
              <span class="rjnav-pname">{{ product.title }}</span>
              <span class="rjnav-pshort">{{ block.settings.short_line }}</span>
            </span>
            <span class="rjnav-pprice">{{ now_price | money }}</span>
          </a>
        {%- endfor -%}

        <div class="rjnav-trust">
          {%- for i in (0..2) -%}
            {%- assign t_field = 'trust_' | append: forloop.index -%}
            {%- assign t_text = section.settings[t_field] -%}
            {%- if t_text != blank -%}<span>{{ trust_icons[i] }}{{ t_text }}</span>{%- endif -%}
          {%- endfor -%}
        </div>
      </div>

      {%- comment -%} Right: preview panels (one per product, first active) {%- endcomment -%}
      <div class="rjnav-preview">
        {%- for block in product_blocks -%}
          {%- assign product = block.settings.product -%}
          {%- if product == blank -%}{%- continue -%}{%- endif -%}
          {%- liquid
            assign base = product.metafields.custom.base_colour | default: purple
            assign tint = product.metafields.custom.sub_base_color.value | default: product.metafields.custom.sub_base_colour.value | default: product.metafields.custom.sub_base_color | default: product.metafields.custom.sub_base_colour | default: '#F4EEF5'
            assign rating = product.metafields.okendo.summaryData.reviewAverageValue | default: 0.0 | plus: 0.0
            assign review_count = product.metafields.okendo.summaryData.reviewCount | default: 0 | plus: 0
            assign sub_price = nil
            for v in product.variants
              for alloc in v.selling_plan_allocations
                if sub_price == nil or alloc.price < sub_price
                  assign sub_price = alloc.price
                endif
              endfor
            endfor
            if sub_price == nil
              assign now_price = product.price
              assign was_price = product.compare_at_price
            else
              assign now_price = sub_price
              assign was_price = product.price
            endif
          -%}
          <div class="rjnav-panel{% if forloop.first %} is-active{% endif %}" data-rjnav-panel data-index="{{ forloop.index0 }}" style="--rjnav-tint: {{ tint }}; --rjnav-base: {{ base }};">
            <div class="rjnav-panel-img"><img src="{{ product.featured_image | image_url: width: 600, format: 'webp' }}" alt="{{ product.title | escape }}" loading="lazy" decoding="async"></div>
            <div class="rjnav-panel-info">
              {%- if review_count > 0 -%}
                <div class="rjnav-panel-rating">
                  <span class="rjnav-stars">{{ star_svg }}{{ star_svg }}{{ star_svg }}{{ star_svg }}{{ star_svg }}</span>
                  <b>{{ rating | round: 1 }}</b>
                  <span class="rjnav-rcount">({% render 'rj-thousands', n: review_count %} reviews)</span>
                </div>
              {%- endif -%}
              <div class="rjnav-panel-name">{{ product.title }}</div>
              <div class="rjnav-panel-desc">{{ block.settings.description }}</div>
              <div class="rjnav-panel-price">
                <span class="rjnav-panel-now">{{ now_price | money }}</span>
                {%- if was_price != blank and was_price > now_price -%}<span class="rjnav-panel-was">{{ was_price | money }}</span>{%- endif -%}
              </div>
              <a href="{{ product.url }}" class="rjnav-shopnow">{{ section.settings.shopnow_label | default: 'SHOP NOW' }}</a>
            </div>
          </div>
        {%- endfor -%}
      </div>
    </div>
  </div>

  {%- comment -%} ===== Mobile bar ===== {%- endcomment -%}
  <div class="rjnav-mbar">
    <a href="/" class="rjnav-logo" aria-label="Rejuvia home">{% render 'logo-rejuvia' %}</a>
    <div class="rjnav-mright">
      <a class="rjnav-carticon" href="/cart" aria-label="Cart">{{ icon_cart }}{% if cart.item_count > 0 %}<span class="rjnav-cart-count">{{ cart.item_count }}</span>{% endif %}</a>
      <button type="button" class="rjnav-mtoggle" data-rjnav-mtoggle aria-label="Open menu" aria-expanded="false" aria-controls="rjnav-mmenu">
        <span class="rjnav-icon-open"><svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg></span>
        <span class="rjnav-icon-close"><svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg></span>
      </button>
    </div>
  </div>

  {%- comment -%} ===== Mobile menu ===== {%- endcomment -%}
  <div class="rjnav-mmenu" id="rjnav-mmenu">
    <div class="rjnav-mcards">
      {%- for block in product_blocks -%}
        {%- assign product = block.settings.product -%}
        {%- if product == blank -%}{%- continue -%}{%- endif -%}
        {%- liquid
          assign tint = product.metafields.custom.sub_base_color.value | default: product.metafields.custom.sub_base_colour.value | default: product.metafields.custom.sub_base_color | default: product.metafields.custom.sub_base_colour | default: '#F4EEF5'
          assign rating = product.metafields.okendo.summaryData.reviewAverageValue | default: 0.0 | plus: 0.0
          assign review_count = product.metafields.okendo.summaryData.reviewCount | default: 0 | plus: 0
          assign is_featured = false
          if block.settings.badge_text != blank
            assign is_featured = true
          endif
        -%}
        <a href="{{ product.url }}" class="rjnav-mcard{% if is_featured %} rjnav-mcard--featured{% endif %}" style="--rjnav-tint: {{ tint }};">
          {%- if is_featured -%}<span class="rjnav-mcard-tag">{{ block.settings.badge_text }}</span>{%- endif -%}
          <span class="rjnav-mcard-imgwrap"><img src="{{ product.featured_image | image_url: width: 180, format: 'webp' }}" alt="{{ product.title | escape }}" loading="lazy" decoding="async"></span>
          <span class="rjnav-mcard-text">
            {%- if review_count > 0 -%}
              <span class="rjnav-mcard-rating"><span class="rjnav-stars">{{ star_svg }}{{ star_svg }}{{ star_svg }}{{ star_svg }}{{ star_svg }}</span><b>{{ rating | round: 1 }}</b><span class="rjnav-rcount">({% render 'rj-thousands', n: review_count %})</span></span>
            {%- endif -%}
            <span class="rjnav-mcard-name">{{ product.title }}</span>
            <span class="rjnav-mcard-short">{{ block.settings.short_line }}</span>
          </span>
        </a>
      {%- endfor -%}
    </div>

    <div class="rjnav-mlinks">
      {%- if section.settings.link_1_label != blank -%}<a class="rjnav-mlink" href="{{ section.settings.link_1_url }}">{{ section.settings.link_1_label }}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg></a>{%- endif -%}
      {%- if section.settings.link_2_label != blank -%}<a class="rjnav-mlink" href="{{ section.settings.link_2_url }}">{{ section.settings.link_2_label }}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg></a>{%- endif -%}
      {%- if section.settings.link_3_label != blank -%}<a class="rjnav-mlink" href="{{ section.settings.link_3_url }}">{{ section.settings.link_3_label }}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg></a>{%- endif -%}
      <a class="rjnav-mlink" href="{{ account_url }}">{{ section.settings.account_label | default: 'Sign In' }}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg></a>
    </div>

    <a class="rjnav-mcta" href="{{ section.settings.cta_url | default: '/products/sleep-spray' }}">{{ section.settings.cta_label | default: 'Shop Sleep Spray' }}</a>

    <div class="rjnav-mtrust">
      {%- for i in (0..2) -%}
        {%- assign t_field = 'trust_' | append: forloop.index -%}
        {%- assign t_text = section.settings[t_field] -%}
        {%- if t_text != blank -%}<div class="rjnav-mtile">{{ trust_icons[i] }}{{ t_text }}</div>{%- endif -%}
      {%- endfor -%}
    </div>
  </div>

</div>

<script>
(function () {
  var header = document.getElementById('header');
  if (!header) return;
  var DESKTOP_MQ = window.matchMedia('(min-width: 990px)');
  var trigger = header.querySelector('[data-rjnav-trigger]');
  var rows = [].slice.call(header.querySelectorAll('[data-rjnav-row]'));
  var panels = [].slice.call(header.querySelectorAll('[data-rjnav-panel]'));
  var closeEls = [].slice.call(header.querySelectorAll('[data-rjnav-close]'));
  var closeTimer = null;

  function setActive(i) {
    rows.forEach(function (r, n) { r.classList.toggle('is-active', n === i); });
    panels.forEach(function (p, n) { p.classList.toggle('is-active', n === i); });
  }
  function openMenu() {
    if (!DESKTOP_MQ.matches) return;
    if (closeTimer) { clearTimeout(closeTimer); closeTimer = null; }
    if (header.classList.contains('rjnav-open')) return;
    setActive(0);
    header.classList.add('rjnav-open');
    if (trigger) trigger.setAttribute('aria-expanded', 'true');
  }
  function closeMenu() {
    if (!header.classList.contains('rjnav-open')) return;
    header.classList.remove('rjnav-open');
    if (trigger) trigger.setAttribute('aria-expanded', 'false');
  }
  function closeSoon() {
    if (closeTimer) clearTimeout(closeTimer);
    closeTimer = setTimeout(closeMenu, 150);
  }
  function cancelClose() {
    if (closeTimer) { clearTimeout(closeTimer); closeTimer = null; }
  }

  if (trigger) {
    trigger.addEventListener('mouseenter', openMenu);
    trigger.addEventListener('focus', openMenu);
    trigger.addEventListener('click', function (e) {
      e.preventDefault();
      if (header.classList.contains('rjnav-open')) closeMenu(); else openMenu();
    });
    trigger.addEventListener('keydown', function (e) {
      if (e.key === 'Enter' || e.key === ' ' || e.key === 'Spacebar') {
        e.preventDefault();
        if (header.classList.contains('rjnav-open')) closeMenu(); else openMenu();
      }
    });
  }

  // Keep open while pointer is within the mega menu; close shortly after leaving.
  var mega = header.querySelector('.rjnav-mega');
  if (mega) {
    mega.addEventListener('mouseenter', cancelClose);
    mega.addEventListener('mouseleave', closeSoon);
  }
  if (trigger) {
    trigger.addEventListener('mouseleave', closeSoon);
    trigger.addEventListener('mouseenter', cancelClose);
  }

  // Entering any other nav link / right cluster / overlay closes the menu.
  closeEls.forEach(function (el) { el.addEventListener('mouseenter', closeMenu); });

  // Preview switching on hover / focus of a product row.
  rows.forEach(function (row, i) {
    row.addEventListener('mouseenter', function () { setActive(i); });
    row.addEventListener('focus', function () { setActive(i); });
  });

  // Esc closes the desktop menu.
  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape' && header.classList.contains('rjnav-open')) {
      closeMenu();
      if (trigger) trigger.focus();
    }
  });

  // Close if focus leaves the header entirely (keyboard tab-out).
  header.addEventListener('focusout', function (e) {
    if (!header.contains(e.relatedTarget)) closeMenu();
  });

  // ===== Mobile menu =====
  var mToggle = header.querySelector('[data-rjnav-mtoggle]');
  function openMobile() {
    header.classList.add('rjnav-mopen');
    document.body.classList.add('rjnav-lock');
    if (mToggle) { mToggle.setAttribute('aria-expanded', 'true'); mToggle.setAttribute('aria-label', 'Close menu'); }
  }
  function closeMobile() {
    header.classList.remove('rjnav-mopen');
    document.body.classList.remove('rjnav-lock');
    if (mToggle) { mToggle.setAttribute('aria-expanded', 'false'); mToggle.setAttribute('aria-label', 'Open menu'); }
  }
  if (mToggle) {
    mToggle.addEventListener('click', function () {
      if (header.classList.contains('rjnav-mopen')) closeMobile(); else openMobile();
    });
  }
  // Close mobile menu when a link inside it is tapped.
  var mmenu = header.querySelector('.rjnav-mmenu');
  if (mmenu) {
    mmenu.addEventListener('click', function (e) {
      if (e.target.closest('a')) closeMobile();
    });
  }
  // Reset menu state when crossing the breakpoint.
  DESKTOP_MQ.addEventListener('change', function () {
    closeMenu();
    closeMobile();
  });

  // ===== Sticky hide-on-scroll (preserved behavior for bottom sticky CTAs) =====
  var HIDE_ON_SCROLL = false, NO_REVEAL = false;
  function refreshHideOnScroll() {
    HIDE_ON_SCROLL = !!document.querySelector('.sticky-cta-v2-section--bottom, .sticky-cta-bogo-section--bottom, .psb');
    NO_REVEAL = !!document.querySelector('[data-psb-no-reveal]');
  }
  refreshHideOnScroll();
  document.addEventListener('DOMContentLoaded', refreshHideOnScroll);
  window.addEventListener('load', refreshHideOnScroll);

  var oldScrollY = 0, ticking = false, HIDE_THRESHOLD = 100, MIN_DELTA = 4;
  function onScroll() {
    if (ticking) return;
    ticking = true;
    requestAnimationFrame(function () {
      var scrollY = window.scrollY;
      var delta = scrollY - oldScrollY;
      if (scrollY > 1) header.classList.add('is-ticky'); else header.classList.remove('is-ticky');
      if (oldScrollY > scrollY) document.body.classList.add('sticky-header'); else document.body.classList.remove('sticky-header');
      if (HIDE_ON_SCROLL && !header.classList.contains('rjnav-mopen')) {
        if (scrollY < HIDE_THRESHOLD) header.classList.remove('is-hidden');
        else if (delta > MIN_DELTA) { header.classList.add('is-hidden'); closeMenu(); }
        else if (delta < -MIN_DELTA && !NO_REVEAL) header.classList.remove('is-hidden');
      }
      oldScrollY = scrollY;
      ticking = false;
    });
  }
  window.addEventListener('scroll', onScroll, { passive: true });
  header.classList.remove('fixed-pending');
})();
</script>

{% schema %}
{
  "name": "Header",
  "class": "main-header",
  "settings": [
    { "type": "header", "content": "Logo" },
    { "type": "range", "id": "logo_width", "min": 100, "max": 240, "step": 2, "unit": "px", "label": "Logo width (desktop)", "default": 150 },
    { "type": "range", "id": "logo_width_mobile", "min": 80, "max": 200, "step": 2, "unit": "px", "label": "Logo width (mobile)", "default": 132 },
    { "type": "header", "content": "Nav links" },
    { "type": "text", "id": "products_label", "label": "Products label", "default": "Products" },
    { "type": "text", "id": "link_1_label", "label": "Link 1 label", "default": "Customer Reviews" },
    { "type": "url", "id": "link_1_url", "label": "Link 1 URL" },
    { "type": "text", "id": "link_2_label", "label": "Link 2 label", "default": "Ingredients" },
    { "type": "url", "id": "link_2_url", "label": "Link 2 URL" },
    { "type": "text", "id": "link_3_label", "label": "Link 3 label", "default": "FAQs" },
    { "type": "url", "id": "link_3_url", "label": "Link 3 URL" },
    { "type": "header", "content": "Right cluster" },
    { "type": "text", "id": "account_label", "label": "Account label", "default": "Sign In" },
    { "type": "text", "id": "cta_label", "label": "CTA label", "default": "Shop Sleep Spray" },
    { "type": "url", "id": "cta_url", "label": "CTA URL" },
    { "type": "text", "id": "shopnow_label", "label": "Preview button label", "default": "SHOP NOW" },
    { "type": "header", "content": "Trust items (menu + mobile tiles)" },
    { "type": "text", "id": "trust_1", "label": "Trust 1 (star icon)", "default": "7,500+ 5-Star Reviews" },
    { "type": "text", "id": "trust_2", "label": "Trust 2 (box icon)", "default": "Free U.S. Shipping Over $59" },
    { "type": "text", "id": "trust_3", "label": "Trust 3 (heart icon)", "default": "Family-Founded Business" },
    { "type": "header", "content": "Behavior (legacy)" },
    { "type": "text", "id": "behavior", "label": "Desktop behavior", "default": "static" },
    { "type": "text", "id": "behavior_mobile", "label": "Mobile behavior", "default": "static" }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "settings": [
        { "type": "product", "id": "product", "label": "Product" },
        { "type": "text", "id": "short_line", "label": "Short line" },
        { "type": "text", "id": "description", "label": "Preview description" },
        { "type": "text", "id": "badge_text", "label": "Badge / featured tag", "info": "e.g. #1 BEST SELLER. Setting this marks the product as the featured (Sleep) card on mobile." }
      ]
    }
  ],
  "max_blocks": 6
}
{% endschema %}
