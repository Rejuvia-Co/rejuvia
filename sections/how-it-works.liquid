{{ 'sections-features.css' | asset_url | stylesheet_tag }}

<style>
  #shopify-section-{{ section.id }} { background-color: {{ section.settings.background_color | default: '#EBEDF6' }}; }
  #shopify-section-{{ section.id }} .section-title--h1 { font-size: 36px; }
  @media (max-width: 749px) { #shopify-section-{{ section.id }} .section-title--h1 { font-size: 26px; } }
</style>

<div class="how-it-word-section_container">
  <h2 class="section-title--h1">
    {{ section.settings.heading }}
  </h2>
  <p class="section-subheading">{{ section.settings.subheading }}</p>
  <div class="card-container">
    {% for item in section.blocks %}
      <div class="card">
        {{ item.settings.image | image_url: width: 400 | image_tag: alt: item.settings.description }}
        <div class="description_card_container">
            <p class="step_idicator">STEP {{ forloop.index }}</p>
            <p class="description">{{ item.settings.description }}</p>
        </div>
      </div>
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "How It Works",
  "tag": "section",
  "class": "how-it-works-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Section background",
      "default": "#EBEDF6"
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Card",
      "limit": 3,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "description",
          "label": "Description"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "How It Works"
    }
  ]
}
{% endschema %}
