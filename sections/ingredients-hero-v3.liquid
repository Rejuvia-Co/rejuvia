{%- comment -%}
  Ingredients page hero (direction 1b): full-bleed lab photo with a frosted
  glass panel of copy, then a plum trust bar of range-wide claims.

  Fonts: the brand's existing heading stack (no serif) per the handoff decision.
  Images: separate desktop / mobile pickers (mobile falls back to desktop).
{%- endcomment -%}

{%- liquid
  assign trust_bg = section.settings.trust_bg | default: '#3A1840'
  assign accent = section.settings.accent_color | default: '#672666'
-%}

{% style %}
  .ing-hero-section { background: {{ section.settings.page_bg | default: '#ffffff' }}; overflow-x: clip; }

  .ing-hero {
    position: relative;
    height: {{ section.settings.height_desktop | default: 640 }}px;
    overflow: hidden;
  }
  .ing-hero__media { position: absolute; inset: 0; margin: 0; }
  .ing-hero__media img {
    width: 100%; height: 100%; object-fit: cover;
    object-position: {{ section.settings.focal_desktop | default: '50% 50%' }};
    display: block;
  }

  .ing-hero__panel {
    position: absolute;
    left: 96px;
    top: 50%;
    transform: translateY(-50%);
    width: 540px;
    max-width: calc(100% - 192px);
    box-sizing: border-box;
    background: rgba(255,255,255,.8);
    -webkit-backdrop-filter: blur(16px);
    backdrop-filter: blur(16px);
    border-radius: 24px;
    padding: 48px;
    display: flex;
    flex-direction: column;
    gap: 22px;
    box-shadow: 0 18px 40px rgba(45,21,48,.12);
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
  }

  .ing-hero__eyebrow {
    font-family: 'HelveticaNeueL', 'Helvetica Neue', Helvetica, Arial, sans-serif;
    font-weight: 700;
    font-size: 15px;
    letter-spacing: .18em;
    text-transform: uppercase;
    color: {{ accent }};
  }

  .ing-hero__heading {
    /* Existing brand heading stack (no serif) per handoff. */
    margin: 0;
    font-family: 'HelveticaNeueL', 'Helvetica Neue', Helvetica, Arial, sans-serif;
    font-weight: 600;
    font-size: 46px;
    line-height: 1.08;
    letter-spacing: -.01em;
    color: {{ section.settings.heading_color | default: '#2a1830' }};
  }
  .ing-hero__heading p { margin: 0; font: inherit; color: inherit; }
  .ing-hero__heading em,
  .ing-hero__heading .accent { color: {{ accent }}; font-style: italic; }

  .ing-hero__body {
    margin: 0;
    font-size: 18px;
    line-height: 1.55;
    color: #3d3a36;
  }
  .ing-hero__body p { margin: 0 0 .6em; }
  .ing-hero__body p:last-child { margin-bottom: 0; }

  .ing-hero__pills { display: flex; flex-wrap: wrap; gap: 8px; }
  .ing-hero__pill {
    display: inline-flex; align-items: center; gap: 8px;
    font-size: 15px; font-weight: 600;
    padding: 10px 16px; border-radius: 100px;
  }
  .ing-hero__pill-dot { width: 9px; height: 9px; border-radius: 50%; flex: none; }

  /* --- Trust bar --- */
  .ing-hero__trust {
    background: {{ trust_bg }};
    color: #fff;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    padding: 28px 48px;
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
  }
  .ing-hero__trust-item {
    display: flex; align-items: center; justify-content: center; gap: 14px;
    text-align: center;
  }
  .ing-hero__trust-item + .ing-hero__trust-item { border-left: 1px solid rgba(255,255,255,.18); }
  .ing-hero__trust-item svg { flex: none; width: 34px; height: 34px; }
  .ing-hero__trust-label { font-size: 18px; font-weight: 600; }

  /* ===================== Mobile ===================== */
  @media (max-width: 749px) {
    .ing-hero { height: auto; overflow: visible; }
    .ing-hero__media { position: static; display: block; }
    .ing-hero__media img {
      height: {{ section.settings.height_mobile | default: 330 }}px;
      object-position: {{ section.settings.focal_mobile | default: '50% 50%' }};
    }
    .ing-hero__panel {
      position: static;
      transform: none;
      width: auto;
      max-width: none;
      margin: -56px 14px 0;
      background: rgba(255,255,255,.92);
      border-radius: 20px;
      padding: 26px 22px;
      gap: 14px;
      box-shadow: 0 14px 32px rgba(45,21,48,.14);
    }
    .ing-hero__eyebrow { font-size: 14px; }
    .ing-hero__heading { font-size: 32px; line-height: 1.1; }
    .ing-hero__body { font-size: 15px; line-height: 1.5; }
    .ing-hero__pills { display: none; } /* desktop only per design */

    .ing-hero__trust {
      margin-top: 24px;
      padding: 18px 6px;
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
    .ing-hero__trust-item { flex-direction: column; gap: 8px; padding: 0 4px; }
    .ing-hero__trust-item svg { width: 26px; height: 26px; }
    .ing-hero__trust-label { font-size: 12px; line-height: 1.25; }
  }
{% endstyle %}

{%- comment -%} Icon set for the trust bar (gold line icons). {%- endcomment -%}
{%- capture icon_leaf -%}<svg viewBox="0 0 24 24" fill="none" stroke="{{ section.settings.icon_color | default: '#eac78b' }}" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 19c0-8 5-13 15-14-1 10-6 15-14 15"/><path d="M5 19c3-4 6-7 10-9"/></svg>{%- endcapture -%}
{%- capture icon_shield -%}<svg viewBox="0 0 24 24" fill="none" stroke="{{ section.settings.icon_color | default: '#eac78b' }}" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l7 3v5.5c0 4.4-3 8-7 9.5-4-1.5-7-5.1-7-9.5V6z"/><path d="M8.8 12.2l2.2 2.2 4.4-4.6"/></svg>{%- endcapture -%}
{%- capture icon_factory -%}<svg viewBox="0 0 24 24" fill="none" stroke="{{ section.settings.icon_color | default: '#eac78b' }}" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 21V4"/><path d="M5 4h13l-2 4 2 4H5"/><path d="M8 7h2M8 9.5h2"/></svg>{%- endcapture -%}
{%- capture icon_flask -%}<svg viewBox="0 0 24 24" fill="none" stroke="{{ section.settings.icon_color | default: '#eac78b' }}" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 3h6M10 3v6l-5 9a2 2 0 0 0 1.8 3h10.4A2 2 0 0 0 19 18l-5-9V3"/><path d="M7.5 14h9"/></svg>{%- endcapture -%}

<div class="ing-hero">
  {%- if section.settings.image != blank -%}
    <picture class="ing-hero__media">
      {%- assign m_img = section.settings.image_mobile | default: section.settings.image -%}
      <source media="(max-width: 749px)"
        srcset="{{ m_img | image_url: width: 600, format: 'webp' }} 600w,
                {{ m_img | image_url: width: 900, format: 'webp' }} 900w,
                {{ m_img | image_url: width: 1200, format: 'webp' }} 1200w"
        sizes="100vw">
      <img src="{{ section.settings.image | image_url: width: 1600, format: 'webp' }}"
           srcset="{{ section.settings.image | image_url: width: 1000, format: 'webp' }} 1000w,
                   {{ section.settings.image | image_url: width: 1600, format: 'webp' }} 1600w,
                   {{ section.settings.image | image_url: width: 2200, format: 'webp' }} 2200w"
           sizes="100vw"
           alt="{{ section.settings.image.alt | default: 'Rejuvia sprays in a clean lab' | escape }}"
           width="{{ section.settings.image.width }}" height="{{ section.settings.image.height }}"
           loading="eager" fetchpriority="high" decoding="async">
    </picture>
  {%- endif -%}

  <div class="ing-hero__panel">
    {%- if section.settings.eyebrow != blank -%}
      <div class="ing-hero__eyebrow">{{ section.settings.eyebrow }}</div>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <h1 class="ing-hero__heading">{{ section.settings.heading }}</h1>
    {%- endif -%}
    {%- if section.settings.body != blank -%}
      <div class="ing-hero__body">{{ section.settings.body }}</div>
    {%- endif -%}

    {%- assign pill_blocks = section.blocks | where: 'type', 'pill' -%}
    {%- if pill_blocks.size > 0 -%}
      <div class="ing-hero__pills">
        {%- for block in pill_blocks -%}
          <span class="ing-hero__pill" style="background: {{ block.settings.bg_color }}; color: {{ block.settings.base_color }};" {{ block.shopify_attributes }}>
            <span class="ing-hero__pill-dot" style="background: {{ block.settings.base_color }};"></span>{{ block.settings.label }}
          </span>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</div>

<div class="ing-hero__trust">
  {%- for i in (1..4) -%}
    {%- assign label_key = 'trust_' | append: i -%}
    {%- assign icon_key = 'trust_icon_' | append: i -%}
    {%- assign label = section.settings[label_key] -%}
    {%- assign icon = section.settings[icon_key] -%}
    {%- if label != blank -%}
      <div class="ing-hero__trust-item">
        {%- case icon -%}
          {%- when 'shield' -%}{{ icon_shield }}
          {%- when 'factory' -%}{{ icon_factory }}
          {%- when 'flask' -%}{{ icon_flask }}
          {%- else -%}{{ icon_leaf }}
        {%- endcase -%}
        <span class="ing-hero__trust-label">{{ label }}</span>
      </div>
    {%- endif -%}
  {%- endfor -%}
</div>

{% schema %}
{
  "name": "Ingredients Hero V3",
  "class": "ing-hero-section",
  "settings": [
    { "type": "header", "content": "Hero image" },
    { "type": "image_picker", "id": "image", "label": "Hero image (desktop)" },
    { "type": "image_picker", "id": "image_mobile", "label": "Hero image (mobile)", "info": "Optional. Shown at 749px and below. Falls back to the desktop image." },
    { "type": "range", "id": "height_desktop", "label": "Image height — desktop (px)", "min": 420, "max": 820, "step": 10, "default": 640 },
    { "type": "range", "id": "height_mobile", "label": "Image height — mobile (px)", "min": 240, "max": 480, "step": 10, "default": 330 },
    { "type": "text", "id": "focal_desktop", "label": "Focal point — desktop", "info": "CSS object-position, e.g. 50% 50%", "default": "50% 50%" },
    { "type": "text", "id": "focal_mobile", "label": "Focal point — mobile", "default": "50% 50%" },
    { "type": "header", "content": "Panel copy" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "INGREDIENTS" },
    { "type": "richtext", "id": "heading", "label": "Heading", "info": "Wrap the accent words in italics to colour them.", "default": "<p>Every ingredient <em>earns its place.</em></p>" },
    { "type": "richtext", "id": "body", "label": "Body", "default": "<p>No fillers, no proprietary blends hiding weak doses. Just clean, research-backed botanicals that absorb under your tongue.</p>" },
    { "type": "color", "id": "heading_color", "label": "Heading color", "default": "#2a1830" },
    { "type": "color", "id": "accent_color", "label": "Accent color", "default": "#672666" },
    { "type": "color", "id": "page_bg", "label": "Page background", "default": "#ffffff" },
    { "type": "header", "content": "Trust bar" },
    { "type": "color", "id": "trust_bg", "label": "Trust bar background", "default": "#3A1840" },
    { "type": "color", "id": "icon_color", "label": "Icon color", "default": "#eac78b" },
    { "type": "text", "id": "trust_1", "label": "Claim 1 label", "default": "100% All-Natural" },
    { "type": "select", "id": "trust_icon_1", "label": "Claim 1 icon", "options": [ { "value": "leaf", "label": "Leaf" }, { "value": "shield", "label": "Shield" }, { "value": "factory", "label": "Factory" }, { "value": "flask", "label": "Flask" } ], "default": "leaf" },
    { "type": "text", "id": "trust_2", "label": "Claim 2 label", "default": "cGMP Certified" },
    { "type": "select", "id": "trust_icon_2", "label": "Claim 2 icon", "options": [ { "value": "leaf", "label": "Leaf" }, { "value": "shield", "label": "Shield" }, { "value": "factory", "label": "Factory" }, { "value": "flask", "label": "Flask" } ], "default": "shield" },
    { "type": "text", "id": "trust_3", "label": "Claim 3 label", "default": "100% Made in USA" },
    { "type": "select", "id": "trust_icon_3", "label": "Claim 3 icon", "options": [ { "value": "leaf", "label": "Leaf" }, { "value": "shield", "label": "Shield" }, { "value": "factory", "label": "Factory" }, { "value": "flask", "label": "Flask" } ], "default": "factory" },
    { "type": "text", "id": "trust_4", "label": "Claim 4 label", "default": "Triple Lab Tested" },
    { "type": "select", "id": "trust_icon_4", "label": "Claim 4 icon", "options": [ { "value": "leaf", "label": "Leaf" }, { "value": "shield", "label": "Shield" }, { "value": "factory", "label": "Factory" }, { "value": "flask", "label": "Flask" } ], "default": "flask" }
  ],
  "blocks": [
    {
      "type": "pill",
      "name": "Product pill (desktop)",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Sleep" },
        { "type": "color", "id": "base_color", "label": "Text / dot color", "default": "#672666" },
        { "type": "color", "id": "bg_color", "label": "Background", "default": "#F4EEF5" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Ingredients Hero V3",
      "blocks": [
        { "type": "pill", "settings": { "label": "Sleep", "base_color": "#672666", "bg_color": "#F4EEF5" } },
        { "type": "pill", "settings": { "label": "Calm", "base_color": "#C23A57", "bg_color": "#FBEBEF" } },
        { "type": "pill", "settings": { "label": "D3+K2", "base_color": "#1B8546", "bg_color": "#E7F4EB" } }
      ]
    }
  ]
}
{% endschema %}
