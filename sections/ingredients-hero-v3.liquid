{%- comment -%}
  Ingredients page hero (direction 2a): copy on the left, the scattered-sprays
  shot on the right, and a 2×2 grid of range-wide trust tiles under the copy
  (replaces the old separate guarantees check-row).

  Heading mirrors the homepage hero H1 exactly (.hero-v2-heading): family /
  weight / tracking from the global --rj-title-* system, 36px desktop / 26px
  at <=900px, line-height 1.4, #141414. Underlined / bold / italic words render
  in the accent colour, same as "3x Faster" on the homepage.

  Mobile order: eyebrow → H1 → image → body → trust tiles.
{%- endcomment -%}

{%- liquid
  assign accent = section.settings.accent_color | default: '#672666'
-%}

{% style %}
  @font-face {
    font-family: 'Helvetica LT Cond';
    src: url('{{ "HelveticaLTStd-BlkCond.woff2" | asset_url }}') format('woff2');
    font-weight: 800;
    font-style: normal;
    font-display: swap;
  }

  .ing-hero-section { background: {{ section.settings.bg_color | default: '#ffffff' }}; overflow-x: clip; }

  .ing-hero {
    max-width: 1240px;
    margin: 0 auto;
    padding: 72px 0 88px;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 600px);
    grid-template-rows: 1fr auto auto auto auto 1fr;
    grid-template-areas:
      ".       media"
      "eyebrow media"
      "title   media"
      "body    media"
      "trust   media"
      ".       media";
    column-gap: 80px;
    align-items: start;
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
    color: #141414;
  }

  .ing-hero__eyebrow {
    grid-area: eyebrow;
    font-family: 'Helvetica LT Cond', 'HelveticaNeueL', 'Helvetica Neue', Helvetica, Arial, sans-serif;
    font-weight: 800;
    font-size: 16px;
    line-height: 1.2;
    letter-spacing: .16em;
    text-transform: uppercase;
    color: {{ accent }};
  }

  /* --- Heading: identical to .hero-v2-heading --- */
  .ing-hero__heading {
    grid-area: title;
    margin: 24px 0 0;
    font-size: 36px;
    line-height: 1.4;
    color: #141414;
    text-transform: none;
  }
  .ing-hero__heading p {
    margin: 0;
    padding: 0;
    font-family: inherit;
    font-weight: inherit;
    font-size: inherit;
    line-height: inherit;
    letter-spacing: inherit;
    color: inherit;
    text-transform: inherit;
  }
  .ing-hero__heading em,
  .ing-hero__heading u,
  .ing-hero__heading [style*="underline"] {
    color: {{ accent }};
    font-style: normal;
  }

  .ing-hero__body {
    grid-area: body;
    margin-top: 24px;
    max-width: 540px;
    font-size: 18px;
    line-height: 1.6;
    color: #3d3a36;
    text-wrap: pretty;
  }
  .ing-hero__body p { margin: 0; }
  .ing-hero__body p + p { margin-top: 12px; }

  .ing-hero__media {
    grid-area: media;
    align-self: center;
    margin: 0;
    aspect-ratio: 1 / 1;
    overflow: hidden;
  }
  .ing-hero__media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* --- Trust tiles --- */
  .ing-hero__trust {
    grid-area: trust;
    margin-top: 32px;
    max-width: 540px;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 10px;
  }
  .ing-hero__tile {
    display: flex;
    align-items: center;
    gap: 14px;
    background: {{ section.settings.tile_bg | default: '#F7F6FB' }};
    border-radius: 12px;
    padding: 16px 18px;
  }
  .ing-hero__tile-icon {
    flex-shrink: 0;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: {{ accent }};
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .ing-hero__tile-icon svg { width: 22px; height: 22px; display: block; }
  .ing-hero__tile-label {
    font-size: 16px;
    font-weight: 600;
    line-height: 1.25;
    color: #141414;
  }

  @media (max-width: 1300px) {
    .ing-hero { padding-left: 24px; padding-right: 24px; column-gap: 56px; }
  }
  @media (max-width: 1100px) {
    .ing-hero { grid-template-columns: minmax(0, 1fr) minmax(0, 44%); column-gap: 40px; }
  }

  @media (max-width: 900px) {
    .ing-hero {
      display: flex;
      flex-direction: column;
      gap: 18px;
      padding: 32px 18px 36px;
    }
    .ing-hero__eyebrow { font-size: 13px; }
    .ing-hero__heading { margin: 0; font-size: 26px; }
    .ing-hero__media { aspect-ratio: auto; }
    .ing-hero__media img { height: auto; }
    .ing-hero__body { margin: 0; max-width: none; font-size: 16px; line-height: 1.55; }
    .ing-hero__trust { margin: 0; max-width: none; gap: 8px; }
    .ing-hero__tile { gap: 10px; padding: 12px; }
    .ing-hero__tile-icon { width: 36px; height: 36px; }
    .ing-hero__tile-icon svg { width: 18px; height: 18px; }
    .ing-hero__tile-label { font-size: 14px; line-height: 1.2; }
  }
{% endstyle %}

<div class="ing-hero">
  {%- if section.settings.eyebrow != blank -%}
    <div class="ing-hero__eyebrow">{{ section.settings.eyebrow }}</div>
  {%- endif -%}

  {%- if section.settings.heading != blank -%}
    <h1 class="ing-hero__heading">{{ section.settings.heading }}</h1>
  {%- endif -%}

  {%- if section.settings.image != blank -%}
    <picture class="ing-hero__media">
      {%- if section.settings.image_mobile != blank -%}
        <source media="(max-width: 900px)"
          srcset="{{ section.settings.image_mobile | image_url: width: 500, format: 'webp' }} 500w,
                  {{ section.settings.image_mobile | image_url: width: 800, format: 'webp' }} 800w,
                  {{ section.settings.image_mobile | image_url: width: 1100, format: 'webp' }} 1100w"
          sizes="100vw">
      {%- endif -%}
      <img src="{{ section.settings.image | image_url: width: 1200, format: 'webp' }}"
           srcset="{{ section.settings.image | image_url: width: 500, format: 'webp' }} 500w,
                   {{ section.settings.image | image_url: width: 800, format: 'webp' }} 800w,
                   {{ section.settings.image | image_url: width: 1200, format: 'webp' }} 1200w,
                   {{ section.settings.image | image_url: width: 1600, format: 'webp' }} 1600w"
           sizes="(max-width: 900px) 100vw, 600px"
           alt="{{ section.settings.image.alt | default: 'Rejuvia Sleep, Calm, D3+K2 and Lutein sprays' | escape }}"
           width="{{ section.settings.image.width }}" height="{{ section.settings.image.height }}"
           loading="eager" fetchpriority="high" decoding="async">
    </picture>
  {%- endif -%}

  {%- if section.settings.body != blank -%}
    <div class="ing-hero__body">{{ section.settings.body }}</div>
  {%- endif -%}

  {%- if section.blocks.size > 0 -%}
    <div class="ing-hero__trust">
      {%- for block in section.blocks -%}
        <div class="ing-hero__tile" {{ block.shopify_attributes }}>
          <span class="ing-hero__tile-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
              {%- case block.settings.icon -%}
                {%- when 'shield' -%}<path d="M12 3l7 3v5.5c0 4.4-3 8-7 9.5-4-1.5-7-5.1-7-9.5V6zM8.8 12.2l2.2 2.2 4.4-4.6"/>
                {%- when 'flag' -%}<path d="M5 21V4M5 4h13l-2 4 2 4H5M8 7h2M8 9.5h2"/>
                {%- when 'flask' -%}<path d="M9 3h6M10 3v6l-5 9a2 2 0 0 0 1.8 3h10.4A2 2 0 0 0 19 18l-5-9V3M7.5 14h9"/>
                {%- else -%}<path d="M5 19c0-8 5-13 15-14-1 10-6 15-14 15M5 19c3-4 6-7 10-9"/>
              {%- endcase -%}
            </svg>
          </span>
          <span class="ing-hero__tile-label">{{ block.settings.label }}</span>
        </div>
      {%- endfor -%}
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Ingredients Hero",
  "class": "ing-hero-section",
  "max_blocks": 6,
  "settings": [
    { "type": "header", "content": "Copy" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "INGREDIENTS" },
    {
      "type": "richtext",
      "id": "heading",
      "label": "Heading",
      "info": "Styled like the homepage hero. Underline / bold / italic words show in the accent colour.",
      "default": "<p>Wondering What's Actually In <span style=\"text-decoration:underline\"><em><strong>Rejuvia?</strong></em></span></p>"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body",
      "default": "<p>A clean, all-natural blend — each ingredient chosen for a reason and dosed to actually do something. No fillers, no proprietary blends.</p>"
    },
    { "type": "header", "content": "Image" },
    { "type": "image_picker", "id": "image", "label": "Hero image" },
    { "type": "image_picker", "id": "image_mobile", "label": "Hero image (mobile)", "info": "Optional. Shown at 900px and below. Falls back to the main image." },
    { "type": "header", "content": "Colours" },
    { "type": "color", "id": "accent_color", "label": "Accent color", "default": "#672666" },
    { "type": "color", "id": "tile_bg", "label": "Trust tile background", "default": "#F7F6FB" },
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#ffffff" }
  ],
  "blocks": [
    {
      "type": "trust",
      "name": "Trust tile",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "100% All-Natural" },
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "leaf", "label": "Leaf" },
            { "value": "shield", "label": "Shield check" },
            { "value": "flag", "label": "Flag" },
            { "value": "flask", "label": "Flask" }
          ],
          "default": "leaf"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Ingredients Hero",
      "category": "Custom",
      "blocks": [
        { "type": "trust", "settings": { "label": "100% All-Natural", "icon": "leaf" } },
        { "type": "trust", "settings": { "label": "cGMP Certified", "icon": "shield" } },
        { "type": "trust", "settings": { "label": "100% Made in USA", "icon": "flag" } },
        { "type": "trust", "settings": { "label": "Triple Lab Tested", "icon": "flask" } }
      ]
    }
  ]
}
{% endschema %}
