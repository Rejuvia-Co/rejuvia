{{ 'key-ingredients-v2.css' | asset_url | stylesheet_tag }}

{% assign currentProduct = product %}
{% assign base_colour = currentProduct.metafields.custom.base_colour %}
{% assign ingredients = currentProduct.metafields.custom.key_ingredients.value %}

{% if ingredients != blank %}
<section class="key-ingredients-v2"{% if base_colour != blank %} style="--base-colour: {{ base_colour }};"{% endif %}>
  <div class="key-ingredients-v2__container">

    <div class="key-ingredients-v2__header">
      <h2 class="key-ingredients-v2__title">{{ section.settings.heading | default: 'The key ingredients' }}</h2>
      {% if section.settings.button_label != blank %}
        <button type="button" class="key-ingredients-v2__btn key-ingredients-v2__btn--desktop" data-open-supplement-popup>{{ section.settings.button_label }}</button>
      {% endif %}
    </div>

    <div class="key-ingredients-v2__grid">
      {% for ingredient in ingredients %}
        <div class="key-ingredients-v2__card">
          {% if ingredient.image != blank %}
            <div class="key-ingredients-v2__card-image">
              <img src="{{ ingredient.image | image_url: width: 400, format: 'webp' }}"
                   alt="{{ ingredient.title | default: 'Ingredient' }}"
                   loading="lazy"
                   width="165"
                   height="165" decoding="async">
            </div>
          {% endif %}
          <div class="key-ingredients-v2__card-content">
            {% if ingredient.title != blank %}
              <h3 class="key-ingredients-v2__card-title">{{ ingredient.title }}</h3>
            {% endif %}
            {% if ingredient.description != blank %}
              <div class="key-ingredients-v2__card-desc">{{ ingredient.description | metafield_tag }}</div>
            {% endif %}
          </div>
        </div>
      {% endfor %}
    </div>

    {% if section.settings.button_label != blank %}
      <div class="key-ingredients-v2__mobile-btn">
        <button type="button" class="key-ingredients-v2__btn" data-open-supplement-popup>{{ section.settings.button_label }}</button>
      </div>
    {% endif %}

    {% comment %} CTA — scrolls up to the product widget; colour follows base_colour {% endcomment %}
    {% if section.settings.cta_text != blank %}
      <div class="key-ingredients-v2__cta">
        <button type="button" class="key-ingredients-v2__cta-btn" data-ki-scrolltop>{{ section.settings.cta_text }}</button>
        {% if section.settings.cta_subtext != blank %}
          <div class="key-ingredients-v2__cta-note">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="13" viewBox="0 0 14 11" fill="none" aria-hidden="true">
              <path d="M11.6558 0.765634C11.8759 0.556086 12.1688 0.440239 12.4727 0.442538C12.7766 0.444838 13.0677 0.565104 13.2846 0.777959C13.5015 0.990814 13.6273 1.27961 13.6353 1.58341C13.6433 1.8872 13.533 2.18224 13.3277 2.40626L7.0933 10.2031C6.98609 10.3186 6.85671 10.4113 6.71288 10.4756C6.56904 10.5399 6.41372 10.5746 6.25619 10.5775C6.09866 10.5804 5.94215 10.5515 5.79604 10.4926C5.64992 10.4336 5.5172 10.3458 5.40579 10.2344L1.27142 6.10001C1.15628 5.99272 1.06394 5.86335 0.999887 5.7196C0.935837 5.57585 0.901396 5.42067 0.89862 5.26333C0.895844 5.10598 0.924789 4.94968 0.983728 4.80376C1.04267 4.65784 1.13039 4.52529 1.24167 4.41401C1.35295 4.30273 1.4855 4.21501 1.63142 4.15607C1.77734 4.09713 1.93364 4.06818 2.09099 4.07096C2.24833 4.07374 2.40351 4.10818 2.54726 4.17223C2.69101 4.23628 2.82038 4.32862 2.92767 4.44376L6.19954 7.71407L11.6261 0.80001L11.6558 0.765634Z" fill="#FAB851"/>
            </svg>
            <span>{{ section.settings.cta_subtext }}</span>
          </div>
        {% endif %}
      </div>
    {% endif %}

  </div>
</section>

<script>
(function() {
  var sec = document.querySelector('#shopify-section-{{ section.id }}');
  if (!sec) return;
  sec.querySelectorAll('[data-ki-scrolltop]').forEach(function(btn) {
    btn.addEventListener('click', function() {
      var target = document.querySelector('[id*="product_widget"]');
      if (target) { target.scrollIntoView({ behavior: 'smooth', block: 'start' }); }
      else { window.scrollTo({ top: 0, behavior: 'smooth' }); }
    });
  });
})();
</script>
{% endif %}

{% schema %}
{
  "name": "Key Ingredients V2",
  "tag": "section",
  "settings": [
    {
      "type": "paragraph",
      "content": "Ingredients from product metafield custom.key_ingredients (list of metaobjects with image, title, description). Section hidden when metafield is empty."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Key all-natural ingredients"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "View Supplement Label"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Button URL"
    },
    {
      "type": "header",
      "content": "Call to action"
    },
    {
      "type": "paragraph",
      "content": "Button at the bottom of the section. Scrolls up to the product widget at the top of the page; colour follows custom.base_colour. Leave the button text empty to hide it."
    },
    { "type": "text", "id": "cta_text", "label": "Button text", "default": "Try Rejuvia risk-free" },
    { "type": "text", "id": "cta_subtext", "label": "Guarantee line", "default": "90-Day Money-Back Guarantee" }
  ],
  "presets": [
    {
      "name": "Key Ingredients V2"
    }
  ]
}
{% endschema %}
