{% style %}
  .main-faq-new.section-{{ section.id }} {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: 40px;
  }

  @media screen and (min-width: 750px) {
    .main-faq-new.section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .main-faq-new__heading {
    margin: 0;
    color: #141414;
    font-size: 36px;
    font-style: normal;
    font-weight: 500;
    line-height: 1.4;
    letter-spacing: normal;
    font-family: "Helvetica Neue", sans-serif;
  }

  .main-faq-new__sub {
    font-family: "Helvetica Neue", Helvetica, Arial, sans-serif;
    font-size: {{ section.settings.sub_size | default: 18 }}px;
    line-height: 1.5;
    color: #232323;
    /* Left-aligned under the title. Capped so the line keeps a comfortable
       measure instead of running the full 1344px container width. */
    max-width: 640px;
    margin: 12px 0 0;
  }

  .main-faq-new__sub p { margin: 0; }

  /* Parity with the homepage FAQ section: <em> is the accent treatment for
     the email address, not italics. */
  .main-faq-new__sub em {
    font-style: normal;
    color: {{ section.settings.accent_color | default: '#672666' }};
    font-weight: 600;
  }

  .main-faq-new .container {
    padding: 0 21px;
    max-width: 1344px;
  }

  @media only screen and (max-width: 749px) {
    .main-faq-new__heading {
      font-size: 28px;
      letter-spacing: normal;
    }

    .main-faq-new__sub {
      font-size: {{ section.settings.sub_size_mobile | default: 16 }}px;
      margin-top: 10px;
    }

    .main-faq-new.section-{{ section.id }} .container {
      padding: 0 16px;
    }
  }
{% endstyle %}

<div class="main-faq-new section-{{ section.id }}">
  <div class="container">
    {%- if section.settings.heading != blank -%}
      <h1 class="main-faq-new__heading" style="color: {{ section.settings.title_color }};">
				{{ page.title }}
			</h1>
    {%- endif -%}

    {%- if section.settings.subheading != blank -%}
      <div class="main-faq-new__sub">{{ section.settings.subheading }}</div>
    {%- endif -%}
  </div>
</div>

<script>
  (function () {
    function setHeaderVar() {
      var header = document.querySelector('header.sticky_header_desktop, header.sticky_header_mobile, header[class*="sticky_header"]') || document.querySelector('header');
      if (!header) return;
      var pos = getComputedStyle(header).position;
      var h = (pos === 'sticky' || pos === 'fixed') ? header.offsetHeight : 0;
      document.documentElement.style.setProperty('--faq-header-h', h + 'px');
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', setHeaderVar);
    } else {
      setHeaderVar();
    }
    window.addEventListener('resize', setHeaderVar);
    window.addEventListener('load', setHeaderVar);
  })();
</script>

{% schema %}
  {
    "name": "Main FAQ new",
    "settings": [
      {
        "type": "text",
        "id": "heading",
        "label": "Heading",
        "default": "Faqs Title"
      },
      {
        "type": "color",
        "id": "title_color",
        "label": "Title Color",
        "default": "#141414"
      },
      {
        "type": "richtext",
        "id": "subheading",
        "label": "Subtitle",
        "info": "Wrap the email address in italics to give it the purple accent.",
        "default": "<p>Don't see your question? We'd love to help. Email us at <em>hello@rejuvia.co!</em></p>"
      },
      {
        "type": "color",
        "id": "accent_color",
        "label": "Subtitle accent",
        "default": "#672666"
      },
      {
        "type": "range",
        "id": "sub_size",
        "min": 14,
        "max": 26,
        "step": 1,
        "unit": "px",
        "label": "Subtitle size (desktop)",
        "default": 18
      },
      {
        "type": "range",
        "id": "sub_size_mobile",
        "min": 13,
        "max": 22,
        "step": 1,
        "unit": "px",
        "label": "Subtitle size (mobile)",
        "default": 16
      },
      {
        "type": "header",
        "content": "Section padding"
      },
      {
        "type": "range",
        "id": "padding_top",
        "min": 0,
        "max": 200,
        "step": 2,
        "unit": "px",
        "label": "Top padding",
        "default": 24
      }, {
        "type": "range",
        "id": "padding_bottom",
        "min": 0,
        "max": 200,
        "step": 2,
        "unit": "px",
        "label": "Bottom padding",
        "default": 24
      }
    ],

    "presets": [
      {
        "name": "Main FAQ new"
      }
    ]
  }
{% endschema %}