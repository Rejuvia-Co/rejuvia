            {%- endif -%}
            {%- if section.settings.onetime_text != blank -%}
              <span class="ob__assurance">{%- if section.settings.onetime_icon != blank -%}<img class="ob__assurance-icon" src="{{ section.settings.onetime_icon | image_url: width: 60 }}" alt="" width="17" height="17" loading="lazy" decoding="async">{%- else -%}<svg width="15" height="15" viewBox="0 0 24 24" fill="none"><path d="M4 12a8 8 0 0 1 13.7-5.6L20 8" stroke="{{ section.settings.accent_color | default: '#018e1c' }}" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/><path d="M20 4v4h-4" stroke="{{ section.settings.accent_color | default: '#018e1c' }}" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/><path d="M20 12a8 8 0 0 1-13.7 5.6L4 16" stroke="{{ section.settings.accent_color | default: '#018e1c' }}" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/><path d="M4 20v-4h4" stroke="{{ section.settings.accent_color | default: '#018e1c' }}" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>{%- endif -%}{{ section.settings.onetime_text }}</span>
            {%- endif -%}
          </div>
        {%- endif -%}

        {%- if section.settings.show_payment_icons -%}
          {%- assign hidden_pay = section.settings.hidden_payments | default: '' | downcase | replace: ' ', '' | split: ',' -%}
          <div class="ob__payments">
            {%- for type in shop.enabled_payment_types -%}{%- unless hidden_pay contains type -%}{{ type | payment_type_svg_tag: class: 'payment-icon' }}{%- endunless -%}{%- endfor -%}
          </div>
        {%- endif -%}
      </div>

      {%- assign has_tabs = false -%}
      {%- for b in section.blocks -%}{%- if b.type == 'tab' and b.settings.title != blank -%}{%- assign has_tabs = true -%}{%- endif -%}{%- endfor -%}
      {%- if has_tabs -%}
        <div class="ob__tabs">
          {%- for b in section.blocks -%}{%- if b.type == 'tab' -%}
            <div class="ob__tab" {{ b.shopify_attributes }}>
              <button type="button" class="ob__tab-q" aria-expanded="false"><span>{{ b.settings.title }}</span>{{ ob_chevron }}</button>
              <div class="ob__tab-a"><div class="ob__tab-a-inner"><div class="ob__tab-body">{{ b.settings.content }}{%- assign tab_t = b.settings.title | downcase -%}{%- if tab_t contains 'ingredient' -%}{% render 'supplement-label-button', product: section.settings.product %}{%- endif -%}</div></div></div>
            </div>
          {%- endif -%}{%- endfor -%}
        </div>
      {%- endif -%}

      {%- if section.settings.show_trusted -%}
        {% render 'trusted-by',
          title: section.settings.trusted_title,
          subtext: section.settings.trusted_subtext,
          image_1: section.settings.trusted_image_1,
          image_2: section.settings.trusted_image_2,
          image_3: section.settings.trusted_image_3,
          bg_color: section.settings.trusted_bg,
          check_color: section.settings.trusted_check %}
      {%- endif -%}
    </div>
  </div>
  {% render 'supplement-label-popup', product: section.settings.product %}
</section>

<script>
(function () {
  var sec = document.getElementById('ob-{{ section.id }}');
  if (!sec) return;

  /* Tier selection */
  sec.querySelectorAll('.ob__tier input[type="radio"]').forEach(function (input) {
    input.addEventListener('change', function () {
      sec.querySelectorAll('.ob__tier').forEach(function (t) { t.classList.remove('is-selected'); });
      input.closest('.ob__tier').classList.add('is-selected');
    });
  });
  if (!sec.querySelector('.ob__tier input[type="radio"]:checked')) {
    var firstInput = sec.querySelector('.ob__tier input[type="radio"]');
    if (firstInput) { firstInput.checked = true; firstInput.closest('.ob__tier').classList.add('is-selected'); }
  }

  /* Gallery */
  var mainImg = sec.querySelector('[data-ob-main]');
  var thumbs = [].slice.call(sec.querySelectorAll('[data-ob-thumb]'));
  var dots = [].slice.call(sec.querySelectorAll('[data-ob-dot]'));
  var idx = 0;
  thumbs.forEach(function (t, i) { if (t.classList.contains('is-active')) idx = i; });
  function setImg(i) {
    if (!thumbs.length) return;
    idx = (i + thumbs.length) % thumbs.length;
    var t = thumbs[idx];
    if (mainImg) { mainImg.removeAttribute('srcset'); mainImg.removeAttribute('sizes'); mainImg.src = t.getAttribute('data-full'); }
    thumbs.forEach(function (x) { x.classList.remove('is-active'); });
    t.classList.add('is-active');
    dots.forEach(function (d, j) { d.classList.toggle('is-active', j === idx); });
    if (t.scrollIntoView) t.scrollIntoView({ block: 'nearest', inline: 'nearest' });
  }
  thumbs.forEach(function (t, i) { t.addEventListener('click', function () { setImg(i); }); });
  var prev = sec.querySelector('[data-ob-prev]'), next = sec.querySelector('[data-ob-next]');
  if (prev) prev.addEventListener('click', function () { setImg(idx - 1); });
  if (next) next.addEventListener('click', function () { setImg(idx + 1); });

  var galMain = sec.querySelector('.ob__main');
  if (galMain && thumbs.length > 1) {
    var gsx = null, gsy = null;
    galMain.addEventListener('touchstart', function (e) {
      var t = e.touches[0]; gsx = t.clientX; gsy = t.clientY;
    }, { passive: true });
    galMain.addEventListener('touchend', function (e) {
      if (gsx === null) return;
      var t = e.changedTouches[0], dx = t.clientX - gsx, dy = t.clientY - gsy;
      if (Math.abs(dx) > 40 && Math.abs(dx) > Math.abs(dy)) { setImg(dx < 0 ? idx + 1 : idx - 1); }
      gsx = null; gsy = null;
    }, { passive: true });
  }

  /* Accordion — one open at a time */
  var tabs = sec.querySelectorAll('.ob__tab');
  sec.querySelectorAll('.ob__tab-q').forEach(function (btn) {
    btn.addEventListener('click', function () {
      var tab = btn.closest('.ob__tab');
      var willOpen = !tab.classList.contains('is-open');
      tabs.forEach(function (t) { t.classList.remove('is-open'); var b = t.querySelector('.ob__tab-q'); if (b) b.setAttribute('aria-expanded', 'false'); });
      if (willOpen) { tab.classList.add('is-open'); btn.setAttribute('aria-expanded', 'true'); }
    });
  });

  /* Buy Now -> build cart (subscription base + free one-time units), apply
     discount code, go to checkout. */
  var buy = sec.querySelector('[data-ob-buy]');
  if (buy) {
    window.addEventListener('pageshow', function () { buy.disabled = false; buy.classList.remove('is-loading'); });
    buy.addEventListener('click', function () {
      var sel = sec.querySelector('.ob__tier input[type="radio"]:checked');
      if (!sel) return;
      var label = sel.closest('.ob__tier');
      var variantId = parseInt(label.getAttribute('data-variant'), 10);
      if (!variantId) return;
      var baseQty = parseInt(label.getAttribute('data-base-qty'), 10) || 1;
      var freeQty = parseInt(label.getAttribute('data-free-qty'), 10) || 0;
      var planRaw = (label.getAttribute('data-plan') || '').trim();
      var plan = planRaw ? parseInt(planRaw, 10) : null;
      var code = (label.getAttribute('data-code') || '').trim();

      var items = [];
      var baseItem = { id: variantId, quantity: baseQty };
      if (plan) { baseItem.selling_plan = plan; }
      items.push(baseItem);
      if (freeQty > 0) { items.push({ id: variantId, quantity: freeQty }); }

      buy.disabled = true; buy.classList.add('is-loading');

      var checkoutUrl = code ? ('/discount/' + encodeURIComponent(code) + '?redirect=/checkout') : '/checkout';

      fetch('/cart/clear.js', { method: 'POST', headers: { 'Content-Type': 'application/json' } })
        .then(function () {
          return fetch('/cart/add.js', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ items: items })
          });
        })
        .then(function (r) { if (!r.ok) throw new Error('add failed'); window.location.href = checkoutUrl; })
        .catch(function () { window.location.href = checkoutUrl; });
    });
  }

  if ('IntersectionObserver' in window) {
    var io = new IntersectionObserver(function (entries) {
      var vis = entries[0].isIntersecting;
      document.body.classList.toggle('ob-offer-visible', vis);
      document.querySelectorAll('.sticky-cta-v2-section').forEach(function (el) {
        if (vis) { el.style.setProperty('display', 'none', 'important'); }
        else { el.style.removeProperty('display'); }
      });
    }, { threshold: 0 });
    io.observe(sec);
  }
})();
</script>

