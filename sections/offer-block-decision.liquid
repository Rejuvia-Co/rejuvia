{%- comment -%}
  Offer Block V3 — One Decision (BOGO3 template).
  Redesigned buy-box from the "BOGO Buy-Box Explorations" handoff, variant 3c:
  the aligned tier grid inverted into a dark plum panel; the recommended row is
  the only light surface, and a live receipt sits above the gold CTA.
  Desktop: sticky left column (gallery + FB review); right column scrolls.
  Shares the sticky-CTA contract with offer-block via body.ob-offer-visible.
{%- endcomment -%}

{% style %}
html { scroll-behavior: smooth; }
body.ob-offer-visible .sticky-cta-v2-section,
body.ob-offer-visible #shopify-section-sticky-cta-v2 { display: none !important; }
/* Desktop sticky gallery: the theme's .content-wrapper has overflow:hidden,
   which breaks position:sticky. Switch ancestors to clip + visible. */
@media (min-width: 901px) {
  main:has(.obd-{{ section.id }}), .content-wrapper:has(.obd-{{ section.id }}) { overflow-x: clip; overflow-y: visible; }
  #shopify-section-{{ section.id }} { overflow-x: clip; overflow-y: visible; }
}

.obd-{{ section.id }} {
  background-color: {{ section.settings.section_bg | default: '#ffffff' }};
  font-family: 'Helvetica Neue', Arimo, Helvetica, Arial, sans-serif;
}
/* Neutralize theme-wide text styling, then re-apply per element via vars. */
.obd-{{ section.id }}, .obd-{{ section.id }} *, .obd-{{ section.id }} *::before, .obd-{{ section.id }} *::after {
  text-transform: var(--tt, none) !important;
  letter-spacing: var(--ls, normal) !important;
  word-spacing: normal !important;
  box-sizing: border-box;
}

.obd__wrap { max-width: 1120px; margin: 0 auto; padding: 36px; display: grid; grid-template-columns: 430px minmax(0, 1fr); grid-template-areas: "gallery header" "gallery buybox"; column-gap: 44px; row-gap: 0; align-items: start; }
.obd__header { grid-area: header; min-width: 0; }
.obd__gallery { grid-area: gallery; min-width: 0; align-self: stretch; }
.obd__buybox { grid-area: buybox; min-width: 0; }
.obd__left-inner { position: sticky; top: {{ section.settings.sticky_offset | default: 16 }}px; display: flex; flex-direction: column; gap: 16px; }

/* ---- Header ---- */
.obd__eyebrow { --tt: uppercase; --ls: .5px; display: flex; align-items: center; gap: 8px; font-size: 11.5px; font-weight: 700; color: #4a4550; }
.obd__stars { display: inline-flex; gap: 1.5px; flex-shrink: 0; }
.obd__stars svg { width: 14px; height: 14px; display: block; }
.obd__eyebrow strong { color: #672666; font-weight: 800; }
.obd__eyebrow p { margin: 0; display: inline; }
.obd__title { --ls: -1.5px; font-size: 44px; line-height: 1.02; font-weight: 800; color: #171512; margin: 10px 0 0; }
.obd__subtitle { font-size: 16.5px; line-height: 1.35; color: #4a4550; margin: 10px 0 0; }

/* ---- Gallery ---- */
.obd__main { position: relative; background: {{ section.settings.gallery_bg | default: '#ffffff' }}; border-radius: 16px; display: flex; align-items: center; justify-content: center; overflow: hidden; }
.obd__main img[data-obd-main] { max-width: 100%; max-height: 440px; width: auto; height: auto; display: block; }
.obd__inc { position: absolute; left: 14px; top: 14px; width: 62px; height: 62px; object-fit: contain; pointer-events: none; }
.obd__thumbrow { display: flex; align-items: center; justify-content: center; gap: 8px; margin-top: 12px; }
.obd__arrow { flex: none; width: 30px; height: 30px; border: 1px solid #e3ddea; border-radius: 50%; background: #fff; color: #672666; display: flex; align-items: center; justify-content: center; cursor: pointer; padding: 0; transition: background .14s ease; }
.obd__arrow:hover { background: #f6eef6; }
.obd__arrow svg { width: 14px; height: 14px; display: block; }
.obd__thumbs { display: flex; gap: 8px; overflow-x: auto; scrollbar-width: none; -ms-overflow-style: none; max-width: 100%; }
.obd__thumbs::-webkit-scrollbar { display: none; }
.obd__thumb { flex: none; width: 48px; height: 48px; border: 1px solid #e9e4f0; border-radius: 10px; background: #f3f0f9; display: flex; align-items: center; justify-content: center; overflow: hidden; cursor: pointer; padding: 0; }
.obd__thumb img { width: 84%; height: 84%; object-fit: contain; display: block; }
.obd__thumb.is-active { border: 1.5px solid #672666; background: #fff; }
.obd__dots { display: flex; gap: 5px; justify-content: center; margin-top: 10px; }
.obd__dot { width: 6px; height: 6px; border-radius: 50%; background: #ddd7e6; transition: background .14s ease; }
.obd__dot.is-active { background: #672666; }

/* ---- Dark panel ---- */
.obd__panel { background: #4c1c4f; border-radius: 20px; padding: 20px; margin-top: 18px; }

/* ---- Tier grid (dark) ---- */
.obd__tiers { display: flex; flex-direction: column; gap: 18px; }
.obd__tier { position: relative; display: block; background: rgba(255,255,255,.07); border: 1.5px solid rgba(255,255,255,.16); border-radius: 12px; color: #f3e9f3; cursor: pointer; transition: background .18s cubic-bezier(.22,1,.36,1), border-color .18s cubic-bezier(.22,1,.36,1), box-shadow .18s cubic-bezier(.22,1,.36,1), color .18s cubic-bezier(.22,1,.36,1); }
.obd__tier.is-selected { background: #fff; border-color: #fab851; box-shadow: inset 0 0 0 .5px #fab851; color: #171512; }
.obd__tier input { position: absolute; opacity: 0; pointer-events: none; }
.obd__row { display: flex; align-items: center; gap: 14px; padding: 17px 18px; }
.obd__radio { flex: none; width: 20px; height: 20px; border: 2px solid rgba(255,255,255,.45); border-radius: 50%; display: flex; align-items: center; justify-content: center; transition: border-color .18s ease; }
.obd__tier.is-selected .obd__radio { border-color: #672666; }
.obd__radio::after { content: ''; width: 10px; height: 10px; border-radius: 50%; background: #672666; opacity: 0; transition: opacity .18s ease; }
.obd__tier.is-selected .obd__radio::after { opacity: 1; }
.obd__picto { display: flex; gap: 4px; align-items: center; width: 84px; flex: none; }
.obd__bottle { width: 10px; height: 28px; border-radius: 3px; background: #a86bae; border-top: 6px solid #fab851; transition: background .18s ease; }
.obd__bottle--free { background: transparent; border: 1.5px solid #00b10d; transition: background .18s ease; }
.obd__tier.is-selected .obd__bottle { background: #672666; }
.obd__tier.is-selected .obd__bottle--free { background: #eefaf0; }
.obd__tinfo { flex: 1; min-width: 0; text-align: left; }
.obd__tname { display: block; font-size: {{ section.settings.tier_title_size | default: 19 }}px; font-weight: 800; line-height: 1.25; white-space: nowrap; }
.obd__tsub { font-size: 15px; line-height: 1.35; color: rgba(243,233,243,.62); margin-top: 6px; white-space: nowrap; transition: color .18s ease; }
.obd__tier.is-selected .obd__tsub { color: #6b6660; }
.obd__tsub--m { display: none; }
.obd__pcol { width: 120px; flex: none; text-align: right; }
.obd__prices { display: flex; align-items: baseline; gap: 7px; justify-content: flex-end; }
.obd__price { font-size: 21px; font-weight: 800; }
.obd__tier--featured.is-selected .obd__price { color: #672666; }
.obd__struck { font-size: 15px; color: rgba(243,233,243,.45); text-decoration: line-through; transition: color .18s ease; }
.obd__tier.is-selected .obd__struck { color: #a9a3b2; }
.obd__save { font-size: 12.5px; font-weight: 800; color: #5ddc6d; margin-top: 6px; transition: color .18s ease; }
.obd__tier.is-selected .obd__save { color: #018e1c; }
.obd__save--pill { display: inline-block; background: #00b10d; color: #fff; padding: 3px 9px; border-radius: 100px; }
.obd__tier.is-selected .obd__save--pill { color: #fff; }
.obd__tag { --ls: .9px; position: absolute; top: -10px; right: 16px; font-size: 9.5px; font-weight: 800; padding: 3px 10px; border-radius: 100px; white-space: nowrap; z-index: 1; }
.obd__tag--goldfill { background: #fab851; color: #46184a; }
.obd__tag--goldoutline { background: #723e4f; color: #EAC78B; border: 1px solid rgba(250,184,81,.6); }

/* ---- Receipt ---- */
.obd__receipt { text-align: left; background: rgba(255,255,255,.08); border-radius: 12px; padding: 13px 15px; margin-top: 16px; color: #f3e9f3; font-size: 14px; display: flex; flex-direction: column; gap: 6px; }
.obd__receipt b { font-weight: 800; }
.obd__rcheck { color: #EAC78B; font-weight: 800; }
.obd__receipt p { margin: 0; display: inline; }
.obd__receipt strong { font-weight: 800; }

/* ---- CTA (inside panel) ---- */
.obd__buy { --ls: 1.2px; width: 100%; display: flex; align-items: center; justify-content: center; gap: 10px; background: #fab851; color: #46184a; border: none; border-radius: 100px; height: 58px; font-family: inherit; font-size: 16px; font-weight: 800; cursor: pointer; margin-top: 14px; transition: background .14s ease, transform .14s ease; }
.obd__buy:hover { background: #f5aa38; transform: translateY(-1px); }
.obd__buy:active { transform: translateY(1px); }
.obd__buy:disabled { cursor: default; }
.obd__spinner { display: none; width: 22px; height: 22px; border: 2.5px solid rgba(70,24,74,.3); border-top-color: #46184a; border-radius: 50%; animation: obd-spin .6s linear infinite; }
.obd__buy.is-loading .obd__buy-label { display: none; }
.obd__buy.is-loading .obd__spinner { display: block; }
@keyframes obd-spin { to { transform: rotate(360deg); } }
.obd__trust--panel { --tt: uppercase; --ls: .6px; display: flex; gap: 18px; justify-content: center; flex-wrap: wrap; margin-top: 14px; font-size: 11px; font-weight: 700; color: rgba(243,233,243,.8); }
.obd__trust--mobile { display: none; }
.obd__payments { display: flex; gap: 5px; justify-content: center; flex-wrap: wrap; margin-top: 11px; }
.obd__payments svg { height: 24px; width: auto; display: block; }
.obd__fb { display: block; width: 100%; height: auto; }
.obd__fb--mobile { display: none; }

/* ---- Accordion ---- */
.obd__tabs { margin-top: 26px; border-top: 1px solid #e6e2ec; }
.obd__tab { border-bottom: 1px solid #e6e2ec; }
.obd__tab-q { --ls: -.2px; width: 100%; display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 18px 4px; background: none; border: none; cursor: pointer; text-align: left; font-family: inherit; font-size: {{ section.settings.tab_title_size | default: 20 }}px; font-weight: 800; color: #171512; line-height: 1.3; }
.obd__tab-q > span { flex: 1 1 auto; min-width: 0; overflow-wrap: anywhere; }
.obd__chev { flex: none; width: 15px; height: 15px; color: #672666; transition: transform 260ms cubic-bezier(.22,1,.36,1); }
.obd__tab.is-open .obd__chev { transform: rotate(180deg); }
.obd__tab-a { display: grid; grid-template-rows: 0fr; transition: grid-template-rows 260ms cubic-bezier(.22,1,.36,1); }
.obd__tab.is-open .obd__tab-a { grid-template-rows: 1fr; }
.obd__tab-a-inner { overflow: hidden; }
.obd__tab-body { text-align: left; font-size: {{ section.settings.tab_body_size | default: 17 }}px; line-height: 1.55; color: #4a4550; padding: 0 4px 18px; max-width: 60ch; }
.obd__tab-body p { margin: 0 0 10px; }
.obd__tab-body p:last-child { margin-bottom: 0; }
.obd__tab-body strong { color: #171512; font-weight: 800; }


/* ---- Mobile ---- */
@media (max-width: 900px) {
  .obd-{{ section.id }} { overflow-x: clip; }
  .obd__wrap { display: flex; flex-direction: column; padding: 18px 16px; gap: 0; }
  .obd__header { text-align: center; }
  .obd__eyebrow { justify-content: center; }
  .obd__eyebrow .obd__stars svg { width: 12px; height: 12px; }
  .obd__eyebrow { font-size: 10.5px; --ls: .4px; }
  .obd__title { font-size: 31px; line-height: 1.05; --ls: -1.1px; margin-top: 7px; }
  .obd__subtitle { font-size: 14px; margin-top: 7px; }
  .obd__gallery { margin-top: 16px; }
  .obd__main img[data-obd-main] { max-height: 320px; }
  .obd__left-inner { position: static; gap: 0; }
  .obd__fb--desktop { display: none; }
  .obd__fb--mobile { display: block; margin-top: 16px; }
  .obd__buybox { margin-top: 0; }
  .obd__panel { border-radius: 18px; padding: 16px 14px; margin-top: 16px; }
  .obd__tiers { gap: 16px; }
  .obd__row { gap: 10px; padding: 14px 12px; }
  .obd__picto { gap: 2px; width: 52px; }
  .obd__bottle { width: 7px; height: 24px; border-radius: 2px; border-top-width: 5px; }
  .obd__bottle--free { border: 1.5px solid #00b10d; }
  .obd__tname { font-size: {{ section.settings.tier_title_size_mobile | default: 17 }}px; }
  .obd__tsub { font-size: 12.5px; }
  .obd__tsub--d { display: none; }
  .obd__tsub--m { display: block; }
  .obd__pcol { width: 72px; }
  .obd__prices { gap: 5px; }
  .obd__price { font-size: 18px; }
  .obd__struck { font-size: 13px; }
  .obd__save { font-size: 11.5px; margin-top: 4px; }
  .obd__save--pill { padding: 2px 7px; }
  .obd__tag { right: 12px; font-size: 9px; --ls: .8px; padding: 3px 9px; }
  .obd__receipt { padding: 12px 14px; margin: 14px 0 0; font-size: 13px; gap: 6px; }
  .obd__ys { display: none; }
  .obd__buy { height: 54px; font-size: 15px; --ls: 1.1px; margin: 12px 0 0; width: 100%; }
  .obd__trust--panel { display: none; }
  .obd__trust--mobile { --tt: uppercase; --ls: .5px; display: flex; flex-direction: column; align-items: center; gap: 6px; margin-top: 16px; font-size: 11.5px; font-weight: 700; color: #4a4550; }
  .obd__trust--mobile .obd__check { color: #672666; }
  .obd__payments { gap: 4px; margin-top: 10px; }
  .obd__payments svg { height: 22px; }
  .obd__tabs { margin-top: 18px; }
  .obd__tab-q { font-size: {{ section.settings.tab_title_size_mobile | default: 19 }}px; }
  .obd__tab-body { font-size: {{ section.settings.tab_body_size_mobile | default: 16 }}px; }
}
{% endstyle %}

{%- capture obd_star -%}<svg viewBox="0 0 18 16" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M3.85124 15.9392C3.43952 16.1504 2.97233 15.7803 3.05553 15.3078L3.94083 10.2626L0.183091 6.68298C-0.167831 6.34806 0.0145632 5.73581 0.484948 5.66968L5.70931 4.9273L8.03883 0.31199C8.24895 -0.103997 8.81747 -0.103997 9.0276 0.31199L11.3571 4.9273L16.5815 5.66968C17.0519 5.73581 17.2343 6.34806 16.8823 6.68298L13.1256 10.2626L14.0109 15.3078C14.0941 15.7803 13.6269 16.1504 13.2152 15.9392L8.53161 13.5329L3.85124 15.9392Z" fill="{{ section.settings.stars_color | default: '#fab851' }}"/></svg>{%- endcapture -%}
{%- capture obd_chevron -%}<svg class="obd__chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>{%- endcapture -%}

{%- assign gallery_product = section.settings.product -%}
{%- assign ship_ts = 'now' | date: '%s' | plus: 86400 -%}
{%- assign ship_date = ship_ts | date: '%a, %b %-d' -%}

{%- capture obd_fb_src -%}{%- if section.settings.fb_image != blank -%}{{ section.settings.fb_image | image_url: width: 1200 }}{%- elsif section.settings.fb_asset != blank -%}{{ section.settings.fb_asset | asset_url }}{%- endif -%}{%- endcapture -%}
{%- capture obd_inc_src -%}{%- if section.settings.badge_image != blank -%}{{ section.settings.badge_image | image_url: width: 200 }}{%- elsif section.settings.badge_asset != blank -%}{{ section.settings.badge_asset | asset_url }}{%- endif -%}{%- endcapture -%}

<section class="obd obd-{{ section.id }}" id="obd-{{ section.id }}">
  <span id="offer" aria-hidden="true" style="display:block;scroll-margin-top:80px;"></span>
  <div class="obd__wrap">

    <div class="obd__header">
      <div class="obd__eyebrow">
        <span class="obd__stars" aria-label="5 stars">{{ obd_star }}{{ obd_star }}{{ obd_star }}{{ obd_star }}{{ obd_star }}</span>
        {%- if section.settings.rating_text != blank -%}<span class="obd__eyebrow-text">{{ section.settings.rating_text }}</span>{%- endif -%}
      </div>
      {%- if section.settings.title != blank -%}<h2 class="obd__title">{{ section.settings.title }}</h2>{%- endif -%}
      {%- if section.settings.subtitle != blank -%}<p class="obd__subtitle">{{ section.settings.subtitle }}</p>{%- endif -%}
    </div>

    <div class="obd__gallery">
      {%- assign main_image = gallery_product.featured_image | default: gallery_product.images.first -%}
      <div class="obd__left-inner">
        <div class="obd__gallery-block">
          <div class="obd__main">
            {%- if main_image != blank -%}<img data-obd-main src="{{ main_image | image_url: width: 1000 }}" alt="{{ gallery_product.title | default: section.settings.title | escape }}" loading="eager">{%- endif -%}
            {%- if obd_inc_src != blank -%}<img class="obd__inc" data-obd-inc src="{{ obd_inc_src }}" alt="Inc. 5000 — America's fastest-growing private companies" loading="lazy">{%- endif -%}
          </div>
          {%- if gallery_product != blank and gallery_product.images.size > 1 -%}
            <div class="obd__thumbrow">
              <button type="button" class="obd__arrow" data-obd-prev aria-label="Previous image"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg></button>
              <div class="obd__thumbs">
                {%- for img in gallery_product.images -%}
                  <button type="button" class="obd__thumb{% if img == main_image %} is-active{% endif %}" data-obd-thumb data-full="{{ img | image_url: width: 1000 }}" aria-label="View image {{ forloop.index }}"><img src="{{ img | image_url: width: 200 }}" alt="" loading="lazy"></button>
                {%- endfor -%}
              </div>
              <button type="button" class="obd__arrow" data-obd-next aria-label="Next image"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6"/></svg></button>
            </div>
            <div class="obd__dots" aria-hidden="true">
              {%- for img in gallery_product.images -%}<span class="obd__dot{% if img == main_image %} is-active{% endif %}" data-obd-dot></span>{%- endfor -%}
            </div>
          {%- endif -%}
        </div>
        {%- if section.settings.show_fb and obd_fb_src != blank -%}
          <img class="obd__fb obd__fb--desktop" src="{{ obd_fb_src }}" alt="Customer review of Rejuvia Sleep Spray" loading="lazy">
        {%- endif -%}
      </div>
    </div>

    <div class="obd__buybox">
      <div class="obd__panel">
        <div class="obd__tiers" role="radiogroup" aria-label="Choose your bundle">
          {%- assign tier_n = 0 -%}
          {%- for b in section.blocks -%}{%- if b.type == 'tier' -%}
            {%- assign tier_n = tier_n | plus: 1 -%}
            {%- assign tier_sel = false -%}
            {%- if tier_n == section.settings.default_tier -%}{%- assign tier_sel = true -%}{%- endif -%}
            {%- assign vid = b.settings.variant_id | strip -%}
            {%- assign tier_variant = blank -%}
            {%- if vid != blank -%}
              {%- assign srcprod = b.settings.product | default: gallery_product -%}
              {%- if srcprod != blank -%}
                {%- for v in srcprod.variants -%}
                  {%- assign vstr = v.id | append: '' -%}
                  {%- if vstr == vid -%}{%- assign tier_variant = v -%}{%- break -%}{%- endif -%}
                {%- endfor -%}
              {%- endif -%}
            {%- endif -%}
            {%- if vid == blank and b.settings.product != blank -%}{%- assign vid = b.settings.product.selected_or_first_available_variant.id -%}{%- endif -%}
            {%- capture tier_price -%}{%- if tier_variant != blank -%}{{ tier_variant.price | money_without_trailing_zeros }}{%- else -%}{{ b.settings.price }}{%- endif -%}{%- endcapture -%}
            {%- capture tier_compare -%}{%- if tier_variant != blank -%}{%- if tier_variant.compare_at_price and tier_variant.compare_at_price > tier_variant.price -%}{{ tier_variant.compare_at_price | money_without_trailing_zeros }}{%- endif -%}{%- else -%}{{ b.settings.compare_price }}{%- endif -%}{%- endcapture -%}
            {%- assign paid_n = b.settings.paid_bottles | default: 1 -%}
            {%- assign free_n = b.settings.free_bottles | default: 1 -%}
            {%- assign total_n = paid_n | plus: free_n -%}
            <label class="obd__tier{% if b.settings.featured %} obd__tier--featured{% endif %}{% if tier_sel %} is-selected{% endif %}" {{ b.shopify_attributes }}>
              <input type="radio" name="obd-{{ section.id }}" value="{{ vid }}" data-price="{{ tier_price | strip }}" data-bottles="{{ total_n }}" data-save="{{ b.settings.save_amount | default: '' }}" data-freeship="{% if b.settings.free_shipping %}1{% else %}0{% endif %}" {% if tier_sel %}checked{% endif %}>
              {%- if b.settings.tag != blank -%}
                <span class="obd__tag obd__tag--{{ b.settings.tag_style | default: 'goldfill' }}">{{ b.settings.tag }}</span>
              {%- endif -%}
              <span class="obd__row">
                <span class="obd__radio" aria-hidden="true"></span>
                <span class="obd__picto" aria-hidden="true">
                  {%- for i in (1..paid_n) -%}<span class="obd__bottle"></span>{%- endfor -%}
                  {%- if free_n > 0 -%}{%- for i in (1..free_n) -%}<span class="obd__bottle obd__bottle--free"></span>{%- endfor -%}{%- endif -%}
                </span>
                <span class="obd__tinfo">
                  <span class="obd__tname">{{ b.settings.label }}</span>
                  <span class="obd__tsub obd__tsub--d">{{ total_n }} bottles &middot; {{ free_n }} free &middot; {% if b.settings.free_shipping %}Free shipping{% else %}Standard shipping{% endif %}</span>
                  <span class="obd__tsub obd__tsub--m">{{ total_n }} bottles &middot; {{ free_n }} free</span>
                </span>
                <span class="obd__pcol">
                  <span class="obd__prices">
                    <span class="obd__price">{{ tier_price }}</span>
                    {%- if tier_compare != blank -%}<span class="obd__struck">{{ tier_compare }}</span>{%- endif -%}
                  </span>
                  {%- if b.settings.savings_text != blank -%}<span class="obd__save{% if b.settings.featured %} obd__save--pill{% endif %}">{{ b.settings.savings_text }}</span>{%- endif -%}
                </span>
              </span>
            </label>
          {%- endif -%}{%- endfor -%}
        </div>

        <div class="obd__receipt">
          <span><span class="obd__rcheck">&#10003;</span> You get <b data-obd-bottles>4</b> bottles &mdash; <span class="obd__ys">you </span>save <b data-obd-save>$60</b></span>
          <span data-obd-shipline><span class="obd__rcheck">&#10003;</span> Free US shipping &mdash; ships by <b>{{ ship_date }}</b></span>
        </div>

        <button type="button" class="obd__buy" data-obd-buy>
          <span class="obd__spinner" aria-hidden="true"></span>
          <span class="obd__buy-label" data-obd-cta-label>{{ section.settings.button_prefix | default: 'BUY NOW —' }}</span>
        </button>

        <div class="obd__trust--panel">
          {%- if section.settings.guarantee_text != blank -%}<span>&#10003; {{ section.settings.guarantee_text }}</span>{%- endif -%}
          {%- if section.settings.onetime_text != blank -%}<span>&#10003; {{ section.settings.onetime_text }}</span>{%- endif -%}
        </div>

        {%- if section.settings.show_payment_icons -%}
          {%- assign hidden_pay = section.settings.hidden_payments | default: '' | downcase | replace: ' ', '' | split: ',' -%}
          <div class="obd__payments">
            {%- for type in shop.enabled_payment_types -%}{%- unless hidden_pay contains type -%}{{ type | payment_type_svg_tag: class: 'payment-icon' }}{%- endunless -%}{%- endfor -%}
          </div>
        {%- endif -%}
      </div>

      <div class="obd__trust--mobile">
        {%- if section.settings.guarantee_text != blank -%}<span><span class="obd__check">&#10003;</span> {{ section.settings.guarantee_text }}</span>{%- endif -%}
        {%- if section.settings.onetime_text != blank -%}<span><span class="obd__check">&#10003;</span> {{ section.settings.onetime_text }}</span>{%- endif -%}
      </div>

      {%- if section.settings.show_fb and obd_fb_src != blank -%}
        <img class="obd__fb obd__fb--mobile" src="{{ obd_fb_src }}" alt="Customer review of Rejuvia Sleep Spray" loading="lazy">
      {%- endif -%}

      {%- assign has_tabs = false -%}
      {%- for b in section.blocks -%}{%- if b.type == 'tab' and b.settings.title != blank -%}{%- assign has_tabs = true -%}{%- endif -%}{%- endfor -%}
      {%- if has_tabs -%}
        <div class="obd__tabs">
          {%- assign tab_n = 0 -%}
          {%- for b in section.blocks -%}{%- if b.type == 'tab' -%}
            {%- assign tab_n = tab_n | plus: 1 -%}
            <div class="obd__tab{% if tab_n == 1 %} is-open{% endif %}" {{ b.shopify_attributes }}>
              <button type="button" class="obd__tab-q" aria-expanded="{% if tab_n == 1 %}true{% else %}false{% endif %}"><span>{{ b.settings.title }}</span>{{ obd_chevron }}</button>
              <div class="obd__tab-a"><div class="obd__tab-a-inner"><div class="obd__tab-body">{{ b.settings.content }}{%- assign tab_t = b.settings.title | downcase -%}{%- if tab_t contains 'ingredient' -%}{% render 'supplement-label-button', product: section.settings.product %}{%- endif -%}</div></div></div>
            </div>
          {%- endif -%}{%- endfor -%}
        </div>
      {%- endif -%}

      {%- if section.settings.show_trusted -%}
        {% render 'trusted-by',
          title: section.settings.trusted_title,
          subtext: section.settings.trusted_subtext,
          image_1: section.settings.trusted_image_1,
          image_2: section.settings.trusted_image_2,
          image_3: section.settings.trusted_image_3,
          bg_color: section.settings.trusted_bg,
          check_color: section.settings.trusted_check %}
      {%- endif -%}
    </div>
  </div>
  {% render 'supplement-label-popup', product: section.settings.product %}
</section>

<script>
(function () {
  var sec = document.getElementById('obd-{{ section.id }}');
  if (!sec) return;

  /* Tier selection + live CTA price + live receipt */
  var ctaLabel = sec.querySelector('[data-obd-cta-label]');
  var ctaPrefix = {{ section.settings.button_prefix | default: 'BUY NOW —' | json }};
  var rBottles = sec.querySelector('[data-obd-bottles]');
  var rSave = sec.querySelector('[data-obd-save]');
  var rShip = sec.querySelector('[data-obd-shipline]');
  var shipDate = {{ ship_date | json }};
  function syncSelection() {
    var sel = sec.querySelector('.obd__tier input[type="radio"]:checked');
    if (!sel) return;
    if (ctaLabel && sel.getAttribute('data-price')) ctaLabel.textContent = ctaPrefix + ' ' + sel.getAttribute('data-price');
    if (rBottles && sel.getAttribute('data-bottles')) rBottles.textContent = sel.getAttribute('data-bottles');
    if (rSave && sel.getAttribute('data-save')) rSave.textContent = sel.getAttribute('data-save');
    if (rShip) {
      var free = sel.getAttribute('data-freeship') === '1';
      rShip.innerHTML = '<span class="obd__rcheck">✓</span> ' + (free ? 'Free US shipping — ships by <b>' + shipDate + '</b>' : 'Ships by <b>' + shipDate + '</b>');
    }
  }
  sec.querySelectorAll('.obd__tier input[type="radio"]').forEach(function (input) {
    input.addEventListener('change', function () {
      sec.querySelectorAll('.obd__tier').forEach(function (t) { t.classList.remove('is-selected'); });
      input.closest('.obd__tier').classList.add('is-selected');
      syncSelection();
    });
  });
  if (!sec.querySelector('.obd__tier input[type="radio"]:checked')) {
    var firstInput = sec.querySelector('.obd__tier input[type="radio"]');
    if (firstInput) { firstInput.checked = true; firstInput.closest('.obd__tier').classList.add('is-selected'); }
  }
  syncSelection();

  /* Gallery */
  var mainImg = sec.querySelector('[data-obd-main]');
  var incBadge = sec.querySelector('[data-obd-inc]');
  var thumbs = [].slice.call(sec.querySelectorAll('[data-obd-thumb]'));
  var dots = [].slice.call(sec.querySelectorAll('[data-obd-dot]'));
  var idx = 0;
  thumbs.forEach(function (t, i) { if (t.classList.contains('is-active')) idx = i; });
  function setImg(i) {
    if (!thumbs.length) return;
    idx = (i + thumbs.length) % thumbs.length;
    var t = thumbs[idx];
    if (mainImg) mainImg.src = t.getAttribute('data-full');
    thumbs.forEach(function (x) { x.classList.remove('is-active'); });
    t.classList.add('is-active');
    dots.forEach(function (d, j) { d.classList.toggle('is-active', j === idx); });
    if (incBadge) incBadge.style.display = idx === 0 ? '' : 'none';
    if (t.scrollIntoView) t.scrollIntoView({ block: 'nearest', inline: 'nearest' });
  }
  thumbs.forEach(function (t, i) { t.addEventListener('click', function () { setImg(i); }); });
  var prev = sec.querySelector('[data-obd-prev]'), next = sec.querySelector('[data-obd-next]');
  if (prev) prev.addEventListener('click', function () { setImg(idx - 1); });
  if (next) next.addEventListener('click', function () { setImg(idx + 1); });

  /* Mobile: horizontal-dominant swipe on the main image */
  var galMain = sec.querySelector('.obd__main');
  if (galMain && thumbs.length > 1) {
    var gsx = null, gsy = null;
    galMain.addEventListener('touchstart', function (e) { var t = e.touches[0]; gsx = t.clientX; gsy = t.clientY; }, { passive: true });
    galMain.addEventListener('touchend', function (e) {
      if (gsx === null) return;
      var t = e.changedTouches[0], dx = t.clientX - gsx, dy = t.clientY - gsy;
      if (Math.abs(dx) > 40 && Math.abs(dx) > Math.abs(dy)) { setImg(dx < 0 ? idx + 1 : idx - 1); }
      gsx = null; gsy = null;
    }, { passive: true });
  }

  /* Accordion — one open at a time */
  var tabs = sec.querySelectorAll('.obd__tab');
  sec.querySelectorAll('.obd__tab-q').forEach(function (btn) {
    btn.addEventListener('click', function () {
      var tab = btn.closest('.obd__tab');
      var willOpen = !tab.classList.contains('is-open');
      tabs.forEach(function (t) { t.classList.remove('is-open'); var b = t.querySelector('.obd__tab-q'); if (b) b.setAttribute('aria-expanded', 'false'); });
      if (willOpen) { tab.classList.add('is-open'); btn.setAttribute('aria-expanded', 'true'); }
    });
  });

  /* Buy Now -> add selected variant, go to checkout */
  var buy = sec.querySelector('[data-obd-buy]');
  if (buy) {
    window.addEventListener('pageshow', function () { buy.disabled = false; buy.classList.remove('is-loading'); });
    buy.addEventListener('click', function () {
      var sel = sec.querySelector('.obd__tier input[type="radio"]:checked');
      if (!sel || !sel.value) return;
      var id = parseInt(sel.value, 10);
      buy.disabled = true; buy.classList.add('is-loading');
      fetch('/cart/clear.js', { method: 'POST', headers: { 'Content-Type': 'application/json' } })
        .then(function () { return fetch('/cart/add.js', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ items: [{ id: id, quantity: {{ section.settings.add_quantity | default: 2 }} }] }) }); })
        .then(function (r) { if (!r.ok) throw new Error('add failed'); window.location.href = '/checkout'; })
        .catch(function () { window.location.href = '/cart/' + id + ':{{ section.settings.add_quantity | default: 2 }}'; });
    });
  }

  /* Hide the sticky CTA bar while this section is in view */
  if ('IntersectionObserver' in window) {
    var io = new IntersectionObserver(function (entries) {
      var vis = entries[0].isIntersecting;
      document.body.classList.toggle('ob-offer-visible', vis);
      document.querySelectorAll('.sticky-cta-v2-section').forEach(function (el) {
        if (vis) { el.style.setProperty('display', 'none', 'important'); }
        else { el.style.removeProperty('display'); }
      });
    }, { threshold: 0 });
    io.observe(sec);
  }
})();
</script>

