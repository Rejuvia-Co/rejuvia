      "settings": [
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "richtext", "id": "content", "label": "Content" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Offer Block PRODUCT",
      "category": "Rejuvia",
      "blocks": [
        { "type": "tier", "settings": { "label": "Buy 1, Get 1 FREE", "image_asset": "rejuvia-bundle-b1g1.webp", "price": "$30", "compare_price": "$60", "variant_id": "46763671027932" } },
        { "type": "tier", "settings": { "label": "Buy 2, Get 2 FREE", "image_asset": "rejuvia-bundle-b2g2.webp", "price": "$60", "compare_price": "$120", "variant_id": "46763671060700", "badge": "MOST POPULAR" } },
        { "type": "tier", "settings": { "label": "Buy 3, Get 3 FREE", "image_asset": "rejuvia-bundle-b3g3.webp", "price": "$90", "compare_price": "$180", "variant_id": "46763671093468" } }
      ]
    }
  ]
}
