{%- comment -%}
  Offer Block PRODUCT: the BOGO offer section from the "BOGO Redesign" mock (design 2a), on the page.bogo-product template.
  Gallery (new hero slide with Inc. 5000 tab + 2M+ pill, then the shared BOGO slides from bogo-gallery-files), and a product-page
  style buy box: top bar, proof, title + live price, scarcity card, tiers with perks, Buy Now, delivery dates, guarantee,
  payment icons, accordion, trusted-by pill.
  Reused from offer-block-sub: tier variant/price logic, the Buy 3 -> Get 4 free Calm Spray gift, Buy Now cart logic,
  accordion copy (tab blocks), supplement label popup, sticky gallery fix. The template's sticky bar reveals once .obp__buy scrolls past.
{%- endcomment -%}

{% style %}
html { scroll-behavior: smooth; }
@media (min-width: 901px) {
  main:has(.obp-{{ section.id }}), .content-wrapper:has(.obp-{{ section.id }}) { overflow-x: clip; overflow-y: visible; }
  #shopify-section-{{ section.id }} { overflow-x: clip; overflow-y: visible; }
}
.obp-{{ section.id }} { background: #fff; font-family: 'Helvetica Neue', Arimo, Helvetica, Arial, sans-serif; color: #111; }
.obp-{{ section.id }}, .obp-{{ section.id }} *, .obp-{{ section.id }} *::before, .obp-{{ section.id }} *::after {
  text-transform: var(--tt, none) !important; letter-spacing: var(--ls, normal) !important; box-sizing: border-box;
}
.obp-{{ section.id }} p, .obp-{{ section.id }} h1 { margin: 0; }
.obp-{{ section.id }} label { padding: 0; margin: 0; }
.obp-{{ section.id }} img { max-width: 100%; }

.obp__wrap { max-width: 1280px; margin: 0 auto; padding: 40px 48px; display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); gap: 56px; align-items: start; }
.obp__gal { position: sticky; top: 20px; min-width: 0; }

/* Gallery */
.obp__frame { position: relative; aspect-ratio: 1 / 1; border-radius: 16px; background: #f4f3f5; overflow: hidden; }
.obp__track { display: flex; width: 100%; height: 100%; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; overscroll-behavior-x: contain; }
.obp__track::-webkit-scrollbar { display: none; }
.obp__slide { position: relative; flex: 0 0 100%; height: 100%; scroll-snap-align: start; }
.obp__slide > img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; display: block; }
.obp__slide--hero > img { object-fit: contain; }
.obp__inc { position: absolute; top: 0; left: 0; background: #fff; padding: 10px 16px 10px 10px; border-radius: 0 0 16px 0; display: flex; align-items: center; gap: 10px; }
.obp__inc img { width: 56px; height: 56px; flex: none; }
.obp__inc-txt { display: flex; flex-direction: column; gap: 2px; }
.obp__inc-t { font-weight: 700; font-size: 17px; line-height: 1.2; color: #111; }
.obp__inc-s { font-size: 12px; color: #666; }
.obp__sold { position: absolute; left: 14px; bottom: 14px; background: #fff; border-radius: 100px; padding: 8px 14px 8px 10px; display: flex; align-items: center; gap: 7px; box-shadow: 0 4px 14px rgba(0,0,0,.08); font-size: 18px; line-height: 1.1; }
.obp__sold-star { color: #f5a623; font-size: 15px; }
.obp__sold strong { font-weight: 800; color: #111; }
.obp__sold span:last-child { font-weight: 500; color: #444; }
.obp__arrow { position: absolute; top: 50%; transform: translateY(-50%); width: 38px; height: 38px; border-radius: 50%; border: 0; padding: 0; background: rgba(255,255,255,.94); box-shadow: 0 2px 8px rgba(0,0,0,.12); display: flex; align-items: center; justify-content: center; cursor: pointer; z-index: 2; }
.obp__arrow--prev { left: 10px; }
.obp__arrow--next { right: 10px; }
.obp__thumbs { display: flex; gap: 8px; overflow-x: auto; margin-top: 10px; scrollbar-width: none; }
.obp__thumbs::-webkit-scrollbar { display: none; }
.obp__thumb { flex: none; width: 76px; height: 76px; border-radius: 10px; background: #f3eef5; border: 2px solid transparent; padding: 0; overflow: hidden; cursor: pointer; }
.obp__thumb.is-active { border-color: #672666; }
.obp__thumb img { width: 100%; height: 100%; object-fit: cover; display: block; }

/* Buy box */
.obp__box { display: flex; flex-direction: column; gap: 16px; min-width: 0; }
.obp__topbar { background: #f6f1f7; border-radius: 10px; padding: 10px 12px; text-align: center; font-size: 13px; color: #333; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.obp__proof { display: flex; flex-direction: column; gap: 8px; }
.obp__buyers { display: flex; align-items: center; gap: 8px; white-space: nowrap; }
.obp__av { display: flex; flex: none; }
.obp__av img { width: 28px; height: 28px; border-radius: 50%; object-fit: cover; border: 2px solid #fff; background: #eee; }
.obp__av img + img { margin-left: -9px; }
.obp__byline { display: flex; align-items: center; gap: 5px; font-size: 14px; color: #333; min-width: 0; }
.obp__byline strong { color: #111; }
.obp__byline svg { flex: none; }
.obp__rating { display: flex; align-items: center; gap: 8px; font-size: 15px; color: #333; }
.obp__rating-stars { --ls: 1px; color: #f5a623; font-size: 17px; }
.obp__rating strong { color: #111; }
.obp__titles { display: flex; flex-direction: column; gap: 10px; }
.obp__title { --ls: -.015em; font-size: 44px; line-height: 1.1; font-weight: 700; color: #111; text-wrap: balance; }
.obp__pricerow { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
.obp__was { font-size: 24px; color: #9a9a9a; text-decoration: line-through; }
.obp__price { font-size: 28px; font-weight: 700; color: #672666; }
.obp__best { --ls: .06em; background: #672666; color: #fff; font-size: 12px; font-weight: 700; padding: 6px 10px; border-radius: 6px; }
.obp__desc { font-size: 15px; line-height: 1.55; color: #555; text-wrap: pretty; }
.obp__scar { background: #fbf5fb; border: 1.5px solid #e4cfe6; border-radius: 12px; padding: 12px 14px; display: flex; flex-direction: column; gap: 8px; }
.obp__scar-row { display: flex; justify-content: space-between; align-items: center; gap: 10px; font-size: 13px; white-space: nowrap; }
.obp__scar-t { --ls: .08em; font-weight: 700; color: #672666; }
.obp__scar-e { color: #333; }
.obp__scar-e strong { font-variant-numeric: tabular-nums; color: #111; }
.obp__bar { height: 7px; border-radius: 7px; background: #eadcec; overflow: hidden; }
.obp__bar span { display: block; width: 89%; height: 100%; background: linear-gradient(90deg, #8a3a88, #672666); border-radius: 7px; }
.obp__scar-n { font-size: 12px; color: #555; }

.obp__tiers { display: flex; flex-direction: column; gap: 22px; margin-top: 8px; }
.obp__tier { position: relative; display: block; border: 1.5px solid #e2d8e4; background: #fff; border-radius: 12px; cursor: pointer; }
.obp__tier input { position: absolute; opacity: 0; pointer-events: none; }
.obp__tier.is-selected { border: 2px solid #672666; background: #fbf6fb; }
.obp__tier:has(input:focus-visible) { outline: 2px solid #672666; outline-offset: 3px; }
.obp__badge { --ls: .03em; position: absolute; top: -12px; right: 14px; background: #e4cfe6; color: #111; font-size: 12px; font-weight: 700; line-height: 1.2; padding: 4px 11px; border-radius: 100px; z-index: 1; }
.obp__badge--gift { background: #d81b60; color: #fff; }
.obp__row { display: flex; align-items: center; gap: 10px; padding: 12px 14px 12px 12px; }
.obp__radio { width: 20px; height: 20px; border-radius: 50%; border: 2px solid #cfc6d3; background: #fff; display: flex; align-items: center; justify-content: center; flex: none; }
.obp__radio::after { content: ''; width: 10px; height: 10px; border-radius: 50%; background: transparent; }
.obp__tier.is-selected .obp__radio { border-color: #672666; }
.obp__tier.is-selected .obp__radio::after { background: #672666; }
.obp__bundle { width: 64px; height: 60px; object-fit: contain; flex: none; }
.obp__tinfo { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 5px; }
.obp__tname { font-size: 17px; font-weight: 700; color: #672666; line-height: 1.15; }
.obp__tmeta { display: flex; align-items: center; gap: 6px; flex-wrap: wrap; }
.obp__per { background: #e7f6eb; color: #1b8a3a; font-size: 13px; font-weight: 700; padding: 3px 9px; border-radius: 100px; }
.obp__supply { font-size: 12px; color: #666; font-style: normal; font-weight: 400; }
.obp__tprice { display: flex; flex-direction: column; align-items: flex-end; justify-content: center; gap: 2px; flex: none; }
.obp__tprice span:first-child { font-size: 21px; font-weight: 700; color: #111; line-height: 1.1; }
.obp__tprice s { font-size: 13px; color: #9a9a9a; line-height: 1.1; }
.obp__perks { display: none; flex-direction: column; border-top: 1px dashed #e0bfd0; border-radius: 0 0 11px 11px; overflow: hidden; }
.obp__tier.is-selected .obp__perks { display: flex; }
.obp__perk { display: flex; align-items: center; gap: 10px; padding: 9px 14px; background: #f8f3f8; }
.obp__perk--gift { background: #fdeef3; }
.obp__perk-ic { width: 34px; height: 34px; border-radius: 8px; background: #fff; display: flex; align-items: center; justify-content: center; flex: none; overflow: hidden; }
.obp__perk-ic img, .obp__perk-ic svg { width: 30px; height: 30px; object-fit: contain; }
.obp__perk-ic svg { width: 22px; height: 22px; }
.obp__perk-txt { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 1px; }
.obp__perk-t { font-size: 14px; font-weight: 700; color: #111; }
.obp__perk-n { font-size: 12px; color: #555; }
.obp__perk-v { display: flex; flex-direction: column; align-items: flex-end; line-height: 1.15; }
.obp__perk-v s { font-size: 12px; color: #9a9a9a; }
.obp__perk-v strong { font-size: 14px; color: #111; }
.obp__perk--gift .obp__perk-t, .obp__perk--gift .obp__perk-v strong { color: #d81b60; }

.obp__cta { display: flex; flex-direction: column; gap: 12px; margin-top: 4px; }
.obp__buy { position: relative; width: 100%; min-height: 72px; border: 0; border-radius: 100px; background: #672666; color: #fff; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 3px; padding: 10px 20px; cursor: pointer; text-align: center; font-family: inherit; transition: background .15s; }
.obp__buy:hover { background: #561f55; }
.obp__buy-l { --ls: .03em; font-size: 20px; font-weight: 700; line-height: 1.2; }
.obp__buy-s { font-size: 11px; font-weight: 500; color: #eadcec; white-space: nowrap; }
.obp__buy.is-loading .obp__buy-l, .obp__buy.is-loading .obp__buy-s { visibility: hidden; }
.obp__spinner { display: none; position: absolute; top: 50%; left: 50%; width: 24px; height: 24px; margin: -12px 0 0 -12px; border: 3px solid rgba(255,255,255,.35); border-top-color: #fff; border-radius: 50%; animation: obp-spin .8s linear infinite; }
.obp__buy.is-loading .obp__spinner { display: block; }
@keyframes obp-spin { to { transform: rotate(360deg); } }
.obp__deliv { display: flex; align-items: center; justify-content: center; gap: 8px; font-size: 14px; color: #333; white-space: nowrap; }
.obp__deliv-dot { width: 8px; height: 8px; border-radius: 50%; background: #7ccf94; flex: none; }

.obp__guar { border: 1.5px solid #d9bfdc; border-radius: 12px; padding: 20px; display: flex; flex-direction: column; gap: 10px; margin-top: 6px; }
.obp__guar-h { display: flex; align-items: center; gap: 8px; }
.obp__guar-h img { width: 24px; height: 24px; flex: none; }
.obp__guar-t { font-size: 18px; font-weight: 700; line-height: 1.2; white-space: nowrap; }
.obp__guar p { font-size: 14px; line-height: 1.55; color: #555; }
.obp__pay { display: flex; justify-content: center; gap: 6px; flex-wrap: wrap; }
.obp__pay svg { width: 40px; height: 26px; }

.obp__acc { display: flex; flex-direction: column; border-top: 1px solid #e6e6e6; }
.obp__acc-i { border-bottom: 1px solid #e6e6e6; }
.obp__acc-q { width: 100%; display: flex; justify-content: space-between; align-items: center; gap: 12px; padding: 20px 4px; background: none; border: 0; cursor: pointer; text-align: left; font-family: inherit; font-size: 20px; font-weight: 700; color: #111; line-height: 1.25; }
.obp__acc-q svg { flex: none; transition: transform .25s cubic-bezier(.22,1,.36,1); }
.obp__acc-i.is-open .obp__acc-q svg { transform: rotate(180deg); }
.obp__acc-a { display: none; padding: 0 4px 20px; }
.obp__acc-i.is-open .obp__acc-a { display: block; }
.obp__acc-a, .obp__acc-a p, .obp__acc-a li { font-size: 15px; line-height: 1.6; color: #444; }
.obp__acc-a > * + * { margin-top: 10px; }

.obp__trust { background: {{ section.settings.trusted_bg | default: '#f4f4f4' }}; border-radius: 100px; padding: 16px 22px 16px 16px; display: flex; align-items: center; gap: 14px; }
.obp__trust-av { display: flex; position: relative; flex: none; }
.obp__trust-av img { width: 48px; height: 48px; border-radius: 50%; object-fit: cover; border: 3px solid #fff; }
.obp__trust-av img + img { margin-left: -14px; }
.obp__trust-ck { position: absolute; top: -4px; right: -6px; width: 20px; height: 20px; border-radius: 50%; background: #22a447; border: 2px solid #fff; display: flex; align-items: center; justify-content: center; }
.obp__trust-txt { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
.obp__trust-t { font-size: 16px; font-weight: 700; color: #111; }
.obp__trust-s { font-size: 13px; color: #333; line-height: 1.35; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; text-wrap: balance; }

@media (max-width: 900px) {
  .obp__wrap { display: flex; flex-direction: column; gap: 18px; padding: 12px 0 24px; }
  .obp__gal { position: static; width: 100%; padding: 0 12px; }
  .obp__box { width: 100%; padding: 0 18px; }
  .obp__inc { padding: 7px 8px 7px 7px; gap: 8px; border-radius: 0 0 12px 0; }
  .obp__inc img { width: 38px; height: 38px; }
  .obp__inc-txt { gap: 1px; }
  .obp__inc-t { font-size: 13px; line-height: 1.15; }
  .obp__inc-s { font-size: 11px; line-height: 1.2; }
  .obp__arrow { width: 27px; height: 27px; }
  .obp__arrow svg { width: 10px; height: 10px; }
  .obp__sold { font-size: 15px; }
  .obp__thumb { width: 60px; height: 60px; }
  .obp__title { font-size: 32px; }
}
{% endstyle %}

{%- assign sleep_img = images['sleep-spray.webp'] -%}
{%- if sleep_img == blank -%}{%- assign sleep_img = section.settings.product.featured_image -%}{%- endif -%}
{%- capture obp_gal_list -%}{%- render 'bogo-gallery-files' -%}{%- endcapture -%}
{%- comment -%} Skip the shared Inc. 5000 first slide: this page already opens with its own Inc. 5000 hero. {%- endcomment -%}
{%- assign obp_files = obp_gal_list | strip | remove: 'sleep_spray_bogo_hero_inc5000.webp|' | split: '|' -%}

{%- assign av1 = section.settings.trusted_image_1 | default: images['customer_1.png'] -%}
{%- assign av2 = section.settings.trusted_image_2 | default: images['customer_13.png'] -%}
{%- assign av3 = section.settings.trusted_image_3 | default: images['customer_12.png'] -%}

{%- capture obp_chev -%}<svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><path d="M3 6l5 5 5-5" stroke="#672666" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg>{%- endcapture -%}
{%- capture obp_truck -%}<svg viewBox="0 0 24 24" fill="none" stroke="#672666" stroke-width="1.8" stroke-linejoin="round" aria-hidden="true"><path d="M2 6h11v10H2zM13 9h4.5L21 12.5V16h-8z"/><circle cx="6" cy="17.5" r="1.8" fill="#fff"/><circle cx="17" cy="17.5" r="1.8" fill="#fff"/></svg>{%- endcapture -%}

<div class="obp obp-{{ section.id }}" id="obp-{{ section.id }}">
  <span id="offer" aria-hidden="true" style="display:block;scroll-margin-top:80px;"></span>
  <div class="obp__wrap">

    <div class="obp__gal">
      <div class="obp__frame">
        <div class="obp__track" data-obp-track>
          {%- if sleep_img != blank -%}
            <div class="obp__slide obp__slide--hero">
              <img src="{{ sleep_img | image_url: width: 1000, format: 'webp' }}"
                   srcset="{{ sleep_img | image_url: width: 500, format: 'webp' }} 500w, {{ sleep_img | image_url: width: 800, format: 'webp' }} 800w, {{ sleep_img | image_url: width: 1000, format: 'webp' }} 1000w"
                   sizes="(max-width: 900px) 100vw, 640px" width="1000" height="1000" alt="Rejuvia Sleep Spray" loading="eager" fetchpriority="high" decoding="async">
              <div class="obp__inc">
                <img src="{{ 'inc5000.png' | asset_url }}" alt="Inc. 5000" width="56" height="56">
                <div class="obp__inc-txt"><span class="obp__inc-t">America's Fastest-Growing<br>Sleep Spray</span><span class="obp__inc-s">Inc. 5000 · #228</span></div>
              </div>
              <div class="obp__sold"><span class="obp__sold-star">★</span><strong>2M+</strong><span>Sprays Sold</span></div>
            </div>
          {%- endif -%}
          {%- for gname in obp_files -%}{%- assign gimg = images[gname] -%}
            {%- if gname contains 'theme:' -%}
              {%- assign gasset = gname | remove: 'theme:' -%}
              <div class="obp__slide"><img src="{{ gasset | append: '-1400.webp' | asset_url }}" srcset="{{ gasset | append: '-800.webp' | asset_url }} 800w, {{ gasset | append: '-1400.webp' | asset_url }} 1400w" sizes="(max-width: 900px) 100vw, 640px" width="1400" height="1400" alt="" loading="lazy" decoding="async"></div>
            {%- elsif gimg != blank -%}
              <div class="obp__slide"><img src="{{ gimg | image_url: width: 1000, format: 'webp' }}" srcset="{{ gimg | image_url: width: 500, format: 'webp' }} 500w, {{ gimg | image_url: width: 800, format: 'webp' }} 800w, {{ gimg | image_url: width: 1000, format: 'webp' }} 1000w, {{ gimg | image_url: width: 1400, format: 'webp' }} 1400w" sizes="(max-width: 900px) 100vw, 640px" width="1000" height="1000" alt="" loading="lazy" decoding="async"></div>
            {%- endif -%}
          {%- endfor -%}
        </div>
        <button type="button" class="obp__arrow obp__arrow--prev" data-obp-prev aria-label="Previous image"><svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true"><path d="M9 2L4 7l5 5" stroke="#111" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
        <button type="button" class="obp__arrow obp__arrow--next" data-obp-next aria-label="Next image"><svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true"><path d="M5 2l5 5-5 5" stroke="#111" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
      </div>
      <div class="obp__thumbs">
        {%- assign th_n = 0 -%}
        {%- if sleep_img != blank -%}{%- assign th_n = 1 -%}<button type="button" class="obp__thumb is-active" data-obp-thumb="0" aria-label="View image 1"><img src="{{ sleep_img | image_url: width: 160, format: 'webp' }}" alt="" width="76" height="76" decoding="async"></button>{%- endif -%}
        {%- for gname in obp_files -%}{%- assign gimg = images[gname] -%}
          {%- if gname contains 'theme:' or gimg != blank -%}
            <button type="button" class="obp__thumb{% if th_n == 0 %} is-active{% endif %}" data-obp-thumb="{{ th_n }}" aria-label="View image {{ th_n | plus: 1 }}">
              {%- if gname contains 'theme:' -%}<img src="{{ gname | remove: 'theme:' | append: '-160.webp' | asset_url }}" alt="" width="76" height="76" loading="lazy" decoding="async">{%- else -%}<img src="{{ gimg | image_url: width: 160, format: 'webp' }}" alt="" width="76" height="76" loading="lazy" decoding="async">{%- endif -%}
            </button>
            {%- assign th_n = th_n | plus: 1 -%}
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>

    <div class="obp__box">
      {%- comment -%} Tier data first, so the title price row and CTA show the pre-selected (first) tier. {%- endcomment -%}
      {%- assign calm_id = 44328103608540 -%}{%- assign calm_value = '$45' -%}{%- assign calm_p = all_products['oral-stress-spray'] -%}
      {%- if calm_p != blank -%}{%- for v in calm_p.variants -%}{%- if v.id == calm_id -%}{%- assign calm_value = v.price | money_without_trailing_zeros -%}{%- break -%}{%- endif -%}{%- endfor -%}{%- endif -%}
      {%- assign spray_value = section.settings.spray_value | default: 30 -%}
      {%- assign first_price = '' -%}{%- assign first_compare = '' -%}{%- assign tier_n = 0 -%}

      {%- capture obp_tiers -%}
        {%- for b in section.blocks -%}{%- if b.type == 'tier' -%}
          {%- assign t_lw = b.settings.label | remove: ',' | split: ' ' -%}
          {%- assign t_n = t_lw[1] | plus: 0 -%}
          {%- assign t_gift = false -%}{%- if t_lw[0] == 'Buy' and t_lw[1] == '3' -%}{%- assign t_gift = true -%}{%- endif -%}
          {%- assign t_middle = false -%}{%- if t_lw[0] == 'Buy' and t_lw[1] == '2' -%}{%- assign t_middle = true -%}{%- endif -%}
          {%- unless t_middle and section.settings.show_middle_tier == false -%}
          {%- assign tier_n = tier_n | plus: 1 -%}
          {%- assign vid = b.settings.variant_id | strip -%}
          {%- assign srcprod = b.settings.product | default: section.settings.product -%}
          {%- assign tier_variant = blank -%}
          {%- if vid != blank and srcprod != blank -%}{%- for v in srcprod.variants -%}{%- assign vstr = v.id | append: '' -%}{%- if vstr == vid -%}{%- assign tier_variant = v -%}{%- break -%}{%- endif -%}{%- endfor -%}{%- endif -%}
          {%- if vid == blank and srcprod != blank -%}{%- assign vid = srcprod.selected_or_first_available_variant.id -%}{%- endif -%}
          {%- capture tier_price -%}{%- if tier_variant != blank -%}{{ tier_variant.price | money_without_trailing_zeros }}{%- else -%}{{ b.settings.price }}{%- endif -%}{%- endcapture -%}
          {%- assign tier_price = tier_price | strip -%}
          {%- capture tier_compare -%}
            {%- if b.settings.compare_price != blank -%}{{ b.settings.compare_price }}
            {%- elsif tier_variant != blank and tier_variant.compare_at_price and tier_variant.compare_at_price > tier_variant.price -%}{{ tier_variant.compare_at_price | money_without_trailing_zeros }}{%- endif -%}
          {%- endcapture -%}
          {%- assign tier_compare = tier_compare | strip -%}
          {%- if t_gift -%}{%- assign tier_compare = '$207' -%}{%- endif -%}
          {%- assign t_label = b.settings.label -%}{%- if t_gift -%}{%- assign t_label = t_label | replace: 'Get 3', 'Get 4' -%}{%- endif -%}
          {%- assign t_sp = tier_price | replace: '$','' | replace: ',','' | plus: 0.0 -%}
          {%- assign t_bottles = t_n | times: 2 -%}{%- if t_gift -%}{%- assign t_bottles = t_bottles | plus: 1 -%}{%- endif -%}
          {%- assign t_per = '' -%}{%- if t_bottles > 0 and t_sp > 0 -%}{%- assign t_per = t_sp | times: 100 | divided_by: t_bottles | round | money_without_trailing_zeros -%}{%- endif -%}
          {%- assign t_serv = b.settings.servings_text -%}
          {%- if t_serv == blank and t_n > 0 -%}{%- capture t_serv -%}{{ t_n | times: 2 }}-Month Supply{%- endcapture -%}{%- endif -%}
          {%- if t_serv contains '(' -%}{%- assign t_serv = t_serv | split: '(' | last | remove: ')' | strip -%}{%- endif -%}
          {%- assign t_sel = false -%}{%- if tier_n == 1 -%}{%- assign t_sel = true -%}{%- assign first_price = tier_price -%}{%- assign first_compare = tier_compare -%}{%- endif -%}
          {%- assign t_free_value = spray_value | times: t_n -%}
          <label class="obp__tier{% if t_sel %} is-selected{% endif %}" {{ b.shopify_attributes }}>
            <input type="radio" name="obp-{{ section.id }}" value="{{ vid }}" data-price="{{ tier_price }}" data-compare="{{ tier_compare }}"
                   data-qty="{{ b.settings.quantity | default: 1 }}"{% if t_gift %} data-gift="{{ calm_id }}"{% endif %}{% if t_sel %} checked{% endif %}>
            {%- if t_gift -%}<span class="obp__badge obp__badge--gift">+ FREE EXTRA GIFT</span>
            {%- elsif b.settings.badge != blank and t_middle -%}<span class="obp__badge">{{ b.settings.badge }}</span>{%- endif -%}
            <span class="obp__row">
              <span class="obp__radio" aria-hidden="true"></span>
              {%- if t_gift -%}
                <img class="obp__bundle" src="{{ 'rejuvia-bundle-b3g4.webp' | asset_url }}" width="64" height="60" alt="" loading="lazy" decoding="async">
              {%- elsif b.settings.image != blank -%}
                <img class="obp__bundle" src="{{ b.settings.image | image_url: width: 200, format: 'webp' }}" width="64" height="60" alt="" loading="lazy" decoding="async">
              {%- elsif b.settings.image_asset != blank -%}
                <img class="obp__bundle" src="{{ b.settings.image_asset | asset_url }}" width="64" height="60" alt="" loading="lazy" decoding="async">
              {%- endif -%}
              <span class="obp__tinfo">
                <span class="obp__tname">{{ t_label }}</span>
                <span class="obp__tmeta">
                  {%- if t_per != blank -%}<span class="obp__per">{{ t_per }} per spray</span>{%- endif -%}
                  {%- if t_serv != blank -%}<span class="obp__supply">{{ t_serv }}</span>{%- endif -%}
                </span>
              </span>
              <span class="obp__tprice"><span>{{ tier_price }}</span>{%- if tier_compare != blank -%}<s>{{ tier_compare }}</s>{%- endif -%}</span>
            </span>
            <span class="obp__perks">
              <span class="obp__perk">
                <span class="obp__perk-ic">{%- if sleep_img != blank -%}<img src="{{ sleep_img | image_url: width: 90, format: 'webp' }}" alt="" width="30" height="30" loading="lazy">{%- endif -%}</span>
                <span class="obp__perk-txt"><span class="obp__perk-t">+ {{ t_n }} FREE Sleep Spray{% if t_n > 1 %}s{% endif %}</span><span class="obp__perk-n">Added to your cart automatically</span></span>
                <span class="obp__perk-v"><s>${{ t_free_value }}</s><strong>FREE</strong></span>
              </span>
              {%- if t_gift -%}
                <span class="obp__perk obp__perk--gift">
                  <span class="obp__perk-ic"><img src="{{ 'rejuvia-calm-bottle.png' | asset_url }}" alt="" width="30" height="30" loading="lazy"></span>
                  <span class="obp__perk-txt"><span class="obp__perk-t">+ 1 FREE Calm Spray</span><span class="obp__perk-n">For racing thoughts during the day</span></span>
                  <span class="obp__perk-v"><s>{{ calm_value }}</s><strong>FREE</strong></span>
                </span>
                <span class="obp__perk">
                  <span class="obp__perk-ic">{{ obp_truck }}</span>
                  <span class="obp__perk-txt"><span class="obp__perk-t">+ FREE Shipping</span><span class="obp__perk-n">Ships from the USA</span></span>
                  <span class="obp__perk-v"><s>$5.95</s><strong>FREE</strong></span>
                </span>
              {%- endif -%}
            </span>
          </label>
          {%- endunless -%}
        {%- endif -%}{%- endfor -%}
      {%- endcapture -%}

      <div class="obp__topbar">Fast-acting sleep spray that works in 10-15 minutes</div>

      <div class="obp__proof">
        <div class="obp__buyers">
          <div class="obp__av">
            {%- for av in (1..3) -%}{%- case av -%}{%- when 1 -%}{%- assign avi = av1 -%}{%- when 2 -%}{%- assign avi = av2 -%}{%- else -%}{%- assign avi = av3 -%}{%- endcase -%}
              {%- if avi != blank -%}<img src="{{ avi | image_url: width: 84 }}" alt="" width="28" height="28" loading="lazy" decoding="async">{%- endif -%}
            {%- endfor -%}
          </div>
          <div class="obp__byline"><strong>Lisa F.</strong><svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 1.5l2.6 1.9 3.2-.2 1 3.1 2.6 1.9-1 3.1 1 3.1-2.6 1.9-1 3.1-3.2-.2L12 22.5l-2.6-1.9-3.2.2-1-3.1L2.6 15.8l1-3.1-1-3.1 2.6-1.9 1-3.1 3.2.2z" fill="#1d9bf0"/><path d="M7.8 12.2l2.8 2.7 5.6-5.8" stroke="#fff" stroke-width="2.2" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg><span>and 500K+ others purchased</span></div>
        </div>
        <div class="obp__rating"><span class="obp__rating-stars" aria-hidden="true">★★★★★</span><span><strong>4.5/5</strong> (7,500+ reviews)</span></div>
      </div>

      <div class="obp__titles">
        <h1 class="obp__title">Rejuvia Sleep Spray</h1>
        <div class="obp__pricerow">
          <span class="obp__was" data-obp-was{% if first_compare == blank %} hidden{% endif %}>{{ first_compare }}</span>
          <span class="obp__price" data-obp-price>{{ first_price }}</span>
          <span class="obp__best">BEST SELLER</span>
        </div>
      </div>

      <p class="obp__desc">A few minty sprays under your tongue, 13 natural ingredients, asleep in 10–15 minutes. Free sprays are added to your cart automatically.</p>

      <div class="obp__scar">
        <div class="obp__scar-row"><span class="obp__scar-t">BOGO SALE · SELLING FAST</span><span class="obp__scar-e">Ends in <strong data-obp-countdown>--:--:--</strong></span></div>
        <div class="obp__bar"><span></span></div>
        <div class="obp__scar-n">89% of BOGOs claimed · One-time purchase only</div>
      </div>

      <div class="obp__tiers" role="radiogroup" aria-label="Choose your bundle">{{ obp_tiers }}</div>

      <div class="obp__cta">
        <button type="button" class="obp__buy" data-obp-buy data-obp-discount="{{ section.settings.checkout_discount_code | strip }}">
          <span class="obp__spinner" aria-hidden="true"></span>
          <span class="obp__buy-l" data-obp-cta>BUY NOW - {{ first_price }}</span>
          <span class="obp__buy-s">90-Day Money-Back Guarantee</span>
        </button>
        <div class="obp__deliv"><span class="obp__deliv-dot" aria-hidden="true"></span><span>🇺🇸 Fast US Delivery (<span data-obp-deliv></span>)</span></div>
      </div>

      <div class="obp__guar">
        <div class="obp__guar-h">
          {%- if section.settings.guarantee_icon != blank -%}<img src="{{ section.settings.guarantee_icon | image_url: width: 72 }}" alt="" width="24" height="24" loading="lazy">{%- endif -%}
          <div class="obp__guar-t">90-day money-back guarantee</div>
        </div>
        <p>As a family-run business, we stand behind Rejuvia. Not sleeping better within 90 days? Full refund — no questions asked, no hidden policies.</p>
      </div>

      {%- assign hidden_pay = section.settings.hidden_payments | default: 'none' | downcase | replace: ' ', '' | split: ',' -%}
      <div class="obp__pay">
        {%- for type in shop.enabled_payment_types -%}{%- unless hidden_pay contains type -%}{{ type | payment_type_svg_tag: class: 'payment-icon' }}{%- endunless -%}{%- endfor -%}
      </div>

      <div class="obp__acc">
        {%- for b in section.blocks -%}{%- if b.type == 'tab' and b.settings.title != blank -%}
          <div class="obp__acc-i" {{ b.shopify_attributes }}>
            <button type="button" class="obp__acc-q" aria-expanded="false"><span>{{ b.settings.title }}</span>{{ obp_chev }}</button>
            <div class="obp__acc-a">{{ b.settings.content }}{%- assign tab_t = b.settings.title | downcase -%}{%- if tab_t contains 'ingredient' -%}{% render 'supplement-label-button', product: section.settings.product %}{%- endif -%}</div>
          </div>
        {%- endif -%}{%- endfor -%}
      </div>

      <div class="obp__trust">
        <div class="obp__trust-av">
          {%- for av in (1..3) -%}{%- case av -%}{%- when 1 -%}{%- assign avi = av1 -%}{%- when 2 -%}{%- assign avi = av2 -%}{%- else -%}{%- assign avi = av3 -%}{%- endcase -%}
            {%- if avi != blank -%}<img src="{{ avi | image_url: width: 144 }}" alt="" width="48" height="48" loading="lazy" decoding="async">{%- endif -%}
          {%- endfor -%}
          <span class="obp__trust-ck" aria-hidden="true"><svg width="10" height="10" viewBox="0 0 10 10"><path d="M2 5.2l2 2 4-4.4" stroke="#fff" stroke-width="1.8" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
        </div>
        <div class="obp__trust-txt"><span class="obp__trust-t">{{ section.settings.trusted_title }}</span><span class="obp__trust-s">{{ section.settings.trusted_subtext }}</span></div>
      </div>
    </div>
  </div>
  {% render 'supplement-label-popup', product: section.settings.product %}
</div>

<script>
(function () {
  var sec = document.getElementById('obp-{{ section.id }}');
  if (!sec) return;

  /* ---- Gallery: swipeable scroll-snap track, arrows, thumbs ---- */
  var track = sec.querySelector('[data-obp-track]');
  var thumbs = sec.querySelectorAll('[data-obp-thumb]');
  var total = track ? track.children.length : 0;
  function cur() { return track && track.clientWidth ? Math.round(track.scrollLeft / track.clientWidth) : 0; }
  function go(i) { if (!track || !total) return; i = (i + total) % total; track.scrollTo({ left: i * track.clientWidth, behavior: 'smooth' }); }
  function syncGal() {
    var i = cur();
    thumbs.forEach(function (t, k) { t.classList.toggle('is-active', k === i); });
    var at = thumbs[i];
    if (at && at.parentNode) { var p = at.parentNode; var l = at.offsetLeft - (p.clientWidth - at.offsetWidth) / 2; p.scrollTo({ left: l, behavior: 'smooth' }); }
  }
  if (track) {
    var st; track.addEventListener('scroll', function () { clearTimeout(st); st = setTimeout(syncGal, 60); }, { passive: true });
    var pv = sec.querySelector('[data-obp-prev]'), nx = sec.querySelector('[data-obp-next]');
    if (pv) pv.addEventListener('click', function () { go(cur() - 1); });
    if (nx) nx.addEventListener('click', function () { go(cur() + 1); });
    thumbs.forEach(function (t) { t.addEventListener('click', function () { go(parseInt(t.getAttribute('data-obp-thumb'), 10) || 0); }); });
  }

  /* ---- Tier selection: selected styles, title price row, CTA price ---- */
  var priceEl = sec.querySelector('[data-obp-price]'), wasEl = sec.querySelector('[data-obp-was]'), cta = sec.querySelector('[data-obp-cta]');
  function syncTier() {
    var sel = sec.querySelector('.obp__tier input:checked');
    sec.querySelectorAll('.obp__tier').forEach(function (l) { l.classList.toggle('is-selected', l.contains(sel)); });
    if (!sel) return;
    var p = sel.getAttribute('data-price'), c = sel.getAttribute('data-compare');
    if (priceEl) priceEl.textContent = p;
    if (wasEl) { wasEl.textContent = c; wasEl.hidden = !c; }
    if (cta) cta.textContent = 'BUY NOW - ' + p;
  }
  sec.querySelectorAll('.obp__tier input').forEach(function (r) { r.addEventListener('change', syncTier); });
  syncTier();

  /* ---- Countdown to local midnight ---- */
  var cd = sec.querySelector('[data-obp-countdown]');
  function pad(n) { return String(n).padStart(2, '0'); }
  function tick() {
    if (!cd) return;
    var d = new Date(), end = new Date(d); end.setHours(24, 0, 0, 0);
    var s = Math.max(0, Math.floor((end - d) / 1000));
    cd.textContent = pad(Math.floor(s / 3600)) + ':' + pad(Math.floor(s % 3600 / 60)) + ':' + pad(s % 60);
  }
  tick(); setInterval(tick, 1000);

  /* ---- Delivery window: today + 2 to + 4 business days ---- */
  var dl = sec.querySelector('[data-obp-deliv]');
  function addBiz(d, n) { var x = new Date(d); while (n > 0) { x.setDate(x.getDate() + 1); if (x.getDay() !== 0 && x.getDay() !== 6) n--; } return x; }
  function fmt(x) { return x.toLocaleDateString('en-US', { month: 'short', day: 'numeric' }); }
  if (dl) { var now = new Date(); dl.textContent = fmt(addBiz(now, 2)) + ' – ' + fmt(addBiz(now, 4)); }

  /* ---- Accordion: one open at a time, all closed by default ---- */
  var accs = sec.querySelectorAll('.obp__acc-i');
  sec.querySelectorAll('.obp__acc-q').forEach(function (btn) {
    btn.addEventListener('click', function () {
      var it = btn.closest('.obp__acc-i'), willOpen = !it.classList.contains('is-open');
      accs.forEach(function (a) { a.classList.remove('is-open'); var q = a.querySelector('.obp__acc-q'); if (q) q.setAttribute('aria-expanded', 'false'); });
      if (willOpen) { it.classList.add('is-open'); btn.setAttribute('aria-expanded', 'true'); }
    });
  });

  /* ---- Buy Now: clear cart, add the tier (+ free Calm Spray on Buy 3), go to checkout ---- */
  var buy = sec.querySelector('[data-obp-buy]');
  if (buy) {
    window.addEventListener('pageshow', function () { buy.disabled = false; buy.classList.remove('is-loading'); });
    buy.addEventListener('click', function () {
      var sel = sec.querySelector('.obp__tier input:checked');
      if (!sel || !sel.value) return;
      var id = parseInt(sel.value, 10), qty = parseInt(sel.getAttribute('data-qty'), 10) || 1;
      var item = { id: id, quantity: qty };
      var gift = parseInt(sel.getAttribute('data-gift'), 10);
      var code = (buy.getAttribute('data-obp-discount') || '').trim();
      var checkoutUrl = code ? ('/discount/' + encodeURIComponent(code) + '?redirect=/checkout') : '/checkout';
      buy.disabled = true; buy.classList.add('is-loading');
      fetch('/cart/clear.js', { method: 'POST', headers: { 'Content-Type': 'application/json' } })
        .then(function () {
          return fetch('/cart/add.js', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ items: gift ? [item, { id: gift, quantity: 1 }] : [item] }) });
        })
        .then(function (r) { if (!r.ok) throw new Error('add failed'); window.location.href = checkoutUrl; })
        .catch(function () { window.location.href = '/cart/' + id + ':' + qty + (gift ? (',' + gift + ':1') : '') + (code ? ('?discount=' + encodeURIComponent(code)) : ''); });
    });
  }

})();
</script>

