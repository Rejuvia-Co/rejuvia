    { "type": "header", "content": "Trusted-by pill" },
    { "type": "text", "id": "trusted_title", "label": "Title", "default": "Trusted by 500K+ customers" },
    { "type": "textarea", "id": "trusted_subtext", "label": "Subtext", "default": "who now fall asleep faster and sleep through the night" },
    { "type": "image_picker", "id": "trusted_image_1", "label": "Avatar 1" },
    { "type": "image_picker", "id": "trusted_image_2", "label": "Avatar 2" },
    { "type": "image_picker", "id": "trusted_image_3", "label": "Avatar 3" },
    { "type": "color", "id": "trusted_bg", "label": "Trusted-by background", "default": "#f4f4f4" }
