{%- comment -%}
  Sleep Spray buy box — v6 "two-step stack" (quantity, then price).

  Forked from offer-block-sub.liquid rather than extended, because BOGOSub and
  Anniversary both render that section and must not shift. Everything outside
  the selector is carried over unchanged: review bar, title/subtitle, gallery,
  urgency strip, CTA, trust lines, payment icons, accordion, trusted-by row.

  PRICING IS FULLY DERIVED FROM SHOPIFY. Every money string on this page is
  rendered here by Liquid from product.variants and selling_plan_allocations,
  then stashed on data-* attributes. The JS only copies those strings into
  place — it never multiplies, divides or formats money. Change a price in
  Shopify and this section follows on the next render, with no edits here.

  Per tier we derive:
    one-time price   variant.price
    MSRP             variant.compare_at_price when it beats price, otherwise
                     the 1-bottle tier's price x bottle count (so a 6-pack
                     without its own compare_at still shows a real strikethrough)
    subscribe price  the selling_plan_allocation matching the tier's plan id
    per bottle       price / bottles, rounded through a float so it lands on
                     the nearest cent rather than truncating
{%- endcomment -%}

{%- liquid
  assign prod = section.settings.product
  assign qtys = section.blocks | where: 'type', 'qty'
  assign accent = section.settings.accent_color
-%}

{%- comment -%}
  Pass 1 — the 1-bottle unit price, used as the MSRP basis for any tier whose
  variant has no compare_at_price of its own.
{%- endcomment -%}
{%- assign unit_price = 0 -%}
{%- if prod != blank -%}
  {%- for b in qtys -%}
    {%- assign bt = b.settings.bottles | plus: 0 -%}
    {%- if bt == 1 -%}
      {%- assign want = b.settings.variant_id | strip -%}
      {%- for v in prod.variants -%}
        {%- assign vs = v.id | append: '' -%}
        {%- if vs == want -%}{%- assign unit_price = v.price -%}{%- break -%}{%- endif -%}
      {%- endfor -%}
    {%- endif -%}
  {%- endfor -%}
{%- endif -%}

{% style %}
  .obq-{{ section.id }} {
    --obq-accent: {{ accent }};
    --obq-cta: {{ section.settings.cta_color }};
    --obq-cta-hover: {{ section.settings.cta_hover_color }};
    --obq-plum: #4c1c4f;
    --obq-gold: {{ section.settings.gold_color }};
    --obq-ink: #171512;
    --obq-body: #4a4550;
    --obq-muted: #6b6660;
    --obq-soft: #8b8494;
    --obq-struck: #a9a3b2;
    --obq-line: #e6e1ee;
    --obq-panel: #fcfbfe;
    --obq-fill: #faf7fd;
    --obq-green: #018e1c;
    --obq-dot: #00b10d;
    --obq-ease: 180ms cubic-bezier(.22,1,.36,1);
    --font-display: 'Helvetica Neue', Arimo, Helvetica, Arial, sans-serif;
    --font-body: 'Helvetica Neue', Arimo, Helvetica, Arial, sans-serif;
    --font-ui: 'HelveticaNeueL', 'Helvetica Neue', Helvetica, Arial, sans-serif;
    background: {{ section.settings.section_bg }};
    font-family: var(--font-body);
    color: var(--obq-ink);
    letter-spacing: normal;
    display: block;
  }

  .obq-{{ section.id }} *,
  .obq-{{ section.id }} *::before,
  .obq-{{ section.id }} *::after { box-sizing: border-box; }

  .obq-{{ section.id }} .obq__wrap {
    max-width: 1120px;
    margin: 0 auto;
    padding: 28px 20px 40px;
  }

  /* ---------- header ---------- */
  .obq-{{ section.id }} .obq__reviewbar {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px;
    font-family: var(--font-ui);
    font-size: 14px;
    color: var(--obq-body);
  }

  .obq-{{ section.id }} .obq__stars { display: inline-flex; gap: 2px; }
  .obq-{{ section.id }} .obq__stars svg { width: 16px; height: 15px; display: block; }
  .obq-{{ section.id }} .obq__rb-strong { font-weight: 700; color: var(--obq-ink); }
  .obq-{{ section.id }} .obq__rb-sep { color: #cfc9dd; }
  .obq-{{ section.id }} .obq__reviewbar p { margin: 0; display: inline; }

  .obq-{{ section.id }} .obq__headline {
    font-family: var(--font-display);
    font-size: {{ section.settings.headline_size }}px;
    font-weight: 800;
    line-height: 1.08;
    letter-spacing: -1.5px;
    color: var(--obq-ink);
    margin: 14px 0 0;
  }

  .obq-{{ section.id }} .obq__subtitle {
    font-size: {{ section.settings.subtitle_size }}px;
    line-height: 1.35;
    color: var(--obq-body);
    margin: 10px 0 0;
  }

  /* ---------- two-column layout, sticky gallery ---------- */
  .obq-{{ section.id }} .obq__cols {
    display: grid;
    grid-template-columns: 430px minmax(0, 1fr);
    gap: 44px;
    align-items: start;
    margin-top: 22px;
  }

  .obq-{{ section.id }} .obq__gallery {
    position: sticky;
    top: {{ section.settings.sticky_offset }}px;
    align-self: flex-start;
  }

  .obq-{{ section.id }} .obq__main {
    background: {{ section.settings.gallery_bg }};
    border-radius: 16px;
    overflow: hidden;
  }

  .obq-{{ section.id }} .obq__main img {
    display: block;
    width: 100%;
    height: auto;
    object-fit: {{ section.settings.gallery_fit }};
  }

  /* display:block above beats the hidden attribute, so restore it —
     otherwise every slide renders at once. */
  .obq-{{ section.id }} .obq__main img[hidden] { display: none; }

  .obq-{{ section.id }} .obq__thumbrow {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-top: 12px;
  }

  .obq-{{ section.id }} .obq__arrow {
    flex: 0 0 auto;
    width: 30px;
    height: 30px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: none;
    border: 0;
    padding: 0;
    cursor: pointer;
    color: var(--obq-accent);
  }

  .obq-{{ section.id }} .obq__arrow svg { width: 20px; height: 20px; }

  .obq-{{ section.id }} .obq__thumbs {
    display: flex;
    gap: 8px;
    overflow-x: auto;
    scrollbar-width: none;
    flex: 1 1 auto;
  }

  .obq-{{ section.id }} .obq__thumbs::-webkit-scrollbar { display: none; }

  .obq-{{ section.id }} .obq__thumb {
    flex: 0 0 auto;
    width: 62px;
    height: 62px;
    padding: 0;
    border: 1.5px solid var(--obq-line);
    border-radius: 10px;
    background: #fff;
    overflow: hidden;
    cursor: pointer;
    transition: border-color var(--obq-ease);
  }

  .obq-{{ section.id }} .obq__thumb.is-active { border-color: var(--obq-accent); border-width: 2px; }
  .obq-{{ section.id }} .obq__thumb img { width: 100%; height: 100%; object-fit: cover; display: block; }

  .obq-{{ section.id }} .obq__dots { display: none; }

  /* ---------- urgency strip ---------- */
  .obq-{{ section.id }} .obq__urgency {
    display: flex;
    align-items: center;
    gap: 11px;
    border: 1.5px dashed #cbb6cc;
    background: #f9f6fc;
    border-radius: 14px;
    padding: 13px 18px;
    font-size: 14.5px;
    line-height: 1.35;
    color: var(--obq-plum);
    margin-top: 16px;
  }

  .obq-{{ section.id }} .obq__urgency svg { width: 20px; height: 20px; flex: 0 0 auto; }
  .obq-{{ section.id }} .obq__urgency b { font-weight: 800; }
  .obq-{{ section.id }} .obq__urgency--top { display: none; }

  /* ---------- panel ---------- */
  .obq-{{ section.id }} .obq__panel {
    background: var(--obq-panel);
    border: 1px solid var(--obq-line);
    border-radius: 20px;
    padding: 20px;
  }

  .obq-{{ section.id }} .obq__step {
    font-family: var(--font-ui);
    font-size: 11.5px;
    font-weight: 800;
    line-height: 1;
    letter-spacing: 1.1px;
    text-transform: uppercase;
    color: var(--obq-soft);
    margin: 0 0 12px;
  }

  .obq-{{ section.id }} .obq__step--two { margin-top: 22px; }

  /* ---------- step 1: quantity cards ---------- */
  .obq-{{ section.id }} .obq__cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
  }

  .obq-{{ section.id }} .obq__card,
  .obq-{{ section.id }} .obq__plan {
    /* The theme sets a global label{} rule (inline-block, uppercase,
       letter-spacing). These are labels, so reset it or every string inside
       renders shouted. */
    text-transform: none;
    letter-spacing: normal;
  }

  .obq-{{ section.id }} .obq__card {
    position: relative;
    display: block;
    border: 1.5px solid var(--obq-line);
    background: #fff;
    border-radius: 14px;
    padding: 18px 12px 15px;
    text-align: center;
    cursor: pointer;
    transition: border-color var(--obq-ease), background var(--obq-ease);
  }

  .obq-{{ section.id }} .obq__card.is-selected {
    border: 2px solid var(--obq-accent);
    background: var(--obq-fill);
    padding: 17.5px 11.5px 14.5px;
  }

  /* The radio covers the whole card and stays invisible. Its own
     :focus-visible ring therefore reads as a ring around the card, which
     avoids :has() -- unsupported before Safari 15.4, and this audience runs
     older webviews. */
  .obq-{{ section.id }} .obq__card input,
  .obq-{{ section.id }} .obq__plan input {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    opacity: 0;
    appearance: none;
    -webkit-appearance: none;
    cursor: pointer;
    border-radius: inherit;
  }

  .obq-{{ section.id }} .obq__card input:focus-visible,
  .obq-{{ section.id }} .obq__plan input:focus-visible {
    outline: 3px solid rgba(103, 38, 102, .35);
    outline-offset: 2px;
  }

  .obq-{{ section.id }} .obq__flag {
    position: absolute;
    top: -10px;
    left: 50%;
    transform: translateX(-50%);
    font-family: var(--font-ui);
    font-size: 9.5px;
    font-weight: 800;
    line-height: 1;
    letter-spacing: 1px;
    padding: 5px 11px 4px;
    border-radius: 100px;
    white-space: nowrap;
  }

  .obq-{{ section.id }} .obq__flag--plum { background: var(--obq-cta); color: #fff; }
  .obq-{{ section.id }} .obq__flag--gold { background: var(--obq-gold); color: var(--obq-plum); }

  .obq-{{ section.id }} .obq__bottles {
    display: flex;
    align-items: flex-end;
    justify-content: center;
    gap: 5px;
    height: 66px;
    margin-bottom: 10px;
  }

  .obq-{{ section.id }} .obq__bottles img { height: 64px; width: auto; display: block; }

  .obq-{{ section.id }} .obq__cname {
    display: block;
    font-size: 18px;
    font-weight: 800;
    line-height: 1.1;
    color: var(--obq-ink);
  }

  .obq-{{ section.id }} .obq__cnights {
    display: block;
    font-size: 12px;
    line-height: 1.3;
    color: var(--obq-soft);
    margin-top: 3px;
  }

  .obq-{{ section.id }} .obq__cprice {
    margin-top: 8px;
    display: flex;
    align-items: baseline;
    justify-content: center;
    gap: 6px;
    flex-wrap: wrap;
  }

  .obq-{{ section.id }} .obq__cprice-now {
    font-size: 20px;
    font-weight: 800;
    line-height: 1.1;
    color: var(--obq-ink);
  }

  .obq-{{ section.id }} .obq__cprice-was {
    font-size: 12.5px;
    color: var(--obq-struck);
    text-decoration: line-through;
  }

  .obq-{{ section.id }} .obq__cper {
    display: block;
    font-size: 12px;
    font-weight: 700;
    line-height: 1.3;
    color: var(--obq-accent);
    margin-top: 3px;
  }

  /* ---------- step 2: plan rows ---------- */
  .obq-{{ section.id }} .obq__plans {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .obq-{{ section.id }} .obq__plan {
    position: relative;
    display: block;
    border: 1.5px solid var(--obq-line);
    background: #fff;
    border-radius: 14px;
    overflow: hidden;
    cursor: pointer;
    transition: border-color var(--obq-ease), background var(--obq-ease);
  }

  .obq-{{ section.id }} .obq__plan.is-selected {
    border: 2px solid var(--obq-accent);
    background: var(--obq-fill);
  }


  .obq-{{ section.id }} .obq__strip {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    background: var(--obq-cta);
    color: #fff;
    font-family: var(--font-ui);
    font-size: 11px;
    font-weight: 800;
    line-height: 1;
    letter-spacing: 1.1px;
    padding: 8px 16px 7px;
  }

  .obq-{{ section.id }} .obq__reco {
    background: var(--obq-gold);
    color: var(--obq-plum);
    font-size: 9.5px;
    font-weight: 800;
    letter-spacing: 1px;
    border-radius: 100px;
    padding: 4px 9px 3px;
    white-space: nowrap;
  }

  .obq-{{ section.id }} .obq__prow {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 15px 16px;
  }

  .obq-{{ section.id }} .obq__radio {
    flex: 0 0 auto;
    width: 20px;
    height: 20px;
    border: 2px solid #cfc9dd;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: border-color var(--obq-ease);
  }

  .obq-{{ section.id }} .obq__radio::after {
    content: '';
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--obq-accent);
    transform: scale(0);
    transition: transform var(--obq-ease);
  }

  .obq-{{ section.id }} .obq__plan.is-selected .obq__radio { border-color: var(--obq-accent); }
  .obq-{{ section.id }} .obq__plan.is-selected .obq__radio::after { transform: scale(1); }

  .obq-{{ section.id }} .obq__pinfo { flex: 1 1 auto; min-width: 0; }

  .obq-{{ section.id }} .obq__ptitle {
    display: block;
    font-size: 17.5px;
    font-weight: 800;
    line-height: 1.15;
    color: var(--obq-ink);
  }

  .obq-{{ section.id }} .obq__psub {
    display: block;
    font-size: 13.5px;
    line-height: 1.35;
    color: var(--obq-muted);
    margin-top: 3px;
  }

  .obq-{{ section.id }} .obq__pright { flex: 0 0 auto; text-align: right; }

  .obq-{{ section.id }} .obq__pprice {
    display: flex;
    align-items: baseline;
    justify-content: flex-end;
    gap: 6px;
  }

  .obq-{{ section.id }} .obq__pnow {
    font-size: 21px;
    font-weight: 800;
    line-height: 1.1;
    color: var(--obq-ink);
  }

  .obq-{{ section.id }} .obq__pwas {
    font-size: 13.5px;
    color: var(--obq-struck);
    text-decoration: line-through;
  }

  .obq-{{ section.id }} .obq__pmeta {
    display: block;
    font-size: 12px;
    font-weight: 700;
    line-height: 1.3;
    margin-top: 3px;
  }

  .obq-{{ section.id }} .obq__pmeta--green { color: var(--obq-green); }
  .obq-{{ section.id }} .obq__pmeta--muted { color: var(--obq-soft); font-weight: 400; }

  /* ---------- summary ---------- */
  .obq-{{ section.id }} .obq__summary {
    background: #fff;
    border: 1px solid var(--obq-line);
    border-radius: 12px;
    padding: 13px 15px;
    margin-top: 16px;
    font-size: 12.5px;
    line-height: 1.5;
    color: var(--obq-ink);
    display: flex;
    flex-direction: column;
    gap: 5px;
  }

  .obq-{{ section.id }} .obq__sline { display: flex; align-items: baseline; gap: 7px; }
  .obq-{{ section.id }} .obq__tick { color: var(--obq-green); font-weight: 800; flex: 0 0 auto; }
  .obq-{{ section.id }} .obq__summary b { font-weight: 800; }

  /* ---------- ships-by bar ---------- */
  .obq-{{ section.id }} .obq__ships {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    background: #f4f2f7;
    border-radius: 12px;
    padding: 12px 16px;
    font-size: 13px;
    line-height: 1.3;
    color: var(--obq-ink);
    margin-top: 12px;
  }

  .obq-{{ section.id }} .obq__ships b { font-weight: 800; }
  .obq-{{ section.id }} .obq__gdot { color: var(--obq-dot); font-size: 15px; line-height: 1; }

  /* ---------- CTA ---------- */
  .obq-{{ section.id }} .obq__buy {
    width: 100%;
    height: 58px;
    margin-top: 14px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    background: var(--obq-cta);
    color: #fff;
    border: 0;
    border-radius: 100px;
    font-family: var(--font-ui);
    font-size: 16px;
    font-weight: 800;
    letter-spacing: 1.2px;
    line-height: 1;
    cursor: pointer;
    box-shadow: 0 6px 18px rgba(45, 21, 48, .16);
    transition: background var(--obq-ease), transform var(--obq-ease);
  }

  .obq-{{ section.id }} .obq__buy:hover { background: var(--obq-cta-hover); transform: translateY(-1px); }
  .obq-{{ section.id }} .obq__buy:active { transform: translateY(1px) scale(.99); }
  .obq-{{ section.id }} .obq__buy svg { width: 18px; height: 18px; }
  .obq-{{ section.id }} .obq__buy.is-loading { opacity: .75; pointer-events: none; }

  /* ---------- trust + payments ---------- */
  .obq-{{ section.id }} .obq__trust {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 6px 18px;
    margin-top: 12px;
    font-family: var(--font-ui);
    font-size: 10px;
    font-weight: 800;
    letter-spacing: .6px;
    color: var(--obq-body);
    text-transform: uppercase;
  }

  .obq-{{ section.id }} .obq__payments {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 7px;
    margin-top: 12px;
  }

  .obq-{{ section.id }} .obq__payments svg { height: 23px; width: auto; border-radius: 4px; }

  /* ---------- accordion ---------- */
  .obq-{{ section.id }} .obq__tabs { margin-top: 26px; border-top: 1px solid rgba(0,0,0,.1); }
  .obq-{{ section.id }} .obq__tab { border-bottom: 1px solid rgba(0,0,0,.1); }

  .obq-{{ section.id }} .obq__tab-q {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    background: none;
    border: 0;
    padding: 22px 2px;
    text-align: left;
    cursor: pointer;
    font-family: var(--font-ui);
    font-size: {{ section.settings.tab_title_size }}px;
    font-weight: 700;
    line-height: 1.3;
    color: var(--obq-ink);
  }

  .obq-{{ section.id }} .obq__chev {
    width: 22px;
    height: 22px;
    flex: 0 0 auto;
    transition: transform var(--obq-ease);
  }

  .obq-{{ section.id }} .obq__tab.is-open .obq__chev { transform: rotate(180deg); }

  .obq-{{ section.id }} .obq__tab-a {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows var(--obq-ease);
  }

  .obq-{{ section.id }} .obq__tab.is-open .obq__tab-a { grid-template-rows: 1fr; }
  .obq-{{ section.id }} .obq__tab-a-inner { overflow: hidden; min-height: 0; }

  .obq-{{ section.id }} .obq__tab-body {
    padding: 0 2px 22px;
    font-size: {{ section.settings.tab_body_size }}px;
    line-height: 1.6;
    color: var(--obq-body);
  }

  .obq-{{ section.id }} .obq__tab-body p { margin: 0 0 1em; }
  .obq-{{ section.id }} .obq__tab-body p:last-child { margin-bottom: 0; }

  /* ---------- mobile ---------- */
  @media screen and (max-width: 989px) {
    .obq-{{ section.id }} .obq__cols { grid-template-columns: 1fr; gap: 18px; }
    .obq-{{ section.id }} .obq__gallery { position: static; top: auto; }
  }

  @media screen and (max-width: 749px) {
    .obq-{{ section.id }} .obq__wrap { padding: 18px 16px 32px; }
    .obq-{{ section.id }} .obq__reviewbar { justify-content: center; font-size: 13px; }
    .obq-{{ section.id }} .obq__headline { font-size: {{ section.settings.headline_size_mobile }}px; letter-spacing: -.8px; }
    .obq-{{ section.id }} .obq__subtitle { font-size: {{ section.settings.subtitle_size_mobile }}px; }

    /* the "300,000+ customers" segment is dropped on mobile per the spec */
    .obq-{{ section.id }} .obq__rb-hide-mobile { display: none; }

    /* mobile shows the urgency strip once above the gallery as well */
    .obq-{{ section.id }} .obq__urgency--top { display: flex; }

    .obq-{{ section.id }} .obq__urgency {
      font-size: 12.5px;
      padding: 11px 13px;
      border-radius: 13px;
      gap: 9px;
    }

    .obq-{{ section.id }} .obq__urgency svg { width: 18px; height: 18px; }

    .obq-{{ section.id }} .obq__panel { border-radius: 18px; padding: 15px 12px; }
    .obq-{{ section.id }} .obq__step { font-size: 10.5px; }
    .obq-{{ section.id }} .obq__cards { gap: 8px; }
    .obq-{{ section.id }} .obq__card { padding: 16px 6px 12px; border-radius: 13px; }
    .obq-{{ section.id }} .obq__card.is-selected { padding: 15.5px 5.5px 11.5px; }
    .obq-{{ section.id }} .obq__bottles { height: 48px; gap: 3px; margin-bottom: 8px; }
    .obq-{{ section.id }} .obq__bottles img { height: 46px; }
    .obq-{{ section.id }} .obq__cname { font-size: 14.5px; }
    .obq-{{ section.id }} .obq__cprice-now { font-size: 17px; }
    .obq-{{ section.id }} .obq__cper { font-size: 11px; }

    /* mobile cards drop the nights line and the strikethrough to stay legible */
    .obq-{{ section.id }} .obq__cnights,
    .obq-{{ section.id }} .obq__cprice-was { display: none; }

    .obq-{{ section.id }} .obq__strip { font-size: 9.5px; letter-spacing: .8px; padding: 7px 12px 6px; }
    .obq-{{ section.id }} .obq__reco { display: none; }
    .obq-{{ section.id }} .obq__prow { padding: 13px 12px; gap: 10px; }
    .obq-{{ section.id }} .obq__ptitle { font-size: 15.5px; }
    .obq-{{ section.id }} .obq__psub { font-size: 12px; }
    .obq-{{ section.id }} .obq__pnow { font-size: 18px; }
    .obq-{{ section.id }} .obq__pwas { display: none; }
    .obq-{{ section.id }} .obq__pmeta--muted { display: none; }
    .obq-{{ section.id }} .obq__buy { height: 54px; font-size: 15px; }
    .obq-{{ section.id }} .obq__thumb { width: 54px; height: 54px; }
    .obq-{{ section.id }} .obq__tab-q { font-size: {{ section.settings.tab_title_size_mobile }}px; padding: 18px 2px; }
    .obq-{{ section.id }} .obq__tab-body { font-size: {{ section.settings.tab_body_size_mobile }}px; padding-bottom: 18px; }
  }
{% endstyle %}

{%- capture obq_star -%}<svg viewBox="0 0 18 16" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M3.85124 15.9392C3.43952 16.1504 2.97233 15.7803 3.05553 15.3078L3.94083 10.2626L0.183091 6.68298C-0.167831 6.34806 0.0145632 5.73581 0.484948 5.66968L5.70931 4.9273L8.03883 0.31199C8.24895 -0.103997 8.81747 -0.103997 9.0276 0.31199L11.3571 4.9273L16.5815 5.66968C17.0519 5.73581 17.2343 6.34806 16.8823 6.68298L13.1256 10.2626L14.0109 15.3078C14.0941 15.7803 13.6269 16.1504 13.2152 15.9392L8.53161 13.5329L3.85124 15.9392Z" fill="{{ section.settings.stars_color }}"/></svg>{%- endcapture -%}
{%- capture obq_chevron -%}<svg class="obq__chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>{%- endcapture -%}
{%- capture obq_truck -%}<svg viewBox="0 0 24 24" fill="none" stroke="{{ accent }}" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 7h11v10H3z"/><path d="M14 10h4l3 3v4h-7z"/><circle cx="7" cy="18" r="1.6"/><circle cx="17.5" cy="18" r="1.6"/></svg>{%- endcapture -%}

{%- assign ship_ts = 'now' | date: '%s' | plus: 86400 -%}
{%- assign ship_date = ship_ts | date: '%a, %b %-d' -%}
{%- assign slides = section.blocks | where: 'type', 'slide' -%}

{%- capture obq_urgency -%}
  {%- if section.settings.urgency_text != blank -%}
    {%- capture sd -%}<b>{{ ship_date }}</b>{%- endcapture -%}
    {%- comment -%}
      The replace must run in an assign tag, never inline in an output tag.
      Liquid ends an output tag by scanning for its closing double brace, and
      the closing brace inside the date placeholder literal breaks that scan
      (FileSaveError: not properly terminated). Assign tags close on percent
      brace instead, so the placeholder is harmless there. offer-block-sub
      does it this way for the same reason.
    {%- endcomment -%}
    {%- assign urgency_html = section.settings.urgency_text | replace: '{date}', sd -%}
    <div class="obq__urgency" role="note">{{ obq_truck }}<span data-obq-urgency>{{ urgency_html }}</span></div>
  {%- endif -%}
{%- endcapture -%}

<section class="obq obq-{{ section.id }}" id="obq-{{ section.id }}">
  <span id="offer" aria-hidden="true" style="display:block;scroll-margin-top:80px;"></span>
  <div class="obq__wrap">

    <div class="obq__header">
      <div class="obq__reviewbar">
        {%- if section.settings.show_stars -%}<span class="obq__stars" role="img" aria-label="5 stars">{{ obq_star }}{{ obq_star }}{{ obq_star }}{{ obq_star }}{{ obq_star }}</span>{%- endif -%}
        {%- if section.settings.rating_label != blank -%}<span class="obq__rb-strong">{{ section.settings.rating_label }}</span>{%- endif -%}
        {%- if section.settings.reviews_label != blank -%}
          <span class="obq__rb-sep" aria-hidden="true">|</span>
          <span>{{ section.settings.reviews_label }}</span>
        {%- endif -%}
        {%- if section.settings.customers_label != blank -%}
          <span class="obq__rb-sep obq__rb-hide-mobile" aria-hidden="true">|</span>
          <span class="obq__rb-hide-mobile">{{ section.settings.customers_label }}</span>
        {%- endif -%}
      </div>
      {%- if section.settings.headline != blank -%}<h1 class="obq__headline">{{ section.settings.headline }}</h1>{%- endif -%}
      {%- if section.settings.subtitle != blank -%}<p class="obq__subtitle">{{ section.settings.subtitle }}</p>{%- endif -%}
    </div>

    {%- comment -%} Mobile only: the strip appears once above the gallery too {%- endcomment -%}
    <div class="obq__urgency--top">{{ obq_urgency }}</div>

    <div class="obq__cols">

      <div class="obq__gallery">
        <div class="obq__main">
          {%- for b in slides -%}
            {%- if b.settings.image != blank -%}
              <img data-obq-main{% unless forloop.first %} hidden{% endunless %}
                   src="{{ b.settings.image | image_url: width: 1000, format: 'webp' }}"
                   srcset="{{ b.settings.image | image_url: width: 500, format: 'webp' }} 500w, {{ b.settings.image | image_url: width: 800, format: 'webp' }} 800w, {{ b.settings.image | image_url: width: 1000, format: 'webp' }} 1000w, {{ b.settings.image | image_url: width: 1400, format: 'webp' }} 1400w"
                   sizes="(max-width: 989px) 92vw, 430px"
                   width="{{ b.settings.image.width }}" height="{{ b.settings.image.height }}"
                   alt="{{ b.settings.image.alt | default: section.settings.headline | strip_html | escape }}"
                   {% if forloop.first %}loading="eager" fetchpriority="high"{% else %}loading="lazy"{% endif %} decoding="async">
            {%- endif -%}
          {%- endfor -%}
        </div>
        {%- if slides.size > 1 -%}
          <div class="obq__thumbrow">
            <button type="button" class="obq__arrow" data-obq-prev aria-label="Previous image"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg></button>
            <div class="obq__thumbs">
              {%- for b in slides -%}
                {%- if b.settings.image != blank -%}
                  <button type="button" class="obq__thumb{% if forloop.first %} is-active{% endif %}" data-obq-thumb aria-label="View image {{ forloop.index }}"><img src="{{ b.settings.image | image_url: width: 160, format: 'webp' }}" alt="" loading="lazy" decoding="async"></button>
                {%- endif -%}
              {%- endfor -%}
            </div>
            <button type="button" class="obq__arrow" data-obq-next aria-label="Next image"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6"/></svg></button>
          </div>
        {%- endif -%}
      </div>

      <div class="obq__buybox">
        <div class="obq__panel" data-obq-panel>

          <p class="obq__step">{{ section.settings.step1_label }}</p>
          <div class="obq__cards" role="radiogroup" aria-label="{{ section.settings.step1_label | escape }}">
            {%- assign n = 0 -%}
            {%- for b in qtys -%}
              {%- assign want = b.settings.variant_id | strip -%}
              {%- assign tv = blank -%}
              {%- if prod != blank and want != blank -%}
                {%- for v in prod.variants -%}
                  {%- assign vs = v.id | append: '' -%}
                  {%- if vs == want -%}{%- assign tv = v -%}{%- break -%}{%- endif -%}
                {%- endfor -%}
              {%- endif -%}
              {%- comment -%} Skip a tier whose variant id no longer resolves on the product. {%- endcomment -%}
              {%- if tv != blank -%}
                {%- assign n = n | plus: 1 -%}

                {%- assign bottles = b.settings.bottles | plus: 0 -%}
                {%- if bottles < 1 -%}{%- assign bottles = 1 -%}{%- endif -%}

                {%- comment -%} one-time {%- endcomment -%}
                {%- assign ot = tv.price -%}
                {%- assign msrp = 0 -%}
                {%- if tv.compare_at_price > tv.price -%}
                  {%- assign msrp = tv.compare_at_price -%}
                {%- else -%}
                  {%- assign derived = unit_price | times: bottles -%}
                  {%- if derived > tv.price -%}{%- assign msrp = derived -%}{%- endif -%}
                {%- endif -%}

                {%- comment -%} subscription: allocation matching this tier's plan {%- endcomment -%}
                {%- assign plan_want = b.settings.selling_plan_id | strip -%}
                {%- assign sub = 0 -%}
                {%- for a in tv.selling_plan_allocations -%}
                  {%- assign ps = a.selling_plan.id | append: '' -%}
                  {%- if ps == plan_want -%}{%- assign sub = a.price -%}{%- break -%}{%- endif -%}
                {%- endfor -%}
                {%- assign has_sub = true -%}
                {%- if sub == 0 -%}{%- assign sub = ot -%}{%- assign has_sub = false -%}{%- endif -%}

                {%- comment -%} per-bottle via float so it rounds to the nearest cent {%- endcomment -%}
                {%- assign ot_per = ot | times: 1.0 | divided_by: bottles | round: 0 -%}
                {%- assign sub_per = sub | times: 1.0 | divided_by: bottles | round: 0 -%}
                {%- assign sub_save = ot | minus: sub -%}
                {%- comment -%}
                  "Regular price" is the MSRP where one exists, otherwise the
                  one-time price. That way the 1-spray tier — which has no
                  compare_at — still reports the real subscriber saving against
                  its $45 list price instead of showing nothing.
                {%- endcomment -%}
                {%- assign ot_save = 0 -%}
                {%- if msrp > 0 -%}{%- assign ot_save = msrp | minus: ot -%}{%- endif -%}
                {%- assign sub_reg = ot -%}
                {%- if msrp > 0 -%}{%- assign sub_reg = msrp -%}{%- endif -%}
                {%- assign sub_msrp_save = sub_reg | minus: sub -%}

                {%- assign sel = false -%}
                {%- if n == section.settings.default_qty -%}{%- assign sel = true -%}{%- endif -%}

                <label class="obq__card{% if sel %} is-selected{% endif %}"
                       data-obq-card
                       data-variant="{{ tv.id }}"
                       data-plan="{{ plan_want }}"
                       data-bottles="{{ bottles }}"
                       data-label="{{ b.settings.label | escape }}"
                       data-nights="{{ b.settings.nights }}"
                       data-cadence="{{ b.settings.cadence_text | escape }}"
                       data-ot-price="{{ ot | money_without_trailing_zeros }}"
                       data-ot-per="{{ ot_per | money_without_trailing_zeros }}"
                       data-sub-price="{{ sub | money_without_trailing_zeros }}"
                       data-sub-per="{{ sub_per | money_without_trailing_zeros }}"
                       data-sub-save="{{ sub_save | money_without_trailing_zeros }}"
                       data-msrp="{% if msrp > 0 %}{{ msrp | money_without_trailing_zeros }}{% endif %}"
                       data-ot-save="{% if ot_save > 0 %}{{ ot_save | money_without_trailing_zeros }}{% endif %}"
                       data-sub-msrp-save="{% if sub_msrp_save > 0 %}{{ sub_msrp_save | money_without_trailing_zeros }}{% endif %}"
                       data-has-sub="{{ has_sub }}"
                       {{ b.shopify_attributes }}>
                  <input type="radio" name="obq-qty-{{ section.id }}" value="{{ n }}" {% if sel %}checked{% endif %}>
                  {%- if b.settings.badge != blank -%}
                    <span class="obq__flag obq__flag--{{ b.settings.badge_style }}">{{ b.settings.badge }}</span>
                  {%- endif -%}
                  <span class="obq__bottles" aria-hidden="true">
                    {%- for i in (1..bottles) -%}
                      {%- if section.settings.bottle_image != blank -%}
                        <img src="{{ section.settings.bottle_image | image_url: width: 140, format: 'webp' }}" alt="" loading="lazy" decoding="async">
                      {%- else -%}
                        <img src="{{ 'spray-bottle-sm.png' | asset_url }}" alt="" loading="lazy" decoding="async">
                      {%- endif -%}
                    {%- endfor -%}
                  </span>
                  <span class="obq__cname">{{ b.settings.label }}</span>
                  {%- if b.settings.nights != blank -%}<span class="obq__cnights">{{ b.settings.nights }} nights</span>{%- endif -%}
                  <span class="obq__cprice">
                    <span class="obq__cprice-now" data-obq-card-price>{{ sub | money_without_trailing_zeros }}</span>
                    <span class="obq__cprice-was" data-obq-card-was>{% if msrp > 0 %}{{ msrp | money_without_trailing_zeros }}{% endif %}</span>
                  </span>
                  <span class="obq__cper" data-obq-card-per>{{ sub_per | money_without_trailing_zeros }}/bottle</span>
                </label>
              {%- endif -%}
            {%- endfor -%}
          </div>

          <p class="obq__step obq__step--two">{{ section.settings.step2_label }}</p>
          <div class="obq__plans" role="radiogroup" aria-label="{{ section.settings.step2_label | escape }}">

            <label class="obq__plan is-selected" data-obq-plan="sub">
              <input type="radio" name="obq-plan-{{ section.id }}" value="sub" checked>
              <span class="obq__strip">
                <span>{{ section.settings.sub_strip_text }}</span>
                {%- if section.settings.recommended_text != blank -%}<span class="obq__reco">{{ section.settings.recommended_text }}</span>{%- endif -%}
              </span>
              <span class="obq__prow">
                <span class="obq__radio" aria-hidden="true"></span>
                <span class="obq__pinfo">
                  <span class="obq__ptitle">{{ section.settings.sub_title }}</span>
                  <span class="obq__psub" data-obq-sub-cadence></span>
                </span>
                <span class="obq__pright">
                  <span class="obq__pprice">
                    <span class="obq__pnow" data-obq-sub-price></span>
                    <span class="obq__pwas" data-obq-sub-was></span>
                  </span>
                  <span class="obq__pmeta obq__pmeta--green" data-obq-sub-meta></span>
                </span>
              </span>
            </label>

            <label class="obq__plan" data-obq-plan="onetime">
              <input type="radio" name="obq-plan-{{ section.id }}" value="onetime">
              <span class="obq__prow">
                <span class="obq__radio" aria-hidden="true"></span>
                <span class="obq__pinfo">
                  <span class="obq__ptitle">{{ section.settings.onetime_title }}</span>
                  <span class="obq__psub">{{ section.settings.onetime_sub }}</span>
                </span>
                <span class="obq__pright">
                  <span class="obq__pprice">
                    <span class="obq__pnow" data-obq-ot-price></span>
                    <span class="obq__pwas" data-obq-ot-was></span>
                  </span>
                  <span class="obq__pmeta obq__pmeta--muted" data-obq-ot-meta></span>
                </span>
              </span>
            </label>
          </div>

          {%- if section.settings.show_summary -%}
            <div class="obq__summary" data-obq-summary>
              <span class="obq__sline"><span class="obq__tick" aria-hidden="true">&#10003;</span><span data-obq-sum1></span></span>
              <span class="obq__sline"><span class="obq__tick" aria-hidden="true">&#10003;</span><span data-obq-sum2></span></span>
              <span class="obq__sline"><span class="obq__tick" aria-hidden="true">&#10003;</span><span data-obq-sum3></span></span>
            </div>
          {%- endif -%}

          {%- if section.settings.show_ships_bar -%}
            <div class="obq__ships">
              <span><span class="obq__gdot" aria-hidden="true">&#9679;</span> {{ section.settings.ships_by_label }} <b>{{ ship_date }}</b></span>
              <span>{{ section.settings.ships_right_text }}</span>
            </div>
          {%- endif -%}

          <button type="button" class="obq__buy" data-obq-buy>
            <span>{{ section.settings.button_label }}</span>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
          </button>

          <div class="obq__trust">
            {%- if section.settings.guarantee_text != blank -%}<span>&#10003; {{ section.settings.guarantee_text }}</span>{%- endif -%}
            <span data-obq-trust2></span>
          </div>

          {%- if section.settings.show_payment_icons -%}
            {%- assign hidden_pay = section.settings.hidden_payments | default: '' | downcase | replace: ' ', '' | split: ',' -%}
            <div class="obq__payments">
              {%- for type in shop.enabled_payment_types -%}{%- unless hidden_pay contains type -%}{{ type | payment_type_svg_tag: class: 'payment-icon' }}{%- endunless -%}{%- endfor -%}
            </div>
          {%- endif -%}
        </div>

        {{ obq_urgency }}

        {%- assign has_tabs = false -%}
        {%- for b in section.blocks -%}{%- if b.type == 'tab' and b.settings.title != blank -%}{%- assign has_tabs = true -%}{%- endif -%}{%- endfor -%}
        {%- if has_tabs -%}
          <div class="obq__tabs">
            {%- assign tab_n = 0 -%}
            {%- for b in section.blocks -%}{%- if b.type == 'tab' -%}
              {%- assign tab_n = tab_n | plus: 1 -%}
              <div class="obq__tab{% if tab_n == 1 %} is-open{% endif %}" {{ b.shopify_attributes }}>
                <button type="button" class="obq__tab-q" aria-expanded="{% if tab_n == 1 %}true{% else %}false{% endif %}"><span>{{ b.settings.title }}</span>{{ obq_chevron }}</button>
                <div class="obq__tab-a"><div class="obq__tab-a-inner"><div class="obq__tab-body">{{ b.settings.content }}{%- assign tab_t = b.settings.title | downcase -%}{%- if tab_t contains 'ingredient' -%}{% render 'supplement-label-button', product: prod %}{%- endif -%}</div></div></div>
              </div>
            {%- endif -%}{%- endfor -%}
          </div>
        {%- endif -%}

        {%- if section.settings.show_trusted -%}
          {% render 'trusted-by',
            title: section.settings.trusted_title,
            subtext: section.settings.trusted_subtext,
            image_1: section.settings.trusted_image_1,
            image_2: section.settings.trusted_image_2,
            image_3: section.settings.trusted_image_3,
            bg_color: section.settings.trusted_bg,
            check_color: section.settings.trusted_check %}
        {%- endif -%}
      </div>
    </div>
  </div>
  {% render 'supplement-label-popup', product: prod %}
</section>

<script>
(function () {
  var sec = document.getElementById('obq-{{ section.id }}');
  if (!sec) return;

  var panel = sec.querySelector('[data-obq-panel]');
  var cards = [].slice.call(sec.querySelectorAll('[data-obq-card]'));
  var planRows = [].slice.call(sec.querySelectorAll('[data-obq-plan]'));
  if (!panel || !cards.length) return;

  /* Copy targets. Nothing below computes money — every price string was
     rendered by Liquid from live Shopify data and parked on a data-* attr. */
  var subPrice  = sec.querySelector('[data-obq-sub-price]');
  var subWas    = sec.querySelector('[data-obq-sub-was]');
  var subMeta   = sec.querySelector('[data-obq-sub-meta]');
  var subCad    = sec.querySelector('[data-obq-sub-cadence]');
  var otPrice   = sec.querySelector('[data-obq-ot-price]');
  var otWas     = sec.querySelector('[data-obq-ot-was]');
  var otMeta    = sec.querySelector('[data-obq-ot-meta]');
  var sum1      = sec.querySelector('[data-obq-sum1]');
  var sum2      = sec.querySelector('[data-obq-sum2]');
  var sum3      = sec.querySelector('[data-obq-sum3]');
  var trust2    = sec.querySelector('[data-obq-trust2]');

  var COPY = {
    subShip:   {{ section.settings.summary_ship_sub | json }},
    otShip:    {{ section.settings.summary_ship_onetime | json }},
    trustSub:  {{ section.settings.trust_sub_text | json }},
    trustOne:  {{ section.settings.trust_onetime_text | json }},
    perBottle: {{ section.settings.per_bottle_suffix | json }},
    saveWord:  {{ section.settings.save_word | json }},
    sumNights: {{ section.settings.summary_nights_text | json }},
    sumSave:   {{ section.settings.summary_save_text | json }}
  };

  function d(el, name) { return el.getAttribute(name) || ''; }
  function set(el, txt) { if (el) el.textContent = txt; }
  function setHtml(el, html) { if (el) el.innerHTML = html; }

  function selectedCard() {
    for (var i = 0; i < cards.length; i++) {
      var input = cards[i].querySelector('input');
      if (input && input.checked) return cards[i];
    }
    return cards[0];
  }

  function selectedPlan() {
    for (var i = 0; i < planRows.length; i++) {
      var input = planRows[i].querySelector('input');
      if (input && input.checked) return planRows[i].getAttribute('data-obq-plan');
    }
    return 'sub';
  }

  /* Only the cutoff time is generated client-side — it depends on the
     visitor's clock, so Liquid cannot render it. Pinned to Eastern so it
     reads honestly for shoppers in other zones. */
  function cutoffNow() {
    try {
      return new Intl.DateTimeFormat('en-US', {
        timeZone: 'America/New_York', hour: 'numeric', minute: '2-digit', hour12: true
      }).format(new Date(Date.now() + 3600000)) + ' ET';
    } catch (e) {
      var t = new Date(Date.now() + 3600000);
      var h = t.getHours() % 12 || 12;
      return h + ':' + ('0' + t.getMinutes()).slice(-2) + (t.getHours() < 12 ? ' AM' : ' PM');
    }
  }

  var urgencyEls = [].slice.call(sec.querySelectorAll('[data-obq-urgency]'));
  var urgencyTpl = urgencyEls.map(function (el) { return el.innerHTML; });
  function paintUrgency() {
    var c = cutoffNow();
    urgencyEls.forEach(function (el, i) {
      el.innerHTML = urgencyTpl[i].replace('{cutoff}', '<b>' + c + '</b>');
    });
  }

  function render() {
    var card = selectedCard();
    var plan = selectedPlan();
    var isSub = plan === 'sub';

    cards.forEach(function (c) { c.classList.toggle('is-selected', c === card); });
    planRows.forEach(function (r) {
      r.classList.toggle('is-selected', r.getAttribute('data-obq-plan') === plan);
    });

    var msrp   = d(card, 'data-msrp');
    var otP    = d(card, 'data-ot-price');
    var otPer  = d(card, 'data-ot-per');
    var subP   = d(card, 'data-sub-price');
    var subPer = d(card, 'data-sub-per');
    var subSav = d(card, 'data-sub-save');

    /* Step 1 card prices follow the chosen plan. */
    cards.forEach(function (c) {
      set(c.querySelector('[data-obq-card-price]'), isSub ? d(c, 'data-sub-price') : d(c, 'data-ot-price'));
      set(c.querySelector('[data-obq-card-was]'), d(c, 'data-msrp'));
      set(c.querySelector('[data-obq-card-per]'), (isSub ? d(c, 'data-sub-per') : d(c, 'data-ot-per')) + COPY.perBottle);
    });

    /* Step 2 rows always show both prices for the chosen quantity. */
    set(subPrice, subP);
    set(subWas, otP);
    set(subMeta, subPer + COPY.perBottle + ' · ' + COPY.saveWord + ' ' + subSav);
    set(subCad, d(card, 'data-cadence'));
    set(otPrice, otP);
    set(otWas, msrp);
    set(otMeta, otPer + COPY.perBottle);

    /* Summary */
    var per = isSub ? subPer : otPer;
    setHtml(sum1, '<b>' + d(card, 'data-label') + '</b> — ' +
      COPY.sumNights.replace('{nights}', d(card, 'data-nights')).replace('{per}', '<b>' + per + '</b>'));
    set(sum2, isSub ? COPY.subShip : COPY.otShip);
    var save = isSub ? d(card, 'data-sub-msrp-save') : d(card, 'data-ot-save');
    if (sum3) {
      if (save) {
        setHtml(sum3, COPY.sumSave.replace('{amount}', '<b>' + save + '</b>'));
        sum3.parentNode.style.display = '';
      } else {
        sum3.parentNode.style.display = 'none';
      }
    }

    set(trust2, '✓ ' + (isSub ? COPY.trustSub : COPY.trustOne));
  }

  cards.forEach(function (c) {
    var input = c.querySelector('input');
    c.addEventListener('click', function () { if (input) { input.checked = true; } render(); });
    if (input) input.addEventListener('change', render);
  });

  planRows.forEach(function (r) {
    var input = r.querySelector('input');
    r.addEventListener('click', function () { if (input) { input.checked = true; } render(); });
    if (input) input.addEventListener('change', render);
  });

  render();
  paintUrgency();
  setInterval(paintUrgency, 20000);

  /* ---- Gallery ---- */
  var mains = [].slice.call(sec.querySelectorAll('[data-obq-main]'));
  var thumbs = [].slice.call(sec.querySelectorAll('[data-obq-thumb]'));
  var idx = 0;
  function setImg(i) {
    if (!mains.length) return;
    idx = (i + mains.length) % mains.length;
    mains.forEach(function (img, j) { img.hidden = j !== idx; });
    thumbs.forEach(function (t, j) { t.classList.toggle('is-active', j === idx); });
    var t = thumbs[idx];
    if (t && t.scrollIntoView) t.scrollIntoView({ block: 'nearest', inline: 'nearest' });
  }
  thumbs.forEach(function (t, i) { t.addEventListener('click', function () { setImg(i); }); });
  var prev = sec.querySelector('[data-obq-prev]'), next = sec.querySelector('[data-obq-next]');
  if (prev) prev.addEventListener('click', function () { setImg(idx - 1); });
  if (next) next.addEventListener('click', function () { setImg(idx + 1); });

  var main = sec.querySelector('.obq__main');
  if (main && mains.length > 1) {
    var sx = null, sy = null;
    main.addEventListener('touchstart', function (e) { var t = e.touches[0]; sx = t.clientX; sy = t.clientY; }, { passive: true });
    main.addEventListener('touchend', function (e) {
      if (sx === null) return;
      var t = e.changedTouches[0], dx = t.clientX - sx, dy = t.clientY - sy;
      if (Math.abs(dx) > 40 && Math.abs(dx) > Math.abs(dy)) setImg(dx < 0 ? idx + 1 : idx - 1);
      sx = null; sy = null;
    }, { passive: true });
  }

  /* ---- Accordion ---- */
  var tabs = sec.querySelectorAll('.obq__tab');
  sec.querySelectorAll('.obq__tab-q').forEach(function (btn) {
    btn.addEventListener('click', function () {
      var tab = btn.closest('.obq__tab');
      var willOpen = !tab.classList.contains('is-open');
      tabs.forEach(function (t) {
        t.classList.remove('is-open');
        var b = t.querySelector('.obq__tab-q');
        if (b) b.setAttribute('aria-expanded', 'false');
      });
      if (willOpen) { tab.classList.add('is-open'); btn.setAttribute('aria-expanded', 'true'); }
    });
  });

  /* ---- Buy: variant + selling plan when subscribing ---- */
  var buy = sec.querySelector('[data-obq-buy]');
  if (buy) {
    window.addEventListener('pageshow', function () { buy.disabled = false; buy.classList.remove('is-loading'); });
    buy.addEventListener('click', function () {
      var card = selectedCard();
      var id = parseInt(d(card, 'data-variant'), 10);
      if (!id) return;
      var item = { id: id, quantity: 1 };
      if (selectedPlan() === 'sub' && d(card, 'data-has-sub') === 'true') {
        item.selling_plan = parseInt(d(card, 'data-plan'), 10);
      }
      buy.disabled = true; buy.classList.add('is-loading');
      fetch('/cart/clear.js', { method: 'POST', headers: { 'Content-Type': 'application/json' } })
        .then(function () {
          return fetch('/cart/add.js', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ items: [item] })
          });
        })
        .then(function (r) { if (!r.ok) throw new Error('add failed'); window.location.href = '/checkout'; })
        .catch(function () { window.location.href = '/cart/' + id + ':1'; });
    });
  }

  /* ---- Hide the sticky CTA bar while this section is in view ---- */
  if ('IntersectionObserver' in window) {
    var io = new IntersectionObserver(function (entries) {
      var vis = entries[0].isIntersecting;
      document.body.classList.toggle('ob-offer-visible', vis);
      document.querySelectorAll('.sticky-cta-v2-section').forEach(function (el) {
        if (vis) el.style.setProperty('display', 'none', 'important');
        else el.style.removeProperty('display');
      });
    }, { threshold: 0 });
    io.observe(sec);
  }
})();
</script>

