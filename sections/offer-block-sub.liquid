{%- comment -%}
  Offer Block SUB — variant 5a "Offer-Led", subscription edition (BOGOSub template).

  Differences from offer-block:
   - The headline IS the offer, not the product name; adds a review bar,
     and the ships-by bar above Buy Now (as on the senior page).
     Purple CTA with an arrow. No Facebook review block.
   - Gallery images come from section blocks uploaded in the customizer,
     NOT from a product's media.
   - Buy Now adds a one-time purchase, same as the BOGO template. The
     subscription path (per-tier Skio selling plan) is removed for now.

  Lifted unchanged from the existing BOGO template: payment icons,
  sub-CTA trust rows, the six-row
  content accordion, the trusted-by "500,000+ customers" bar, the
  supplement-label popup, the desktop sticky gallery column, and the
  sticky-CTA hide contract (body.ob-offer-visible).

  Setup: upload the five gallery images into the Gallery image blocks and set
  each tier's Variant ID.
{%- endcomment -%}

{% style %}
html { scroll-behavior: smooth; }
body.ob-offer-visible .sticky-cta-v2-section,
body.ob-offer-visible #shopify-section-sticky-cta-v2 { display: none !important; }
/* Desktop sticky gallery: the theme's .content-wrapper has overflow:hidden,
   which breaks position:sticky. Switch ancestors to clip + visible. */
@media (min-width: 901px) {
  main:has(.obs-{{ section.id }}), .content-wrapper:has(.obs-{{ section.id }}) { overflow-x: clip; overflow-y: visible; }
  #shopify-section-{{ section.id }} { overflow-x: clip; overflow-y: visible; }
}

.obs-{{ section.id }} {
  background-color: {{ section.settings.section_bg | default: '#ffffff' }};
  font-family: 'Helvetica Neue', Arimo, Helvetica, Arial, sans-serif;
}
/* Neutralize theme-wide text styling, then re-apply per element via vars. */
.obs-{{ section.id }}, .obs-{{ section.id }} *, .obs-{{ section.id }} *::before, .obs-{{ section.id }} *::after {
  text-transform: var(--tt, none) !important;
  letter-spacing: var(--ls, normal) !important;
  word-spacing: normal !important;
  box-sizing: border-box;
}

/* Gallery column matches the product page (500px at a 1280 viewport, the
   common desktop case; the product page is fluid, this stays capped). The
   wrap grows 1120 -> 1190 by the same 70px so the buy-box column keeps its
   574px instead of being squeezed. */
/* Gallery column is fixed at /pages/bogo's 560px on every BOGO page (code, not the template setting, because template JSON edits don't deploy). */
.obs__wrap { max-width: 1190px; margin: 0 auto; padding: 36px; display: grid; grid-template-columns: 560px minmax(0, 1fr); grid-template-areas: "gallery header" "gallery buybox"; column-gap: 44px; row-gap: 0; align-items: start; }
.obs__header { grid-area: header; min-width: 0; }
.obs__gallery { grid-area: gallery; min-width: 0; align-self: stretch; }
.obs__buybox { grid-area: buybox; min-width: 0; }
.obs__left-inner { position: sticky; top: {{ section.settings.sticky_offset | default: 16 }}px; display: flex; flex-direction: column; gap: 16px; }

/* ---- Gallery (customizer images) ---- */
.obs__main { position: relative; background: {{ section.settings.gallery_bg | default: '#F8EFE4' }}; border-radius: 16px; aspect-ratio: 1 / 1; display: flex; align-items: center; justify-content: center; overflow: hidden; }
.obs__main img[data-obs-main] { width: 100%; height: 100%; object-fit: {{ section.settings.gallery_fit | default: 'cover' }}; display: block; }
/* the rule above sets display:block, which overrides the hidden attribute -
   this restores it so only the active slide renders */
.obs__main img[data-obs-main][hidden] { display: none; }
.obs__thumbrow { display: flex; align-items: center; justify-content: center; gap: 8px; margin-top: 12px; }
.obs__arrow { flex: none; width: 28px; height: 28px; border: none; background: none; color: #672666; display: flex; align-items: center; justify-content: center; cursor: pointer; padding: 0; transition: color .14s ease; }
.obs__arrow:hover { color: #4a1a4c; }
.obs__arrow svg { width: 18px; height: 18px; display: block; }
.obs__thumbs { display: flex; gap: 8px; overflow-x: auto; scrollbar-width: none; -ms-overflow-style: none; max-width: 100%; }
.obs__thumbs::-webkit-scrollbar { display: none; }
.obs__thumb { flex: none; width: 57px; height: 57px; border: 1px solid #e9e4f0; border-radius: 12px; background: #f3f0f9; display: flex; align-items: center; justify-content: center; overflow: hidden; cursor: pointer; padding: 0; }
.obs__thumb img { width: 100%; height: 100%; object-fit: cover; display: block; }
.obs__thumb.is-active { border: 1.5px solid #672666; background: #fff; }
.obs__dots { display: flex; gap: 5px; justify-content: center; margin-top: 10px; }
.obs__dot { width: 6px; height: 6px; border-radius: 50%; background: #ddd7e6; transition: background .14s ease; }
.obs__dot.is-active { background: #672666; }

/* ---- Review bar ---- */
.obs__reviewbar { display: flex; align-items: center; gap: 10px; font-size: 16px; color: #4a4550; flex-wrap: wrap; }
.obs__reviewbar .obs__stars { display: inline-flex; gap: 1.5px; flex-shrink: 0; }
.obs__reviewbar .obs__stars svg { width: 15px; height: 15px; display: block; }
.obs__rb-strong { font-weight: 400; }
.obs__rb-sep { color: #d9d3e0; }
.obs__reviewbar strong, .obs__reviewbar b { color: #171512; font-weight: 800; }
.obs__reviewbar p { margin: 0; display: inline; }

/* ---- Offer headline ---- */
.obs__headline { --ls: -1.4px; font-size: 46px; line-height: 1.04; font-weight: 800; color: #171512; margin: 16px 0 0; }
.obs__subtitle { font-size: 22px; line-height: 1.35; color: #4a4550; margin: 12px 0 0; }


/* ---- Tier boxes: the bogo-og design (Nov 2026; that page is retired). Buy 3 is plain Buy 3, Get 3 FREE, so the automatic B3G3 discount applies at checkout. ---- */
.obs__tiers { display: flex; flex-direction: column; gap: 22px; margin-top: 18px; }
.obs__tier { position: relative; display: flex; align-items: center; gap: 28px; background: #fff; border: 1.5px solid #dcdce2; border-radius: 13px; padding: 28px 30px; cursor: pointer; transition: background .15s ease, border-color .15s ease; box-sizing: border-box; }
.obs__tier.is-selected { border-color: var(--obs-accent, #672666); box-shadow: inset 0 0 0 1.5px var(--obs-accent, #672666); background: var(--obs-selected, #f4ecf7); }
.obs__tier input { position: absolute; opacity: 0; pointer-events: none; }
.obs__radio { flex-shrink: 0; width: 22px; height: 22px; border-radius: 50%; border: 2px solid var(--obs-accent, #672666); position: relative; }
.obs__tier.is-selected .obs__radio::after { content: ''; position: absolute; inset: 4px; border-radius: 50%; background: var(--obs-accent, #672666); }
.obs__bundle { flex-shrink: 0; width: 112px; height: auto; display: block; }
.obs__tinfo { min-width: 0; display: flex; flex-direction: column; gap: 15px; text-align: left; }
.obs__tname { font-size: 26px; font-weight: 700; color: var(--obs-accent, #672666); line-height: 1.1; white-space: nowrap; }
.obs__prices { display: flex; align-items: baseline; gap: 10px; flex-wrap: nowrap; white-space: nowrap; }
.obs__price { font-size: 29px; font-weight: 700; color: #141414; }
.obs__struck { font-size: 21px; font-weight: 400; color: #b7b7be; text-decoration: line-through; }
.obs__save { --tt: uppercase; display: inline-flex; align-items: center; justify-content: center; align-self: center; font-family: var(--rj-title-font-family, 'HelveticaNeueL', 'Helvetica Neue', Helvetica, Arial, sans-serif); font-size: 16px; font-weight: 700; line-height: 1; color: #018e1c; background: #dcf5df; border-radius: 100px; padding: 6px 11px 5px; white-space: nowrap; }
.obs__ship { font-size: 18px; font-weight: 700; color: #141414; }
.obs__pernight { font-size: 20px; font-weight: 400; font-style: italic; color: #8c8c92; }
/* caps-only text: extra top pad offsets the font's empty descender space so the label is optically centred */
.obs__badge { position: absolute; top: -13px; right: 16px; font-family: var(--rj-title-font-family, 'HelveticaNeueL', 'Helvetica Neue', Helvetica, Arial, sans-serif); font-size: 14px; font-weight: 700; line-height: 1; padding: 8px 12px 4px; border-radius: 100px; white-space: nowrap; z-index: 1; }
.obs__badge--plum { background: var(--obs-badge, #5d215f); color: #fff; }
.obs__badge--gold { background: #EAC78B; color: #141414; }

/* ---- CTA (purple, with arrow) ---- */
.obs__cta-wrap { margin-top: 18px; }
/* Ships-by bar above Buy Now, spaced as on the senior page. */
.obs__cta-wrap .ship-bar--stack { margin-top: -8px; margin-bottom: 14px; }
.obs__buy { width: 100%; display: inline-flex; align-items: center; justify-content: center; gap: 10px; background: #672666; color: #fff; font-family: inherit; font-weight: 500; font-size: 18px; letter-spacing: normal; line-height: 1; padding: 24px 32px; border: none; border-radius: 100px; cursor: pointer; transition: opacity .25s ease; }
.obs__buy:hover { opacity: 0.9; }
.obs__buy:active { opacity: 0.9; }
.obs__buy:disabled { cursor: default; }
.obs__buy svg { flex: none; width: 20px; height: 20px; }
.obs__spinner { display: none; width: 22px; height: 22px; border: 2.5px solid rgba(255,255,255,.4); border-top-color: #fff; border-radius: 50%; animation: obs-spin .6s linear infinite; }
.obs__buy.is-loading .obs__buy-label, .obs__buy.is-loading svg { display: none; }
.obs__buy.is-loading .obs__spinner { display: block; }
@keyframes obs-spin { to { transform: rotate(360deg); } }

/* ---- Sub-CTA trust rows ---- */
.obs__trust { display: flex; flex-direction: column; align-items: center; gap: 8px; margin-top: 16px; }
.obs__trust span.obs__check { color: #672666; }
.obs__trust-item { display: inline-flex; align-items: center; gap: 8px; font-size: 14px; font-weight: 600; letter-spacing: .03em; text-transform: uppercase; color: #4a4a4a; }
.obs__trust-item img { width: 17px; height: 17px; object-fit: contain; display: block; }
.obs__payments { display: flex; gap: 6px; justify-content: center; flex-wrap: wrap; margin-top: 12px; }
.obs__payments svg { height: 24px; width: auto; display: block; }

/* ---- Guarantee proof ---- */

/* ---- Accordion (same behaviour as the BOGO template) ---- */
.obs__tabs { margin-top: 26px; border-top: 1px solid #e6e2ec; }
.obs__tab { border-bottom: 1px solid #e6e2ec; }
.obs__tab-q { --ls: -.2px; width: 100%; display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 18px 4px; background: none; border: none; cursor: pointer; text-align: left; font-family: inherit; font-size: {{ section.settings.tab_title_size | default: 20 }}px; font-weight: 800; color: #171512; line-height: 1.3; }
.obs__tab-q > span { flex: 1 1 auto; min-width: 0; overflow-wrap: anywhere; }
.obs__chev { flex: none; width: 20px; height: 20px; color: #672666; transition: transform .22s ease; }
.obs__tab.is-open .obs__chev { transform: rotate(180deg); }
.obs__tab-a { display: grid; grid-template-rows: 0fr; transition: grid-template-rows 260ms cubic-bezier(.22,1,.36,1); }
.obs__tab.is-open .obs__tab-a { grid-template-rows: 1fr; }
.obs__tab-a-inner { overflow: hidden; }
.obs__tab-body { text-align: left; font-size: {{ section.settings.tab_body_size | default: 17 }}px; line-height: 1.55; color: #4a4550; padding: 0 4px 18px; max-width: 60ch; }
.obs__tab-body p { margin: 0 0 10px; }
.obs__tab-body p:last-child { margin-bottom: 0; }
.obs__tab-body strong { color: #171512; font-weight: 800; }

/* ---- Mobile ---- */
@media (max-width: 900px) {
  .obs-{{ section.id }} { overflow-x: clip; }
  .obs__wrap { display: flex; flex-direction: column; padding: 18px 16px; }
  .obs__left-inner { position: static; gap: 0; }
  .obs__reviewbar { justify-content: flex-start; gap: 7px; font-size: 16px; }
  .obs__reviewbar .obs__rb-strong,
  .obs__reviewbar .obs__rb-sep-reviews { display: none; }
  .obs__reviewbar .obs__rb-customers { order: 1; }
  .obs__reviewbar .obs__rb-sep-customers { order: 2; }
  .obs__reviewbar .obs__rb-reviews { order: 3; }
  .obs__reviewbar .obs__stars svg { width: 12px; height: 12px; }
  .obs__rb-hide-mobile { display: none; }
  /* 30px on mobile with half the old tracking (was 29px at -1.1px, which read cramped). Fixed in code: template JSON edits don't deploy. */
  .obs__headline { font-size: 33px; line-height: 1.08; --ls: -0.55px; text-align: left; margin-top: 12px; }
  .obs__subtitle { font-size: 18.5px; text-align: left; padding: 0; margin-top: 8px; }
  .obs__gallery { order: 1; }
  .obs__thumbrow { margin-top: 6px; }
  .obs__header { order: 2; margin-top: 16px; }
  .obs__buybox { order: 3; margin-top: 2px; }
  .obs__tiers { gap: 18px; margin-top: 16px; }
  .obs__tier { gap: 18px; padding: 16px 16px 16px 14px; border: 1.6px solid #9a679b; }
  .obs__tinfo { gap: 10px; }
  .obs__bundle { width: 83px; margin-left: -7px; }
  .obs__tname { font-size: 21px; white-space: normal; }
  .obs__prices { gap: 7px; flex-wrap: wrap; white-space: normal; }
  .obs__price { font-size: 24px; }
  .obs__struck { font-size: 18px; }
  .obs__save { font-size: 14px; padding: 5px 10px 4px; }
  .obs__ship { font-size: 15px; }
  .obs__pernight { font-size: 18px; }
  .obs__badge { font-size: 12px; padding: 7px 12px 4px; }
  .obs__buy { font-size: clamp(15px, 4.6vw, 18px); padding: 24px 20px; }
  .obs__trust { gap: 8px; }
  .obs__payments { gap: 5px; margin-top: 10px; }
  .obs__payments svg { height: 22px; }
  .obs__tabs { margin-top: 18px; }
  .obs__tab-q { font-size: {{ section.settings.tab_title_size_mobile | default: 19 }}px; }
  .obs__tab-body { font-size: {{ section.settings.tab_body_size_mobile | default: 16 }}px; }
}
{% endstyle %}

{%- capture obs_star -%}<svg viewBox="0 0 18 16" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M3.85124 15.9392C3.43952 16.1504 2.97233 15.7803 3.05553 15.3078L3.94083 10.2626L0.183091 6.68298C-0.167831 6.34806 0.0145632 5.73581 0.484948 5.66968L5.70931 4.9273L8.03883 0.31199C8.24895 -0.103997 8.81747 -0.103997 9.0276 0.31199L11.3571 4.9273L16.5815 5.66968C17.0519 5.73581 17.2343 6.34806 16.8823 6.68298L13.1256 10.2626L14.0109 15.3078C14.0941 15.7803 13.6269 16.1504 13.2152 15.9392L8.53161 13.5329L3.85124 15.9392Z" fill="{{ section.settings.stars_color | default: '#fab851' }}"/></svg>{%- endcapture -%}
{%- capture obs_chevron -%}<svg class="obs__chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>{%- endcapture -%}




<section class="obs obs-{{ section.id }}" id="obs-{{ section.id }}">
  <span id="offer" aria-hidden="true" style="display:block;scroll-margin-top:80px;"></span>
  <div class="obs__wrap">

    <div class="obs__header">
      <div class="obs__reviewbar">
        {%- if section.settings.show_stars -%}<span class="obs__stars" role="img" aria-label="5 stars">{{ obs_star }}{{ obs_star }}{{ obs_star }}{{ obs_star }}{{ obs_star }}</span>{%- endif -%}
        {%- if section.settings.rb_rating != blank -%}{%- assign rb_num = section.settings.rb_rating | split: ' ' | first -%}<span class="obs__rb-strong"><strong>{{ rb_num }}</strong> {{ section.settings.rb_rating | remove_first: rb_num | strip }}</span>{%- endif -%}
        {%- if section.settings.rb_reviews != blank -%}
          <span class="obs__rb-sep obs__rb-sep-reviews" aria-hidden="true">|</span>
          <span class="obs__rb-reviews">{{ section.settings.rb_reviews }}</span>
        {%- endif -%}
        {%- if section.settings.rb_customers != blank -%}
          <span class="obs__rb-sep obs__rb-sep-customers" aria-hidden="true">|</span>
          <span class="obs__rb-customers">{{ section.settings.rb_customers }}</span>
        {%- endif -%}
      </div>
      {%- comment -%} Every BOGO page (anniversary, Black Friday, welcome-kit, 3am, night shift, bogo-sub, listicle, fall-asleep-faster, travel, menopause) runs on this section and differs in headline and subtitle (3am, night shift, travel and menopause also in their trusted-by line and tab leads below; fall-asleep-faster keeps the old bogosub2 trusted-by line), set here by page URL because template JSON edits don't deploy. {%- endcomment -%}
      {%- assign obs_headline = section.settings.headline -%}{%- assign obs_subtitle = section.settings.subtitle -%}
      {%- if page.handle == 'black-friday' -%}
        {%- assign obs_headline = 'Black Friday Sale: Buy 1, Get 1 FREE' -%}
        {%- assign obs_subtitle = 'For Black Friday only, claim your BOGO on Rejuvia Sleep Spray to get the best sleep of your entire life.' -%}
      {%- elsif page.handle == 'welcome-kit' -%}
        {%- assign obs_headline = 'Rejuvia Welcome Kit' -%}
        {%- assign obs_subtitle = 'For a limited-time, claim your BOGO free offer on our Welcome Kit today' -%}
      {%- elsif page.handle == 'nightshift-bogo' -%}
        {%- assign obs_headline = 'The Night Shift Discount: Buy 1, Get 1 FREE' -%}
        {%- capture obs_subtitle -%}For everyone who works while the rest of us sleep. Get home at 7am and be asleep in 10–15 minutes, then wake up clear for your next shift. Just $15 a bottle, with a 90-day money-back guarantee.{%- endcapture -%}
      {%- elsif page.handle == '3am-wake-up-bogo' -%}
        {%- assign obs_headline = 'Stop Waking Up at 3AM: Buy 1, Get 1 FREE' -%}
        {%- capture obs_subtitle -%}Wide awake at 3am doing the sleep math? 6–8 sprays under your tongue at bedtime and you're asleep in 10–15 minutes, then sleep straight through to morning. Just $15 a bottle, about 50¢ a night, with a 90-day money-back guarantee.{%- endcapture -%}
      {%- elsif page.handle == 'bogo-fall-asleep-faster' -%}
        {%- assign obs_headline = 'Claim Your Buy One, Get One Free on Rejuvia Today' -%}
        {%- assign obs_subtitle = 'Free sprays automatically added to your cart. One-time purchase, backed by our 90-day money-back guarantee.' -%}
      {%- elsif page.handle == 'travel-bogo' -%}
        {%- capture obs_headline -%}Sleep Like You're in First Class With Rejuvia{%- endcapture -%}
        {%- capture obs_subtitle -%}Spray it under your tongue before takeoff and drift off in 10–15 minutes, on red-eyes, long-haul flights and in unfamiliar hotel rooms. Try it risk-free today as long as stock is still available.{%- endcapture -%}
      {%- elsif page.handle == 'menopause-bogo' -%}
        {%- capture obs_headline -%}Sleep Like You Did Before Menopause with Rejuvia{%- endcapture -%}
        {%- capture obs_subtitle -%}Rejuvia started as a sleep spray for our founder's mom, who couldn't sleep going through menopause. 6-8 sprays under your tongue and you drift off in 10–15 minutes. Try it risk-free today as long as stock is still available.{%- endcapture -%}
      {%- endif -%}
      {%- if obs_headline != blank -%}<h2 class="obs__headline">{{ obs_headline }}</h2>{%- endif -%}
      {%- comment -%} Pre-select the middle box; page.bogo pre-selects the first box (Buy 1, Get 1 FREE). Done in code, not the settings, because Shopify reverts template JSON edits from git. {%- endcomment -%}
      {%- assign pb_per_spray = false -%}{%- if template.suffix == 'bogo' -%}{%- assign pb_per_spray = true -%}{%- endif -%}
      {%- assign ob_tier_count = 0 -%}{%- for b in section.blocks -%}{%- if b.type == 'tier' -%}{%- assign ob_tier_count = ob_tier_count | plus: 1 -%}{%- endif -%}{%- endfor -%}
      {%- assign ob_default_tier = ob_tier_count | plus: 1 | divided_by: 2 -%}
      {%- if pb_per_spray -%}{%- assign ob_default_tier = 1 -%}{%- endif -%}
      {%- if obs_subtitle != blank -%}<p class="obs__subtitle">{{ obs_subtitle }}</p>{%- endif -%}
    </div>

    <div class="obs__gallery">
      <div class="obs__left-inner">
        {%- render 'bogo-gallery', id: section.id, alt: obs_headline -%}
      </div>
    </div>

    <div class="obs__buybox">


      {%- comment -%} Tier rows — each carries its own variant + Skio selling plan {%- endcomment -%}
      <div class="obs__tiers" role="radiogroup" aria-label="Choose your bundle">
        {%- assign tier_n = 0 -%}
        {%- for b in section.blocks -%}{%- if b.type == 'tier' -%}
          {%- assign tier_n = tier_n | plus: 1 -%}
          {%- assign tier_sel = false -%}
          {%- if tier_n == ob_default_tier -%}{%- assign tier_sel = true -%}{%- endif -%}

          {%- assign vid = b.settings.variant_id | strip -%}
          {%- assign srcprod = b.settings.product | default: section.settings.product -%}
          {%- assign tier_variant = blank -%}
          {%- if vid != blank and srcprod != blank -%}
            {%- for v in srcprod.variants -%}
              {%- assign vstr = v.id | append: '' -%}
              {%- if vstr == vid -%}{%- assign tier_variant = v -%}{%- break -%}{%- endif -%}
            {%- endfor -%}
          {%- endif -%}
          {%- if vid == blank and srcprod != blank -%}{%- assign vid = srcprod.selected_or_first_available_variant.id -%}{%- endif -%}
          {%- comment -%} Optional Skio selling plan: priced from the plan (first-order price x quantity) and added to the cart on it. Blank = one-time. {%- endcomment -%}
          {%- assign tqty = b.settings.quantity | default: section.settings.add_quantity | default: 1 -%}
          {%- assign tplan = b.settings.selling_plan | strip -%}{%- assign tplan_total = blank -%}{%- assign tplan_ok = '' -%}
          {%- if tplan != blank and tier_variant != blank -%}{%- for al in tier_variant.selling_plan_allocations -%}{%- assign alid = al.selling_plan.id | append: '' -%}{%- if alid == tplan -%}{%- assign tplan_total = al.price | times: tqty -%}{%- assign tplan_ok = tplan -%}{%- break -%}{%- endif -%}{%- endfor -%}{%- endif -%}

          {%- capture tier_price -%}
            {%- if section.settings.use_manual_prices and b.settings.price != blank -%}{{ b.settings.price }}
            {%- elsif tplan_total != blank -%}{{ tplan_total | money_without_trailing_zeros }}
            {%- elsif tier_variant != blank -%}{{ tier_variant.price | money_without_trailing_zeros }}
            {%- else -%}{{ b.settings.price }}{%- endif -%}
          {%- endcapture -%}
          {%- comment -%} Block's compare-at field wins when set (editable strikethrough); otherwise use the live variant's compare-at. {%- endcomment -%}
          {%- capture tier_compare -%}
            {%- if b.settings.compare_price != blank -%}{{ b.settings.compare_price }}
            {%- elsif tier_variant != blank and tier_variant.compare_at_price and tier_variant.compare_at_price > tier_variant.price -%}{{ tier_variant.compare_at_price | money_without_trailing_zeros }}{%- endif -%}
          {%- endcapture -%}

          {%- comment -%} Tier box: the retired bogo-og design. SAVE $X = strikethrough minus live price; + FREE Shipping on boxes 2 and 3 (both clear the $59 threshold); per night = box price over 2N bottles x 30 nights. {%- endcomment -%}
          {%- assign tc = tier_compare | strip -%}
          {%- assign t_sp = tier_price | replace: '$','' | replace: ',','' | strip | plus: 0.0 -%}{%- assign t_sc = tc | replace: '$','' | replace: ',','' | strip | plus: 0.0 -%}
          {%- assign t_save = b.settings.savings_text -%}{%- assign t_su = t_save | upcase -%}
          {%- if t_su contains 'SAVE $' and t_sc > t_sp and t_sp > 0 -%}{%- assign t_save = t_sc | minus: t_sp | times: 100 | round | money_without_trailing_zeros | prepend: 'SAVE ' -%}{%- endif -%}
          {%- assign t_pw = b.settings.label | remove: ',' | split: ' ' -%}{%- assign t_nights = t_pw[1] | plus: 0 | times: 60 -%}
          {%- assign t_night = blank -%}
          {%- if t_pw[0] == 'Buy' and t_nights > 0 and t_sp > 0 -%}{%- assign t_night = t_sp | times: 100 | divided_by: t_nights | round | money | append: ' Per Night' -%}{%- endif -%}
          <label class="obs__tier{% if tier_sel %} is-selected{% endif %}" {{ b.shopify_attributes }}>
            <input type="radio" name="obs-{{ section.id }}" value="{{ vid }}"
                   data-price="{{ tier_price | strip }}"
                   data-qty="{{ b.settings.quantity | default: section.settings.add_quantity | default: 1 }}"
                   data-plan="{{ tplan_ok }}"{% if tplan != blank and tplan_ok == blank %} data-plan-missing="true"{% endif %} {% if tier_sel %}checked{% endif %}>
            {%- if b.settings.badge != blank -%}<span class="obs__badge obs__badge--{{ b.settings.badge_style | default: 'plum' }}">{{ b.settings.badge }}</span>{%- endif -%}
            <span class="obs__radio" aria-hidden="true"></span>
            {%- if b.settings.image != blank -%}
              <img class="obs__bundle" src="{{ b.settings.image | image_url: width: 290, format: 'webp' }}" width="290" height="320" alt="" loading="lazy" decoding="async">
