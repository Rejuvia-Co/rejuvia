                {%- if section.settings.onetime_icon != blank -%}<img src="{{ section.settings.onetime_icon | image_url: width: 60 }}" alt="" width="17" height="17" loading="lazy" decoding="async">{%- else -%}<svg width="17" height="17" viewBox="0 0 24 24" fill="none"><rect x="4" y="10" width="16" height="11" rx="2.5" stroke="#5d215f" stroke-width="1.8"/><path d="M8 10V7a4 4 0 0 1 8 0v3" stroke="#5d215f" stroke-width="1.8" stroke-linecap="round"/></svg>{%- endif -%}
                {{ section.settings.onetime_text }}
              </span>
            {%- endif -%}
