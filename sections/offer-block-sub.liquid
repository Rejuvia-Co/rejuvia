              <img class="obs__bundle" src="{{ b.settings.image_asset | asset_url }}" width="290" height="320" alt="" loading="lazy" decoding="async">
            {%- endif -%}
            <span class="obs__tinfo">
              <span class="obs__tname">{{ b.settings.label }}</span>
              <span class="obs__prices">
