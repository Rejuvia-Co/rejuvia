                {%- if tc != blank -%}<span class="obs__struck">{{ tc }}</span>{%- endif -%}
                {%- if t_save != blank -%}<span class="obs__save">{{ t_save }}</span>{%- endif -%}
              </span>
              {%- if tier_n >= 2 -%}<span class="obs__ship">+ FREE Shipping</span>{%- endif -%}
              {%- if t_night != blank -%}<span class="obs__pernight">{{ t_night }}</span>{%- endif -%}
            </span>
          </label>
        {%- endif -%}{%- endfor -%}
      </div>

      <div class="obs__cta-wrap">
