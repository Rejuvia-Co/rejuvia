{%- comment -%}
  Offer Block SUB — variant 5a "Offer-Led", subscription edition (BOGOSub template).

  Differences from offer-block:
   - The headline IS the offer, not the product name; adds a review bar,
     a dashed urgency strip with a live cutoff time, and a guarantee-proof
     panel. Purple CTA with an arrow. No Facebook review block.
   - Gallery images come from section blocks uploaded in the customizer,
     NOT from a product's media.
   - Each tier carries its own Skio selling plan id, so Buy Now adds a
     subscription line item (selling_plan) rather than a one-off.

  Lifted unchanged from the existing BOGO template: the ships-by bar
  (shipping-bar snippet), payment icons, sub-CTA trust rows, the six-row
  content accordion, the trusted-by "300,000+ customers" bar, the
  supplement-label popup, the desktop sticky gallery column, and the
  sticky-CTA hide contract (body.ob-offer-visible).

  Setup: upload the five gallery images into the Gallery image blocks, and
  set each tier's Variant ID + Skio selling plan ID. A tier with no plan id
  is added as a one-time purchase.
{%- endcomment -%}

{% style %}
html { scroll-behavior: smooth; }
body.ob-offer-visible .sticky-cta-v2-section,
body.ob-offer-visible #shopify-section-sticky-cta-v2 { display: none !important; }
/* Desktop sticky gallery: the theme's .content-wrapper has overflow:hidden,
   which breaks position:sticky. Switch ancestors to clip + visible. */
@media (min-width: 901px) {
  main:has(.obs-{{ section.id }}), .content-wrapper:has(.obs-{{ section.id }}) { overflow-x: clip; overflow-y: visible; }
  #shopify-section-{{ section.id }} { overflow-x: clip; overflow-y: visible; }
}

.obs-{{ section.id }} {
  background-color: {{ section.settings.section_bg | default: '#ffffff' }};
  font-family: 'Helvetica Neue', Arimo, Helvetica, Arial, sans-serif;
}
/* Neutralize theme-wide text styling, then re-apply per element via vars. */
.obs-{{ section.id }}, .obs-{{ section.id }} *, .obs-{{ section.id }} *::before, .obs-{{ section.id }} *::after {
  text-transform: var(--tt, none) !important;
  letter-spacing: var(--ls, normal) !important;
  word-spacing: normal !important;
  box-sizing: border-box;
}

.obs__wrap { max-width: 1120px; margin: 0 auto; padding: 36px; display: grid; grid-template-columns: 430px minmax(0, 1fr); grid-template-areas: "gallery header" "gallery buybox"; column-gap: 44px; row-gap: 0; align-items: start; }
.obs__header { grid-area: header; min-width: 0; }
.obs__gallery { grid-area: gallery; min-width: 0; align-self: stretch; }
.obs__buybox { grid-area: buybox; min-width: 0; }
.obs__left-inner { position: sticky; top: {{ section.settings.sticky_offset | default: 16 }}px; display: flex; flex-direction: column; gap: 16px; }

/* ---- Gallery (customizer images) ---- */
.obs__main { position: relative; background: {{ section.settings.gallery_bg | default: '#F8EFE4' }}; border-radius: 16px; aspect-ratio: 1 / 1; display: flex; align-items: center; justify-content: center; overflow: hidden; }
.obs__main img[data-obs-main] { width: 100%; height: 100%; object-fit: {{ section.settings.gallery_fit | default: 'cover' }}; display: block; }
/* the rule above sets display:block, which overrides the hidden attribute -
   this restores it so only the active slide renders */
.obs__main img[data-obs-main][hidden] { display: none; }
.obs__inc { position: absolute; left: 14px; bottom: 14px; width: 62px; height: 62px; object-fit: contain; pointer-events: none; }
.obs__thumbrow { display: flex; align-items: center; justify-content: center; gap: 8px; margin-top: 12px; }
.obs__arrow { flex: none; width: 30px; height: 30px; border: 1px solid #e3ddea; border-radius: 50%; background: #fff; color: #672666; display: flex; align-items: center; justify-content: center; cursor: pointer; padding: 0; transition: background .14s ease; }
.obs__arrow:hover { background: #f6eef6; }
.obs__arrow svg { width: 14px; height: 14px; display: block; }
.obs__thumbs { display: flex; gap: 8px; overflow-x: auto; scrollbar-width: none; -ms-overflow-style: none; max-width: 100%; }
.obs__thumbs::-webkit-scrollbar { display: none; }
.obs__thumb { flex: none; width: 48px; height: 48px; border: 1px solid #e9e4f0; border-radius: 10px; background: #f3f0f9; display: flex; align-items: center; justify-content: center; overflow: hidden; cursor: pointer; padding: 0; }
.obs__thumb img { width: 100%; height: 100%; object-fit: cover; display: block; }
.obs__thumb.is-active { border: 1.5px solid #672666; background: #fff; }
.obs__dots { display: flex; gap: 5px; justify-content: center; margin-top: 10px; }
.obs__dot { width: 6px; height: 6px; border-radius: 50%; background: #ddd7e6; transition: background .14s ease; }
.obs__dot.is-active { background: #672666; }

/* ---- Review bar ---- */
.obs__reviewbar { display: flex; align-items: center; gap: 10px; font-size: 13px; color: #4a4550; flex-wrap: wrap; }
.obs__reviewbar .obs__stars { display: inline-flex; gap: 1.5px; flex-shrink: 0; }
.obs__reviewbar .obs__stars svg { width: 15px; height: 15px; display: block; }
.obs__rb-strong { font-weight: 800; color: #171512; }
.obs__rb-sep { color: #d9d3e0; }
.obs__reviewbar strong, .obs__reviewbar b { color: #171512; font-weight: 800; }
.obs__reviewbar p { margin: 0; display: inline; }

/* ---- Offer headline ---- */
.obs__headline { --ls: -1.4px; font-size: {{ section.settings.headline_size | default: 42 }}px; line-height: 1.04; font-weight: 800; color: #171512; margin: 10px 0 0; }
.obs__subtitle { font-size: {{ section.settings.subtitle_size | default: 16.5 }}px; line-height: 1.35; color: #4a4550; margin: 9px 0 0; }

/* ---- Urgency strip ---- */
.obs__urgency { display: flex; align-items: center; gap: 10px; border: 1.5px dashed #b79ab8; background: #faf7fd; border-radius: 12px; padding: 12px 16px; margin-top: 18px; font-size: 14px; line-height: 1.35; color: #4c1c4f; }
.obs__urgency svg { flex: none; width: 20px; height: 20px; }
.obs__urgency b { font-weight: 800; }

/* ---- Tier rows (real bundle photography, no pictograms) ---- */
.obs__tiers { display: flex; flex-direction: column; gap: 16px; margin-top: 16px; }
.obs__tier { position: relative; display: block; background: #fff; border: 1.5px solid #e6e1ee; border-radius: 12px; cursor: pointer; transition: background .18s cubic-bezier(.22,1,.36,1), border-color .18s cubic-bezier(.22,1,.36,1), box-shadow .18s cubic-bezier(.22,1,.36,1); }
.obs__tier.is-selected { border-color: #672666; box-shadow: inset 0 0 0 .5px #672666; background: #faf7fd; }
.obs__tier input { position: absolute; opacity: 0; pointer-events: none; }
.obs__row { display: flex; align-items: center; gap: 16px; padding: 14px 18px; }
.obs__radio { flex: none; width: 20px; height: 20px; border: 2px solid #cfc9dd; border-radius: 50%; display: flex; align-items: center; justify-content: center; transition: border-color .18s ease; }
.obs__tier.is-selected .obs__radio { border-color: #672666; }
.obs__radio::after { content: ''; width: 10px; height: 10px; border-radius: 50%; background: #672666; opacity: 0; transition: opacity .18s ease; }
.obs__tier.is-selected .obs__radio::after { opacity: 1; }
.obs__bundle { flex: none; width: 104px; height: 96px; object-fit: contain; display: block; }
.obs__tinfo { flex: 1; min-width: 0; text-align: left; }
.obs__tname { --ls: -.3px; display: block; font-size: {{ section.settings.tier_title_size | default: 21 }}px; font-weight: 800; color: #672666; line-height: 1.2; white-space: nowrap; }
.obs__prices { display: flex; align-items: center; gap: 10px; margin-top: 5px; flex-wrap: wrap; }
.obs__price { font-size: 23px; font-weight: 800; color: #171512; line-height: 1; }
.obs__struck { font-size: 15px; color: #a9a3b2; text-decoration: line-through; }
.obs__save { display: inline-flex; align-items: center; justify-content: center; line-height: 1; background: #eefaf0; color: #018e1c; font-weight: 800; font-size: 12.5px; padding: 5px 10px 4px; border-radius: 100px; white-space: nowrap; }
.obs__ship { display: block; font-size: 13.5px; font-weight: 800; color: #171512; margin-top: 6px; }
.obs__pernight { display: block; font-size: 13.5px; color: #8b8494; font-style: italic; margin-top: 5px; }
.obs__badge { --ls: 1.1px; position: absolute; top: -11px; right: 18px; font-size: 10.5px; font-weight: 800; padding: 4px 12px; border-radius: 100px; white-space: nowrap; z-index: 1; }
.obs__badge--plum { background: #5d215f; color: #fff; }
.obs__badge--gold { background: #EAC78B; color: #4c1c4f; }

/* ---- CTA (purple, with arrow) ---- */
.obs__cta-wrap { margin-top: 18px; }
.obs__buy { --ls: 1.2px; width: 100%; display: flex; align-items: center; justify-content: center; gap: 10px; background: #5d215f; color: #fff; border: none; border-radius: 100px; height: 58px; font-family: inherit; font-size: 16px; font-weight: 800; cursor: pointer; margin-top: 14px; box-shadow: 0 6px 18px rgba(45,21,48,.16); transition: background .14s ease, transform .14s ease; }
.obs__buy:hover { background: #4a1a4c; transform: translateY(-1px); }
.obs__buy:active { transform: translateY(1px); }
.obs__buy:disabled { cursor: default; }
.obs__buy svg { flex: none; width: 20px; height: 20px; }
.obs__spinner { display: none; width: 22px; height: 22px; border: 2.5px solid rgba(255,255,255,.4); border-top-color: #fff; border-radius: 50%; animation: obs-spin .6s linear infinite; }
.obs__buy.is-loading .obs__buy-label, .obs__buy.is-loading svg { display: none; }
.obs__buy.is-loading .obs__spinner { display: block; }
@keyframes obs-spin { to { transform: rotate(360deg); } }

/* ---- Sub-CTA trust rows ---- */
.obs__trust { --tt: uppercase; --ls: .6px; display: flex; gap: 22px; justify-content: center; flex-wrap: wrap; margin-top: 16px; font-size: 11px; font-weight: 700; color: #4a4550; }
.obs__trust span.obs__check { color: #672666; }
.obs__trust-item { display: inline-flex; align-items: center; gap: 6px; }
.obs__trust-item img { width: 15px; height: 15px; object-fit: contain; display: block; }
.obs__payments { display: flex; gap: 6px; justify-content: center; flex-wrap: wrap; margin-top: 12px; }
.obs__payments svg { height: 24px; width: auto; display: block; }

/* ---- Guarantee proof ---- */
.obs__proof { display: flex; align-items: center; gap: 14px; background: #F8EFE4; border-radius: 12px; padding: 14px 18px; margin-top: 16px; }
.obs__proof svg { flex: none; width: 32px; height: 32px; }
.obs__proof-text { font-size: 14px; line-height: 1.4; color: #4c1c4f; }
.obs__proof-text b, .obs__proof-text strong { font-weight: 800; }
.obs__proof-text p { margin: 0; }

/* ---- Accordion (same behaviour as the BOGO template) ---- */
.obs__tabs { margin-top: 26px; border-top: 1px solid #e6e2ec; }
.obs__tab { border-bottom: 1px solid #e6e2ec; }
.obs__tab-q { --ls: -.2px; width: 100%; display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 18px 4px; background: none; border: none; cursor: pointer; text-align: left; font-family: inherit; font-size: {{ section.settings.tab_title_size | default: 20 }}px; font-weight: 800; color: #171512; line-height: 1.3; }
.obs__tab-q > span { flex: 1 1 auto; min-width: 0; overflow-wrap: anywhere; }
.obs__chev { flex: none; width: 20px; height: 20px; color: #672666; transition: transform .22s ease; }
.obs__tab.is-open .obs__chev { transform: rotate(180deg); }
.obs__tab-a { display: grid; grid-template-rows: 0fr; transition: grid-template-rows 260ms cubic-bezier(.22,1,.36,1); }
.obs__tab.is-open .obs__tab-a { grid-template-rows: 1fr; }
.obs__tab-a-inner { overflow: hidden; }
.obs__tab-body { text-align: left; font-size: {{ section.settings.tab_body_size | default: 17 }}px; line-height: 1.55; color: #4a4550; padding: 0 4px 18px; max-width: 60ch; }
.obs__tab-body p { margin: 0 0 10px; }
.obs__tab-body p:last-child { margin-bottom: 0; }
.obs__tab-body strong { color: #171512; font-weight: 800; }

/* ---- Mobile ---- */
@media (max-width: 900px) {
  .obs-{{ section.id }} { overflow-x: clip; }
  .obs__wrap { display: flex; flex-direction: column; padding: 18px 16px; }
  .obs__left-inner { position: static; gap: 0; }
  .obs__reviewbar { justify-content: center; gap: 7px; font-size: 11px; }
  .obs__reviewbar .obs__stars svg { width: 12px; height: 12px; }
  .obs__rb-hide-mobile { display: none; }
  .obs__headline { font-size: {{ section.settings.headline_size_mobile | default: 29 }}px; line-height: 1.06; --ls: -1.1px; text-align: center; }
  .obs__subtitle { font-size: {{ section.settings.subtitle_size_mobile | default: 13.5 }}px; text-align: center; padding: 0 6px; }
  .obs__header { order: 1; }
  .obs__gallery { order: 2; margin-top: 16px; }
  .obs__buybox { order: 3; margin-top: 14px; }
  .obs__urgency { font-size: 12.5px; padding: 11px 13px; margin-top: 16px; }
  .obs__tiers { gap: 14px; margin-top: 14px; }
  .obs__row { gap: 10px; padding: 12px; }
  .obs__bundle { width: 76px; height: 72px; }
  .obs__tname { font-size: {{ section.settings.tier_title_size_mobile | default: 17 }}px; }
  .obs__prices { gap: 8px; }
  .obs__price { font-size: 19px; }
  .obs__struck { font-size: 13px; }
  .obs__save { font-size: 11px; padding: 4px 9px 3px; }
  .obs__ship, .obs__pernight { font-size: 12px; }
  .obs__badge { right: 12px; font-size: 9.5px; }
  .obs__buy { height: 54px; font-size: 15px; --ls: 1.1px; box-shadow: none; }
  .obs__trust { flex-direction: column; align-items: center; gap: 6px; font-size: 10.5px; --ls: .5px; }
  .obs__payments { gap: 5px; margin-top: 10px; }
  .obs__payments svg { height: 22px; }
  .obs__proof { padding: 13px 14px; gap: 12px; }
  .obs__proof svg { width: 28px; height: 28px; }
  .obs__proof-text { font-size: 13px; }
  .obs__tabs { margin-top: 18px; }
  .obs__tab-q { font-size: {{ section.settings.tab_title_size_mobile | default: 19 }}px; }
  .obs__tab-body { font-size: {{ section.settings.tab_body_size_mobile | default: 16 }}px; }
}
{% endstyle %}

{%- capture obs_star -%}<svg viewBox="0 0 18 16" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M3.85124 15.9392C3.43952 16.1504 2.97233 15.7803 3.05553 15.3078L3.94083 10.2626L0.183091 6.68298C-0.167831 6.34806 0.0145632 5.73581 0.484948 5.66968L5.70931 4.9273L8.03883 0.31199C8.24895 -0.103997 8.81747 -0.103997 9.0276 0.31199L11.3571 4.9273L16.5815 5.66968C17.0519 5.73581 17.2343 6.34806 16.8823 6.68298L13.1256 10.2626L14.0109 15.3078C14.0941 15.7803 13.6269 16.1504 13.2152 15.9392L8.53161 13.5329L3.85124 15.9392Z" fill="{{ section.settings.stars_color | default: '#fab851' }}"/></svg>{%- endcapture -%}
{%- capture obs_chevron -%}<svg class="obs__chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>{%- endcapture -%}

{%- assign ship_ts = 'now' | date: '%s' | plus: 86400 -%}
{%- assign ship_date = ship_ts | date: '%a, %b %-d' -%}
{%- assign today_date = 'now' | date: '%a, %b %-d' -%}

{%- capture obs_inc_src -%}{%- if section.settings.badge_image != blank -%}{{ section.settings.badge_image | image_url: width: 200, format: 'webp' }}{%- elsif section.settings.badge_asset != blank -%}{{ section.settings.badge_asset | asset_url }}{%- endif -%}{%- endcapture -%}

{%- comment -%} Gallery slides come from customizer blocks, not a product {%- endcomment -%}
{%- assign slides = section.blocks | where: 'type', 'slide' -%}

<section class="obs obs-{{ section.id }}" id="obs-{{ section.id }}">
  <span id="offer" aria-hidden="true" style="display:block;scroll-margin-top:80px;"></span>
  <div class="obs__wrap">

    <div class="obs__header">
      <div class="obs__reviewbar">
        {%- if section.settings.show_stars -%}<span class="obs__stars" role="img" aria-label="5 stars">{{ obs_star }}{{ obs_star }}{{ obs_star }}{{ obs_star }}{{ obs_star }}</span>{%- endif -%}
        {%- if section.settings.rating_label != blank -%}<span class="obs__rb-strong">{{ section.settings.rating_label }}</span>{%- endif -%}
        {%- if section.settings.reviews_label != blank -%}
          <span class="obs__rb-sep" aria-hidden="true">|</span>
          <span>{{ section.settings.reviews_label }}</span>
        {%- endif -%}
        {%- if section.settings.customers_label != blank -%}
          <span class="obs__rb-sep obs__rb-hide-mobile" aria-hidden="true">|</span>
          <span class="obs__rb-hide-mobile">{{ section.settings.customers_label }}</span>
        {%- endif -%}
      </div>
      {%- if section.settings.headline != blank -%}<h2 class="obs__headline">{{ section.settings.headline }}</h2>{%- endif -%}
      {%- if section.settings.subtitle != blank -%}<p class="obs__subtitle">{{ section.settings.subtitle }}</p>{%- endif -%}
    </div>

    <div class="obs__gallery">
      <div class="obs__left-inner">
        <div class="obs__main">
          {%- for b in slides -%}
            {%- if b.settings.image != blank -%}
              <img data-obs-main{% unless forloop.first %} hidden{% endunless %}
                   src="{{ b.settings.image | image_url: width: 1000, format: 'webp' }}"
                   srcset="{{ b.settings.image | image_url: width: 500, format: 'webp' }} 500w, {{ b.settings.image | image_url: width: 800, format: 'webp' }} 800w, {{ b.settings.image | image_url: width: 1000, format: 'webp' }} 1000w"
                   sizes="(max-width: 900px) 92vw, 430px"
                   alt="{{ b.settings.image.alt | default: section.settings.headline | strip_html | escape }}"
                   {% if forloop.first %}loading="eager" fetchpriority="high"{% else %}loading="lazy"{% endif %} decoding="async">
            {%- endif -%}
          {%- endfor -%}
          {%- if obs_inc_src != blank -%}
            <img class="obs__inc" data-obs-inc src="{{ obs_inc_src }}" alt="Inc. 5000 — America's fastest-growing private companies" loading="lazy" decoding="async">
          {%- endif -%}
        </div>
        {%- if slides.size > 1 -%}
          <div class="obs__thumbrow">
            <button type="button" class="obs__arrow" data-obs-prev aria-label="Previous image"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg></button>
            <div class="obs__thumbs">
              {%- for b in slides -%}
                {%- if b.settings.image != blank -%}
                  <button type="button" class="obs__thumb{% if forloop.first %} is-active{% endif %}" data-obs-thumb aria-label="View image {{ forloop.index }}"><img src="{{ b.settings.image | image_url: width: 160, format: 'webp' }}" alt="" loading="lazy" decoding="async"></button>
                {%- endif -%}
              {%- endfor -%}
            </div>
            <button type="button" class="obs__arrow" data-obs-next aria-label="Next image"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6"/></svg></button>
          </div>
          <div class="obs__dots" aria-hidden="true">
            {%- for b in slides -%}{%- if b.settings.image != blank -%}<span class="obs__dot{% if forloop.first %} is-active{% endif %}" data-obs-dot></span>{%- endif -%}{%- endfor -%}
          </div>
        {%- endif -%}
      </div>
    </div>

    <div class="obs__buybox">

      {%- comment -%} Urgency strip. {date} is rendered server-side; {cutoff} is filled in on load. {%- endcomment -%}
      {%- if section.settings.urgency_text != blank -%}
        {%- capture ship_date_bold -%}<b>{{ ship_date }}</b>{%- endcapture -%}
        {%- assign urgency = section.settings.urgency_text | replace: '{date}', ship_date_bold | replace: '{today}', today_date -%}
        <div class="obs__urgency" role="note">
          <svg viewBox="0 0 24 24" fill="none" stroke="#672666" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 7h11v10H3z"/><path d="M14 10h4l3 3v4h-7z"/><circle cx="7" cy="18" r="1.6"/><circle cx="17.5" cy="18" r="1.6"/></svg>
          <span data-obs-urgency>{{ urgency }}</span>
        </div>
      {%- endif -%}

      {%- comment -%} Tier rows — each carries its own variant + Skio selling plan {%- endcomment -%}
      <div class="obs__tiers" role="radiogroup" aria-label="Choose your subscription">
        {%- assign tier_n = 0 -%}
        {%- for b in section.blocks -%}{%- if b.type == 'tier' -%}
          {%- assign tier_n = tier_n | plus: 1 -%}
          {%- assign tier_sel = false -%}
          {%- if tier_n == section.settings.default_tier -%}{%- assign tier_sel = true -%}{%- endif -%}

          {%- assign vid = b.settings.variant_id | strip -%}
          {%- assign plan_id = b.settings.selling_plan_id | strip -%}
          {%- assign srcprod = b.settings.product | default: section.settings.product -%}
          {%- assign tier_variant = blank -%}
          {%- if vid != blank and srcprod != blank -%}
            {%- for v in srcprod.variants -%}
              {%- assign vstr = v.id | append: '' -%}
              {%- if vstr == vid -%}{%- assign tier_variant = v -%}{%- break -%}{%- endif -%}
            {%- endfor -%}
          {%- endif -%}
          {%- if vid == blank and srcprod != blank -%}{%- assign vid = srcprod.selected_or_first_available_variant.id -%}{%- endif -%}

          {%- comment -%} Subscription price: prefer the selling plan allocation for this plan {%- endcomment -%}
          {%- assign alloc_price = blank -%}
          {%- assign alloc_compare = blank -%}
          {%- if tier_variant != blank and plan_id != blank -%}
            {%- for alloc in tier_variant.selling_plan_allocations -%}
              {%- assign aid = alloc.selling_plan.id | append: '' -%}
              {%- if aid == plan_id -%}
                {%- assign alloc_price = alloc.price -%}
                {%- assign alloc_compare = alloc.compare_at_price -%}
                {%- break -%}
              {%- endif -%}
            {%- endfor -%}
          {%- endif -%}

          {%- capture tier_price -%}
            {%- if alloc_price != blank -%}{{ alloc_price | money_without_trailing_zeros }}
            {%- elsif tier_variant != blank -%}{{ tier_variant.price | money_without_trailing_zeros }}
            {%- else -%}{{ b.settings.price }}{%- endif -%}
          {%- endcapture -%}
          {%- capture tier_compare -%}
            {%- if alloc_compare != blank and alloc_compare > alloc_price -%}{{ alloc_compare | money_without_trailing_zeros }}
            {%- elsif tier_variant != blank and tier_variant.compare_at_price > tier_variant.price -%}{{ tier_variant.compare_at_price | money_without_trailing_zeros }}
            {%- else -%}{{ b.settings.compare_price }}{%- endif -%}
          {%- endcapture -%}

          <label class="obs__tier{% if tier_sel %} is-selected{% endif %}" {{ b.shopify_attributes }}>
            <input type="radio" name="obs-{{ section.id }}" value="{{ vid }}"
                   data-price="{{ tier_price | strip }}"
                   data-selling-plan="{{ plan_id }}"
                   data-qty="{{ b.settings.quantity | default: section.settings.add_quantity | default: 1 }}"
                   {% if tier_sel %}checked{% endif %}>
            {%- if b.settings.badge != blank -%}
              <span class="obs__badge obs__badge--{{ b.settings.badge_style | default: 'plum' }}">{{ b.settings.badge }}</span>
            {%- endif -%}
            <span class="obs__row">
              <span class="obs__radio" aria-hidden="true"></span>
              {%- if b.settings.image != blank -%}
                <img class="obs__bundle" src="{{ b.settings.image | image_url: width: 320, format: 'webp' }}" alt="" loading="lazy" decoding="async">
              {%- elsif b.settings.image_asset != blank -%}
                <img class="obs__bundle" src="{{ b.settings.image_asset | asset_url }}" alt="" loading="lazy" decoding="async">
              {%- endif -%}
              <span class="obs__tinfo">
                <span class="obs__tname">{{ b.settings.label }}</span>
                <span class="obs__prices">
                  <span class="obs__price">{{ tier_price | strip }}</span>
                  {%- assign tc = tier_compare | strip -%}
                  {%- if tc != blank -%}<span class="obs__struck">{{ tc }}</span>{%- endif -%}
                  {%- if b.settings.savings_text != blank -%}<span class="obs__save">{{ b.settings.savings_text }}</span>{%- endif -%}
                </span>
                {%- if b.settings.free_shipping -%}<span class="obs__ship">+ FREE Shipping</span>{%- endif -%}
                {%- if b.settings.per_night != blank -%}<span class="obs__pernight">{{ b.settings.per_night }}</span>{%- endif -%}
              </span>
            </span>
          </label>
        {%- endif -%}{%- endfor -%}
      </div>

      <div class="obs__cta-wrap">
        {% render 'shipping-bar', extra_class: 'ship-bar--stack' %}

        <button type="button" class="obs__buy" data-obs-buy>
          <span class="obs__spinner" aria-hidden="true"></span>
          <span class="obs__buy-label" data-obs-cta-label>{{ section.settings.button_prefix | default: 'BUY NOW —' }}</span>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </button>

        {%- if section.settings.guarantee_text != blank or section.settings.onetime_text != blank -%}
          <div class="obs__trust">
            {%- if section.settings.guarantee_text != blank -%}
              <span class="obs__trust-item">
                {%- if section.settings.guarantee_icon != blank -%}<img src="{{ section.settings.guarantee_icon | image_url: width: 60 }}" alt="" width="15" height="15" loading="lazy" decoding="async">{%- else -%}<span class="obs__check" aria-hidden="true">&#10003;</span>{%- endif -%}
                {{ section.settings.guarantee_text }}
              </span>
            {%- endif -%}
            {%- if section.settings.onetime_text != blank -%}
              <span class="obs__trust-item">
                {%- if section.settings.onetime_icon != blank -%}<img src="{{ section.settings.onetime_icon | image_url: width: 60 }}" alt="" width="15" height="15" loading="lazy" decoding="async">{%- else -%}<span class="obs__check" aria-hidden="true">&#10003;</span>{%- endif -%}
                {{ section.settings.onetime_text }}
              </span>
            {%- endif -%}
          </div>
        {%- endif -%}

        {%- if section.settings.show_payment_icons -%}
          {%- assign hidden_pay = section.settings.hidden_payments | default: '' | downcase | replace: ' ', '' | split: ',' -%}
          <div class="obs__payments">
            {%- for type in shop.enabled_payment_types -%}{%- unless hidden_pay contains type -%}{{ type | payment_type_svg_tag: class: 'payment-icon' }}{%- endunless -%}{%- endfor -%}
          </div>
        {%- endif -%}

        {%- if section.settings.proof_text != blank -%}
          <div class="obs__proof">
            <svg viewBox="0 0 24 24" fill="none" stroke="#4c1c4f" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="4" y="10.5" width="16" height="10.5" rx="2.5"/><path d="M8 10.5V7.6a4 4 0 0 1 8 0v2.9"/><circle cx="12" cy="15.6" r="1.15" fill="#4c1c4f" stroke="none"/></svg>
            <span class="obs__proof-text">{{ section.settings.proof_text }}</span>
          </div>
        {%- endif -%}
      </div>

      {%- assign has_tabs = false -%}
      {%- for b in section.blocks -%}{%- if b.type == 'tab' and b.settings.title != blank -%}{%- assign has_tabs = true -%}{%- endif -%}{%- endfor -%}
      {%- if has_tabs -%}
        <div class="obs__tabs">
          {%- assign tab_n = 0 -%}
          {%- for b in section.blocks -%}{%- if b.type == 'tab' -%}
            {%- assign tab_n = tab_n | plus: 1 -%}
            <div class="obs__tab{% if tab_n == 1 %} is-open{% endif %}" {{ b.shopify_attributes }}>
              <button type="button" class="obs__tab-q" aria-expanded="{% if tab_n == 1 %}true{% else %}false{% endif %}"><span>{{ b.settings.title }}</span>{{ obs_chevron }}</button>
              <div class="obs__tab-a"><div class="obs__tab-a-inner"><div class="obs__tab-body">{{ b.settings.content }}{%- assign tab_t = b.settings.title | downcase -%}{%- if tab_t contains 'ingredient' -%}{% render 'supplement-label-button', product: section.settings.product %}{%- endif -%}</div></div></div>
            </div>
          {%- endif -%}{%- endfor -%}
        </div>
      {%- endif -%}

      {%- if section.settings.show_trusted -%}
        {% render 'trusted-by',
          title: section.settings.trusted_title,
          subtext: section.settings.trusted_subtext,
          image_1: section.settings.trusted_image_1,
          image_2: section.settings.trusted_image_2,
          image_3: section.settings.trusted_image_3,
          bg_color: section.settings.trusted_bg,
          check_color: section.settings.trusted_check %}
      {%- endif -%}
    </div>
  </div>
  {% render 'supplement-label-popup', product: section.settings.product %}
</section>

<script>
(function () {
  var sec = document.getElementById('obs-{{ section.id }}');
  if (!sec) return;

  /* ---- Tier selection + live CTA price ---- */
  var ctaLabel = sec.querySelector('[data-obs-cta-label]');
  var ctaPrefix = {{ section.settings.button_prefix | default: 'BUY NOW —' | json }};
  function syncCta() {
    var sel = sec.querySelector('.obs__tier input[type="radio"]:checked');
    if (ctaLabel && sel && sel.getAttribute('data-price')) {
      ctaLabel.textContent = ctaPrefix + ' ' + sel.getAttribute('data-price');
    }
  }
  sec.querySelectorAll('.obs__tier input[type="radio"]').forEach(function (input) {
    input.addEventListener('change', function () {
      sec.querySelectorAll('.obs__tier').forEach(function (t) { t.classList.remove('is-selected'); });
      input.closest('.obs__tier').classList.add('is-selected');
      syncCta();
    });
  });
  if (!sec.querySelector('.obs__tier input[type="radio"]:checked')) {
    var first = sec.querySelector('.obs__tier input[type="radio"]');
    if (first) { first.checked = true; first.closest('.obs__tier').classList.add('is-selected'); }
  }
  syncCta();

  /* ---- Urgency cutoff: current time + 1 hour, pinned to America/New_York so
         it reads honestly for shoppers outside Eastern time. ---- */
  var urgency = sec.querySelector('[data-obs-urgency]');
  if (urgency && urgency.textContent.indexOf('{cutoff}') !== -1) {
    var cutoff;
    try {
      cutoff = new Intl.DateTimeFormat('en-US', {
        timeZone: 'America/New_York', hour: 'numeric', minute: '2-digit', hour12: true
      }).format(new Date(Date.now() + 3600000)) + ' ET';
    } catch (e) {
      var d = new Date(Date.now() + 3600000);
      var h = d.getHours() % 12 || 12, m = ('0' + d.getMinutes()).slice(-2);
      cutoff = h + ':' + m + (d.getHours() < 12 ? ' AM' : ' PM');
    }
    urgency.textContent = urgency.textContent.replace('{cutoff}', cutoff);
  }

  /* ---- Gallery (customizer images) ---- */
  var mains = [].slice.call(sec.querySelectorAll('[data-obs-main]'));
  var thumbs = [].slice.call(sec.querySelectorAll('[data-obs-thumb]'));
  var dots = [].slice.call(sec.querySelectorAll('[data-obs-dot]'));
  var inc = sec.querySelector('[data-obs-inc]');
  var idx = 0;
  function setImg(i) {
    if (!mains.length) return;
    idx = (i + mains.length) % mains.length;
    mains.forEach(function (img, j) { img.hidden = j !== idx; });
    thumbs.forEach(function (t, j) { t.classList.toggle('is-active', j === idx); });
    dots.forEach(function (d, j) { d.classList.toggle('is-active', j === idx); });
    if (inc) inc.style.display = idx === 0 ? '' : 'none';
    var t = thumbs[idx];
    if (t && t.scrollIntoView) t.scrollIntoView({ block: 'nearest', inline: 'nearest' });
  }
  thumbs.forEach(function (t, i) { t.addEventListener('click', function () { setImg(i); }); });
  var prev = sec.querySelector('[data-obs-prev]'), next = sec.querySelector('[data-obs-next]');
  if (prev) prev.addEventListener('click', function () { setImg(idx - 1); });
  if (next) next.addEventListener('click', function () { setImg(idx + 1); });

  /* Mobile: horizontal-dominant swipe only, so vertical scrolling is never hijacked */
  var main = sec.querySelector('.obs__main');
  if (main && mains.length > 1) {
    var sx = null, sy = null;
    main.addEventListener('touchstart', function (e) { var t = e.touches[0]; sx = t.clientX; sy = t.clientY; }, { passive: true });
    main.addEventListener('touchend', function (e) {
      if (sx === null) return;
      var t = e.changedTouches[0], dx = t.clientX - sx, dy = t.clientY - sy;
      if (Math.abs(dx) > 40 && Math.abs(dx) > Math.abs(dy)) setImg(dx < 0 ? idx + 1 : idx - 1);
      sx = null; sy = null;
    }, { passive: true });
  }

  /* ---- Accordion: one open at a time ---- */
  var tabs = sec.querySelectorAll('.obs__tab');
  sec.querySelectorAll('.obs__tab-q').forEach(function (btn) {
    btn.addEventListener('click', function () {
      var tab = btn.closest('.obs__tab');
      var willOpen = !tab.classList.contains('is-open');
      tabs.forEach(function (t) {
        t.classList.remove('is-open');
        var b = t.querySelector('.obs__tab-q');
        if (b) b.setAttribute('aria-expanded', 'false');
      });
      if (willOpen) { tab.classList.add('is-open'); btn.setAttribute('aria-expanded', 'true'); }
    });
  });

  /* ---- Buy Now: add the selected variant WITH its selling plan, then checkout ---- */
  var buy = sec.querySelector('[data-obs-buy]');
  if (buy) {
    window.addEventListener('pageshow', function () { buy.disabled = false; buy.classList.remove('is-loading'); });
    buy.addEventListener('click', function () {
      var sel = sec.querySelector('.obs__tier input[type="radio"]:checked');
      if (!sel || !sel.value) return;
      var id = parseInt(sel.value, 10);
      var plan = sel.getAttribute('data-selling-plan');
      var qty = parseInt(sel.getAttribute('data-qty'), 10) || 1;
      var item = { id: id, quantity: qty };
      if (plan) item.selling_plan = parseInt(plan, 10);
      buy.disabled = true; buy.classList.add('is-loading');
      fetch('/cart/clear.js', { method: 'POST', headers: { 'Content-Type': 'application/json' } })
        .then(function () {
          return fetch('/cart/add.js', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ items: [item] })
          });
        })
        .then(function (r) { if (!r.ok) throw new Error('add failed'); window.location.href = '/checkout'; })
        .catch(function () {
          /* permalink fallback keeps the selling plan */
          var url = '/cart/' + id + ':' + qty;
          if (plan) url += '?selling_plan=' + plan;
          window.location.href = url;
        });
    });
  }

  /* ---- Hide the sticky CTA bar while this section is in view ---- */
  if ('IntersectionObserver' in window) {
    var io = new IntersectionObserver(function (entries) {
      var vis = entries[0].isIntersecting;
      document.body.classList.toggle('ob-offer-visible', vis);
      document.querySelectorAll('.sticky-cta-v2-section').forEach(function (el) {
        if (vis) el.style.setProperty('display', 'none', 'important');
        else el.style.removeProperty('display');
      });
    }, { threshold: 0 });
    io.observe(sec);
  }
})();
</script>

