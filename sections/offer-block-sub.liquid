        {%- endif -%}

      </div>

      {%- assign has_tabs = false -%}
      {%- for b in section.blocks -%}{%- if b.type == 'tab' and b.settings.title != blank -%}{%- assign has_tabs = true -%}{%- endif -%}{%- endfor -%}
      {%- if has_tabs -%}
        <div class="obs__tabs">
          {%- assign obs_why_lead = '' -%}{%- assign obs_faq_lead = '' -%}
          {%- if page.handle == 'nightshift-bogo' -%}
            {%- assign obs_why_lead = '<p>Your bedtime is when the sun comes up. The spray absorbs under your tongue, straight into your bloodstream, so most people are asleep in 10–15 minutes instead of the 45–60 it takes pills and gummies.</p>' -%}
            {%- capture obs_faq_lead -%}<p><strong>Will it leave me groggy for my next shift?</strong></p><p>No. Rejuvia uses 2mg of melatonin, not the 10–12mg in many gummies, so you wake up clear, not foggy on the drive in. Use 6–8 sprays under your tongue whenever you're ready to sleep, day or night.</p>{%- endcapture -%}
          {%- elsif page.handle == '3am-wake-up-bogo' -%}
            {%- assign obs_why_lead = '<p>Built for the 3am wake-up: 6–8 sprays under your tongue at bedtime, asleep in 10–15 minutes, and sleep straight through to your alarm. The low 2mg dose means you wake up clear, not groggy.</p>' -%}
            {%- capture obs_faq_lead -%}<p><strong>Will it stop my 3am wake-ups?</strong></p><p>Waking up in the middle of the night is the #1 sleep problem our customers tell us about, and it's what Rejuvia is made for. Use 6–8 sprays under your tongue at bedtime and sleep straight through to morning. If you're still waking up at 3am, you get every penny back for 90 days.</p>{%- endcapture -%}
          {%- elsif page.handle == 'travel-bogo' -%}
            {%- assign obs_why_lead = '<p>Flying overnight or landing in a new time zone? 6–8 sprays under your tongue and most people are asleep in 10–15 minutes on local time, and the low 2mg dose means you wake up clear, not groggy.</p>' -%}
            {%- capture obs_faq_lead -%}<p><strong>Can I use it on a flight?</strong></p><p>Yes. Use 6–8 sprays under your tongue once you're settled in, and most people are asleep in 10–15 minutes. At your destination, use it at bedtime on local time to beat jet lag and wake up clear.</p>{%- endcapture -%}
          {%- elsif page.handle == 'menopause-bogo' -%}
            {%- assign obs_why_lead = '<p>Wide awake at 3am, too warm to settle? The spray goes under your tongue, so there is nothing to swallow, and most people are asleep in 10–15 minutes.</p>' -%}
            {%- capture obs_faq_lead -%}<p><strong>Will it work for me since menopause?</strong></p><p>Rejuvia started as a sleep spray for our founder's mom, who couldn't sleep going through menopause. 6–8 sprays under your tongue and most people are asleep in 10–15 minutes, and with just 2mg of melatonin you wake up clear, not groggy. If it doesn't work for you, you get every penny back for 90 days.</p>{%- endcapture -%}
          {%- endif -%}
          {%- assign tab_n = 0 -%}
          {%- for b in section.blocks -%}{%- if b.type == 'tab' -%}
            {%- assign tab_n = tab_n | plus: 1 -%}
            {%- assign tab_open = false -%}{%- if tab_n == 1 and section.settings.open_first_tab -%}{%- assign tab_open = true -%}{%- endif -%}
            <div class="obs__tab{% if tab_open %} is-open{% endif %}" {{ b.shopify_attributes }}>
              <button type="button" class="obs__tab-q" aria-expanded="{% if tab_open %}true{% else %}false{% endif %}"><span>{{ b.settings.title }}</span>{{ obs_chevron }}</button>
              <div class="obs__tab-a"><div class="obs__tab-a-inner"><div class="obs__tab-body">{%- assign tab_t = b.settings.title | downcase -%}{%- if tab_t contains 'why rejuvia works' -%}{{ obs_why_lead }}{%- elsif tab_t contains 'frequently asked' -%}{{ obs_faq_lead }}{%- endif -%}{{ b.settings.content }}{%- if tab_t contains 'ingredient' -%}{% render 'supplement-label-button', product: section.settings.product %}{%- endif -%}</div></div></div>
            </div>
          {%- endif -%}{%- endfor -%}
        </div>
      {%- endif -%}

      {%- if section.settings.show_trusted -%}
        {%- assign obs_tb_sub = section.settings.trusted_subtext -%}
        {%- if page.handle == '3am-wake-up-bogo' -%}{%- assign obs_tb_sub = 'who now sleep straight through the night, without the 3am wake-ups' -%}{%- elsif page.handle == 'nightshift-bogo' -%}{%- assign obs_tb_sub = 'who now fall asleep fast, even when their bedtime is 8am' -%}{%- elsif page.handle == 'travel-bogo' -%}{%- assign obs_tb_sub = 'who use Rejuvia to beat jet lag and fall asleep in any time zone' -%}{%- elsif page.handle == 'menopause-bogo' -%}{%- assign obs_tb_sub = 'who use Rejuvia to fall asleep faster and get right back to sleep after a 3am wake-up' -%}{%- elsif page.handle == 'bogo-fall-asleep-faster' -%}{%- assign obs_tb_sub = 'who use Rejuvia to sleep through the entire night' -%}{%- endif -%}
        {% render 'trusted-by',
          title: section.settings.trusted_title,
          subtext: obs_tb_sub,
          image_1: section.settings.trusted_image_1,
          image_2: section.settings.trusted_image_2,
          image_3: section.settings.trusted_image_3,
          bg_color: section.settings.trusted_bg,
          check_color: section.settings.trusted_check %}
      {%- endif -%}
    </div>
  </div>
  {% render 'supplement-label-popup', product: section.settings.product %}
</section>

<script>
(function () {
  var sec = document.getElementById('obs-{{ section.id }}');
  if (!sec) return;

  /* ---- Tier selection ---- */
  sec.querySelectorAll('.obs__tier input[type="radio"]').forEach(function (input) {
    input.addEventListener('change', function () {
      sec.querySelectorAll('.obs__tier').forEach(function (t) { t.classList.remove('is-selected'); });
      input.closest('.obs__tier').classList.add('is-selected');
    });
  });
  if (!sec.querySelector('.obs__tier input[type="radio"]:checked')) {
    var first = sec.querySelector('.obs__tier input[type="radio"]');
    if (first) { first.checked = true; first.closest('.obs__tier').classList.add('is-selected'); }
  }

  /* ---- Gallery (customizer images) ---- */
  var mains = [].slice.call(sec.querySelectorAll('[data-obs-main]'));
  var thumbs = [].slice.call(sec.querySelectorAll('[data-obs-thumb]'));
  var dots = [].slice.call(sec.querySelectorAll('[data-obs-dot]'));
  var idx = 0;
  function setImg(i) {
    if (!mains.length) return;
    idx = (i + mains.length) % mains.length;
    mains.forEach(function (img, j) { img.hidden = j !== idx; });
    thumbs.forEach(function (t, j) { t.classList.toggle('is-active', j === idx); });
    dots.forEach(function (d, j) { d.classList.toggle('is-active', j === idx); });
    var t = thumbs[idx];
    if (t && t.scrollIntoView) t.scrollIntoView({ block: 'nearest', inline: 'nearest' });
  }
  thumbs.forEach(function (t, i) { t.addEventListener('click', function () { setImg(i); }); });
  var prev = sec.querySelector('[data-obs-prev]'), next = sec.querySelector('[data-obs-next]');
  if (prev) prev.addEventListener('click', function () { setImg(idx - 1); });
  if (next) next.addEventListener('click', function () { setImg(idx + 1); });

  /* Mobile: horizontal-dominant swipe only, so vertical scrolling is never hijacked */
  var main = sec.querySelector('.obs__main');
  if (main && mains.length > 1) {
    var sx = null, sy = null;
    main.addEventListener('touchstart', function (e) { var t = e.touches[0]; sx = t.clientX; sy = t.clientY; }, { passive: true });
    main.addEventListener('touchend', function (e) {
      if (sx === null) return;
      var t = e.changedTouches[0], dx = t.clientX - sx, dy = t.clientY - sy;
      if (Math.abs(dx) > 40 && Math.abs(dx) > Math.abs(dy)) setImg(dx < 0 ? idx + 1 : idx - 1);
      sx = null; sy = null;
    }, { passive: true });
  }

  /* ---- Accordion: one open at a time ---- */
  var tabs = sec.querySelectorAll('.obs__tab');
  sec.querySelectorAll('.obs__tab-q').forEach(function (btn) {
    btn.addEventListener('click', function () {
      var tab = btn.closest('.obs__tab');
      var willOpen = !tab.classList.contains('is-open');
      tabs.forEach(function (t) {
        t.classList.remove('is-open');
        var b = t.querySelector('.obs__tab-q');
        if (b) b.setAttribute('aria-expanded', 'false');
      });
      if (willOpen) { tab.classList.add('is-open'); btn.setAttribute('aria-expanded', 'true'); }
    });
  });

  /* ---- Buy Now: add the selected variant (on its Skio plan when the tier has one), then checkout ---- */
  var buy = sec.querySelector('[data-obs-buy]');
  if (buy) {
    window.addEventListener('pageshow', function () { buy.disabled = false; buy.classList.remove('is-loading'); });
    buy.addEventListener('click', function () {
      var sel = sec.querySelector('.obs__tier input[type="radio"]:checked');
      if (!sel || !sel.value) return;
      var id = parseInt(sel.value, 10);
      var qty = parseInt(sel.getAttribute('data-qty'), 10) || 1;
      var item = { id: id, quantity: qty };
      /* Buy 3 box: also add one Calm Spray, made free at checkout by the automatic Buy X Get Y discount. */
      var gift = parseInt(sel.getAttribute('data-gift'), 10);
      /* A tier that names a Skio plan the product doesn't have must never fall back to a one-time sale. */
      if (sel.getAttribute('data-plan-missing') === 'true') { alert('Sorry, this offer is unavailable right now. Please contact support.'); return; }
      var plan = parseInt(sel.getAttribute('data-plan'), 10);
      if (plan) { item.selling_plan = plan; }
      var code = (buy.getAttribute('data-obs-discount') || '').trim();
      var checkoutUrl = code ? ('/discount/' + encodeURIComponent(code) + '?redirect=/checkout') : '/checkout';
      buy.disabled = true; buy.classList.add('is-loading');
      fetch('/cart/clear.js', { method: 'POST', headers: { 'Content-Type': 'application/json' } })
        .then(function () {
          return fetch('/cart/add.js', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ items: gift ? [item, { id: gift, quantity: 1 }] : [item] })
          });
        })
        .then(function (r) { if (!r.ok) throw new Error('add failed'); window.location.href = checkoutUrl; })
        .catch(function () { window.location.href = plan ? '/cart' : ('/cart/' + id + ':' + qty + (gift ? (',' + gift + ':1') : '') + (code ? ('?discount=' + encodeURIComponent(code)) : '')); });
    });
  }

  /* ---- Hide the sticky CTA bar while this section is in view ---- */
  if ('IntersectionObserver' in window) {
    var io = new IntersectionObserver(function (entries) {
      var vis = entries[0].isIntersecting;
      document.body.classList.toggle('ob-offer-visible', vis);
      document.querySelectorAll('.sticky-cta-v2-section').forEach(function (el) {
        if (vis) el.style.setProperty('display', 'none', 'important');
        else el.style.removeProperty('display');
      });
    }, { threshold: 0 });
    io.observe(sec);
  }
})();
</script>

