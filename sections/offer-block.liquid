{% style %}
html { scroll-behavior: smooth; }
/* Hide the sticky CTA bar while the offer block (incl. its accordion) is in view */
body.ob-offer-visible .sticky-cta-v2-section,
body.ob-offer-visible #shopify-section-sticky-cta-v2 { display: none !important; }
/* Desktop sticky gallery: the theme's .content-wrapper has overflow:hidden,
   which breaks position:sticky. Switch the ancestor to clip + visible when
   this section is present (mirrors the bogo-offer fix). */
@media (min-width: 901px) {
  main:has(.ob-{{ section.id }}), .content-wrapper:has(.ob-{{ section.id }}) { overflow-x: clip; overflow-y: visible; }
  #shopify-section-{{ section.id }} { overflow-x: clip; overflow-y: visible; }
}
.ob-{{ section.id }} {
  --ob-plum-900: #4a1c4a;
  --ob-plum-800: #5d215f;
  --ob-accent: {{ section.settings.accent_color | default: '#672666' }};
  --ob-ink: #141414;
  --ob-sub: #3a3a3a;
  --ob-pernight: #8c8c92;
  --ob-struck: #b7b7be;
  --ob-sel-bg: {{ section.settings.selected_bg | default: '#f4ecf7' }};
  --ob-border: #dcdce2;
  --ob-border-m: #9a679b;
  --ob-disc-text: #018e1c;
  --ob-disc-bg: #dcf5df;
  --ob-divider: rgba(0,0,0,0.1);
  --ob-gold: {{ section.settings.stars_color | default: '#EAC78B' }};
  --font-display: 'Helvetica Neue', Arimo, Helvetica, Arial, sans-serif;
  --font-body: 'Helvetica Neue', Arimo, Helvetica, Arial, sans-serif;
  --font-ui: 'HelveticaNeueL', 'Helvetica Neue', Helvetica, Arial, sans-serif;
  background-color: {{ section.settings.section_bg | default: '#ffffff' }};
  font-family: var(--font-body);
  text-transform: none;
  letter-spacing: normal;
  word-spacing: normal;
}
.ob-{{ section.id }} *, .ob-{{ section.id }} *::before, .ob-{{ section.id }} *::after {
  text-transform: none;
  letter-spacing: normal !important;
  word-spacing: normal !important;
}
.ob-{{ section.id }} .ob__assurance { text-transform: uppercase; }
.ob__card {
  max-width: 1280px; margin: 0 auto; padding: 48px 24px;
  background: {{ section.settings.card_bg | default: 'transparent' }};
  display: grid; grid-template-columns: minmax(0,1fr) minmax(0,1fr);
  grid-template-areas: "gallery header" "gallery buybox";
  column-gap: 56px; row-gap: 16px; align-items: start;
}
.ob__header { grid-area: header; min-width: 0; }
.ob__gallery { grid-area: gallery; min-width: 0; align-self: stretch; }
.ob__gallery-inner { position: sticky; top: {{ section.settings.sticky_offset | default: 24 }}px; display: flex; flex-direction: column; gap: 16px; }
.ob__buybox { grid-area: buybox; min-width: 0; }

/* Gallery */
/* Fixed stage sized to the featured image's aspect ratio (set inline on .ob__main),
   capped at 440x440. Every gallery image object-fit:contain's into the SAME box, so
   switching thumbnails no longer changes the displayed size (first image was bigger
   because images were height-normalized with width:auto). */
.ob__main { position: relative; width: 100%; max-width: 440px; max-height: 440px; margin: 0 auto; overflow: hidden; background: {{ section.settings.image_bg | default: 'transparent' }}; }
.ob__main img { width: 100%; height: 100%; object-fit: contain; display: block; }
/* Thumb sizing lives here so the strip can cap itself to a whole number
   of thumbs. Centred so the arrows sit beside them, as on the product
   page gallery. */
.ob__thumbs-row { --ob-thumb: 96px; --ob-tgap: 10px; display: flex; align-items: center; justify-content: center; gap: var(--ob-tgap); }
.ob__dots { display: flex; justify-content: center; gap: 7px; margin-top: 2px; }
.ob__dot { width: 8px; height: 8px; border-radius: 50%; background: #d6cad6; transition: background .15s ease; }
.ob__dot.is-active { background: var(--ob-accent); }
/* BOGO ships-bar: equal spacing above/below (override the product-page --stack pull). */
.ob__cta-wrap .ship-bar--stack { margin-top: -8px; margin-bottom: 14px; }
.ob__arrow { flex-shrink: 0; width: 46px; height: 46px; border: none; background: none; color: var(--ob-accent); display: grid; place-items: center; cursor: pointer; transition: opacity .15s; }
.ob__arrow:hover { opacity: .55; }
/* flex:1 made the strip fill whatever space was left -- an arbitrary
   476px on desktop -- so the 5th thumb rendered sliced in half. Capping
   to exactly 4 thumbs plus their gaps means every thumb shown is whole;
   the rest are still reachable by scrolling. */
.ob__thumbs { display: flex; gap: var(--ob-tgap); overflow-x: auto; flex: 0 1 auto; min-width: 0;
  max-width: min(100%, calc(var(--ob-thumb) * 4 + var(--ob-tgap) * 3));
  scroll-snap-type: x mandatory;
  scrollbar-width: none; -ms-overflow-style: none; }
.ob__thumbs::-webkit-scrollbar { display: none; }
.ob__thumb { flex: 0 0 auto; width: 96px; height: 96px; border-radius: 11px; overflow: hidden; border: 1.5px solid var(--ob-border); background: {{ section.settings.image_bg | default: '#f5f1f9' }}; cursor: pointer; padding: 0; scroll-snap-align: start; }
.ob__thumb.is-active { border: 2px solid var(--ob-accent); }
.ob__thumb img { width: 100%; height: 100%; object-fit: contain; display: block; }

/* Desktop gallery matches /pages/bogo: 560px column, square 560px stage
   (rounded, cream, images cover), 57px thumbs with 28px arrows. */
@media (min-width: 901px) {
  .ob__card { grid-template-columns: 560px minmax(0,1fr); }
  .ob__gallery-inner { gap: 0; }
  .ob__main { max-width: none; max-height: none; aspect-ratio: 1 / 1; border-radius: 16px; background: #F8EFE4; }
  .ob__main img { object-fit: cover; }
  .ob__thumbs-row { --ob-thumb: 57px; --ob-tgap: 8px; margin-top: 12px; }
  .ob__thumbs { max-width: 100%; scroll-snap-type: none; }
  .ob__thumb { width: 57px; height: 57px; border-radius: 12px; border: 1px solid #e9e4f0; background: #f3f0f9; }
  .ob__thumb.is-active { border: 1.5px solid var(--ob-accent); background: #fff; }
  .ob__thumb img { object-fit: cover; }
  .ob__arrow { width: 28px; height: 28px; }
  .ob__arrow svg { width: 18px; height: 18px; }
  .ob__dots { gap: 5px; margin-top: 10px; }
  .ob__dot { width: 6px; height: 6px; }
}

/* Header */
.ob__badge { display: inline-flex; align-items: center; background: {{ section.settings.pill_bg | default: '#5d215f' }}; color: {{ section.settings.pill_color | default: '#ffffff' }}; font-family: var(--font-display); font-weight: 700; font-size: {{ section.settings.pill_size | default: 14 }}px; line-height: 1; padding: 9px 20px; border-radius: 100px; margin-bottom: 12px; white-space: nowrap; }
.ob__rating { display: flex; align-items: center; justify-content: flex-start; gap: 8px; flex-wrap: wrap; margin-bottom: 12px; }
.ob__stars { display: inline-flex; gap: 0; flex-shrink: 0; }
.ob__stars svg { width: {{ section.settings.stars_size | default: 20 }}px; height: {{ section.settings.stars_size | default: 20 }}px; display: block; margin: 0 -1px; }
.ob__rating-text { font-family: var(--font-body); font-size: {{ section.settings.rating_text_size | default: 18 }}px; font-weight: 400; color: var(--ob-ink); }
.ob__rating-text strong { font-weight: 700; color: var(--ob-accent); }
.ob__rating-text p { margin: 0; display: inline; }
/* Review bar, same as /pages/bogo: stars | 4.5 Stars | 7,500+ Reviews | 500K+ Customers.
   Mobile drops the rating label and leads with customers. */
.ob__reviewbar { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; font-family: 'Helvetica Neue', Arimo, Helvetica, Arial, sans-serif; font-size: 16px; color: #4a4550; margin-bottom: 12px; }
.ob__reviewbar .ob__stars { gap: 1.5px; }
.ob__reviewbar .ob__stars svg { width: 15px; height: 15px; margin: 0; }
.ob__rb-sep { color: #d9d3e0; }
.ob__reviewbar strong, .ob__reviewbar b { color: #171512; font-weight: 800; }
.ob__reviewbar p { margin: 0; display: inline; }
.ob__title { font-family: var(--font-display); font-size: {{ section.settings.title_size | default: 52 }}px; font-weight: 700; line-height: 1.05; letter-spacing: -0.6px; color: var(--ob-ink); margin: 0 0 10px; }
.ob__pricebar { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 14px; }
.ob__pricebar > [hidden] { display: none; }
.ob__pb-price { font-weight: 800; font-size: 32px; line-height: 1.1; color: var(--ob-accent); }
.ob__pb-struck { font-weight: 700; font-size: 26px; line-height: 1.1; color: #8a8a8a; }
.ob__pb-pill { padding: 8px 14px; border-radius: 8px; background: var(--ob-accent); color: #fff; font-weight: 800; font-size: 15px; line-height: 1.2; letter-spacing: .3px; white-space: nowrap; }
.ob__subtitle { font-family: var(--font-body); font-size: {{ section.settings.subtitle_size | default: 24 }}px; line-height: 1.35; color: var(--ob-sub); margin: 0; }
/* Uniform, editable spacing between the four header items (pill, review, title, subtitle) */
.ob-{{ section.id }} .ob__badge, .ob-{{ section.id }} .ob__rating, .ob-{{ section.id }} .ob__title, .ob-{{ section.id }} .ob__pricebar { margin-bottom: {{ section.settings.header_gap | default: 12 }}px; }
.ob-{{ section.id }} .ob__title, .ob-{{ section.id }} .ob__pricebar { margin-bottom: {{ section.settings.header_gap | default: 12 | plus: 6 }}px; }

/* Offer cards */
.ob__tiers { display: flex; flex-direction: column; gap: 22px; margin-top: 0; }
.ob__tier { position: relative; display: flex; align-items: center; gap: 28px; background: #fff; border: 1.5px solid var(--ob-border); border-radius: 13px; padding: 28px 30px; cursor: pointer; transition: background .15s ease, border-color .15s ease; box-sizing: border-box; }
.ob__tier.is-selected { border-color: var(--ob-accent); box-shadow: inset 0 0 0 1.5px var(--ob-accent); background: var(--ob-sel-bg); }
.ob__tier input { position: absolute; opacity: 0; pointer-events: none; }
.ob__radio { flex-shrink: 0; width: 22px; height: 22px; border-radius: 50%; border: 2px solid var(--ob-accent); position: relative; }
.ob__tier.is-selected .ob__radio::after { content: ''; position: absolute; inset: 4px; border-radius: 50%; background: var(--ob-accent); }
.ob__tier-img { flex-shrink: 0; width: 112px; height: auto; }
.ob__tier-body { min-width: 0; display: flex; flex-direction: column; gap: 15px; }
.ob__tier-title { font-family: var(--font-display); font-size: {{ section.settings.tier_title_size | default: 26 }}px; font-weight: 700; color: var(--ob-accent); line-height: 1.1; white-space: nowrap; }
.ob__tier-prices { display: flex; align-items: baseline; gap: 10px; flex-wrap: nowrap; white-space: nowrap; }
.ob__price { font-size: 29px; font-weight: 700; color: var(--ob-ink); }
.ob__struck { font-size: 21px; font-weight: 400; color: var(--ob-struck); text-decoration: line-through; }
.ob__off { display: inline-flex; align-items: center; justify-content: center; align-self: center; font-family: var(--font-ui); font-size: 16px; font-weight: 700; line-height: 1; color: var(--ob-disc-text); background: var(--ob-disc-bg); border-radius: 100px; padding: 6px 11px 5px; white-space: nowrap; text-transform: uppercase; }
.ob__ship { font-size: 18px; font-weight: 700; color: var(--ob-ink); }
.ob__pernight { font-size: 20px; font-weight: 400; font-style: italic; color: var(--ob-pernight); }
.ob__tag { position: absolute; top: -13px; right: 16px; font-family: var(--font-ui); font-size: 14px; font-weight: 700; line-height: 1; padding: 8px 12px 4px; border-radius: 100px; white-space: nowrap; }
.ob__tag--brand { background: var(--ob-plum-800); color: #fff; }
.ob__tag--gold { background: var(--ob-gold); color: var(--ob-ink); }

/* CTA (pill) */
.ob__cta-wrap { margin-top: 22px; }
.ob__buy { width: 100%; display: inline-flex; align-items: center; justify-content: center; gap: 10px; background: var(--ob-accent); color: #fff; font-family: var(--font-display); font-weight: 500; font-size: 18px; letter-spacing: normal; line-height: 1; padding: 24px 32px; border: none; border-radius: 100px; cursor: pointer; transition: opacity .25s ease; }
.ob__buy:hover { opacity: 0.9; }
.ob__buy:disabled { cursor: default; }
.ob__spinner { display: none; width: 24px; height: 24px; border: 2.5px solid rgba(255,255,255,.45); border-top-color: #fff; border-radius: 50%; animation: ob-spin .6s linear infinite; }
.ob__buy.is-loading { justify-content: center; }
.ob__buy.is-loading .ob__buy-label, .ob__buy.is-loading svg { display: none; }
.ob__buy.is-loading .ob__spinner { display: block; }
@keyframes ob-spin { to { transform: rotate(360deg); } }

.ob__assurances { display: flex; flex-direction: column; align-items: center; gap: 8px; margin-top: 16px; }
.ob__assurance { display: inline-flex; align-items: center; gap: 8px; font-family: var(--font-ui); font-size: 14px; font-weight: 600; letter-spacing: .03em; text-transform: uppercase; color: #4a4a4a; }
.ob__assurance svg { width: 17px; height: 17px; flex-shrink: 0; }
.ob__assurance-icon { width: 17px; height: 17px; flex-shrink: 0; object-fit: contain; display: block; }
.ob__payments { display: flex; align-items: center; justify-content: center; gap: 8px; flex-wrap: wrap; margin-top: 16px; }
.ob__payments svg { height: 26px; width: auto; }

/* Accordion */
.ob__tabs { margin-top: 22px; border-bottom: 1px solid var(--ob-divider); }
.ob__tab { border-top: 1px solid var(--ob-divider); }
.ob__tab-q { width: 100%; display: flex; align-items: center; justify-content: space-between; gap: 20px; padding: 26px 4px; background: none; border: none; cursor: pointer; text-align: left; font-family: var(--font-display); font-size: {{ section.settings.tab_title_size | default: 20 }}px; font-weight: 500; color: #171512; line-height: 1.4; }
.ob__tab-q > span { flex: 1 1 auto; min-width: 0; overflow-wrap: anywhere; }
.ob__tab-chevron { flex-shrink: 0; width: 20px; height: 20px; color: var(--ob-accent); transition: transform .22s ease; }
.ob__tab.is-open .ob__tab-chevron { transform: rotate(180deg); }
.ob__tab-a { display: grid; grid-template-rows: 0fr; transition: grid-template-rows .3s ease; }
.ob__tab.is-open .ob__tab-a { grid-template-rows: 1fr; }
.ob__tab-a-inner { overflow: hidden; }
.ob__tab-body { padding: 0 4px 28px; font-family: var(--font-body); font-size: {{ section.settings.tab_body_size | default: 18 }}px; line-height: 1.6; color: var(--ob-sub); }
.ob__tab-body p { margin: 0 0 12px; }
.ob__tab-body p:last-child { margin-bottom: 0; }
.ob__tab-body strong { color: var(--ob-ink); font-weight: 700; }

@media (max-width: 900px) {
  .ob-{{ section.id }} { overflow-x: clip; }
  .ob__buybox, .ob__tabs, .ob__tab-q { min-width: 0; max-width: 100%; }
  .ob__card { display: flex; flex-direction: column; gap: 16px; padding: 22px 16px 28px; border-radius: 0; box-shadow: none; }
  /* Mobile order: gallery first, then the header (rating, title, subtitle), then the buy box. */
  .ob-{{ section.id }} .ob__gallery { order: -1; }
  .ob-{{ section.id }} .ob__header { text-align: left; }
  .ob-{{ section.id }} .ob__buybox { margin-top: -6px; }
  .ob-{{ section.id }} .ob__badge { font-size: {{ section.settings.pill_size_mobile | default: 13 }}px; }
  .ob-{{ section.id }} .ob__rating { justify-content: flex-start; }
  .ob-{{ section.id }} .ob__stars svg { width: {{ section.settings.stars_size_mobile | default: 20 }}px; height: {{ section.settings.stars_size_mobile | default: 20 }}px; }
  .ob-{{ section.id }} .ob__rating-text { font-size: {{ section.settings.rating_text_size_mobile | default: 18 }}px; }
  .ob__reviewbar { gap: 7px; }
  .ob__reviewbar .ob__rb-strong, .ob__reviewbar .ob__rb-sep-reviews { display: none; }
  .ob__reviewbar .ob__rb-customers { order: 1; }
  .ob__reviewbar .ob__rb-sep-customers { order: 2; }
  .ob__reviewbar .ob__rb-reviews { order: 3; }
  .ob-{{ section.id }} .ob__reviewbar .ob__stars svg { width: 12px; height: 12px; }
  /* 30px on mobile to match /pages/bogo (fixed in code: template JSON edits don't deploy). */
  .ob-{{ section.id }} .ob__title { font-size: 30px; letter-spacing: -1px; text-align: left; }
  .ob-{{ section.id }} .ob__subtitle { font-size: {{ section.settings.subtitle_size_mobile | default: 20 }}px; text-align: left; padding: 0; }
  .ob-{{ section.id }} .ob__badge, .ob-{{ section.id }} .ob__rating, .ob-{{ section.id }} .ob__title, .ob-{{ section.id }} .ob__pricebar { margin-bottom: {{ section.settings.header_gap_mobile | default: 12 | divided_by: 2 }}px; }
  .ob-{{ section.id }} .ob__title, .ob-{{ section.id }} .ob__pricebar { margin-bottom: {{ section.settings.header_gap_mobile | default: 12 | divided_by: 2 | plus: 6 }}px; }
  .ob__gallery-inner { position: static; }
  .ob__pricebar { gap: 6px; }
  .ob__pb-price { font-size: clamp(23px, 7.2vw, 28px); }
  .ob__pb-struck { font-size: clamp(17px, 5.4vw, 21px); font-weight: 400; }
  /* Pill is exactly as tall as the price line (price font x 1.1), with no extra top/bottom padding. */
  .ob__pb-pill { display: inline-flex; align-items: center; box-sizing: border-box; height: calc(clamp(23px, 7.2vw, 28px) * 1.1); line-height: 1; padding: 0 8px; border-radius: 6px; font-size: clamp(10px, 2.95vw, 11.5px); letter-spacing: .2px; }
  .ob__main { min-height: 0; max-width: 100%; max-height: none; }
  /* Fill the gallery width on mobile. The base rule is width:auto with a
     max-height, so a square image capped at 320px tall also rendered 320px
     wide -- 23px narrower than the 343px gallery, thumbs and dots, which read
     as the image being misaligned. Width now governs and the height follows
     the aspect ratio. */
  .ob__main img { width: 100%; height: 100%; object-fit: contain; }
  /* Thumbnail arrows on mobile; the thumb strip scrolls between them. */
  .ob__arrow { width: 28px; height: 28px; }
  .ob__arrow svg { width: 18px; height: 18px; }
  /* Mobile strip matches /pages/bogo: 57px thumbs, 8px gaps, five across. */
  .ob__thumbs-row { margin-top: -8px; --ob-thumb: 57px; --ob-tgap: 8px; }
  .ob__thumbs { max-width: min(100%, calc(var(--ob-thumb) * 5 + var(--ob-tgap) * 4)); }
  .ob__thumb { width: 57px; height: 57px; border-radius: 12px; }
  .ob__tiers { gap: 18px; margin-top: 0; }
  .ob__tier { gap: 18px; padding: 16px 16px 16px 14px; border: 1.6px solid var(--ob-border-m); }
  .ob__tier-body { gap: 10px; }
  .ob__tier-img { width: 83px; margin-left: -7px; }
  .ob__tier-title { font-size: {{ section.settings.tier_title_size_mobile | default: 21 }}px; white-space: normal; }
  .ob__price { font-size: 24px; }
  .ob__struck { font-size: 18px; }
  .ob__off { font-size: 14px; padding: 5px 10px 4px; }
  .ob__ship { font-size: 15px; }
  .ob__pernight { font-size: 18px; }
  .ob__tag { font-size: 12px; padding: 7px 12px 4px; }
  .ob__buy { font-size: clamp(15px, 4.6vw, 18px); padding: 24px 20px; }
  .ob__tier-prices { gap: 7px; flex-wrap: wrap; white-space: normal; }
  .ob__tab-q { font-size: {{ section.settings.tab_title_size_mobile | default: 18 }}px; padding: 24px 2px; }
  .ob__tab-body { font-size: {{ section.settings.tab_body_size_mobile | default: 17 }}px; }
}
/* Header: left-aligned on desktop */
@media (min-width: 901px) {
  .ob-{{ section.id }} .ob__header,
  .ob-{{ section.id }} .ob__title,
  .ob-{{ section.id }} .ob__subtitle { text-align: left; }
  .ob-{{ section.id }} .ob__rating { justify-content: flex-start; }
}
{% endstyle %}

{%- capture ob_star -%}<svg viewBox="0 0 18 16" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M3.85124 15.9392C3.43952 16.1504 2.97233 15.7803 3.05553 15.3078L3.94083 10.2626L0.183091 6.68298C-0.167831 6.34806 0.0145632 5.73581 0.484948 5.66968L5.70931 4.9273L8.03883 0.31199C8.24895 -0.103997 8.81747 -0.103997 9.0276 0.31199L11.3571 4.9273L16.5815 5.66968C17.0519 5.73581 17.2343 6.34806 16.8823 6.68298L13.1256 10.2626L14.0109 15.3078C14.0941 15.7803 13.6269 16.1504 13.2152 15.9392L8.53161 13.5329L3.85124 15.9392Z" fill="{{ section.settings.stars_color | default: '#EAC78B' }}"/></svg>{%- endcapture -%}
{%- comment -%} Review-bar star: the /pages/bogo gold. {%- endcomment -%}
{%- capture ob_rb_star -%}<svg viewBox="0 0 18 16" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M3.85124 15.9392C3.43952 16.1504 2.97233 15.7803 3.05553 15.3078L3.94083 10.2626L0.183091 6.68298C-0.167831 6.34806 0.0145632 5.73581 0.484948 5.66968L5.70931 4.9273L8.03883 0.31199C8.24895 -0.103997 8.81747 -0.103997 9.0276 0.31199L11.3571 4.9273L16.5815 5.66968C17.0519 5.73581 17.2343 6.34806 16.8823 6.68298L13.1256 10.2626L14.0109 15.3078C14.0941 15.7803 13.6269 16.1504 13.2152 15.9392L8.53161 13.5329L3.85124 15.9392Z" fill="#fab851"/></svg>{%- endcapture -%}
{%- capture ob_chevron -%}<svg class="ob__tab-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>{%- endcapture -%}

{%- assign gallery_product = section.settings.product -%}

<section class="ob-{{ section.id }}" id="ob-{{ section.id }}">
  <span id="offer" aria-hidden="true" style="display:block;scroll-margin-top:80px;"></span>
  <div class="ob__card">

    <div class="ob__header">
      {%- if section.settings.pill_text != blank -%}
        <span class="ob__badge">{{ section.settings.pill_text }}</span>
      {%- endif -%}
      <div class="ob__rating ob__reviewbar">
        {%- if section.settings.show_stars -%}<span role="img" class="ob__stars" aria-label="5 stars">{{ ob_rb_star }}{{ ob_rb_star }}{{ ob_rb_star }}{{ ob_rb_star }}{{ ob_rb_star }}</span>{%- endif -%}
        {%- if section.settings.rb_rating != blank -%}{%- assign rb_num = section.settings.rb_rating | split: ' ' | first -%}<span class="ob__rb-strong"><strong>{{ rb_num }}</strong> {{ section.settings.rb_rating | remove_first: rb_num | strip }}</span>{%- endif -%}
        {%- if section.settings.rb_reviews != blank -%}
          <span class="ob__rb-sep ob__rb-sep-reviews" aria-hidden="true">|</span>
          <span class="ob__rb-reviews">{{ section.settings.rb_reviews }}</span>
        {%- endif -%}
        {%- if section.settings.rb_customers != blank -%}
          <span class="ob__rb-sep ob__rb-sep-customers" aria-hidden="true">|</span>
          <span class="ob__rb-customers">{{ section.settings.rb_customers }}</span>
        {%- endif -%}
      </div>
      {%- comment -%} The senior, military and nurse BOGO pages all run on the senior template; their headline and subtitle (and military/nurse's pill and checkout code) are set here by page URL because template JSON edits don't deploy. {%- endcomment -%}
      {%- assign ob_kind = template.suffix -%}
      {%- assign ob_title = section.settings.title -%}{%- assign ob_subtitle = section.settings.subtitle -%}{%- assign ob_code = section.settings.checkout_discount_code | strip -%}
      {%- if page.handle == 'senior-citizen-bogo' -%}
        {%- assign ob_title = 'Rejuvia Sleep Spray Senior Discount: BOGO Free + 10% OFF' -%}
        {%- capture ob_subtitle -%}Seniors only: just $13.50 a bottle, about 45¢ a night. Asleep in about 15 minutes, right back to sleep after the 3am bathroom trip, or every penny back for 90 days.{%- endcapture -%}
      {%- elsif page.handle == 'military-bogo' -%}
        {%- assign ob_kind = 'military' -%}
        {%- assign ob_title = 'Rejuvia Sleep Spray Military Discount: BOGO Free + 10% OFF' -%}
        {%- capture ob_subtitle -%}Thank you to everyone who served, active duty and veterans. Just $13.50 a bottle: asleep in about 15 minutes, wake up clear, not groggy. 90-day money-back guarantee.{%- endcapture -%}
        {%- assign ob_code = 'MILITARY10' -%}
      {%- elsif page.handle == 'nurse-bogo' -%}
        {%- assign ob_kind = 'nurse' -%}
        {%- assign ob_title = 'Rejuvia Sleep Spray Nurse Discount: BOGO Free + 10% OFF' -%}
        {%- capture ob_subtitle -%}You take care of everyone else. Tonight it's your turn: asleep in about 15 minutes after any shift, day or night, and wake up clear. Just $13.50 a bottle, 90-day money-back guarantee.{%- endcapture -%}
        {%- assign ob_code = 'NURSE10' -%}
      {%- endif -%}
      {%- if ob_title != blank -%}<h2 class="ob__title">{{ ob_title }}</h2>{%- endif -%}
      {%- comment -%} Pill label: the audience pages name their discount; every other BOGO page uses the sale label (FALL SALE). Keyed on the page template in code because template JSON edits don't deploy. {%- endcomment -%}
      {%- case ob_kind -%}
        {%- when 'military' -%}{%- assign pb_label = 'MILITARY DISCOUNT' -%}
        {%- when 'senior' -%}{%- assign pb_label = 'SENIOR DISCOUNT' -%}
        {%- when 'nurse' -%}{%- assign pb_label = 'NURSE DISCOUNT' -%}
        {%- else -%}{%- assign pb_label = section.settings.sale_label | default: 'FALL SALE' -%}
      {%- endcase -%}
      {%- comment -%} Price bar (same as the product page) between title and subtitle: the pre-selected box's price, strikethrough and "<sale label> - X% OFF" pill, worked out the same way as the box rows below. The script updates it when another box is picked. {%- endcomment -%}
      {%- comment -%} Pre-select the middle box on every BOGO page. Done in code, not the Pre-selected setting, because Shopify reverts template JSON edits from git. {%- endcomment -%}
      {%- assign ob_tier_count = 0 -%}{%- for b in section.blocks -%}{%- if b.type == 'tier' -%}{%- assign ob_tier_count = ob_tier_count | plus: 1 -%}{%- endif -%}{%- endfor -%}
      {%- assign ob_default_tier = ob_tier_count | plus: 1 | divided_by: 2 -%}
      {%- comment -%} Nurse, senior and military pre-select the first box (Buy 1, Get 1 FREE) {%- endcomment -%}
      {%- if ob_kind == 'nurse' or ob_kind == 'senior' or ob_kind == 'military' -%}{%- assign ob_default_tier = 1 -%}{%- endif -%}
      {%- assign pb_price = '' -%}{%- assign pb_compare = '' -%}{%- assign ptn = 0 -%}{%- assign pb_sprays = 0 -%}
      {%- for b in section.blocks -%}{%- if b.type == 'tier' -%}
        {%- assign ptn = ptn | plus: 1 -%}
        {%- if ptn == ob_default_tier -%}
          {%- assign psrc = b.settings.product | default: gallery_product -%}
          {%- assign pv = blank -%}{%- assign pvid = b.settings.variant_id | strip -%}
          {%- if pvid != blank and psrc != blank -%}{%- for v in psrc.variants -%}{%- assign vs = v.id | append: '' -%}{%- if vs == pvid -%}{%- assign pv = v -%}{%- break -%}{%- endif -%}{%- endfor -%}{%- endif -%}
          {%- assign pb_manual = section.settings.use_manual_prices -%}
          {%- if pv != blank and pb_manual != true -%}
            {%- assign pb_price = pv.price | money_without_trailing_zeros -%}
            {%- if b.settings.compare_price != blank -%}{%- assign pb_compare = b.settings.compare_price -%}{%- elsif pv.compare_at_price and pv.compare_at_price > pv.price -%}{%- assign pb_compare = pv.compare_at_price | money_without_trailing_zeros -%}{%- endif -%}
          {%- else -%}
            {%- assign pb_price = b.settings.price -%}{%- assign pb_compare = b.settings.compare_price -%}
          {%- endif -%}
          {%- assign pb_lw = b.settings.label | remove: ',' | split: ' ' -%}
          {%- if pb_lw[0] == 'Buy' and pb_lw[1] == '3' -%}{%- assign pb_compare = '$207' -%}{%- endif -%}
          {%- if pb_lw[0] == 'Buy' -%}{%- assign pb_sprays = pb_lw[1] | plus: 0 | times: 2 -%}{%- endif -%}
        {%- endif -%}
      {%- endif -%}{%- endfor -%}
      {%- assign pbnp = pb_price | replace: '$','' | replace: ',','' | strip | plus: 0.0 -%}
      {%- assign pbnc = pb_compare | replace: '$','' | replace: ',','' | strip | plus: 0.0 -%}
      {%- assign pb_pill = '' -%}
      {%- if pbnc > pbnp and pbnp > 0 -%}
        {%- assign pb_pct = pbnc | minus: pbnp | times: 100.0 | divided_by: pbnc | round -%}
        {%- assign pb_pill = pb_label | append: ' - ' | append: pb_pct | append: '% OFF' -%}
      {%- else -%}
        {%- assign pb_compare = '' -%}
      {%- endif -%}
      {%- comment -%} Pill reads "$X PER SPRAY" (box price / bottles), like the bogosub price bar. {%- endcomment -%}
      {%- if pb_sprays > 0 and pbnp > 0 -%}
        {%- assign pb_each = pbnp | times: 100 | divided_by: pb_sprays | round | money_without_trailing_zeros -%}
        {%- assign pb_pill = pb_each | append: ' PER SPRAY' -%}
      {%- endif -%}
      {%- if pb_price != blank -%}
      <div class="ob__pricebar">
        <span class="ob__pb-price" data-ob-pb-price>{{ pb_price | strip }}</span>
        <s class="ob__pb-struck" data-ob-pb-struck{% if pb_compare == blank %} hidden{% endif %}>{{ pb_compare | strip }}</s>
        <span class="ob__pb-pill" data-ob-pb-pill{% if pb_pill == blank %} hidden{% endif %}>{{ pb_pill }}</span>
      </div>
      {%- endif -%}
      {%- if ob_subtitle != blank -%}<p class="ob__subtitle">{{ ob_subtitle }}</p>{%- endif -%}
    </div>

    <div class="ob__gallery">
      <div class="ob__gallery-inner">
        {%- comment -%} Same gallery (design + images) as /pages/bogo on every BOGO page {%- endcomment -%}
        {%- render 'bogo-gallery', id: section.id, alt: ob_title -%}
      </div>
    </div>

    <div class="ob__buybox">
      <div class="ob__tiers" role="radiogroup" aria-label="Choose your bundle">
        {%- assign tier_n = 0 -%}
        {%- for b in section.blocks -%}{%- if b.type == 'tier' -%}
          {%- assign tier_n = tier_n | plus: 1 -%}
          {%- assign tier_sel = false -%}
          {%- if tier_n == ob_default_tier -%}{%- assign tier_sel = true -%}{%- endif -%}
          {%- assign vid = b.settings.variant_id | strip -%}
          {%- assign tier_variant = blank -%}
          {%- if vid != blank -%}
            {%- assign srcprod = b.settings.product | default: gallery_product -%}
            {%- if srcprod != blank -%}
              {%- for v in srcprod.variants -%}
                {%- assign vstr = v.id | append: '' -%}
                {%- if vstr == vid -%}{%- assign tier_variant = v -%}{%- break -%}{%- endif -%}
              {%- endfor -%}
            {%- endif -%}
          {%- endif -%}
          {%- if vid == blank and b.settings.product != blank -%}{%- assign vid = b.settings.product.selected_or_first_available_variant.id -%}{%- endif -%}
          {%- comment -%} The extra 10% code (SENIOR10, MILITARY10, NURSE10, set by page handle) applies to every box, and each box shows its 10%-off price ($27 / $54 / $81 from the template's manual prices). The codes stack with the automatic Buy N, Get N discounts. {%- endcomment -%}
          {%- assign t_manual = section.settings.use_manual_prices -%}{%- assign t_code = ob_code -%}
          <label class="ob__tier{% if tier_sel %} is-selected{% endif %}" {{ b.shopify_attributes }}>
            <input type="radio" name="ob-{{ section.id }}" value="{{ vid }}" data-code="{{ t_code }}" {% if tier_sel %}checked{% endif %}>
            {%- if b.settings.tag != blank -%}<span class="ob__tag ob__tag--{{ b.settings.tag_style | default: 'brand' }}">{{ b.settings.tag }}</span>{%- endif -%}
            <span class="ob__radio" aria-hidden="true"></span>
            {%- if b.settings.image != blank -%}
              <img class="ob__tier-img" src="{{ b.settings.image | image_url: width: 290, format: 'webp' }}" width="290" height="320" alt="" decoding="async" loading="lazy">
            {%- elsif b.settings.image_asset != blank -%}
              <img class="ob__tier-img" src="{{ b.settings.image_asset | asset_url }}" width="290" height="320" alt="" decoding="async" loading="lazy">
            {%- endif -%}
            <span class="ob__tier-body">
              <span class="ob__tier-title">{{ b.settings.label }}</span>
              <span class="ob__tier-prices">
                {%- assign t_sp = 0 -%}{%- assign t_sc = 0 -%}
                {%- if tier_variant != blank and t_manual != true -%}
                  {%- assign t_sp = tier_variant.price | divided_by: 100.0 -%}
                  {%- if b.settings.compare_price != blank -%}{%- assign t_sc = b.settings.compare_price | replace: '$','' | replace: ',','' | strip | plus: 0.0 -%}{%- elsif tier_variant.compare_at_price -%}{%- assign t_sc = tier_variant.compare_at_price | divided_by: 100.0 -%}{%- endif -%}
                  <span class="ob__price">{{ tier_variant.price | money_without_trailing_zeros }}</span>
                  {%- comment -%} Block's compare-at field wins when set (editable strikethrough); otherwise use the live variant's compare-at. {%- endcomment -%}
                  {%- if b.settings.compare_price != blank -%}<span class="ob__struck">{{ b.settings.compare_price }}</span>
                  {%- elsif tier_variant.compare_at_price and tier_variant.compare_at_price > tier_variant.price -%}<span class="ob__struck">{{ tier_variant.compare_at_price | money_without_trailing_zeros }}</span>{%- endif -%}
                {%- else -%}
                  {%- if b.settings.price != blank -%}<span class="ob__price">{{ b.settings.price }}</span>{%- endif -%}
                  {%- if b.settings.compare_price != blank -%}<span class="ob__struck">{{ b.settings.compare_price }}</span>{%- endif -%}
                {%- endif -%}
                {%- if t_sp == 0 -%}{%- assign t_sp = b.settings.price | replace: '$','' | replace: ',','' | strip | plus: 0.0 -%}{%- endif -%}
                {%- comment -%} Bigger boxes: a SAVE $X badge is worked out from the strikethrough minus the live price. {%- endcomment -%}
                {%- assign t_save = b.settings.savings_text -%}{%- assign t_su = t_save | upcase -%}
                {%- if tier_n > 1 and t_su contains 'SAVE $' and t_sc > t_sp and t_sp > 0 -%}{%- assign t_save = t_sc | minus: t_sp | times: 100 | round | money_without_trailing_zeros | prepend: 'SAVE ' -%}{%- endif -%}
                {%- if t_save != blank -%}<span class="ob__off">{{ t_save }}</span>{%- endif -%}
              </span>
              {%- if tier_n == 3 -%}<span class="ob__ship">+ FREE Shipping</span>{%- endif -%}
              {%- comment -%} Per night = box price over 2N bottles x 30 nights, from the "Buy N, Get N" label (as on /pages/bogo-og). {%- endcomment -%}
              {%- assign t_pw = b.settings.label | remove: ',' | split: ' ' -%}{%- assign t_nights = t_pw[1] | plus: 0 | times: 60 -%}
              {%- if t_pw[0] == 'Buy' and t_nights > 0 and t_sp > 0 -%}<span class="ob__pernight">{{ t_sp | times: 100 | divided_by: t_nights | round | money }} Per Night</span>{%- endif -%}
            </span>
          </label>
        {%- endif -%}{%- endfor -%}
      </div>

      <div class="ob__cta-wrap">
        {% render 'shipping-bar', extra_class: 'ship-bar--stack' %}
        <button type="button" class="ob__buy" data-ob-buy data-ob-discount="{{ ob_code }}">
          <span class="ob__spinner" aria-hidden="true"></span>
          <span class="ob__buy-label">BUY NOW</span>
          <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </button>

        {%- if section.settings.guarantee_text != blank or section.settings.onetime_text != blank -%}
          <div class="ob__assurances">
            {%- if section.settings.guarantee_text != blank -%}
              <span class="ob__assurance">{%- if section.settings.guarantee_icon != blank -%}<img class="ob__assurance-icon" src="{{ section.settings.guarantee_icon | image_url: width: 60 }}" alt="" width="17" height="17" loading="lazy" decoding="async">{%- else -%}<svg width="15" height="15" viewBox="0 0 24 24" fill="none"><path d="M12 2l8 3v6c0 5-3.4 8.5-8 11-4.6-2.5-8-6-8-11V5l8-3z" stroke="#4a4a4a" stroke-width="1.6" stroke-linejoin="round"/></svg>{%- endif -%}{{ section.settings.guarantee_text }}</span>
            {%- endif -%}
            {%- if section.settings.onetime_text != blank -%}
              <span class="ob__assurance">{%- if section.settings.onetime_icon != blank -%}<img class="ob__assurance-icon" src="{{ section.settings.onetime_icon | image_url: width: 60 }}" alt="" width="17" height="17" loading="lazy" decoding="async">{%- else -%}<svg width="15" height="15" viewBox="0 0 24 24" fill="none"><rect x="4" y="10" width="16" height="11" rx="2.5" stroke="#5d215f" stroke-width="1.8"/><path d="M8 10V7a4 4 0 0 1 8 0v3" stroke="#5d215f" stroke-width="1.8" stroke-linecap="round"/></svg>{%- endif -%}{{ section.settings.onetime_text }}</span>
            {%- endif -%}
          </div>
        {%- endif -%}

        {%- if section.settings.show_payment_icons -%}
          {%- assign hidden_pay = section.settings.hidden_payments | default: '' | downcase | replace: ' ', '' | split: ',' -%}
          <div class="ob__payments">
            {%- for type in shop.enabled_payment_types -%}{%- unless hidden_pay contains type -%}{{ type | payment_type_svg_tag: class: 'payment-icon' }}{%- endunless -%}{%- endfor -%}
          </div>
        {%- endif -%}
      </div>

      {%- assign has_tabs = false -%}
      {%- for b in section.blocks -%}{%- if b.type == 'tab' and b.settings.title != blank -%}{%- assign has_tabs = true -%}{%- endif -%}{%- endfor -%}
      {%- comment -%} Audience pages add one line to the top of "Why Rejuvia Works" and one question to the top of the FAQ tab; the rest of each tab is unchanged. {%- endcomment -%}
      {%- assign ob_why_lead = '' -%}{%- assign ob_faq_lead = '' -%}
      {%- case page.handle -%}
        {%- when 'senior-citizen-bogo' -%}
          {%- assign ob_why_lead = '<p>No pills to swallow: just 6–8 sprays under your tongue.</p>' -%}
          {%- capture ob_faq_lead -%}<p><strong>Is it really just $13.50 a bottle?</strong></p><p>Yes. Your extra 10% senior discount comes off automatically at checkout, so Buy 1, Get 1 FREE works out to $13.50 a bottle, about 45¢ a night. It's a one-time purchase, not a subscription.</p>{%- endcapture -%}
        {%- when 'military-bogo' -%}
          {%- assign ob_why_lead = '<p>Works the same at home, on deployment or across time zones: 6–8 sprays under your tongue, and most people are asleep in 10–15 minutes.</p>' -%}
          {%- assign ob_faq_lead = '<p><strong>Who gets the military discount?</strong></p><p>Everyone who has served: active duty and veterans. Your extra 10% comes off automatically at checkout.</p>' -%}
        {%- when 'nurse-bogo' -%}
          {%- assign ob_why_lead = '<p>Coming off a night shift? It works whenever you need to sleep, day or night, and the low 2mg dose means you wake up clear for your next shift.</p>' -%}
          {%- capture ob_faq_lead -%}<p><strong>I work nights. Can I use it during the day?</strong></p><p>Yes. Use 6–8 sprays whenever you're ready to sleep, day or night. With just 2mg of melatonin, you wake up clear, not groggy.</p>{%- endcapture -%}
      {%- endcase -%}
      {%- if has_tabs -%}
        <div class="ob__tabs">
          {%- for b in section.blocks -%}{%- if b.type == 'tab' -%}
            <div class="ob__tab" {{ b.shopify_attributes }}>
              <button type="button" class="ob__tab-q" aria-expanded="false"><span>{{ b.settings.title }}</span>{{ ob_chevron }}</button>
              <div class="ob__tab-a"><div class="ob__tab-a-inner"><div class="ob__tab-body">{%- assign tab_t = b.settings.title | downcase -%}{%- if tab_t contains 'why rejuvia works' -%}{{ ob_why_lead }}{%- elsif tab_t contains 'frequently asked' -%}{{ ob_faq_lead }}{%- endif -%}{{ b.settings.content }}{%- if tab_t contains 'ingredient' -%}{% render 'supplement-label-button', product: section.settings.product %}{%- endif -%}</div></div></div>
            </div>
          {%- endif -%}{%- endfor -%}
        </div>
      {%- endif -%}

      {%- if section.settings.show_trusted -%}
        {%- comment -%} Trusted-by line under "Used by 500,000+ customers": each audience page names the result that matters most to them. {%- endcomment -%}
        {%- assign ob_tb_sub = section.settings.trusted_subtext -%}
        {%- case page.handle -%}
          {%- when 'senior-citizen-bogo' -%}{%- assign ob_tb_sub = 'to fall asleep faster and get right back to sleep after the 3am bathroom trip.' -%}
          {%- when 'military-bogo' -%}{%- assign ob_tb_sub = 'to fall asleep faster and wake up clear, not groggy.' -%}
          {%- when 'nurse-bogo' -%}{%- assign ob_tb_sub = 'to fall asleep faster after any shift, even when you sleep during the day.' -%}
        {%- endcase -%}
        {% render 'trusted-by',
          title: section.settings.trusted_title,
          subtext: ob_tb_sub,
          image_1: section.settings.trusted_image_1,
          image_2: section.settings.trusted_image_2,
          image_3: section.settings.trusted_image_3,
          bg_color: section.settings.trusted_bg,
          check_color: section.settings.trusted_check %}
      {%- endif -%}
    </div>
  </div>
  {% render 'supplement-label-popup', product: section.settings.product %}
</section>

<script>
(function () {
  var sec = document.getElementById('ob-{{ section.id }}');
  if (!sec) return;

  /* Tier selection */
  sec.querySelectorAll('.ob__tier input[type="radio"]').forEach(function (input) {
    input.addEventListener('change', function () {
      sec.querySelectorAll('.ob__tier').forEach(function (t) { t.classList.remove('is-selected'); });
      input.closest('.ob__tier').classList.add('is-selected');
    });
  });
  /* Ensure exactly one box is selected on load */
  if (!sec.querySelector('.ob__tier input[type="radio"]:checked')) {
    var firstInput = sec.querySelector('.ob__tier input[type="radio"]');
    if (firstInput) { firstInput.checked = true; firstInput.closest('.ob__tier').classList.add('is-selected'); }
  }

  /* Price bar mirrors the selected box: its price, strikethrough and "<sale label> - X% OFF". */
  var pbPrice = sec.querySelector('[data-ob-pb-price]');
  var pbStruck = sec.querySelector('[data-ob-pb-struck]');
  var pbPill = sec.querySelector('[data-ob-pb-pill]');
  var pbLabel = {{ pb_label | json }};
  function pbNum(s) { return parseFloat(String(s || '').replace(/[^0-9.]/g, '')) || 0; }
  function syncPricebar() {
    var sel = sec.querySelector('.ob__tier input[type="radio"]:checked');
    if (!sel || !pbPrice) return;
    var tier = sel.closest('.ob__tier');
    var p = tier.querySelector('.ob__price'), c = tier.querySelector('.ob__struck');
    var pt = p ? p.textContent.trim() : '', ct = c ? c.textContent.trim() : '';
    var np = pbNum(pt), nc = pbNum(ct), off = nc > np && np > 0;
    pbPrice.textContent = pt;
    pbStruck.textContent = off ? ct : ''; pbStruck.hidden = !off;
    pbPill.textContent = off ? pbLabel + ' - ' + Math.round((nc - np) * 100 / nc) + '% OFF' : ''; pbPill.hidden = !off;
    var tn = tier.querySelector('.ob__tier-title'), m = tn && tn.textContent.match(/Buy\s+(\d+)/i);
    if (m && np > 0) { var each = np / (2 * parseInt(m[1], 10) + (sel.hasAttribute('data-gift') ? 1 : 0)); pbPill.textContent = '$' + (each % 1 ? each.toFixed(2) : each) + ' PER SPRAY'; pbPill.hidden = false; }
  }
  sec.addEventListener('change', function (e) { if (e.target.closest('.ob__tier')) syncPricebar(); });
  syncPricebar();


  /* Gallery */
  var mainImg = sec.querySelector('[data-ob-main]');
  var thumbs = [].slice.call(sec.querySelectorAll('[data-ob-thumb]'));
  var dots = [].slice.call(sec.querySelectorAll('[data-ob-dot]'));
  var idx = 0;
  thumbs.forEach(function (t, i) { if (t.classList.contains('is-active')) idx = i; });
  function setImg(i) {
    if (!thumbs.length) return;
    idx = (i + thumbs.length) % thumbs.length;
    var t = thumbs[idx];
    if (mainImg) { mainImg.removeAttribute('srcset'); mainImg.removeAttribute('sizes'); mainImg.src = t.getAttribute('data-full'); }
    thumbs.forEach(function (x) { x.classList.remove('is-active'); });
    t.classList.add('is-active');
    dots.forEach(function (d, j) { d.classList.toggle('is-active', j === idx); });
    if (t.scrollIntoView) t.scrollIntoView({ block: 'nearest', inline: 'nearest' });
  }
  thumbs.forEach(function (t, i) { t.addEventListener('click', function () { setImg(i); }); });
  var prev = sec.querySelector('[data-ob-prev]'), next = sec.querySelector('[data-ob-next]');
  if (prev) prev.addEventListener('click', function () { setImg(idx - 1); });
  if (next) next.addEventListener('click', function () { setImg(idx + 1); });

  /* Mobile: horizontal swipe on the main image toggles through the gallery.
     Horizontal-dominant only, so vertical page scrolling is never hijacked. */
  var galMain = sec.querySelector('.ob__main');
  if (galMain && thumbs.length > 1) {
    var gsx = null, gsy = null;
    galMain.addEventListener('touchstart', function (e) {
      var t = e.touches[0]; gsx = t.clientX; gsy = t.clientY;
    }, { passive: true });
    galMain.addEventListener('touchend', function (e) {
      if (gsx === null) return;
      var t = e.changedTouches[0], dx = t.clientX - gsx, dy = t.clientY - gsy;
      if (Math.abs(dx) > 40 && Math.abs(dx) > Math.abs(dy)) { setImg(dx < 0 ? idx + 1 : idx - 1); }
      gsx = null; gsy = null;
    }, { passive: true });
  }

  /* Accordion — one open at a time */
  var tabs = sec.querySelectorAll('.ob__tab');
  sec.querySelectorAll('.ob__tab-q').forEach(function (btn) {
    btn.addEventListener('click', function () {
      var tab = btn.closest('.ob__tab');
      var willOpen = !tab.classList.contains('is-open');
      tabs.forEach(function (t) { t.classList.remove('is-open'); var b = t.querySelector('.ob__tab-q'); if (b) b.setAttribute('aria-expanded', 'false'); });
      if (willOpen) { tab.classList.add('is-open'); btn.setAttribute('aria-expanded', 'true'); }
    });
  });

  /* Buy Now -> add selected variant, go to checkout */
  var buy = sec.querySelector('[data-ob-buy]');
  if (buy) {
    window.addEventListener('pageshow', function () { buy.disabled = false; buy.classList.remove('is-loading'); });
    buy.addEventListener('click', function () {
      var sel = sec.querySelector('.ob__tier input[type="radio"]:checked');
      if (!sel || !sel.value) return;
      var id = parseInt(sel.value, 10);
      var code = (sel.getAttribute('data-code') || '').trim();
      var gift = parseInt(sel.getAttribute('data-gift'), 10);
      var item = { id: id, quantity: {{ section.settings.add_quantity | default: 1 }} };
      var checkoutUrl = code ? ('/discount/' + encodeURIComponent(code) + '?redirect=/checkout') : '/checkout';
      buy.disabled = true; buy.classList.add('is-loading');
      fetch('/cart/clear.js', { method: 'POST', headers: { 'Content-Type': 'application/json' } })
        .then(function () { return fetch('/cart/add.js', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ items: gift ? [item, { id: gift, quantity: 1 }] : [item] }) }); })
        .then(function (r) { if (!r.ok) throw new Error('add failed'); window.location.href = checkoutUrl; })
        .catch(function () { window.location.href = '/cart/' + id + ':{{ section.settings.add_quantity | default: 1 }}' + (gift ? (',' + gift + ':1') : '') + (code ? ('?discount=' + encodeURIComponent(code)) : ''); });
    });
  }

  /* Hide the sticky CTA bar whenever this offer block (incl. accordion) is in the viewport.
     The bar is position:fixed and its own JS toggles .is-visible on scroll, so we force
     display:none with !important directly on the element (beats its own styles). */
  if ('IntersectionObserver' in window) {
    var io = new IntersectionObserver(function (entries) {
      var vis = entries[0].isIntersecting;
      document.body.classList.toggle('ob-offer-visible', vis);
      document.querySelectorAll('.sticky-cta-v2-section').forEach(function (el) {
        if (vis) { el.style.setProperty('display', 'none', 'important'); }
        else { el.style.removeProperty('display'); }
      });
    }, { threshold: 0 });
    io.observe(sec);
  }
})();
</script>

