{%- comment -%}
  Arrows sit in a centred controls row with the dots (not overlaying the slides).
  Press Carousel — one press quote + logo per slide, on a full-bleed
  brand-purple background. Prev/next arrows + dots. Each slide (quote +
  logo image) is a section block. Editable quote font size for desktop
  and mobile. Scoped CSS; Online Store 2.0 compatible.
{%- endcomment -%}

{%- liquid
  assign uid = 'pc-' | append: section.id
  assign bg = section.settings.bg_color
  assign fg = section.settings.text_color
  assign ctrl = section.settings.control_color
-%}

<style>
  #{{ uid }} {
    background-color: {{ bg }};
    padding: {{ section.settings.padding_top }}px 20px {{ section.settings.padding_bottom }}px;
    font-family: 'HelveticaNeueL', 'Helvetica Neue', Arimo, Helvetica, Arial, sans-serif;
  }
  #{{ uid }} .pc__viewport { position: relative; max-width: {{ section.settings.max_width }}px; margin: 0 auto; }
  #{{ uid }} .pc__window { overflow: hidden; }
  #{{ uid }} .pc__track { display: flex; align-items: stretch; transition: transform .4s cubic-bezier(.22,1,.36,1); }
  #{{ uid }} .pc__slide { flex: 0 0 33.3333%; min-width: 0; box-sizing: border-box; padding: 0 24px; text-align: center; display: flex; flex-direction: column; align-items: center; justify-content: flex-start; }
  #{{ uid }} .pc__quote {
    margin: 0;
    color: {{ fg }};
    font-size: {{ section.settings.quote_size_desktop }}px;
    font-weight: 400;
    line-height: 1.4;
    max-width: 420px;
  }
  #{{ uid }} .pc__logo { display: block; width: auto; height: {{ section.settings.logo_max_height }}px; max-width: 240px; object-fit: contain; margin: auto auto 0; padding-top: 20px; }

  /* Arrows */
  #{{ uid }} .pc__controls { display: flex; align-items: center; justify-content: center; gap: 20px; margin-top: 30px; }
  #{{ uid }} .pc__arrow {
    flex: none;
    width: 46px; height: 46px; border-radius: 50%;
    border: 1.5px solid {{ ctrl }}; background: transparent; color: {{ ctrl }};
    display: inline-flex; align-items: center; justify-content: center;
    cursor: pointer; padding: 0; transition: background .15s ease, opacity .15s ease;
  }
  #{{ uid }} .pc__arrow:hover { background: rgba(0,0,0,0.05); }
  #{{ uid }} .pc__arrow svg { width: 18px; height: 18px; }

  /* Dots */
  #{{ uid }} .pc__dots { display: flex; justify-content: center; gap: 14px; margin: 0; }
  #{{ uid }} .pc__dot {
    width: 15px; height: 15px; border-radius: 50%;
    border: 1.5px solid {{ ctrl }}; background: transparent; padding: 0; cursor: pointer;
    transition: background .15s ease;
  }
  #{{ uid }} .pc__dot.is-active { background: {{ ctrl }}; }

  @media screen and (max-width: 767px) {
    #{{ uid }} { padding: 40px 14px; }
    #{{ uid }} .pc__track { align-items: flex-start; }
    #{{ uid }} .pc__slide { flex: 0 0 100%; padding: 0 44px; justify-content: center; }
    #{{ uid }} .pc__quote { font-size: {{ section.settings.quote_size_mobile }}px; max-width: 100%; }
    #{{ uid }} .pc__logo { height: 34px; margin: 22px auto 0; padding-top: 0; }
    #{{ uid }} .pc__arrow { width: 38px; height: 38px; }
    #{{ uid }} .pc__controls { margin-top: 24px; gap: 14px; }
    #{{ uid }} .pc__dots { gap: 11px; }
    #{{ uid }} .pc__dot { width: 13px; height: 13px; }
  }
</style>

<section id="{{ uid }}" class="pc" aria-roledescription="carousel" aria-label="{{ section.settings.aria_label | default: 'Press quotes' | escape }}">
  <div class="pc__viewport">

    <div class="pc__window">
      <div class="pc__track" data-pc-track>
        {%- for block in section.blocks -%}
          <div class="pc__slide" data-pc-slide role="group" aria-roledescription="slide" aria-label="{{ forloop.index }} of {{ forloop.length }}" {{ block.shopify_attributes }}>
            {%- if block.settings.quote != blank -%}
              <blockquote class="pc__quote">{{ block.settings.quote }}</blockquote>
            {%- endif -%}
            {%- if block.settings.logo != blank -%}
              <img class="pc__logo"
                   src="{{ block.settings.logo | image_url: width: 480 }}"
                   srcset="{{ block.settings.logo | image_url: width: 240 }} 240w, {{ block.settings.logo | image_url: width: 480 }} 480w"
                   sizes="240px"
                   width="{{ block.settings.logo.width }}" height="{{ block.settings.logo.height }}"
                   alt="{{ block.settings.logo_alt | default: 'Press logo' | escape }}" loading="lazy">
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    </div>

  </div>

  {%- if section.blocks.size > 1 -%}
    <div class="pc__controls">
      <button type="button" class="pc__arrow pc__arrow--prev" data-pc-prev aria-label="Previous">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg>
      </button>
      <div class="pc__dots" data-pc-dots role="tablist" aria-label="Choose slide"></div>
      <button type="button" class="pc__arrow pc__arrow--next" data-pc-next aria-label="Next">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6"/></svg>
      </button>
    </div>
  {%- endif -%}
</section>

<script>
(function () {
  var root = document.getElementById('{{ uid }}');
  if (!root) return;
  var track = root.querySelector('[data-pc-track]');
  var slides = Array.prototype.slice.call(root.querySelectorAll('[data-pc-slide]'));
  var dotsWrap = root.querySelector('[data-pc-dots]');
  if (!track || slides.length < 2) return;

  var count = slides.length;
  var autoplay = {{ section.settings.autoplay | json }};
  var intervalMs = {{ section.settings.autoplay_seconds | times: 1000 }};
  var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  var prevBtn = root.querySelector('[data-pc-prev]');
  var nextBtn = root.querySelector('[data-pc-next]');
  var timer = null, pos = 0, perView = 1, positions = 1, dots = [];

  function calcPerView() { return (window.matchMedia && window.matchMedia('(min-width: 768px)').matches) ? 3 : 1; }

  function buildDots() {
    dots = [];
    if (!dotsWrap) return;
    dotsWrap.innerHTML = '';
    if (positions < 2) return;
    for (var i = 0; i < positions; i++) {
      var b = document.createElement('button');
      b.type = 'button';
      b.className = 'pc__dot' + (i === pos ? ' is-active' : '');
      b.setAttribute('aria-label', 'Slide ' + (i + 1));
      (function (n) { b.addEventListener('click', function () { goTo(n); restart(); }); })(i);
      dotsWrap.appendChild(b);
      dots.push(b);
    }
  }

  function render() {
    var step = 100 / perView;
    track.style.transform = 'translateX(' + (-pos * step) + '%)';
    dots.forEach(function (d, i) {
      var on = i === pos;
      d.classList.toggle('is-active', on);
      if (on) { d.setAttribute('aria-current', 'true'); } else { d.removeAttribute('aria-current'); }
    });
    var hide = positions < 2;
    if (prevBtn) prevBtn.style.display = hide ? 'none' : '';
    if (nextBtn) nextBtn.style.display = hide ? 'none' : '';
  }

  function layout() {
    perView = calcPerView();
    positions = Math.max(1, count - perView + 1);
    if (pos > positions - 1) pos = positions - 1;
    buildDots();
    render();
  }

  function goTo(n) { pos = (n % positions + positions) % positions; render(); }
  function next() { goTo(pos + 1); }
  function prev() { goTo(pos - 1); }

  if (prevBtn) prevBtn.addEventListener('click', function () { prev(); restart(); });
  if (nextBtn) nextBtn.addEventListener('click', function () { next(); restart(); });

  function start() { if (!autoplay || reduce || positions < 2) return; stop(); timer = setInterval(next, intervalMs); }
  function stop() { if (timer) { clearInterval(timer); timer = null; } }
  function restart() { stop(); start(); }
  root.addEventListener('mouseenter', stop);
  root.addEventListener('mouseleave', start);

  /* Swipe */
  var startX = null;
  root.addEventListener('pointerdown', function (e) { startX = e.clientX; });
  root.addEventListener('pointerup', function (e) {
    if (startX === null) return;
    var dx = e.clientX - startX;
    if (dx < -40) { next(); restart(); } else if (dx > 40) { prev(); restart(); }
    startX = null;
  });

  var rt;
  window.addEventListener('resize', function () { clearTimeout(rt); rt = setTimeout(layout, 150); });

  layout();
  start();
})();
</script>

{% schema %}
{
  "name": "Press Carousel",
  "tag": "section",
  "class": "press-carousel-section",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section background",
      "default": "#eaeaf7"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Quote color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "control_color",
      "label": "Arrows & dots color",
      "default": "#672666"
    },
    {
      "type": "header",
      "content": "Quote font size"
    },
    {
      "type": "range",
      "id": "quote_size_desktop",
      "min": 16,
      "max": 52,
      "step": 1,
      "unit": "px",
      "label": "Quote size (desktop)",
      "default": 20
    },
    {
      "type": "range",
      "id": "quote_size_mobile",
      "min": 14,
      "max": 36,
      "step": 1,
      "unit": "px",
      "label": "Quote size (mobile)",
      "default": 20
    },
    {
      "type": "header",
      "content": "Logo"
    },
    {
      "type": "range",
      "id": "logo_max_height",
      "min": 16,
      "max": 120,
      "step": 1,
      "unit": "px",
      "label": "Logo height (desktop)",
      "default": 64
    },
    {
      "type": "header",
      "content": "Autoplay"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Auto-rotate slides",
      "default": true
    },
    {
      "type": "range",
      "id": "autoplay_seconds",
      "min": 3,
      "max": 10,
      "step": 1,
      "unit": "s",
      "label": "Seconds per slide",
      "default": 6
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 600,
      "max": 1300,
      "step": 20,
      "unit": "px",
      "label": "Content max width",
      "default": 1160
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Padding top (desktop)",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom (desktop)",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "quote",
      "name": "Press quote",
      "settings": [
        {
          "type": "textarea",
          "id": "quote",
          "label": "Quote"
        },
        {
          "type": "image_picker",
          "id": "logo",
          "label": "Logo image",
          "info": "Transparent PNG/SVG. Dark logos work best on the light background."
        },
        {
          "type": "text",
          "id": "logo_alt",
          "label": "Logo alt text",
          "info": "For accessibility, e.g. the publication name."
        }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "Press Carousel",
      "category": "Rejuvia",
      "settings": {
        "bg_color": "#eaeaf7",
        "text_color": "#000000",
        "control_color": "#672666",
        "quote_size_desktop": 20,
        "quote_size_mobile": 20,
        "logo_max_height": 64,
        "autoplay": true,
        "autoplay_seconds": 6,
        "max_width": 1160,
        "padding_top": 48,
        "padding_bottom": 48
      },
      "blocks": [
        {
          "type": "quote",
          "settings": {
            "quote": "Rejuvia was recently ranked #228 on the Inc. 5000 list of America's fastest-growing companies",
            "logo": "shopify://shop_images/logo.png",
            "logo_alt": ""
          }
        },
        {
          "type": "quote",
          "settings": {
            "quote": "\"Rejuvia is all-natural and the spray works as fast and effectively as anything else out there.\"",
            "logo": "shopify://shop_images/rejuvia_scary_mommy_logo.png",
            "logo_alt": ""
          }
        },
        {
          "type": "quote",
          "settings": {
            "quote": "\"Finally, I found something to take the edge off at night before I head to bed. I'm sleeping better than ever.\"",
            "logo": "shopify://shop_images/rejuvia_womens_health_logo_svg.png",
            "logo_alt": ""
          }
        },
        {
          "type": "quote",
          "settings": {
            "quote": "\"Shockingly effective. Knocks you out for the night and keeps you asleep until the morning.\"",
            "logo": "shopify://shop_images/forbes_rejuvia_logo.png",
            "logo_alt": ""
          }
        },
        {
          "type": "quote",
          "settings": {
            "quote": "\"Rejuvia works as advertised. It's highly effective, safe and natural.\"",
            "logo": "shopify://shop_images/rejuvia_bustle_lgoo_svg.png",
            "logo_alt": ""
          }
        }
      ]
    }
  ]
}
{% endschema %}
