{%- comment -%}
  Product Alternatives V2 — the "BOGO" comparison table, per product.

  Layout matches product-comparison-enhanced (solid highlighted Rejuvia column,
  white checks, outlined crosses) but is driven PER PRODUCT by metafields:

    custom.comparison (metaobject "Comparison")
      .heading            -> table heading (falls back to section setting)
      .rejuvia_name       -> highlighted column label (e.g. "Rejuvia Sleep Spray")
      .rejuvia_image      -> bottle photo atop the highlighted column (falls back to featured image)
      .competitor_1_name / _2_ / _3_ -> the three competitor column labels
      .rows (list of "Comparison Row")
          .label          -> feature name (left column)
          .rejuvia        -> "check" | "cross" | free text
          .competitor_1   -> "check" | "cross" | free text
          .competitor_2   -> "check" | "cross" | free text
          .competitor_3   -> "check" | "cross" | free text

  Colours: the highlighted column background, every purple text run, and the
  check/cross icons all follow custom.base_colour (falls back to #672666).

  Competitor icons are the SAME across all products, so they live in section
  settings and are rendered grayscale via CSS (reuse the brand illustrations).

  The section renders on any product that has a comparison metaobject attached
  in custom.comparison (empty field = hidden). Product template only.
{%- endcomment -%}

{%- liquid
  # Source product: on a product page use the page's product; on other pages
  # (e.g. the homepage) fall back to the section's chosen Source product so the
  # table can render a specific product's comparison off a product page.
  assign src = product
  if src == blank
    assign src = section.settings.source_product
  endif

  assign cmp = src.metafields.custom.comparison.value

  # Accent: read .value so the basic colour metafield resolves to its string.
  assign base = src.metafields.custom.base_colour.value | default: src.metafields.custom.base_colour | default: '#672666'
  # Sub-base: the softer tint used for the highlighted Rejuvia column background
  # (US and UK spellings both supported), falling back to a light neutral.
  assign subbase = src.metafields.custom.sub_base_color.value | default: src.metafields.custom.sub_base_colour.value | default: src.metafields.custom.sub_base_color | default: src.metafields.custom.sub_base_colour | default: '#f5f5f7'

  # Show whenever a comparison metaobject is attached to the product. Presence of
  # the metaobject IS the toggle now, so a product simply shows the table by having
  # one linked in custom.comparison (and hides it by leaving that field empty).
  assign show = false
  if cmp != blank
    assign show = true
  endif

  # Field keys are read in both forms: the short handle and the name-derived key
  # Shopify auto-generates (e.g. "Rejuvia value" -> rejuvia_value), so the section
  # works whichever the metaobject definition actually uses.
  assign heading = cmp.heading | default: section.settings.heading
  assign rej_name = cmp.rejuvia_name | default: cmp.rejuvia_column_name | default: 'Rejuvia'
  assign rej_image = cmp.rejuvia_image | default: cmp.rejuvia_bottle_image | default: src.featured_image
  assign rows = cmp.rows.value

  # Count how many competitor columns actually have a name or icon (for the mobile dots).
  assign comp_count = 0
  if cmp.competitor_1_name != blank or section.settings.comp_1_image != blank
    assign comp_count = comp_count | plus: 1
  endif
  if cmp.competitor_2_name != blank or section.settings.comp_2_image != blank
    assign comp_count = comp_count | plus: 1
  endif
  if cmp.competitor_3_name != blank or section.settings.comp_3_image != blank
    assign comp_count = comp_count | plus: 1
  endif
-%}

{%- if show and rows != blank and rows.size > 0 -%}
<style>
  #shopify-section-{{ section.id }} {
    --palt-v2-base: {{ base }};
    --palt-v2-subbase: {{ subbase }};
    --palt-v2-icon-size: {{ section.settings.icon_size | default: 84 }}px;
  }
  .palt-v2-section { width: 100%; background-color: {{ section.settings.bg_color | default: '#ffffff' }}; }
  .palt-v2-container {
    width: 100%; max-width: 1200px; margin: 0 auto;
    display: flex; flex-direction: column; gap: 32px; align-items: center;
    padding: 64px 16px; box-sizing: border-box;
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
  }
  .palt-v2-heading {
    font-family: 'HelveticaNeueL', 'Helvetica Neue', Helvetica, Arial, sans-serif;
    font-size: 36px; font-weight: 700; line-height: 1.2; color: #171512;
    letter-spacing: -0.52px; margin: 0; width: 100%; text-align: center;
  }

  /* Table — top padding reserves room for the bottle to pop up above the column,
     and keeps that protrusion INSIDE the (mobile) scroll box so it is never clipped. */
  .palt-v2-table { display: flex; width: 100%; align-items: stretch; padding-top: 48px; }

  /* Labels column */
  .palt-v2-labels { flex: 1; min-width: 0; padding-right: 12px; display: flex; flex-direction: column; }
  @media (min-width: 901px) {
    /* Match the Product Intro width (1200) so the section is as wide as the sections above. */
    .palt-v2-heading, .palt-v2-table { max-width: 1200px; }
    /* let the labels column grow so the table fills the full width (aligns the left edge) */
    .palt-v2-labels { flex: 1 1 300px; }
  }
  .palt-v2-label-header { height: calc(var(--palt-v2-icon-size, 84px) + 78px); border-bottom: 1px solid #eaeaf7; }
  .palt-v2-label {
    height: 80px; display: flex; align-items: center;
    font-size: 16px; font-weight: 600; line-height: 1.3;
    color: var(--palt-v2-base, #672666); border-bottom: 1px solid #eaeaf7;
  }
  .palt-v2-label:last-child { border-bottom: none; }

  /* Product columns */
  .palt-v2-col { width: 200px; flex-shrink: 0; display: flex; flex-direction: column; padding: 0 12px; }

  /* Highlighted Rejuvia column — soft sub-base tint, base-colour content */
  .palt-v2-col--highlight {
    background: var(--palt-v2-subbase, #f5f5f7);
    border-radius: 24px; padding: 0 12px;
    box-shadow: 0 8px 30px rgba(0,0,0,0.08);
  }
  .palt-v2-col--highlight .palt-v2-col-header { border-bottom: 1px solid rgba(0,0,0,0.08); }
  .palt-v2-col--highlight .palt-v2-col-name { color: var(--palt-v2-base, #672666); font-weight: 700; }
  .palt-v2-col--highlight .palt-v2-cell { color: var(--palt-v2-base, #672666); font-weight: 600; border-bottom: 1px solid rgba(0,0,0,0.08); }
  .palt-v2-col--highlight .palt-v2-cell:last-child { border-bottom: none; }

  /* Column header */
  .palt-v2-col-header {
    height: calc(var(--palt-v2-icon-size, 84px) + 78px);
    display: flex; flex-direction: column; align-items: center; justify-content: flex-end;
    gap: 14px; padding: 16px 0; border-bottom: 1px solid #eaeaf7;
  }
  .palt-v2-col-name {
    font-size: 15px; font-weight: 600; line-height: 1.35;
    color: var(--palt-v2-base, #672666); text-align: center;
  }

  /* Competitor icon — brand illustration rendered neutral grey */
  .palt-v2-competitor-icon {
    max-height: var(--palt-v2-icon-size, 84px); width: auto; object-fit: contain; flex-shrink: 0;
    filter: grayscale(1); -webkit-filter: grayscale(1);
  }

  /* Rejuvia bottle — pops up above the column so its gold nozzle + ~30% sit on the
     white above the tinted column. Protrusion (44px) stays within the table's 64px
     top padding so it is never clipped, on desktop or in the mobile scroll box. */
  .palt-v2-rejuvia-bottle {
    max-height: calc(var(--palt-v2-icon-size, 84px) + 52px); width: auto; object-fit: contain;
    margin-top: -44px; filter: drop-shadow(0 8px 16px rgba(0,0,0,0.20));
  }

  /* Cell */
  .palt-v2-cell {
    height: 80px; display: flex; align-items: center; justify-content: center; text-align: center;
    font-size: 16px; font-weight: 400; line-height: 1.4; color: #141414;
    border-bottom: 1px solid #eaeaf7;
  }
  .palt-v2-cell:last-child { border-bottom: none; }
  .palt-v2-cell--bold { font-weight: 700; }

  /* Icons: check / cross rendered from base colour */
  .palt-v2-ic { width: 26px; height: 26px; border-radius: 50%; display: inline-flex; align-items: center; justify-content: center; box-sizing: border-box; flex-shrink: 0; }
  .palt-v2-ic svg { width: 14px; height: 14px; display: block; }
  /* Rejuvia column: filled base disc, white check (reads on the light sub-base column) */
  .palt-v2-ic--rej { background: var(--palt-v2-base, #672666); }
  .palt-v2-ic--rej svg { stroke: #ffffff; }
  /* Competitor positive: filled base disc, white check */
  .palt-v2-ic--pos { background: var(--palt-v2-base, #672666); }
  .palt-v2-ic--pos svg { stroke: #ffffff; }
  /* Competitor negative: outlined base circle, base x */
  .palt-v2-ic--cross { border: 2px solid var(--palt-v2-base, #672666); }
  .palt-v2-ic--cross svg { stroke: var(--palt-v2-base, #672666); }

  /* CTA — matches the homepage alternatives CTA exactly (weight 500, 24px 32px, 400px wrapper) */
  .palt-v2-cta { display: flex; flex-direction: column; align-items: center; gap: 12px; max-width: 400px; width: 100%; }
  .palt-v2-cta-btn {
    display: flex; align-items: center; justify-content: center;
    width: 100%; padding: 24px 32px;
    background: var(--palt-v2-base, #672666); color: #fff;
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
    font-size: 18px; font-weight: 500; line-height: 1.4;
    text-decoration: none; border: none; border-radius: 100px;
    cursor: pointer; transition: opacity 0.25s ease; letter-spacing: normal;
    text-transform: capitalize;
  }
  .palt-v2-cta-btn:hover { opacity: 0.9; }
  .palt-v2-cta-note { display: flex; align-items: flex-start; gap: 6px; font-size: 14px; line-height: 1; color: #141414; }
  .palt-v2-cta-note svg { width: 14px; height: 11px; flex-shrink: 0; }

  /* Nav (mobile) */
  .palt-v2-dots { display: none; justify-content: center; align-items: center; gap: 8px; }
  .palt-v2-dot { width: 8px; height: 8px; border-radius: 50%; background: #d3d3d3; transition: background .3s ease, width .3s ease; }
  .palt-v2-dot.is-active { background: var(--palt-v2-base, #672666); width: 20px; border-radius: 4px; }
  .palt-v2-nav { display: none; align-items: center; justify-content: space-between; padding: 16px 16px 0; width: 100%; }
  .palt-v2-nav-arrow { width: 40px; height: 40px; border: none; background: none; cursor: pointer; display: flex; align-items: center; justify-content: center; padding: 0; flex-shrink: 0; transition: opacity .2s ease; }
  .palt-v2-nav-arrow:disabled { opacity: .3; cursor: default; }
  .palt-v2-nav-arrow svg { width: 40px; height: 40px; }
  .palt-v2-nav-arrow--prev svg { transform: rotate(180deg); }

  @media (max-width: 900px) {
    .palt-v2-container { padding: 40px 0; gap: 18px; }
    .palt-v2-heading { font-size: 26px; padding: 0 16px; }
    .palt-v2-section { overflow-x: clip; }
    /* keep top padding so the popped bottle stays inside the scroll box (not clipped) */
    .palt-v2-table { overflow-x: auto; scrollbar-width: none; -webkit-overflow-scrolling: touch; padding: 40px 16px 0; }
    .palt-v2-cta { padding: 0 16px; max-width: 100%; }
    .palt-v2-table::-webkit-scrollbar { display: none; }
    .palt-v2-nav { display: flex; }
    .palt-v2-nav .palt-v2-dots { display: flex; }
    .palt-v2-labels { min-width: 130px; max-width: 130px; position: sticky; left: 0; background: {{ section.settings.bg_color | default: '#ffffff' }}; z-index: 3; padding-right: 10px; }
    .palt-v2-labels::before { content: ''; position: absolute; top: 0; left: -20px; bottom: 0; width: 20px; background: linear-gradient(to right, transparent, rgba(255,255,255,0.9)); z-index: 4; pointer-events: none; }
    .palt-v2-col { min-width: 150px; }

    /* Tighter, easier-to-scan rows on mobile */
    .palt-v2-label-header, .palt-v2-col-header { height: 112px; }
    .palt-v2-col-header { gap: 8px; padding: 12px 0; }
    .palt-v2-competitor-icon { max-height: 62px; }
    .palt-v2-rejuvia-bottle { max-height: 108px; margin-top: -38px; }
    .palt-v2-col-name { font-size: 14px; }
    .palt-v2-label { font-size: 14px; height: 58px; line-height: 1.25; }
    .palt-v2-cell { height: 58px; font-size: 15px; }
    .palt-v2-ic { width: 24px; height: 24px; }
    .palt-v2-ic svg { width: 13px; height: 13px; }
  }
</style>

<div class="palt-v2-container">
  <div class="palt-v2-heading">{{ heading }}</div>

  <div class="palt-v2-table">
    {%- comment -%} Labels column {%- endcomment -%}
    <div class="palt-v2-labels">
      <div class="palt-v2-label-header"></div>
      {%- for row in rows -%}
        <div class="palt-v2-label">{{ row.label }}</div>
      {%- endfor -%}
    </div>

    {%- comment -%} Rejuvia column (highlighted, solid base colour) {%- endcomment -%}
    <div class="palt-v2-col palt-v2-col--highlight">
      <div class="palt-v2-col-header">
        {%- if rej_image != blank -%}
          <img class="palt-v2-rejuvia-bottle" src="{{ rej_image | image_url: width: 220 }}"
               srcset="{{ rej_image | image_url: width: 220 }} 220w, {{ rej_image | image_url: width: 440 }} 440w"
               sizes="200px" alt="{{ rej_name | escape }}" loading="lazy" decoding="async">
        {%- endif -%}
        <span class="palt-v2-col-name">{{ rej_name }}</span>
      </div>
      {%- for row in rows -%}
        <div class="palt-v2-cell{% if forloop.first %} palt-v2-cell--bold{% endif %}">
          {%- assign v = row.rejuvia | default: row.rejuvia_value | strip -%}
          {%- if v == 'check' -%}
            <span class="palt-v2-ic palt-v2-ic--rej"><svg viewBox="0 0 24 24" fill="none"><path d="M5 12.5L10 17.5L19 7" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
          {%- elsif v == 'cross' -%}
            <span class="palt-v2-ic palt-v2-ic--rej"><svg viewBox="0 0 24 24" fill="none"><path d="M7 7L17 17M17 7L7 17" stroke-width="2.5" stroke-linecap="round"/></svg></span>
          {%- else -%}
            <span>{{ v }}</span>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>

    {%- comment -%} Competitor columns (1..3) {%- endcomment -%}
    {%- for i in (0..2) -%}
      {%- case i -%}
        {%- when 0 -%}{%- assign cname = cmp.competitor_1_name -%}{%- assign cicon = section.settings.comp_1_image -%}
        {%- when 1 -%}{%- assign cname = cmp.competitor_2_name -%}{%- assign cicon = section.settings.comp_2_image -%}
        {%- when 2 -%}{%- assign cname = cmp.competitor_3_name -%}{%- assign cicon = section.settings.comp_3_image -%}
      {%- endcase -%}
      {%- if cname != blank or cicon != blank -%}
        <div class="palt-v2-col">
          <div class="palt-v2-col-header">
            {%- if cicon != blank -%}
              <img class="palt-v2-competitor-icon" src="{{ cicon | image_url: width: 200 }}" alt="{{ cname | escape }}" loading="lazy" decoding="async">
            {%- endif -%}
            <span class="palt-v2-col-name">{{ cname }}</span>
          </div>
          {%- for row in rows -%}
            {%- case i -%}
              {%- when 0 -%}{%- assign v = row.competitor_1 | default: row.competitor_1_value | strip -%}
              {%- when 1 -%}{%- assign v = row.competitor_2 | default: row.competitor_2_value | strip -%}
              {%- when 2 -%}{%- assign v = row.competitor_3 | default: row.competitor_3_value | strip -%}
            {%- endcase -%}
            <div class="palt-v2-cell">
              {%- if v == 'check' -%}
                <span class="palt-v2-ic palt-v2-ic--pos"><svg viewBox="0 0 24 24" fill="none"><path d="M5 12.5L10 17.5L19 7" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
              {%- elsif v == 'cross' -%}
                <span class="palt-v2-ic palt-v2-ic--cross"><svg viewBox="0 0 24 24" fill="none"><path d="M7 7L17 17M17 7L7 17" stroke-width="2.5" stroke-linecap="round"/></svg></span>
              {%- else -%}
                <span>{{ v }}</span>
              {%- endif -%}
            </div>
          {%- endfor -%}
        </div>
      {%- endif -%}
    {%- endfor -%}
  </div>

  {%- comment -%} Mobile nav: arrows + dots {%- endcomment -%}
  <div class="palt-v2-nav" data-palt-v2-nav>
    <button class="palt-v2-nav-arrow palt-v2-nav-arrow--prev" data-palt-v2-prev disabled aria-label="Previous">
      <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 40 40" fill="none">
        <circle cx="20" cy="20" r="16.667" fill="white"/>
        <path d="M20 26.667L26.667 20L20 13.333" stroke="{{ base }}" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
        <path d="M13.333 20H26.667" stroke="{{ base }}" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </button>
    <div class="palt-v2-dots" data-palt-v2-dots>
      {%- for i in (1..comp_count) -%}
        <div class="palt-v2-dot{% if forloop.first %} is-active{% endif %}"></div>
      {%- endfor -%}
    </div>
    <button class="palt-v2-nav-arrow" data-palt-v2-next aria-label="Next">
      <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 40 40" fill="none">
        <circle cx="20" cy="20" r="16.667" fill="white"/>
        <path d="M20 26.667L26.667 20L20 13.333" stroke="{{ base }}" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
        <path d="M13.333 20H26.667" stroke="{{ base }}" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </button>
  </div>

  {%- comment -%} CTA — scrolls up to the product widget; colour follows base_colour {%- endcomment -%}
  {%- if section.settings.cta_text != blank -%}
    <div class="palt-v2-cta">
      <button type="button" class="palt-v2-cta-btn" data-palt-v2-scrolltop data-palt-v2-target="{{ section.settings.cta_target | escape }}">{{ section.settings.cta_text }}</button>
      {%- if section.settings.cta_subtext != blank -%}
        <div class="palt-v2-cta-note">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="13" viewBox="0 0 14 11" fill="none" aria-hidden="true">
            <path d="M11.6558 0.765634C11.8759 0.556086 12.1688 0.440239 12.4727 0.442538C12.7766 0.444838 13.0677 0.565104 13.2846 0.777959C13.5015 0.990814 13.6273 1.27961 13.6353 1.58341C13.6433 1.8872 13.533 2.18224 13.3277 2.40626L7.0933 10.2031C6.98609 10.3186 6.85671 10.4113 6.71288 10.4756C6.56904 10.5399 6.41372 10.5746 6.25619 10.5775C6.09866 10.5804 5.94215 10.5515 5.79604 10.4926C5.64992 10.4336 5.5172 10.3458 5.40579 10.2344L1.27142 6.10001C1.15628 5.99272 1.06394 5.86335 0.999887 5.7196C0.935837 5.57585 0.901396 5.42067 0.89862 5.26333C0.895844 5.10598 0.924789 4.94968 0.983728 4.80376C1.04267 4.65784 1.13039 4.52529 1.24167 4.41401C1.35295 4.30273 1.4855 4.21501 1.63142 4.15607C1.77734 4.09713 1.93364 4.06818 2.09099 4.07096C2.24833 4.07374 2.40351 4.10818 2.54726 4.17223C2.69101 4.23628 2.82038 4.32862 2.92767 4.44376L6.19954 7.71407L11.6261 0.80001L11.6558 0.765634Z" fill="#FAB851"/>
          </svg>
          <span>{{ section.settings.cta_subtext }}</span>
        </div>
      {%- endif -%}
    </div>
  {%- endif -%}
</div>

<script>
(function() {
    var section = document.querySelector('#shopify-section-{{ section.id }}');
    if (!section) return;

    // CTA: smooth-scroll to a configured target (e.g. "#offer" on offer/BOGO pages),
    // otherwise up to the product widget at the top of the page.
    section.querySelectorAll('[data-palt-v2-scrolltop]').forEach(function(btn) {
        btn.addEventListener('click', function() {
            var sel = btn.getAttribute('data-palt-v2-target');
            var target = null;
            if (sel) { try { target = document.querySelector(sel); } catch (e) { target = null; } }
            if (!target) { target = document.querySelector('[id*="product_widget"]'); }
            if (target) { target.scrollIntoView({ behavior: 'smooth', block: 'start' }); }
            else { window.scrollTo({ top: 0, behavior: 'smooth' }); }
        });
    });

    var table = section.querySelector('.palt-v2-table');
    var dots = section.querySelectorAll('.palt-v2-dot');
    var cols = section.querySelectorAll('.palt-v2-col:not(.palt-v2-col--highlight)');
    if (!table || cols.length === 0) return;

    var currentIndex = 0;
    var prevBtn = section.querySelector('[data-palt-v2-prev]');
    var nextBtn = section.querySelector('[data-palt-v2-next]');
    var total = cols.length;

    function updateNav() {
        if (prevBtn) prevBtn.disabled = currentIndex <= 0;
        if (nextBtn) nextBtn.disabled = currentIndex >= total - 1;
        dots.forEach(function(dot, i) { dot.classList.toggle('is-active', i === currentIndex); });
    }
    function scrollToIndex(index) {
        if (index < 0 || index >= total) return;
        currentIndex = index;
        var col = cols[currentIndex];
        var labelsWidth = section.querySelector('.palt-v2-labels').offsetWidth;
        table.scrollTo({ left: col.offsetLeft - labelsWidth - 16, behavior: 'smooth' });
        updateNav();
    }
    if (prevBtn) prevBtn.addEventListener('click', function() { scrollToIndex(currentIndex - 1); });
    if (nextBtn) nextBtn.addEventListener('click', function() { scrollToIndex(currentIndex + 1); });
    table.addEventListener('scroll', function() {
        var labelsWidth = section.querySelector('.palt-v2-labels').offsetWidth;
        var scrollLeft = table.scrollLeft + labelsWidth + 16;
        var closest = 0, minDist = Infinity;
        cols.forEach(function(col, i) {
            var dist = Math.abs(col.offsetLeft - scrollLeft);
            if (dist < minDist) { minDist = dist; closest = i; }
        });
        currentIndex = closest;
        updateNav();
    });
    updateNav();
})();
</script>
{%- endif -%}

{% schema %}
{
    "name": "Product Alternatives V2",
    "class": "palt-v2-section",
