{%- comment -%}
  Product How To Use — clean 3-step layout (matches the "How To Use (Steps)"
  design used on the V2 template), but driven PER PRODUCT by the existing
  custom.how_to_use metaobject instead of section blocks.

  Metaobject fields used:
    .value.title      -> heading (falls back to the section setting)
    .value.subtitle   -> subheading line
    .value.steps.value (list) -> per step: .image, .description
  The "STEP n" eyebrow is generated automatically from the step order.

  Desktop: 3 photo steps in a row. Mobile: one hero photo (first step's image)
  + three compact rows (64px circle thumb + STEP label + sentence). Static, no JS.
  Renders nothing when the metaobject has no steps.
{%- endcomment -%}

{%- liquid
  assign how_to_use = product.metafields.custom.how_to_use
  assign steps = how_to_use.value.steps.value
  assign uid = 'hus-' | append: section.id
  assign heading = how_to_use.value.title | default: section.settings.heading
  assign subheading = how_to_use.value.subtitle
  comment
    Section background follows the product's sub-base colour (a softer tint of the
    accent), falling back to the section's own background_color setting.
  endcomment
  assign section_bg = product.metafields.custom.sub_base_colour | default: section.settings.background_color | default: '#ffffff'
-%}

{%- if steps != blank and steps.size > 0 -%}
<style>
  #{{ uid }} {
    background-color: {{ section_bg }};
    font-family: 'HelveticaNeueL', 'Helvetica Neue', Arimo, Helvetica, Arial, sans-serif;
  }
  #{{ uid }} .hus__inner { max-width: 1200px; margin: 0 auto; padding: 72px 80px; display: flex; flex-direction: column; gap: 48px; box-sizing: border-box; }
  #{{ uid }} .hus__header { display: flex; flex-direction: column; gap: 10px; text-align: center; align-items: center; }
  #{{ uid }} .hus__heading { margin: 0; font-size: {{ section.settings.heading_size | default: 36 }}px; font-weight: 700; line-height: 1.2; letter-spacing: -0.52px; color: #171512; }
  #{{ uid }} .hus__sub { margin: 0; font-size: {{ section.settings.subheading_size | default: 17 }}px; line-height: 1.6; color: #3D2F3C; max-width: 720px; }

  /* Mobile hero — hidden on desktop */
  #{{ uid }} .hus__hero { display: none; }

  /* Steps grid */
  #{{ uid }} .hus__grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 32px; }
  #{{ uid }} .hus__step { display: flex; flex-direction: column; gap: 18px; }
  #{{ uid }} .hus__media { aspect-ratio: 16 / 13.2; border-radius: 14px; overflow: hidden; }
  #{{ uid }} .hus__media img { width: 100%; height: 100%; object-fit: cover; object-position: 50% 20%; display: block; }
  #{{ uid }} .hus__body { display: flex; flex-direction: column; gap: 8px; }
  #{{ uid }} .hus__label { margin: 0; font-size: 13px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.16em; color: #6B5B69; }
  #{{ uid }} .hus__text { margin: 0; font-size: {{ section.settings.step_text_size | default: 18 }}px; line-height: 1.5; font-weight: 400; color: #232323; text-wrap: pretty; }
  #{{ uid }} .hus__text p { margin: 0; }
  #{{ uid }} .hus__text strong { font-weight: 700; }

  @media (max-width: 767px) {
    #{{ uid }} .hus__inner { padding: 40px 16px 44px; gap: 24px; }
    #{{ uid }} .hus__heading { font-size: {{ section.settings.heading_size_mobile | default: 26 }}px; line-height: 1.15; }
    #{{ uid }} .hus__sub { font-size: {{ section.settings.subheading_size_mobile | default: 15 }}px; line-height: 1.55; }
    #{{ uid }} .hus__hero { display: block; aspect-ratio: 3 / 2; border-radius: 14px; overflow: hidden; }
    #{{ uid }} .hus__hero img { width: 100%; height: 100%; object-fit: cover; object-position: 50% 18%; display: block; }
    #{{ uid }} .hus__grid { grid-template-columns: 1fr; gap: 14px; }
    #{{ uid }} .hus__step { flex-direction: row; align-items: center; gap: 14px; }
    #{{ uid }} .hus__media { flex: none; width: 64px; height: 64px; aspect-ratio: auto; border-radius: 100px; }
    #{{ uid }} .hus__media img { object-position: 50% 18%; }
    #{{ uid }} .hus__body { gap: 2px; }
    #{{ uid }} .hus__label { font-size: 11px; }
    #{{ uid }} .hus__text { font-size: {{ section.settings.step_text_size_mobile | default: 16 }}px; line-height: 1.5; font-weight: 400; }
  }
</style>

<section id="{{ uid }}" class="hus">
  <div class="hus__inner">
    <div class="hus__header">
      {%- if heading != blank -%}<h2 class="hus__heading">{{ heading }}</h2>{%- endif -%}
      {%- if subheading != blank -%}<p class="hus__sub">{{ subheading }}</p>{%- endif -%}
    </div>

    {%- comment -%} Mobile hero = first step's photo. Rendered via a limit:1 loop so the
       metaobject image field resolves the same way it does in the grid loop below. {%- endcomment -%}
    {%- for step in steps limit: 1 -%}
      {%- if step.image != blank -%}
        <div class="hus__hero" style="background: {{ section.settings.backdrop_color | default: '#F7EDEC' }};">
          <img src="{{ step.image | image_url: width: 800 }}"
               srcset="{{ step.image | image_url: width: 500 }} 500w, {{ step.image | image_url: width: 800 }} 800w"
               sizes="100vw"
               alt="{{ heading | default: 'How to use Rejuvia' | escape }}" loading="eager" decoding="async">
        </div>
      {%- endif -%}
    {%- endfor -%}

    <div class="hus__grid">
      {%- for step in steps -%}
        <div class="hus__step">
          <div class="hus__media" style="background: {{ section.settings.backdrop_color | default: '#F7EDEC' }};">
            {%- if step.image != blank -%}
              <img class="hus__img"
                   src="{{ step.image | image_url: width: 800 }}"
                   srcset="{{ step.image | image_url: width: 128 }} 128w, {{ step.image | image_url: width: 400 }} 400w, {{ step.image | image_url: width: 800 }} 800w"
                   sizes="(max-width: 767px) 64px, 380px"
                   alt="{{ step.step_title | default: 'Step' | escape }}" loading="lazy" decoding="async">
            {%- endif -%}
          </div>
          <div class="hus__body">
            <p class="hus__label">STEP {{ forloop.index }}</p>
            {%- if step.description != blank -%}<div class="hus__text">{{ step.description | newline_to_br }}</div>{%- endif -%}
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "Product How To Use",
  "tag": "section",
  "class": "product-how-to-use",
  "settings": [
    {
      "type": "paragraph",
      "content": "Content comes from the product's custom.how_to_use metaobject: subtitle, plus each step's image and description. Edit it on the product page in the admin. The section hides itself when no steps are defined."
    },
    { "type": "color", "id": "background_color", "label": "Section background", "default": "#ffffff" },
    { "type": "text", "id": "heading", "label": "Heading fallback", "info": "Used when the metaobject has no title.", "default": "How To Use Rejuvia" },
    { "type": "color", "id": "backdrop_color", "label": "Photo backdrop", "default": "#F7EDEC" },
    { "type": "header", "content": "Font sizes" },
    { "type": "range", "id": "heading_size", "min": 20, "max": 60, "step": 1, "unit": "px", "label": "Heading size (desktop)", "default": 36 },
    { "type": "range", "id": "heading_size_mobile", "min": 16, "max": 44, "step": 1, "unit": "px", "label": "Heading size (mobile)", "default": 26 },
    { "type": "range", "id": "subheading_size", "min": 12, "max": 30, "step": 1, "unit": "px", "label": "Subheading size (desktop)", "default": 17 },
    { "type": "range", "id": "subheading_size_mobile", "min": 11, "max": 24, "step": 1, "unit": "px", "label": "Subheading size (mobile)", "default": 15 },
    { "type": "range", "id": "step_text_size", "min": 12, "max": 30, "step": 1, "unit": "px", "label": "Step text size (desktop)", "default": 18 },
    { "type": "range", "id": "step_text_size_mobile", "min": 11, "max": 24, "step": 1, "unit": "px", "label": "Step text size (mobile)", "default": 16 }
  ],
  "presets": [
    {
      "name": "Product How To Use"
    }
  ],
  "templates": ["product"]
}
{% endschema %}
