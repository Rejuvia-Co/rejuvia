{{ 'product-widget.css' | asset_url | stylesheet_tag }}
{{ 'product-single-select.css' | asset_url | stylesheet_tag }}

{% render 'product-single-select-core', section: section %}

{% schema %}
{
  "name": "Product Single-Select",
  "tag": "section",
  "class": "product-widget-section",
  "settings": [
    {
      "type": "product",
      "id": "selected_product",
      "label": "Product: "
    },
    {
      "type": "checkbox",
      "id": "show_bundle_text",
      "label": "Show bundle text on gallery image",
      "default": false
    },
    {
      "type": "header",
      "content": "Pricing source"
    },
    {
      "type": "text",
      "id": "unit_variant_id",
      "label": "1-pack variant ID",
      "info": "Variant every tier is built from. Blank = the product's first variant."
    },
    {
      "type": "text",
      "id": "unit_noun",
      "label": "Unit name (singular)",
      "default": "Spray"
    },
    {
      "type": "text",
      "id": "unit_noun_plural",
      "label": "Unit name (plural)",
      "default": "Sprays"
    },
    {
      "type": "header",
      "content": "Price line"
    },
    {
      "type": "text",
      "id": "sale_label",
      "label": "Sale label",
      "default": "SUMMER SALE",
      "info": "Pill under the description reads \"<label> - <SAVE %> OFF\" for the selected tier. Change per campaign. Blank = no pill (unless a tier sets its own pill text)."
    },
    {
      "type": "image_picker",
      "id": "band_image",
      "label": "Free band thumbnail"
    },
    {
      "type": "text",
      "id": "band_image_asset",
      "label": "Free band thumbnail (theme asset filename)",
      "default": "sleep-spray-tier-1.png"
    },
    {
      "type": "header",
      "content": "One-time purchase"
    },
    {
      "type": "select",
      "id": "one_time_display",
      "label": "One-time purchase display",
      "default": "link",
      "options": [
        {
          "value": "link",
          "label": "Link under the used-by bar"
        },
        {
          "value": "block",
          "label": "Row under the tiers"
        }
      ]
    },
    {
      "type": "text",
      "id": "one_time_link_text",
      "label": "Link text",
      "default": "Buy once",
      "info": "The one-time price is appended automatically."
    },
    {
      "type": "text",
      "id": "one_time_title",
      "label": "Row title",
      "default": "One-time Purchase"
    },
    {
      "type": "text",
      "id": "one_time_shipping",
      "label": "Row shipping note",
      "default": "+ $4.75 shipping"
    },
    {
      "type": "header",
      "content": "Used-by bar (below accordion)"
    },
    {
      "type": "checkbox",
      "id": "show_trusted",
      "label": "Show used-by bar",
      "default": false
    },
    {
      "type": "text",
      "id": "trusted_title",
      "label": "Title",
      "default": "Used by 450,000+ customers"
    },
    {
      "type": "textarea",
      "id": "trusted_subtext",
      "label": "Subtext",
      "default": "to fall asleep faster and sleep the full night."
    },
    {
      "type": "image_picker",
      "id": "trusted_image_1",
      "label": "Avatar 1"
    },
    {
      "type": "image_picker",
      "id": "trusted_image_2",
      "label": "Avatar 2"
    },
    {
      "type": "image_picker",
      "id": "trusted_image_3",
      "label": "Avatar 3"
    },
    {
      "type": "color",
      "id": "trusted_bg",
      "label": "Bar background",
      "default": "#f4f4f4"
    },
    {
      "type": "color",
      "id": "trusted_check",
      "label": "Checkmark colour",
      "default": "#34c759"
    },
    {
      "type": "header",
      "content": "Payment icons (below Buy Now)"
    },
    {
      "type": "checkbox",
      "id": "show_payment_icons",
      "label": "Show payment icons",
      "default": true
    },
    {
      "type": "text",
      "id": "hidden_payments",
      "label": "Hide payment icons",
      "info": "Comma-separated, e.g. discover,jcb,diners_club",
      "default": "discover,jcb,diners_club"
    }
  ],
  "blocks": [
    {
      "type": "@app"
    },
    {
      "type": "okendo-reviews",
      "name": "Star Rating",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "reviews_anchor",
          "label": "Reviews section anchor ID",
          "default": "shopify-product-reviews",
          "info": "ID of the reviews section to scroll to"
        },
        {
          "type": "color",
          "id": "star_color",
          "label": "Star color",
          "default": "#EAC78B"
        },
        {
          "type": "color",
          "id": "empty_star_color",
          "label": "Empty star color",
          "default": "#dddddd"
        },
        {
          "type": "range",
          "id": "margin_top",
          "label": "Margin top (px)",
          "min": 0,
          "max": 60,
          "step": 1,
          "default": 10,
          "unit": "px"
        },
        {
          "type": "range",
          "id": "margin_bottom",
          "label": "Margin bottom (px)",
          "min": 0,
          "max": 100,
          "step": 1,
          "default": 24,
          "unit": "px"
        }
      ]
    },
    {
      "type": "title",
      "name": "Product Title",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "custom_title",
          "label": "Custom title",
          "default": "Sleep Spray",
          "info": "Leave blank to use product title"
        },
        {
          "type": "range",
          "id": "margin_top",
          "label": "Margin top (px)",
          "min": 0,
          "max": 100,
          "step": 4,
          "default": 0,
          "unit": "px"
        },
        {
          "type": "range",
          "id": "margin_bottom",
          "label": "Margin bottom (px)",
          "min": 0,
          "max": 100,
          "step": 1,
          "default": 24,
          "unit": "px"
        }
      ]
    },
    {
      "type": "description",
      "name": "Product Description",
      "limit": 1,
      "settings": [
        {
          "type": "range",
          "id": "margin_top",
          "label": "Margin top (px)",
          "min": 0,
          "max": 60,
          "step": 1,
          "default": 10,
          "unit": "px"
        },
        {
          "type": "range",
          "id": "margin_bottom",
          "label": "Margin bottom (px)",
          "min": 0,
          "max": 100,
          "step": 1,
          "default": 20,
          "unit": "px"
        }
      ]
    },
    {
      "type": "price-line",
      "name": "Price line",
      "limit": 1,
      "settings": [
        {
          "type": "paragraph",
          "content": "Selected tier's price, strikethrough and pill. Updates as the shopper switches tiers. Pill text is set on each Tier block."
        },
        {
          "type": "range",
          "id": "margin_top",
          "label": "Margin top (px)",
          "min": 0,
          "max": 60,
          "step": 2,
          "default": 0
        },
        {
          "type": "range",
          "id": "margin_bottom",
          "label": "Margin bottom (px)",
          "min": 0,
          "max": 60,
          "step": 2,
          "default": 20
        }
      ]
    },
    {
      "type": "product-specs",
      "name": "Product Specs",
      "limit": 1,
      "settings": [
        {
          "type": "html",
          "id": "icon_svg",
          "label": "Icon SVG code",
          "info": "Paste SVG code here (optional)"
        },
        {
          "type": "text",
          "id": "custom_text_1",
          "label": "Custom text 1",
          "info": "Leave blank to use variant grams metafield"
        },
        {
          "type": "text",
          "id": "custom_text_2",
          "label": "Custom text 2",
          "info": "Leave blank to use variant servings metafield"
        },
        {
          "type": "range",
          "id": "margin_top",
          "label": "Margin top (px)",
          "min": 0,
          "max": 100,
          "step": 4,
          "default": 0,
          "unit": "px"
        },
        {
          "type": "range",
          "id": "margin_bottom",
          "label": "Margin bottom (px)",
          "min": 0,
          "max": 100,
          "step": 1,
          "default": 24,
          "unit": "px"
        }
      ]
    },
    {
      "type": "supply-selector",
      "name": "Supply selector + Buy Now",
      "limit": 1,
      "settings": [
        {
          "type": "paragraph",
          "content": "Urgency strip, CHOOSE YOUR SUPPLY rows (from the Tier blocks), Buy Now button, guarantee line and payment icons."
        },
        {
          "type": "header",
          "content": "Urgency strip"
        },
        {
          "type": "text",
          "id": "urgency_text",
          "label": "Urgency text",
          "info": "Tokens: {date_ord} = next ship day with ordinal (Fri, Oct 9th), {date} = next ship day (Fri, Oct 9), {cutoff} = now + 1 hour in ET. Leave blank to hide.",
          "default": "Order within the next hour for guaranteed fast shipping by {date_ord}"
        },
        {
          "type": "header",
          "content": "Selector"
        },
        {
          "type": "text",
          "id": "header_text",
          "label": "Divider text",
          "default": "CHOOSE YOUR SUPPLY"
        },
        {
          "type": "range",
          "id": "default_tier",
          "label": "Default selected tier",
          "min": 1,
          "max": 4,
          "step": 1,
          "default": 2
        },
        {
          "type": "header",
          "content": "Button"
        },
        {
          "type": "text",
          "id": "button_text",
          "label": "Button text",
          "default": "BUY NOW"
        },
        {
          "type": "text",
          "id": "guarantee_label",
          "label": "Guarantee line",
          "default": "90-Day Money-Back Guarantee"
        },
        {
          "type": "html",
          "id": "guarantee_icon_svg",
          "label": "Guarantee icon SVG"
        },
        {
          "type": "text",
          "id": "one_time_label",
          "label": "Line shown when the one-time row is selected",
          "default": "ONE-TIME PURCHASE (NOT A SUBSCRIPTION)",
          "info": "Only used when One-time purchase display = Row."
        },
        {
          "type": "inline_richtext",
          "id": "guarantee_bar",
          "label": "Proof bar (under payment icons)",
          "default": "<b>Less than 1%</b> of customers ever claim our 90‑day money‑back guarantee",
          "info": "Light purple bar under the payment icons. Blank to hide."
        }
      ]
    },
    {
      "type": "tier",
      "name": "Tier",
      "limit": 3,
      "settings": [
        {
          "type": "paragraph",
          "content": "Adds Paid quantity of the 1-pack on the Skio plan -- or, with a pack variant set, that one pack on the plan (set Paid quantity to the sprays in the pack). Free quantity (off at launch) adds free one-time 1-packs that the discount code makes $0. Price, strikethrough, SAVE %, per-spray and servings are all calculated."
        },
        {
          "type": "text",
          "id": "label",
          "label": "Title",
          "default": "3 Sleep Sprays"
        },
        {
          "type": "range",
          "id": "paid_qty",
          "label": "Sprays (paid)",
          "min": 1,
          "max": 10,
          "step": 1,
          "default": 1,
          "info": "With a pack variant, the number of sprays in the pack (3 for 90 Servings, 6 for 180 Servings)."
        },
        {
          "type": "range",
          "id": "free_qty",
          "label": "Free sprays (free offer -- 0 = off)",
          "min": 0,
          "max": 10,
          "step": 1,
          "default": 0
        },
        {
          "type": "text",
          "id": "variant_id",
          "label": "Pack variant ID (optional)",
          "info": "e.g. the 90 Servings variant for a 3-spray tier. Blank = build the tier from the 1-pack."
        },
        {
          "type": "text",
          "id": "selling_plan",
          "label": "Skio selling plan ID",
          "info": "Price comes from this plan on the pack variant (or the 1-pack when no pack is set). Blank = one-time price, no subscription."
        },
        {
          "type": "text",
          "id": "discount_code",
          "label": "Discount code",
          "info": "Only for 1-pack tiers with Free quantity > 0: must make the free units $0. Not needed with a pack variant."
        },
        {
          "type": "text",
          "id": "price_pill",
          "label": "Price pill text override",
          "info": "Blank = \"<Sale label> - <SAVE %> OFF\" from the section setting."
        },
        {
          "type": "text",
          "id": "badge",
          "label": "Corner tag",
          "info": "e.g. MOST POPULAR. Leave blank for none."
        },
        {
          "type": "select",
          "id": "badge_style",
          "label": "Corner tag colour",
          "default": "purple",
          "options": [
            {
              "value": "purple",
              "label": "Purple"
            },
            {
              "value": "gold",
              "label": "Gold"
            }
          ]
        },
        {
          "type": "select",
          "id": "band_style",
          "label": "Free band colour",
          "default": "purple",
          "options": [
            {
              "value": "purple",
              "label": "Dark purple"
            },
            {
              "value": "lavender",
              "label": "Soft lavender"
            }
          ]
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "image_asset",
          "label": "Image (theme asset filename)",
          "info": "Fallback when no image is picked, e.g. sleep-spray-tier-3.png."
        },
        {
          "type": "textarea",
          "id": "perks",
          "label": "Perks (shown when selected, one per line)",
          "info": "Tokens: {per_unit} = price per spray, {servings}, {frequency} = plan name (e.g. every 4 weeks), {paid}, {free}."
        }
      ]
    },
    {
      "type": "custom-tabs",
      "name": "Custom Tabs (Accordion)",
      "limit": 1,
      "settings": []
    }
  ]
}
{% endschema %}
