<style>
.puij-v2-section {
    width: 100%;
    background-color: #eaeaf7;
}

.puij-v2-wrapper {
    background-color: #eaeaf7;
    width: 100vw;
    position: relative;
    left: 50%;
    right: 50%;
    margin-left: -50vw;
    margin-right: -50vw;
}

.puij-v2-container {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 32px;
    padding: 64px;
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
}

/* Header row */
.puij-v2-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
}

.puij-v2-heading {
    font-size: 30px;
    font-weight: 500 !important;
    line-height: 1.4;
    color: #141414;
    letter-spacing: 0 !important;
    margin: 0;
}

.puij-v2-heading p {
    margin: 0; padding: 0; font: inherit; letter-spacing: inherit; color: inherit;
}

.puij-v2-heading em {
    color: #672666; font-style: normal; text-decoration: underline;
}

/* Content row */
.puij-v2-content {
    display: flex;
    gap: 64px;
    align-items: flex-start;
    width: 100%;
}

/* Image */
.puij-v2-image {
    flex: 1;
    min-width: 0;
    border-radius: 10px;
    overflow: hidden;
    position: relative;
    height: 600px;
    min-height: 600px;
}

.puij-v2-step-image {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    opacity: 0;
    transition: opacity 0.4s ease;
}

.puij-v2-step-image.is-active {
    opacity: 1;
}

/* Watermark */
/* Accordion */
.puij-v2-accordion {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 16px;
}

.puij-v2-step {
    background: rgba(255,255,255,0.8);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-radius: 10px;
    box-shadow: 0 3px 16px rgba(0,0,0,0.06);
    overflow: hidden;
}

.puij-v2-step-header {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 24px;
    cursor: pointer;
    background: none;
    border: none;
    width: 100%;
    font-family: inherit;
    text-align: left;
}

.puij-v2-step-title {
    flex: 1;
    font-size: 16px;
    line-height: 1.4;
    color: #141414;
}

.puij-v2-step.is-active .puij-v2-step-title {
    font-weight: 700;
}

.puij-v2-step:not(.is-active) .puij-v2-step-title {
    font-weight: 400;
}

.puij-v2-step-chevron {
    width: 24px;
    height: 24px;
    flex-shrink: 0;
}

.puij-v2-step-chevron svg {
    width: 20px;
    height: 20px;
    display: block;
    color: #672666;
    transition: transform 0.22s ease;
}

.puij-v2-step.is-active .puij-v2-step-chevron svg {
    transform: rotate(180deg);
}

/* Step content */
.puij-v2-step-body {
    display: none;
    padding: 0 24px 24px;
    flex-direction: column;
    gap: 24px;
}

.puij-v2-step.is-active .puij-v2-step-body {
    display: flex;
}

.puij-v2-step-desc {
    font-size: 18px;
    font-weight: 400;
    line-height: 1.4;
    color: #141414;
    margin: 0;
}

.puij-v2-step-divider {
    width: 100%;
    height: 1px;
    background: #e5e5e5;
}

/* Tips */
.puij-v2-tips {
    display: flex;
    gap: 24px;
}

.puij-v2-tip {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 16px;
}

.puij-v2-tip-label {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 16px;
    font-weight: 400;
    line-height: 1.4;
    color: #141414;
}

.puij-v2-tip-label svg {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
}

.puij-v2-tip-text {
    font-size: 16px;
    font-weight: 400;
    line-height: 1.4;
    color: #141414;
    margin: 0;
}

/* ===== Responsive ===== */
@media (max-width: 1100px) {
    .puij-v2-container { padding: 40px 32px; }
    .puij-v2-content { gap: 32px; }
    .puij-v2-heading { font-size: 26px; }
}

@media (max-width: 900px) {
    .puij-v2-container {
        padding: 40px 16px;
        gap: 24px;
        align-items: stretch;
    }
    .puij-v2-header {
        display: contents;
    }
    .puij-v2-heading { font-size: 24px; order: 1; width: 100%; text-align: left; }
    .puij-v2-content {
        order: 2;
        flex-direction: column;
        gap: 24px;
        width: 100%;
    }
    .puij-v2-accordion {
        width: 100%;
    }
    .puij-v2-image {
        width: 100%;
        height: 0;
        min-height: 0;
        padding-bottom: 100%;
        border-radius: 20px;
    }
    .puij-v2-step-image {
        border-radius: 20px;
    }
}
</style>

{% assign puij_meta = product.metafields.custom.product_use_in_just.value %}

{% if puij_meta != blank %}

{% assign puij_bg = puij_meta.background | default: '#eaeaf7' %}
{% assign puij_accent = puij_meta.accent_colour | default: product.metafields.custom.base_colour | default: '#672666' %}

<style>
  .puij-v2-wrapper--{{ section.id }} {
    background-color: {{ puij_bg }};
  }
  .puij-v2-wrapper--{{ section.id }} .puij-v2-heading em {
    color: {{ puij_accent }};
  }
  .puij-v2-wrapper--{{ section.id }}
</style>

<div class="puij-v2-wrapper puij-v2-wrapper--{{ section.id }}">
<div class="puij-v2-container">
    {%- comment -%} Header {%- endcomment -%}
    <div class="puij-v2-header">
        <div class="puij-v2-heading">{{ section.settings.heading }}</div>
    </div>

    {%- comment -%} Content {%- endcomment -%}
    <div class="puij-v2-content">
        {%- comment -%} Image {%- endcomment -%}
        <div class="puij-v2-image">
            {% for block in section.blocks %}
                {% if block.settings.image != blank %}
                    <img
                        class="puij-v2-step-image{% if forloop.first %} is-active{% endif %}"
                        data-puij-v2-img="{{ forloop.index0 }}"
                        src="{{ block.settings.image | image_url: width: 800, format: 'webp' }}"
                        srcset="{{ block.settings.image | image_url: width: 400, format: 'webp' }} 400w, {{ block.settings.image | image_url: width: 600, format: 'webp' }} 600w, {{ block.settings.image | image_url: width: 800, format: 'webp' }} 800w, {{ block.settings.image | image_url: width: 1200, format: 'webp' }} 1200w"
                        sizes="(max-width: 900px) 92vw, 400px"
                        alt="{{ block.settings.title }}"
                        loading="{% if forloop.first %}eager{% else %}lazy{% endif %}" {% if forloop.first %}fetchpriority="high"{% endif %} decoding="async">
                {% endif %}
            {% endfor %}
        </div>

        {%- comment -%} Accordion {%- endcomment -%}
        <div class="puij-v2-accordion">
            {% for block in section.blocks %}
                <div class="puij-v2-step{% if forloop.first %} is-active{% endif %}" data-puij-v2-step {{ block.shopify_attributes }}>
                    <button class="puij-v2-step-header" type="button">
                        <span class="puij-v2-step-title">{{ block.settings.title }}</span>
                        <span class="puij-v2-step-chevron">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
                        </span>
                    </button>
                    <div class="puij-v2-step-body">
                        <p class="puij-v2-step-desc">{{ block.settings.description }}</p>
                        {% if block.settings.tip1_label != blank %}
                            <div class="puij-v2-step-divider"></div>
                            <div class="puij-v2-tips">
                                {% if block.settings.tip1_label != blank %}
                                    <div class="puij-v2-tip">
                                        <div class="puij-v2-tip-label">
                                            {% if block.settings.tip1_icon != blank %}
                                                <img src="{{ block.settings.tip1_icon | image_url: width: 32 }}" alt="" width="16" height="16" loading="lazy" decoding="async">
                                            {% endif %}
                                            {{ block.settings.tip1_label }}
                                        </div>
                                        <p class="puij-v2-tip-text">{{ block.settings.tip1_text }}</p>
                                    </div>
                                {% endif %}
                            </div>
                        {% endif %}
                    </div>
                </div>
            {% endfor %}
        </div>
    </div>

    {%- comment -%} Mobile link (shown via CSS order) {%- endcomment -%}
</div>
</div>

{% endif %}

<script>
(function() {
    var section = document.querySelector('.puij-v2-section');
    if (!section) return;

    var steps = section.querySelectorAll('[data-puij-v2-step]');


    function deactivateAll() {
        steps.forEach(function(s) { s.classList.remove('is-active'); });
        section.querySelectorAll('[data-puij-v2-img]').forEach(function(img) { img.classList.remove('is-active'); });
        /* closed state = step 1's image, so opening step 1 never swaps files */
        var firstImg = section.querySelector('[data-puij-v2-img="0"]');
        if (firstImg) firstImg.classList.add('is-active');
    }

    function activate(index) {
        deactivateAll();
        steps[index].classList.add('is-active');
        var img = section.querySelector('[data-puij-v2-img="' + index + '"]');
        if (img) img.classList.add('is-active');
    }

    steps.forEach(function(step, index) {
        step.querySelector('.puij-v2-step-header').addEventListener('click', function() {
            if (step.classList.contains('is-active')) {
                deactivateAll();
            } else {
                activate(index);
            }
        });
    });
})();
</script>

{% schema %}
{
  "name": "Product Use In Just V2",
  "class": "puij-v2-section",
  "settings": [
    {
      "type": "richtext",
      "id": "heading",
      "label": "Heading",
      "default": "<p>Use in <em>just 30 seconds</em></p>"
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Step 1: Spray"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Hold the bottle close and spray 6–8 times under your tongue about 5–10 minutes before bed. Brush your teeth first, then spray—clean breath helps the nutrients absorb faster."
        },
        {
          "type": "image_picker",
          "id": "tip1_icon",
          "label": "Tip 1 icon (SVG)"
        },
        {
          "type": "text",
          "id": "tip1_label",
          "label": "Tip 1 label",
          "default": "When to use"
        },
        {
          "type": "textarea",
          "id": "tip1_text",
          "label": "Tip 1 text",
          "default": "Right before bed, or again if you wake up during the night."
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Step image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product Use In Just V2",
      "category": "Custom",
      "blocks": [
        {
          "type": "step",
          "settings": {
            "title": "Step 1: Spray",
            "description": "Hold the bottle close and spray 6–8 times under your tongue about 5–10 minutes before bed. Brush your teeth first, then spray—clean breath helps the nutrients absorb faster.",
            "tip1_label": "When to use",
            "tip1_text": "Right before bed, or again if you wake up during the night."
          }
        },
        {
          "type": "step",
          "settings": {
            "title": "Step 2: Settle In",
            "description": "Lie down, relax, and let the spray go to work. Most people feel the effects within 10–15 minutes.",
            "tip1_label": "",
            "tip1_text": ""
          }
        },
        {
          "type": "step",
          "settings": {
            "title": "Step 3: Store & Repeat",
            "description": "Keep it on your nightstand. Use it nightly for the best results — consistency is key.",
            "tip1_label": "",
            "tip1_text": ""
          }
        }
      ]
    }
  ]
}
{% endschema %}
