{%- comment -%}
  Content source (per tab, in priority order):
    1. The per-product metaobject custom.real_stories — parent object holding
       heading, facebook_reviews[] (child real_story_fb: screenshot OR name+comment),
       and online_reviews[] (child real_story_review: title/body/name/initials/
       stars/badge/avatar_color). Used on product pages.
    2. The section's own blocks — used on pages with no product context
       (homepage, BOGO/landers) so the section always renders.
  The star banner (trusted_count) stays a global section setting, not per product.
{%- endcomment -%}
{%- liquid
  assign rs = product.metafields.custom.real_stories
  assign rs_fb = rs.value.facebook_reviews.value
  assign rs_online = rs.value.online_reviews.value
  assign rs_heading = rs.value.heading | default: section.settings.heading
  # The field holds the whole highlighted phrase (e.g. "425,000+ Sleepers" or
  # "425,000+ Calmer Customers"). Only "Trusted by" is fixed, so strip it if the
  # value happens to include it; never append a hard-coded noun.
  assign rs_trusted = rs.value.trusted_count | default: section.settings.trusted_count
  assign rs_trusted = rs_trusted | remove_first: 'Trusted by ' | strip

  assign use_fb_meta = false
  if rs_fb != blank and rs_fb.size > 0
    assign use_fb_meta = true
  endif

  assign use_online_meta = false
  if rs_online != blank and rs_online.size > 0
    assign use_online_meta = true
  endif

  # Section background follows the product's sub-base colour (US or British key),
  # falling back to the original light grey on pages with no product context.
  assign rs_bg = product.metafields.custom.sub_base_color.value | default: product.metafields.custom.sub_base_colour.value
  assign rs_bg = rs_bg | default: product.metafields.custom.sub_base_color | default: product.metafields.custom.sub_base_colour | default: '#fafafa'

  # Trust-pill text colour follows the product's base colour (brand purple fallback).
  assign rs_base = product.metafields.custom.base_colour.value | default: product.metafields.custom.base_colour | default: '#672666'
-%}

<style>
.rs-v2-section {
    width: 100%;
    background-color: {{ rs_bg }};
}

.rs-v2-container {
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 22px;
    padding: 56px 64px 64px;
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
}

/* Header — social-proof pill (matches the Video Testimonials banner) */
.rs-v2-rating {
    --base-colour: {{ rs_base }};
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    width: fit-content;
    padding: 10px 15px;
    background: #ffffff;
    border: 1px solid rgba(0,0,0,0.10);
    border-radius: 10px;
}

.rs-v2-stars { display: inline-flex; gap: 0; line-height: 0; flex-shrink: 0; }
.rs-v2-stars svg { width: 18px; height: 18px; display: block; margin: 0 -1px; }

.rs-v2-rating-text {
    /* Optical alignment: nudge the cap-height text down to sit with the stars. */
    transform: translateY(0.1em);
    font-size: 18px;
    font-weight: 700;
    line-height: 1.3;
    color: var(--base-colour, #672666);
}

.rs-v2-rating-text .rs-v2-accent {
    font-weight: 700;
    color: inherit;
}

.rs-v2-heading {
    font-size: 30px;
    font-weight: 500 !important;
    line-height: 1.4;
    color: #141414;
    letter-spacing: 0 !important;
    margin: 0;
    text-align: center;
}

.rs-v2-heading p {
    margin: 0; padding: 0; font: inherit; letter-spacing: inherit; color: inherit;
}

.rs-v2-heading em {
    color: #672666; font-style: normal; text-decoration: underline;
}

/* Tabs */
.rs-v2-tabs {
    display: flex;
    gap: 12px;
    align-items: center;
}

.rs-v2-tab {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 12px 32px;
    border-radius: 80px;
    border: none;
    cursor: pointer;
    font-family: inherit;
    font-size: 14px;
    font-weight: 400;
    line-height: 20px;
    color: #141414;
    background: transparent;
    box-shadow: 0 2px 12px rgba(0,0,0,0.06);
    transition: box-shadow 0.2s ease, background 0.2s ease;
}

.rs-v2-tab.is-active {
    background: rgba(255,255,255,0.8);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    box-shadow: 0 3px 16px rgba(0,0,0,0.06);
}

.rs-v2-tab svg {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
}

/* Reviews grid */
.rs-v2-reviews {
    display: none;
    width: 100%;
}

.rs-v2-reviews.is-active {
    display: block;
    columns: 2;
    column-gap: 30px;
}

/* FB reviews (images) - staggered effect */
.rs-v2-fb-review {
    break-inside: avoid;
    margin-bottom: 30px;
}


.rs-v2-fb-review img {
    width: 100%;
    height: auto;
    display: block;
    border-radius: 4px;
}

/* Trustpilot review cards — 3-column grid */
.rs-v2-reviews--tp.is-active {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 30px;
    columns: unset;
}

.rs-v2-tp-review {
    background: #fff;
    border-radius: 10px;
    padding: 24px 16px;
    display: flex;
    flex-direction: column;
    gap: 16px;
}

.rs-v2-tp-header {
    display: flex;
    align-items: center;
    gap: 12px;
}

.rs-v2-tp-avatar {
    width: 40px;
    height: 40px;
    border-radius: 20px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 13.3px;
    font-weight: 500;
    color: #141414;
    letter-spacing: 0.4px;
    flex-shrink: 0;
}

.rs-v2-tp-info {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 8px;
}

.rs-v2-tp-stars { display: flex; gap: 3px; margin-top: 4px; }
.rs-v2-tp-stars svg { width: 20px; height: 20px; display: block; }

.rs-v2-tp-title {
    font-size: 20px;
    font-weight: 500;
    line-height: 1.4;
    color: #141414;
    margin: 0;
}

.rs-v2-tp-text {
    font-size: 18px;
    font-weight: 400;
    line-height: 1.4;
    color: #141414;
    margin: 0;
}

.rs-v2-tp-footer {
    display: flex;
    flex-direction: row;
    align-items: center;
    flex-wrap: wrap;
    gap: 10px;
}

.rs-v2-tp-name {
    font-size: 16px;
    font-weight: 500;
    line-height: 1.4;
    color: #141414;
}

.rs-v2-tp-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 4px 10px;
    background: #f1f1f1;
    border-radius: 4px;
    font-size: 13px;
    font-weight: 700;
    line-height: 1.4;
    color: #141414;
}

/* FB text review (styled as FB comment) */
.rs-v2-fb-text {
    background: #fff;
    border-radius: 10px;
    padding: 16px;
    display: flex;
    gap: 12px;
    align-items: flex-start;
    break-inside: avoid;
    margin-bottom: 30px;
}


.rs-v2-fb-avatar {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    object-fit: cover;
    flex-shrink: 0;
}

.rs-v2-fb-avatar-placeholder {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: #e4e6eb;
    flex-shrink: 0;
}

.rs-v2-fb-body {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
}

.rs-v2-fb-bubble {
    background: #f0f2f5;
    border-radius: 18px;
    padding: 10px 14px;
}

.rs-v2-fb-name {
    font-size: 13px;
    font-weight: 600;
    line-height: 1.3;
    color: #050505;
}

.rs-v2-fb-comment {
    font-size: 14px;
    font-weight: 400;
    line-height: 1.4;
    color: #050505;
    margin: 2px 0 0;
}

.rs-v2-fb-actions {
    display: flex;
    gap: 12px;
    padding-left: 14px;
}

.rs-v2-fb-action {
    font-size: 12px;
    font-weight: 600;
    color: #65676b;
    cursor: default;
}

/* ===== Responsive ===== */
@media (max-width: 900px) {
    .rs-v2-container {
        padding: 40px 16px;
        gap: 24px;
        align-items: flex-start;
    }
    .rs-v2-heading {
        font-size: 24px;
        text-align: left;
    }
    .rs-v2-tabs {
        width: 100%;
    }
    .rs-v2-tab {
        flex: 1;
        justify-content: center;
        padding: 12px;
    }
    .rs-v2-reviews.is-active {
        columns: 1;
    }
    .rs-v2-fb-review,
    .rs-v2-fb-text {
        margin-bottom: 16px;
    }
    .rs-v2-reviews--tp.is-active {
        grid-template-columns: 1fr;
        gap: 16px;
    }
    .rs-v2-rating-text {
        font-size: 16px;
    }
}
</style>

<div class="rs-v2-container">
    {%- comment -%} Rating {%- endcomment -%}
    <div class="rs-v2-rating">
        <div class="rs-v2-stars">
            {% for i in (1..5) %}
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 25 24" fill="none" aria-hidden="true"><path d="M12.5006 18.26L5.44715 22.2082L7.02248 14.2799L1.08789 8.7918L9.11493 7.84006L12.5006 0.5L15.8862 7.84006L23.9132 8.7918L17.9787 14.2799L19.554 22.2082L12.5006 18.26Z" fill="#fab851"/></svg>
            {% endfor %}
        </div>
        <span class="rs-v2-rating-text">
            Trusted by <span class="rs-v2-accent">{{ rs_trusted }}</span>
        </span>
    </div>

    {%- comment -%} Heading {%- endcomment -%}
    <div class="rs-v2-heading">{{ rs_heading }}</div>

    {%- comment -%} Tabs {%- endcomment -%}
    <div class="rs-v2-tabs">
        <button class="rs-v2-tab is-active" data-rs-v2-tab="facebook" type="button">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="none">
                <circle cx="8" cy="8" r="8" fill="#1877F2"/>
                <path d="M11.1 10.3L11.45 8H9.25V6.5C9.25 5.85 9.56 5.22 10.56 5.22H11.55V3.24C11.55 3.24 10.66 3.09 9.81 3.09C8.03 3.09 6.86 4.17 6.86 6.13V8H4.84V10.3H6.86V16H9.25V10.3H11.1Z" fill="white"/>
            </svg>
            Facebook Reviews
        </button>
        <button class="rs-v2-tab" data-rs-v2-tab="trustpilot" type="button">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="none">
                <circle cx="8" cy="8" r="8" fill="#00B67A"/>
                <path d="M8 3L9.2 6.7H13L9.9 8.9L11.1 12.6L8 10.4L4.9 12.6L6.1 8.9L3 6.7H6.8L8 3Z" fill="white"/>
            </svg>
            Online Reviews
        </button>
    </div>

    {%- comment -%} Facebook Reviews {%- endcomment -%}
    <div class="rs-v2-reviews is-active" data-rs-v2-panel="facebook">
        {% if use_fb_meta %}
            {% for fb in rs_fb %}
                {%- assign fb_img = fb.screenshot -%}
                {% if fb_img != blank %}
                    <div class="rs-v2-fb-review">
                        <img src="{{ fb_img | image_url: width: 800, format: 'webp' }}" alt="Facebook review" loading="lazy" decoding="async">
                    </div>
                {% elsif fb.comment != blank %}
                    <div class="rs-v2-fb-text">
                        {% if fb.avatar != blank %}
                            <img class="rs-v2-fb-avatar" src="{{ fb.avatar | image_url: width: 72, format: 'webp' }}" alt="{{ fb.name }}" loading="lazy" decoding="async">
                        {% else %}
                            <div class="rs-v2-fb-avatar-placeholder"></div>
                        {% endif %}
                        <div class="rs-v2-fb-body">
                            <div class="rs-v2-fb-bubble">
                                <div class="rs-v2-fb-name">{{ fb.name }}</div>
                                <p class="rs-v2-fb-comment">{{ fb.comment }}</p>
                            </div>
                            <div class="rs-v2-fb-actions">
                                <span class="rs-v2-fb-action">Like</span>
                                <span class="rs-v2-fb-action">Reply</span>
                            </div>
                        </div>
                    </div>
                {% endif %}
            {% endfor %}
        {% else %}
        {% for block in section.blocks %}
            {% if block.type == 'fb_review' %}
                <div class="rs-v2-fb-review" style="margin-top: {{ block.settings.offset_top }}px; padding-left: {{ block.settings.offset_left }}px; padding-right: {{ block.settings.offset_right }}px;" {{ block.shopify_attributes }}>
                    {%- assign fb_img_url = block.settings.image | image_url: width: 800, format: 'webp' -%}
                    {% if fb_img_url != blank %}
                        <img
                            src="{{ fb_img_url }}"
                            alt="Facebook review"
                            loading="lazy" decoding="async">
                    {% endif %}
                </div>
            {% elsif block.type == 'fb_text_review' %}
                <div class="rs-v2-fb-text" style="margin-top: {{ block.settings.offset_top }}px; padding-left: {{ block.settings.offset_left }}px; padding-right: {{ block.settings.offset_right }}px;" {{ block.shopify_attributes }}>
                    {% if block.settings.avatar != blank %}
                        <img class="rs-v2-fb-avatar" src="{{ block.settings.avatar | image_url: width: 72, format: 'webp' }}" alt="{{ block.settings.name }}" loading="lazy" decoding="async">
                    {% else %}
                        <div class="rs-v2-fb-avatar-placeholder"></div>
                    {% endif %}
                    <div class="rs-v2-fb-body">
                        <div class="rs-v2-fb-bubble">
                            <div class="rs-v2-fb-name">{{ block.settings.name }}</div>
                            <p class="rs-v2-fb-comment">{{ block.settings.comment }}</p>
                        </div>
                        <div class="rs-v2-fb-actions">
                            <span class="rs-v2-fb-action">Like</span>
                            <span class="rs-v2-fb-action">Reply</span>
                        </div>
                    </div>
                </div>
            {% endif %}
        {% endfor %}
        {% endif %}
    </div>

    {%- comment -%} Online / Trustpilot Reviews {%- endcomment -%}
    <div class="rs-v2-reviews rs-v2-reviews--tp" data-rs-v2-panel="trustpilot">
        {% if use_online_meta %}
            {%- comment -%} Stars, badge and avatar colour are the same for every card,
               so they come from the section settings, not the metaobject. {%- endcomment -%}
            {%- assign rs_avatar_color = section.settings.tp_avatar_color | default: '#d0ffdd' -%}
            {%- assign rs_badge = section.settings.tp_badge -%}
            {%- assign rs_star_count = section.settings.tp_stars | default: 5 -%}
            {% for r in rs_online %}
                {%- comment -%} Initials are derived from the name (first + last word). {%- endcomment -%}
                {%- assign name_parts = r.name | strip | split: ' ' -%}
                {%- assign rs_initials = name_parts.first | slice: 0 | upcase -%}
                {%- if name_parts.size > 1 -%}
                    {%- assign rs_last_initial = name_parts.last | slice: 0 | upcase -%}
                    {%- assign rs_initials = rs_initials | append: rs_last_initial -%}
                {%- endif -%}
                <div class="rs-v2-tp-review">
                    <div class="rs-v2-tp-header">
                        <div class="rs-v2-tp-avatar" style="background-color: {{ rs_avatar_color }};">
                            {{ rs_initials }}
                        </div>
                        <div class="rs-v2-tp-info">
                            <p class="rs-v2-tp-title">{{ r.title }}</p>
                        </div>
                    </div>
                    <p class="rs-v2-tp-text">{{ r.body }}</p>
                    <div class="rs-v2-tp-stars">
                        {% for i in (1..rs_star_count) %}
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect width="24" height="24" fill="#00B67A"/><path d="M12 4 L14.35 9.4 L20 9.9 L15.7 13.7 L17 19.4 L12 16.4 L7 19.4 L8.3 13.7 L4 9.9 L9.65 9.4 Z" fill="#ffffff"/></svg>
                        {% endfor %}
                    </div>
                    <div class="rs-v2-tp-footer">
                        <span class="rs-v2-tp-name">{{ r.name }}</span>
                        {% if rs_badge != blank %}
                            <span class="rs-v2-tp-badge">{{ rs_badge }}</span>
                        {% endif %}
                    </div>
                </div>
            {% endfor %}
        {% else %}
        {% for block in section.blocks %}
            {% if block.type == 'tp_review' %}
                <div class="rs-v2-tp-review" {{ block.shopify_attributes }}>
                    <div class="rs-v2-tp-header">
                        <div class="rs-v2-tp-avatar" style="background-color: {{ block.settings.avatar_color | default: '#d0ffdd' }};">
                            {{ block.settings.initials }}
                        </div>
                        <div class="rs-v2-tp-info">
                            <p class="rs-v2-tp-title">{{ block.settings.title }}</p>
                        </div>
                    </div>
                    <p class="rs-v2-tp-text">{{ block.settings.text }}</p>
                    <div class="rs-v2-tp-stars">
                        {% assign star_count = block.settings.stars | default: 5 %}
                        {% for i in (1..star_count) %}
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect width="24" height="24" fill="#00B67A"/><path d="M12 4 L14.35 9.4 L20 9.9 L15.7 13.7 L17 19.4 L12 16.4 L7 19.4 L8.3 13.7 L4 9.9 L9.65 9.4 Z" fill="#ffffff"/></svg>
                        {% endfor %}
                    </div>
                    <div class="rs-v2-tp-footer">
                        <span class="rs-v2-tp-name">{{ block.settings.name }}</span>
                        {% if block.settings.badge != blank %}
                            <span class="rs-v2-tp-badge">{{ block.settings.badge }}</span>
                        {% endif %}
                    </div>
                </div>
            {% endif %}
        {% endfor %}
        {% endif %}
    </div>
</div>

<script>
(function() {
    var section = document.querySelector('.rs-v2-section');
    if (!section) return;

    var tabs = section.querySelectorAll('[data-rs-v2-tab]');
    var panels = section.querySelectorAll('[data-rs-v2-panel]');

    tabs.forEach(function(tab) {
        tab.addEventListener('click', function() {
            var target = tab.getAttribute('data-rs-v2-tab');
            tabs.forEach(function(t) { t.classList.toggle('is-active', t === tab); });
            panels.forEach(function(p) { p.classList.toggle('is-active', p.getAttribute('data-rs-v2-panel') === target); });
        });
    });
})();
</script>

{% schema %}
{
    "name": "Real Stories V2",
    "class": "rs-v2-section",
    "settings": [
        {
            "type": "text",
            "id": "trusted_count",
            "label": "Trusted count",
            "info": "The whole phrase after 'Trusted by' (e.g. '425,000+ Sleepers'). Fallback only — product pages use custom.real_stories > trusted_count.",
            "default": "425,000+ Sleepers"
        },
        {
            "type": "richtext",
            "id": "heading",
            "label": "Heading",
            "info": "Fallback only. Product pages use custom.real_stories > heading.",
            "default": "<p>Real stories from people who <em>have tried everything</em></p>"
        },
        {
            "type": "header",
            "content": "Online review card style",
            "info": "Applied to every Online Review card (same for all, so not stored per review)."
        },
        {
            "type": "color",
            "id": "tp_avatar_color",
            "label": "Avatar circle color",
            "default": "#d0ffdd"
        },
        {
            "type": "range",
            "id": "tp_stars",
            "label": "Star count",
            "min": 1,
            "max": 5,
            "step": 1,
            "default": 5
        },
        {
            "type": "text",
            "id": "tp_badge",
            "label": "Badge text",
            "default": "Verified"
        }
    ],
    "blocks": [
        {
            "type": "fb_review",
            "name": "Facebook Review",
            "settings": [
                {
                    "type": "image_picker",
                    "id": "image",
                    "label": "Review screenshot"
                },
                {
                    "type": "range",
                    "id": "offset_top",
                    "label": "Top offset (px)",
                    "min": -50,
                    "max": 80,
                    "step": 5,
                    "default": 0,
                    "unit": "px"
                },
                {
                    "type": "range",
                    "id": "offset_left",
                    "label": "Left padding (px)",
                    "min": 0,
                    "max": 60,
                    "step": 5,
                    "default": 0,
                    "unit": "px"
                },
                {
                    "type": "range",
                    "id": "offset_right",
                    "label": "Right padding (px)",
                    "min": 0,
                    "max": 60,
                    "step": 5,
                    "default": 0,
                    "unit": "px"
                }
            ]
        },
        {
            "type": "fb_text_review",
            "name": "Facebook Review (text)",
            "settings": [
                {
                    "type": "image_picker",
                    "id": "avatar",
                    "label": "Avatar"
                },
                {
                    "type": "text",
                    "id": "name",
                    "label": "Name",
                    "default": "Karla Finney"
                },
                {
                    "type": "textarea",
                    "id": "comment",
                    "label": "Comment",
                    "default": "Just tried last night for the first time. HOLY HELL, for literally the first time in 10 years, I SLEPT THROUGH THE NIGHT!"
                },
                {
                    "type": "range",
                    "id": "offset_top",
                    "label": "Top offset (px)",
                    "min": -50,
                    "max": 80,
                    "step": 5,
                    "default": 0,
                    "unit": "px"
                },
                {
                    "type": "range",
                    "id": "offset_left",
                    "label": "Left padding (px)",
                    "min": 0,
                    "max": 60,
                    "step": 5,
                    "default": 0,
                    "unit": "px"
                },
                {
                    "type": "range",
                    "id": "offset_right",
                    "label": "Right padding (px)",
                    "min": 0,
                    "max": 60,
                    "step": 5,
                    "default": 0,
                    "unit": "px"
                }
            ]
        },
        {
            "type": "tp_review",
            "name": "Trustpilot Review",
            "settings": [
                {
                    "type": "text",
                    "id": "initials",
                    "label": "Initials",
                    "default": "LD"
                },
                {
                    "type": "color",
                    "id": "avatar_color",
                    "label": "Avatar color",
                    "default": "#d0ffdd"
                },
