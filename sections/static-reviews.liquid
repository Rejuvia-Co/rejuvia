{%- comment -%}
  Static Reviews — fixed customer reviews in the Okendo card style (replaces the Okendo widget).
  Review content lives in snippets/rj-static-reviews.liquid (one line per review).
  Adding this section also hides the Okendo app section and the auto-inserted fallback copy on the page.
{%- endcomment -%}
{%- render 'rj-static-reviews',
  heading: section.settings.heading,
  subheading: section.settings.subheading,
  initial: section.settings.initial,
  variant: 'section'
-%}

{% schema %}
{
  "name": "Static Reviews",
  "tag": "div",
  "class": "rj-static-reviews-section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Real Reviews From 500,000+ Sleepers" },
    { "type": "text", "id": "subheading", "label": "Rating line", "default": "4.5 Stars | 8,500+ Verified Customer Reviews" },
    { "type": "range", "id": "initial", "label": "Reviews shown before \"Show more\"", "min": 3, "max": 18, "step": 3, "default": 6 },
    { "type": "paragraph", "content": "Edit, reorder or date the reviews in snippets/rj-static-reviews.liquid." }
  ],
  "presets": [ { "name": "Static Reviews" } ]
}
{% endschema %}
