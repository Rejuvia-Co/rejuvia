{%- comment -%}
  Comments: Facebook social-proof section (real, unedited Facebook comment screenshots).
  Rendered by sections/comments.liquid, and by sections/customer-testimonials-video.liquid
  in place of "Join 500,000..." on the BOGO page templates (senior, bogosub, bogosub2, bogotest).

  Params (all optional):
    badge, headline, highlight, sub_desktop, sub_mobile
  Images: assets/fb-comment-{id}.webp (desktop crop, 2x) and fb-comment-{id}-m.webp
  (same pixels re-flowed for phones). Lossless WebP of the design-handoff PNGs.
{%- endcomment -%}
{%- liquid
  assign c_badge = badge | default: '5,000,000+ Sprays Sold'
  assign c_headline = headline | default: 'Real Reviews From'
  assign c_highlight = highlight | default: '531,719 Customers'
  assign c_sub_d = sub_desktop | default: 'Unedited comments from our Facebook community'
  assign c_sub_m = sub_mobile | default: 'Unedited comments from Facebook'

  # id|asset|css width|css height|name
  assign col_1 = 'barbara|fb-comment-barbara|548|66|Barbara Cartee;lori|fb-comment-lori|571|85|Lori Tranum McCullough;jeane|fb-comment-jeane|583|84|Jeane Calfee Gross;robin|fb-comment-robin|594|121|Robin Burrows Vera;janet|fb-comment-janet|407|66|Janet Whitmire Robinson;ted|fb-comment-ted|347|67|Ted Ensminger' | split: ';'
  assign col_2 = 'betty|fb-comment-betty|582|85|Betty Kowalski;stephanie|fb-comment-stephanie|574|85|Stephanie E Oberdin Bailes;cathy|fb-comment-cathy|589|85|Cathy A Roe;brian|fb-comment-brian|595|85|Brian Owen;ao|fb-comment-ao|550|67|Ao Kieffer;rebecca|fb-comment-rebecca|406|66|Rebecca Watson Routon' | split: ';'
  assign col_m = 'barbara|fb-comment-barbara-m|311|86|Barbara Cartee;betty|fb-comment-betty-m|310|101|Betty Kowalski;lori|fb-comment-lori-m|304|105|Lori Tranum McCullough;stephanie|fb-comment-stephanie-m|309|124|Stephanie E Oberdin Bailes;janet|fb-comment-janet|407|66|Janet Whitmire Robinson;jeane|fb-comment-jeane-m|326|123|Jeane Calfee Gross;ted|fb-comment-ted|347|67|Ted Ensminger;robin|fb-comment-robin-m|322|195|Robin Burrows Vera;rebecca|fb-comment-rebecca|406|66|Rebecca Watson Routon;cathy|fb-comment-cathy-m|323|105|Cathy A Roe;diane|fb-comment-diane|300|81|Diane Townsend' | split: ';'
-%}
<style>
  .fbc { background: #F9F9F9; color: #141414; font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; }
  .fbc__inner { max-width: 1200px; margin: 0 auto; padding: 80px 0 88px; display: flex; flex-direction: column; align-items: center; gap: 40px; }
  .fbc__head { display: flex; flex-direction: column; align-items: center; gap: 20px; text-align: center; }
  .fbc__badge { display: flex; align-items: center; gap: 14px; background: #fff; border: 1px solid #E6E6E6; border-radius: 14px; padding: 14px 22px; }
  .fbc__stars { display: block; flex: none; width: 110px; height: 22px; }
  .fbc__badge-text { font-weight: 700; font-size: 20px; line-height: 1.2; color: #5F2A63; letter-spacing: -0.01em; }
  .fbc .fbc__title { margin: 0; font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; font-weight: 700; font-size: 46px; line-height: 1.1; letter-spacing: -0.015em; color: #141414; text-transform: none; }
  .fbc__title span { color: #5F2A63; text-decoration: underline; text-decoration-thickness: 3px; text-underline-offset: 6px; }
  .fbc__sub { display: flex; align-items: center; gap: 8px; font-size: 16px; line-height: 1.3; color: #5A5A5A; margin: 0; }
  .fbc__sub svg { display: block; flex: none; width: 18px; height: 18px; }
  .fbc__sub-m { display: none; }
  .fbc__grid { width: 100%; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20px; align-items: start; }
  .fbc__panel { background: #fff; border: 1px solid #E6E6E6; border-radius: 12px; padding: 18px 20px 10px; display: flex; flex-direction: column; gap: 4px; box-sizing: border-box; }
  .fbc__panel img { display: block; max-width: 100%; height: auto; }
  .fbc__panel--m { display: none; }
  @media (max-width: 1240px) { .fbc__inner { padding-left: 20px; padding-right: 20px; } }
  @media (max-width: 899px) {
    .fbc__inner { padding: 48px 16px 56px; gap: 28px; }
    .fbc__head { gap: 16px; }
    .fbc__badge { gap: 10px; border-radius: 12px; padding: 11px 16px; }
    .fbc__stars { width: 85px; height: 17px; }
    .fbc__badge-text { font-size: 16px; }
    .fbc .fbc__title { font-size: 30px; line-height: 1.15; letter-spacing: -0.01em; text-wrap: balance; }
    .fbc__title span { text-decoration-thickness: 2px; text-underline-offset: 5px; }
    .fbc__sub { gap: 7px; font-size: 14px; }
    .fbc__sub svg { width: 16px; height: 16px; }
    .fbc__sub-d { display: none; }
    .fbc__sub-m { display: inline; }
    .fbc__grid { display: none; }
    .fbc__panel--m { display: flex; width: 100%; padding: 14px 12px 6px; }
  }
</style>
<div class="fbc">
  <div class="fbc__inner">
    <div class="fbc__head">
      <div class="fbc__badge">
        <svg class="fbc__stars" viewBox="0 0 100 20" role="img" aria-label="5 stars">
          {%- for x in (0..4) -%}<path transform="translate({{ x | times: 20 }} 0)" d="M10 .8l2.75 5.95 6.5.75-4.83 4.42 1.33 6.42L10 15.1l-5.75 3.24 1.33-6.42L.75 7.5l6.5-.75z" fill="#FDB447"/>{%- endfor -%}
        </svg>
        <span class="fbc__badge-text">{{ c_badge }}</span>
      </div>
      <h2 class="fbc__title">{{ c_headline }} <span>{{ c_highlight }}</span></h2>
      <p class="fbc__sub">
        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="12" fill="#1877F2"/><path d="M13.2 19v-6.1h2l.3-2.4h-2.3V9c0-.7.2-1.2 1.2-1.2h1.2V5.7c-.2 0-1-.1-1.8-.1-1.8 0-3 1.1-3 3.1v1.8h-2v2.4h2V19h2.4z" fill="#fff"/></svg>
        <span class="fbc__sub-d">{{ c_sub_d }}</span><span class="fbc__sub-m">{{ c_sub_m }}</span>
      </p>
    </div>
    <div class="fbc__grid">
      {%- for col in (1..2) -%}
        {%- if col == 1 -%}{%- assign list = col_1 -%}{%- else -%}{%- assign list = col_2 -%}{%- endif -%}
        <div class="fbc__panel">
          {%- for row in list -%}
            {%- assign c = row | split: '|' -%}
            <img src="{{ c[1] | append: '.webp' | asset_url }}" width="{{ c[2] }}" height="{{ c[3] }}" alt="Facebook comment from {{ c[4] }}" loading="lazy" decoding="async">
          {%- endfor -%}
        </div>
      {%- endfor -%}
    </div>
    <div class="fbc__panel fbc__panel--m">
      {%- for row in col_m -%}
        {%- assign c = row | split: '|' -%}
        <img src="{{ c[1] | append: '.webp' | asset_url }}" width="{{ c[2] }}" height="{{ c[3] }}" alt="Facebook comment from {{ c[4] }}" loading="lazy" decoding="async">
      {%- endfor -%}
    </div>
  </div>
</div>
