{%- comment -%}
  Vertical checkmark benefit list (Gruns-style), driven by the product metafield
  custom.key_benefits (type: list of single-line text). Renders NOTHING when the
  metafield is empty. Check colour follows --base-colour (green fallback), matching
  the used-by bar / leaf icon. Reusable on any template:
    {% render 'product-benefits', product: currentProduct %}
{%- endcomment -%}
{%- comment -%}
  Accept either a proper list metafield (each entry = one benefit) or a single
  line-text field holding a comma-separated string. In the string case, split on
  commas and strip stray wrapping quotes/spaces so "A", "B", "C" still yields
  three clean rows.
{%- endcomment -%}
{%- assign mf = product.metafields.custom.key_benefits -%}
{%- if mf.type contains 'list' -%}
  {%- assign benefits = mf.value -%}
{%- else -%}
  {%- assign benefits = mf.value | split: ',' -%}
{%- endif -%}
{%- if benefits and benefits.size > 0 -%}
  <ul class="pw-benefits">
    {%- for benefit in benefits -%}
      {%- assign line = benefit | strip | replace: '"', '' | replace: '“', '' | replace: '”', '' | strip -%}
      {%- if line != blank -%}
      <li class="pw-benefit">
        <span class="pw-benefit__check" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg>
        </span>
        <span class="pw-benefit__text">{{ line }}</span>
      </li>
      {%- endif -%}
    {%- endfor -%}
  </ul>
  {%- unless pw_benefits_css -%}{%- assign pw_benefits_css = true -%}
  <style>
    .pw-benefits { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 10px; }
    .pw-benefit { display: flex; align-items: center; gap: 10px; color: #141414; font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; font-size: 18px; font-weight: 400; line-height: 1.35; }
    .pw-benefit__check { display: inline-flex; flex-shrink: 0; color: var(--base-colour, #018C0B); }
    .pw-benefit__check svg { display: block; }
    @media (max-width: 749px) {
      .pw-benefits { gap: 8px; }
      .pw-benefit { font-size: 16px; }
      .pw-benefit__check svg { width: 18px; height: 18px; }
    }
  </style>
  {%- endunless -%}
{%- endif -%}
