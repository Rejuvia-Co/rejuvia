{%- assign rj_list = rj_reviews | split: '^^' -%}
{%- liquid
  # Params (all optional): heading, initial (cards shown before "Show more"), variant ('section' | 'fallback')
  assign rj_heading = heading | default: 'Real Reviews From 500,000+ Sleepers'
  assign rj_initial = initial | default: 6 | plus: 0
  assign rj_variant = variant | default: 'section'
-%}

<style>
  /* Hide the Okendo app section on these pages; static reviews replace it. */
  [id$="__17814435248f2fd49e"] { display: none !important; }

  /* The auto-inserted fallback copy steps aside once the Static Reviews section is on the page. */
  body:has(.rj-rev--section) .rj-rev--fallback { display: none !important; }

  .rj-rev { background: #fff; padding: 64px 16px; font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; color: #1f1f1f; }
  .rj-rev__wrap { max-width: 860px; margin: 0 auto; }
  .rj-rev__head { text-align: center; margin-bottom: 36px; }
  /* Family / weight / letter-spacing come from the global --rj-title-* system (theme.liquid), like every BOGO section heading. */
  .rj-rev__title { font-size: 36px; line-height: 1.2; color: #171512; margin: 0; text-wrap: balance; }
  .rj-rev__head .rj-rev__title { display: block; }
  /* Review bar: same as the offer section's (offer-block-sub .obs__reviewbar), centered. */
  .rj-rev__rb { display: flex; align-items: center; justify-content: center; gap: 10px; font-size: 16px; color: #4a4550; flex-wrap: wrap; margin: 0 0 14px; }
  .rj-rev__rb-stars { display: inline-flex; gap: 1.5px; flex-shrink: 0; }
  .rj-rev__rb-stars svg { width: 15px; height: 15px; display: block; }
  .rj-rev__rb-sep { color: #d9d3e0; }
  .rj-rev__rb strong { color: #171512; font-weight: 800; }

  .rj-rev__list { display: grid; gap: 18px; }
  .rj-rev__card { background: #fff; border: 1px solid #e6e2dc; border-radius: 14px; padding: 28px 30px 24px; box-shadow: 0 1px 2px rgba(0,0,0,.03); }
  .rj-rev__card[hidden] { display: none; }
  .rj-rev__top { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 8px; }
  .rj-rev__stars { display: inline-flex; gap: 1.5px; }
  .rj-rev__stars svg { width: 20px; height: 20px; }
  .rj-rev__date { font-size: 14px; color: #6b6b6b; white-space: nowrap; }
  .rj-rev__ctitle { font-size: 21px; font-weight: 700; line-height: 1.25; margin: 0 0 10px; color: #1f1f1f; }
  .rj-rev__body { font-size: 17px; line-height: 1.65; color: #333; margin: 0 0 20px; }
  .rj-rev__foot { display: flex; align-items: center; flex-wrap: wrap; gap: 10px; padding-top: 16px; border-top: 1px solid #f0ece6; font-size: 15px; }
  .rj-rev__name { font-weight: 700; color: #1f1f1f; }
  .rj-rev__div { width: 1px; height: 16px; background: #d9d4cc; }
  .rj-rev__ver { display: inline-flex; align-items: center; gap: 6px; color: #555; }
  .rj-rev__ver svg { width: 17px; height: 17px; flex: none; }

  .rj-rev__more-wrap { text-align: center; margin-top: 28px; }
  .rj-rev__more { appearance: none; background: #fff; color: #672666; border: 1.5px solid #672666; border-radius: 999px; padding: 14px 34px; font: 600 16px/1 'Helvetica Neue', Helvetica, Arial, sans-serif; cursor: pointer; transition: background .15s, color .15s; }
  .rj-rev__more:hover, .rj-rev__more:active, .rj-rev__more:focus-visible { background: #672666; color: #fff; border-color: #672666; outline: none; }

  @media (max-width: 600px) {
    .rj-rev { padding: 44px 16px; }
    .rj-rev__title { font-size: 26px; line-height: 1.15; }
    .rj-rev__head { margin-bottom: 24px; }
    .rj-rev__rb { gap: 7px; font-size: 14px; margin-bottom: 10px; }
    .rj-rev__rb-rating, .rj-rev__rb-sep-reviews { display: none; }
    .rj-rev__rb-customers { order: 1; }
    .rj-rev__rb-sep-customers { order: 2; }
    .rj-rev__rb-reviews { order: 3; }
    .rj-rev__rb-stars svg { width: 14px; height: 14px; }
    .rj-rev__card { padding: 22px 20px 18px; }
    .rj-rev__ctitle { font-size: 19px; }
    .rj-rev__body { font-size: 16px; }
  }
</style>

{%- capture rj_star -%}<svg viewBox="0 0 20 20" aria-hidden="true"><path fill="#E2B55A" d="M10 1.5l2.6 5.4 5.9.8-4.3 4.1 1 5.8L10 14.9l-5.2 2.7 1-5.8L1.5 7.7l5.9-.8z"/></svg>{%- endcapture -%}

{%- capture rj_rb_star -%}<svg viewBox="0 0 18 16" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M3.85124 15.9392C3.43952 16.1504 2.97233 15.7803 3.05553 15.3078L3.94083 10.2626L0.183091 6.68298C-0.167831 6.34806 0.0145632 5.73581 0.484948 5.66968L5.70931 4.9273L8.03883 0.31199C8.24895 -0.103997 8.81747 -0.103997 9.0276 0.31199L11.3571 4.9273L16.5815 5.66968C17.0519 5.73581 17.2343 6.34806 16.8823 6.68298L13.1256 10.2626L14.0109 15.3078C14.0941 15.7803 13.6269 16.1504 13.2152 15.9392L8.53161 13.5329L3.85124 15.9392Z" fill="{{ section.settings.stars_color | default: '#E2B55A' }}"/></svg>{%- endcapture -%}
<section class="rj-rev rj-rev--{{ rj_variant }}"{% if rj_variant == 'section' %} id="reviews"{% endif %} aria-label="Customer reviews" data-rj-rev>
  <div class="rj-rev__wrap">
    <div class="rj-rev__head">
      <div class="rj-rev__rb">
        <span class="rj-rev__rb-stars" role="img" aria-label="5 stars">{{ rj_rb_star }}{{ rj_rb_star }}{{ rj_rb_star }}{{ rj_rb_star }}{{ rj_rb_star }}</span>
        <span class="rj-rev__rb-rating"><strong>4.5</strong> Stars</span>
        <span class="rj-rev__rb-sep rj-rev__rb-sep-reviews" aria-hidden="true">|</span>
        <span class="rj-rev__rb-reviews"><strong>7,500+</strong> Reviews</span>
        <span class="rj-rev__rb-sep rj-rev__rb-sep-customers" aria-hidden="true">|</span>
        <span class="rj-rev__rb-customers"><strong>500K+</strong> Customers</span>
      </div>
      <h2 class="rj-rev__title">{{ rj_heading }}</h2>
    </div>

    <div class="rj-rev__list" data-rj-rev-list>
      {%- for r in rj_list -%}
        {%- assign f = r | strip | split: '||' -%}
        {%- assign r_name = f[0] | strip -%}
        {%- assign r_date = f[1] | strip -%}
        {%- assign r_title = f[2] | strip -%}
        {%- assign r_body = f[3] | strip -%}
        {%- if r_name == blank -%}{%- continue -%}{%- endif -%}
        <article class="rj-rev__card"{% if forloop.index > rj_initial %} hidden{% endif %}>
          <div class="rj-rev__top">
            <div class="rj-rev__stars" aria-label="5 out of 5 stars">{{ rj_star }}{{ rj_star }}{{ rj_star }}{{ rj_star }}{{ rj_star }}</div>
            {%- if r_date != blank -%}<span class="rj-rev__date">{{ r_date }}</span>{%- endif -%}
          </div>
          <h3 class="rj-rev__ctitle">{{ r_title }}</h3>
          <p class="rj-rev__body">{{ r_body }}</p>
          <div class="rj-rev__foot">
            <span class="rj-rev__name">{{ r_name }}</span>
            <span class="rj-rev__div" aria-hidden="true"></span>
            <span class="rj-rev__ver">
              <svg viewBox="0 0 20 20" aria-hidden="true"><circle cx="10" cy="10" r="10" fill="#E2B55A"/><path fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" d="M6.3 10.2l2.5 2.5 4.9-5"/></svg>
              Verified Customer
            </span>
          </div>
        </article>
      {%- endfor -%}
    </div>

    {%- if rj_list.size > rj_initial -%}
      <div class="rj-rev__more-wrap">
        <button type="button" class="rj-rev__more" data-rj-rev-more>Show More Reviews</button>
      </div>
    {%- endif -%}
  </div>
</section>

<script>
  (function () {
    document.querySelectorAll('[data-rj-rev]').forEach(function (root) {
      if (root.dataset.rjRevInit) return;
      root.dataset.rjRevInit = '1';
      if (root.classList.contains('rj-rev--fallback') && document.querySelector('.rj-rev--section')) { root.remove(); return; }
      var btn = root.querySelector('[data-rj-rev-more]');
      if (!btn) return;
      var step = {{ rj_initial }};
      btn.addEventListener('click', function () {
        var hidden = root.querySelectorAll('.rj-rev__card[hidden]');
        for (var i = 0; i < hidden.length && i < step; i++) hidden[i].removeAttribute('hidden');
        if (hidden.length <= step) btn.parentNode.remove();
      });
    });
  })();
</script>
